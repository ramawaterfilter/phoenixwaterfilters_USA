{% assign secondary_heading = product.metafields.custom.secondary_heading %}
{% assign secondary_content = product.metafields.custom.secondary_content | metafield_tag %}

{% if product.metafields.custom.show_secondary_panel != false %}

  <div class="background-image-container {{ section.settings.style }}"></div>

  <div class="{{ section.settings.custom_class }} layout-copy" id="{{ section.settings.custom_id }}">

    {% assign col_one_class = 'col-11 col-md-9 col-lg-9' %}
    {% assign col_two_class = 'copy-col col-11 col-md-9 col-lg-9 ' %}
    {% assign row_settings = 'justify-content-center' %}
    {% assign h2_setting = 'col-10 col-md-12 text-lg-start' %}


    <div class="container">
      <div class="row align-items-center {{ row_settings }}">

        <div class="{{ col_two_class }}">

          {% if secondary_heading != blank %}
            <h2 class="{{ h2_setting }}">{{ secondary_heading }}</h2>

          {% elsif section.settings.heading != blank %}
            <h2 class="{{ h2_setting }}">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if secondary_content != blank %}
            {{ secondary_content }}
          {% elsif section.settings.content != blank %}
            {{ section.settings.content | replace: '[month]', '<span class="dyn-month"></span>' }}
          {% endif %}


          {% if section.settings.buttonlink != blank %}
            <div class="row">
              <div class="col-12">
                {% render 'button' %}
              </div>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endif %}

{% schema %}
  {
    "name": "Secondary Details",
    "tag": "section",
    "class": "section-copy-image secondary-details",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Background",
        "default": "bg-white",
        "options": [
          {
            "label": "White",
            "value": "bg-white"
          }, {
            "label": "Light",
            "value": "bg-light"
          }
        ]
      },

      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes/ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }
    ],
    "presets": [
      {
        "name": "Secondary Details"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}