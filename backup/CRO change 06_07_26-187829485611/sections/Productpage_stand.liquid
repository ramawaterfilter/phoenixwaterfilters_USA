 <script>
document.addEventListener("DOMContentLoaded", function () {
  // ======= Stainless Steel Spigot Logic =======
  const addonCheckbox = document.getElementById("addon-checkbox");
  const addonPriceSpan = document.getElementById("addon-price");
  const addonMap = window.addonVariantMap || {};

  function updateSpigotAddon(sizeValue) {
    const addonData = addonMap[sizeValue];
    if (!addonData) return;

    addonCheckbox.dataset.variantId = addonData.id;

    const originalPrice = parseFloat(addonData.price);
    const discountedPrice = (originalPrice * 0.65).toFixed(2); // 35% OFF

    addonCheckbox.dataset.price = discountedPrice;

    addonPriceSpan.innerHTML = `
      <span style="color: #dc2626; font-weight: 600; display:none;">₹${discountedPrice}</span>
      <s style="margin-left: 8px; color: #888; display:none;">₹${originalPrice.toFixed(2)}</s>
      <span style="color: #0f2f4f; margin-left: 5px; font-size:16px; font-weight:600; display:none;">35% OFF</span>
    `;
  }

  // ======= Wooden & Steel Stand Logic =======
  const woodenRadio = document.querySelector('input[value="Premium Wooden Stand"]');
  const steelRadio = document.querySelector('input[value="Stainless Steel Stand"]');
  const woodenPriceSpan = woodenRadio?.closest('.addon-card')?.querySelector('.addon-price span');
  const steelPriceSpan = steelRadio?.closest('.addon-card')?.querySelector('.addon-price span');

  const woodenMap = window.woodenStandVariantMap || {};
  const steelMap = window.steelStandVariantMap || {};

  function updateStandAddons(sizeValue) {
    // Premium Wooden Stand
    if (woodenRadio && woodenMap[sizeValue]) {
      woodenRadio.value = woodenMap[sizeValue].id;
      if (woodenPriceSpan) {
        const originalPrice = parseFloat(woodenMap[sizeValue].price);
        const discountedPrice = (originalPrice * 0.8).toFixed(2); // 20% OFF
        woodenPriceSpan.innerHTML = `
          <span style="color: #dc2626; font-weight: 600;  font-size:16px; display:none;">₹${discountedPrice}</span>
          <s style="margin-left: 8px; color: #888; font-size:16px; display:none;"">₹${originalPrice.toFixed(2)}</s><br>
          <span style="color: #0f2f4f; margin-left: 5px; font-size:16px; font-weight:600; display:none;">20% OFF</span>
        `;
      }
    }

    // Stainless Steel Stand
    if (steelRadio && steelMap[sizeValue]) {
      steelRadio.value = steelMap[sizeValue].id;
      if (steelPriceSpan) {
        const originalPrice = parseFloat(steelMap[sizeValue].price);
        const discountedPrice = (originalPrice * 0.8).toFixed(2); // 20% OFF
        steelPriceSpan.innerHTML = `
          <span style="color: #dc2626; font-weight: 600; font-size:16px; display:none;">₹${discountedPrice}</span>
          <s style="margin-left: 8px; color: #888; font-size:16px; display:none;">₹${originalPrice.toFixed(2)}</s><br>
          <span style="color: #0f2f4f; margin-left: 5px; font-size:16px; font-weight:600; display:none;">20% OFF</span>
        `;
      }
    }
  }

  // ======= Listen for size change =======
  const sizeRadios = document.querySelectorAll('input[name="size"]');
  sizeRadios.forEach(radio => {
    radio.addEventListener('change', function () {
      if (radio.checked) {
        updateSpigotAddon(radio.value);
        updateStandAddons(radio.value);
      }
    });
  });

  // ======= Run on load =======
  const selectedSize = document.querySelector('input[name="size"]:checked')?.value;
  if (selectedSize) {
    updateSpigotAddon(selectedSize);
    updateStandAddons(selectedSize);
  }
});
</script>



<script>
document.addEventListener("DOMContentLoaded", function () {
  const basePriceEl = document.getElementById('base-price');
  const variantSelect = document.getElementById('product-selectors');
  const addonCards = document.querySelectorAll('.addon-card');

  if (!basePriceEl || !variantSelect || addonCards.length === 0) return;

  function parsePrice(text) {
    return parseFloat(text.replace(/[^0-9.]/g, '')) || 0;
  }

  function getVariantPrice() {
    const selectedOption = variantSelect.options[variantSelect.selectedIndex];
    const priceStr = selectedOption?.getAttribute('data-price') || '0';
    return parsePrice(priceStr);
  }

  function getSelectedAddonPrices() {
    let total = 0;
    addonCards.forEach(card => {
      if (card.classList.contains('selected')) {
        const priceSpan = card.querySelector('.addon-price span');
        const priceText = priceSpan?.textContent || '0';
        total += parsePrice(priceText);
      }
    });
    return total;
  }

  function updateBasePrice() {
    const variantPrice = getVariantPrice();
    const addonTotal = getSelectedAddonPrices();
    const total = variantPrice + addonTotal;

    basePriceEl.textContent = `$${total.toFixed(2)}`;
  }

  // Listen to variant change
  variantSelect.addEventListener('change', updateBasePrice);

  // Listen to clicks on all addon cards
  addonCards.forEach(card => {
    card.addEventListener('click', function () {
      setTimeout(updateBasePrice, 50);
    });
  });

  // Initial run
  updateBasePrice();
});
</script>




