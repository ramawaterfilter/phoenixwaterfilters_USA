<script>
document.addEventListener("DOMContentLoaded", function () {
  const popup = document.getElementById("variant-popup-overlay");
  const closeBtn = document.getElementById("variant-popup-close");
  const imgDiv = document.getElementById("variant-popup-image");
  const titleEl = document.getElementById("variant-popup-title");
  const descEl = document.getElementById("variant-popup-description");
  const variantSelect = document.querySelector('#product-selectors');
  const wrapper = document.querySelector(".variant-wrapper");
  const textArea = document.getElementById("variant-popup-text");
  const variants = window.productVariants || [];

  // ✅ Popup content database
  const filterPopupData = {
    "2 Carbon Filter Elements": {
      title: "2 Carbon Filter Elements",
      desc: "Our carbon filter elements are made from 100% natural coconut shells, known for their excellent adsorption properties. For optimal performance, we recommend replacing them <strong>every 12 months</strong>.",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Learn_more_Carbon_2.jpg?v=1750924148"
    },
    "2 Carbon Filters + POSTreat Fluoride and Arsenic Reduction Filter Elements": {
      title: "POSTreat + Carbon Filters",
      desc: "Built with AISI 304 stainless steel, the POSTreat filters house our proprietary Fluorid™™™ media, specifically designed to reduce fluoride and other persistent impurities. To ensure continued effectiveness, the filter media should be replaced <strong> every 4 months </strong>, while the stainless steel casing is reusable.",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Convenient_1.jpg?v=1750924148"
    }
  };

 const standPopupData = {
       "Stainless Steel Stand": {
       title: "Stainless Steel Stand",
       desc: "Choose the right size that fits your Place",
        img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Stainless_Stand.jpg?v=1751539237"
    },
   "Teak Wood Stand": {
      title: "Teak Wood Stand",
desc: "Choose the right size that fits your Place",

        img: "https://cdn.shopify.com/s/files/1/2644/2852/files/Teak_Wood_Stand-varient.jpg?v=1751539320"
    }
  };

  const staticPopupContent = {
    size: {
      title: "Size Guide",
      desc: "Choose the right size that fills your family",
      img: "https://cdn.shopify.com/s/files/1/2644/2852/files/image_112_6b13c989-b9fe-4a74-a49e-1c1803ae1fde.png?v=1750936024"
      
    }
  };

  // ✅ Open popup with layout mode
  function openPopup({ title, desc, img, layout = "default" }) {
    titleEl.textContent = title;
    // descEl.textContent = desc;
    descEl.innerHTML = desc;
    imgDiv.style.backgroundImage = `url('${img}')`;

    wrapper.classList.remove("filter-layout", "default-layout", "image-below-layout");

    // 🔁 Reorder DOM based on layout
    if (layout === "image-below") {
      wrapper.classList.add("image-below-layout");
      if (wrapper.lastElementChild !== imgDiv) {
        wrapper.insertBefore(textArea, wrapper.firstChild);
        wrapper.appendChild(imgDiv); // move image to bottom
      }
    } else {
      wrapper.classList.add(layout === "filter" ? "filter-layout" : "default-layout");
      if (wrapper.firstElementChild !== imgDiv) {
        wrapper.insertBefore(imgDiv, wrapper.firstChild); // move image to top
        wrapper.insertBefore(textArea, imgDiv.nextSibling);
      }
    }

    popup.style.display = "flex";
  }

  // ✅ FILTER button
  const filterBtn = document.getElementById("filter-popup-btn");
  if (filterBtn) {
    filterBtn.addEventListener("click", () => {
      const selectedId = variantSelect?.value;
      const variant = variants.find(v => v.id == selectedId);
      if (!variant) return;
      const filter = variant.options[1];
      const data = filterPopupData[filter];
      if (data) openPopup({ ...data, layout: "filter" });
    });
  }

  // ✅ STAND button
  const standBtn = document.getElementById("stand-popup-btn");
  if (standBtn) {
    standBtn.addEventListener("click", () => {
      const selectedId = variantSelect?.value;
      const variant = variants.find(v => v.id == selectedId);
      if (!variant) return;
      const stand = variant.options[2];
      const data = standPopupData[stand];
      if (data) openPopup({ ...data, layout: "image-below" });
    });
  }

  // ✅ SIZE button
  const sizeBtn = document.getElementById("size-popup-btn");
  if (sizeBtn) {
    sizeBtn.addEventListener("click", () => openPopup({ ...staticPopupContent.size, layout: "image-below" }));
  }

  // ✅ Close popup on click or overlay click
  closeBtn.addEventListener("click", () => popup.style.display = "none");
  popup.addEventListener("click", (e) => {
    if (e.target === popup) popup.style.display = "none";
  });
});
  
