<script>
  function toggleAddonCard(card) {
    const checkbox = card.querySelector('input[type="checkbox"]');
    if (!checkbox) return; // only runs for checkbox-style add-ons
    card.classList.toggle('selected');
    checkbox.checked = !checkbox.checked;
    updateTotalPrice();
  }

  function selectStandAddon(card) {
    const allCards = document.querySelectorAll('.addon-card input[name="stand-addon"]');
    allCards.forEach(input => input.closest('.addon-card').classList.remove('selected'));
    const radio = card.querySelector('input[name="stand-addon"]');
    radio.checked = true;
    card.classList.add('selected');
    updateTotalPrice();
  }

  function selectFilterAddon(card) {
    const allCards = document.querySelectorAll('.addon-card input[name="filter-addon"]');
    allCards.forEach(input => input.closest('.addon-card').classList.remove('selected'));
    const radio = card.querySelector('input[name="filter-addon"]');
    radio.checked = true;
    card.classList.add('selected');
    updateTotalPrice();
  }

  function updateTotalPrice() {
    const priceEl = document.querySelector('#main-price');
    const basePrice = parseFloat(priceEl.dataset.base) || 0;
    let total = basePrice;

    // Vision Tap / Spigot
    const addonCheckbox = document.querySelector('#addon-checkbox');
    if (addonCheckbox?.checked) {
      total += parseFloat(addonCheckbox.dataset.price) || 0;
    }

    // Stand
    const selectedStandRadio = document.querySelector('input[name="stand-addon"]:checked');
    if (selectedStandRadio && selectedStandRadio.value !== '') {
      total += parseFloat(selectedStandRadio.dataset.price) || 0;
    }

    // POSTreat (radio)
    const selectedFilterRadio = document.querySelector('input[name="filter-addon"]:checked');
    if (selectedFilterRadio && selectedFilterRadio.value !== '') {
      total += parseFloat(selectedFilterRadio.dataset.price) || 0;
    }

    priceEl.innerText = `$${total.toLocaleString()}`;
  }

  document.addEventListener('DOMContentLoaded', function () {
    const addonCheckbox = document.querySelector('#addon-checkbox'); // Vision Tap
    const atcBtn = document.querySelector('.btn-product');

    if (!atcBtn) return;

    atcBtn.addEventListener('click', function (e) {
      e.preventDefault();

      const mainVariantId = Number(document.querySelector('input[name="id"]').value);
      const items = [{ id: mainVariantId, quantity: 1 }];

      // Vision Tap / Spigot
      if (addonCheckbox?.checked) {
        const addonId = Number(addonCheckbox.dataset.variantId);
        if (addonId) items.push({ id: addonId, quantity: 1 });
      }

      // Stand
      const selectedStandRadio = document.querySelector('input[name="stand-addon"]:checked');
      if (selectedStandRadio && selectedStandRadio.value !== '') {
        const standVariantId = Number(selectedStandRadio.dataset.variantId);
        if (standVariantId) items.push({ id: standVariantId, quantity: 1 });
      }

      // POSTreat (radio)
      const selectedFilterRadio = document.querySelector('input[name="filter-addon"]:checked');
      if (selectedFilterRadio && selectedFilterRadio.value !== '') {
        const postreatId = Number(selectedFilterRadio.dataset.variantId || 0);
        if (postreatId && !items.some(it => Number(it.id) === postreatId)) {
          items.push({ id: postreatId, quantity: 1 });
        }
      }

      fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: items })
      }).then(() => {
        window.location.href = '/cart';
      });
    });
  });
</script>



