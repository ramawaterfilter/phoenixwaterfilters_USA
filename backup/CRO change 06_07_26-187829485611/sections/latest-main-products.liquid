  // ✅ Open popup with layout mode
  function openPopup({ title, desc, img, layout = "default" }) {
    titleEl.textContent = title;
    // descEl.textContent = desc;
    descEl.innerHTML = desc;
    imgDiv.style.backgroundImage = `url('${img}')`;

    wrapper.classList.remove("filter-layout", "default-layout", "image-below-layout");

    // 🔁 Reorder DOM based on layout
    if (layout === "image-below") {
      wrapper.classList.add("image-below-layout");
      if (wrapper.lastElementChild !== imgDiv) {
        wrapper.insertBefore(textArea, wrapper.firstChild);
        wrapper.appendChild(imgDiv); // move image to bottom
      }
    } else {
      wrapper.classList.add(layout === "filter" ? "filter-layout" : "default-layout");
      if (wrapper.firstElementChild !== imgDiv) {
        wrapper.insertBefore(imgDiv, wrapper.firstChild); // move image to top
        wrapper.insertBefore(textArea, imgDiv.nextSibling);
      }
    }

    popup.style.display = "flex";
