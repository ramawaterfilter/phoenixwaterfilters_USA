    img: "https://cdn.shopify.com/s/files/1/2644/2852/files/WITHOUT_STAND.jpg?v=1778562490"
  }

};


document.addEventListener("DOMContentLoaded", function () {

  const variantSelect = document.getElementById("product-selectors");
  const standBtn = document.getElementById("stand-popup-btn");
  const variants = window.productVariants || [];

  function updateStandPopup() {

    const selectedId = variantSelect?.value;
    const variant = variants.find(v => v.id == selectedId);

    if (!variant) return;

    // 3rd option = Stand
    const standOption = variant.options[2];

    // Always show button
    standBtn.style.display = "inline-block";

    // Get popup data
    const popupData = standPopupData[standOption];

    if (popupData) {

      // Example popup content update
      const popupTitle = document.querySelector(".stand-popup-title");
      const popupDesc = document.querySelector(".stand-popup-desc");
      const popupImg = document.querySelector(".stand-popup-image");

      if (popupTitle) {
        popupTitle.innerText = popupData.title;
      }

      if (popupDesc) {
        popupDesc.innerText = popupData.desc;
      }

      if (popupImg) {
        popupImg.src = popupData.img;
      }

    }

  }

  // Initial load
  updateStandPopup();

  // Variant change
  variantSelect?.addEventListener("change", updateStandPopup);

});

</script>     
