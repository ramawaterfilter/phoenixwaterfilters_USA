  if (sizeBtn) {
    sizeBtn.addEventListener("click", () => openPopup({ ...staticPopupContent.size, layout: "image-below" }));
  }

  // ✅ Close popup on click or overlay click
  closeBtn.addEventListener("click", () => popup.style.display = "none");
  popup.addEventListener("click", (e) => {
    if (e.target === popup) popup.style.display = "none";
  });
});
  
