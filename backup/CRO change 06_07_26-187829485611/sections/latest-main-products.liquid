<script>
  // Image lookup based on Filter Type + Stand
  window.variantComboImages = {
    {% for variant in product.variants %}
      "{{ variant.options[1] }}|{{ variant.options[2] }}": {{ variant.metafields.custom.variant_combo_image | json }}
      {% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // Full variant list
  window.productVariants = [
    {% for variant in product.variants %}
      {
        id: {{ variant.id }},
        options: [{% for opt in variant.options %}"{{ opt }}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
      }{% unless forloop.last %}, {% endunless %}
    {% endfor %}
  ];
</script>
<script>
document.addEventListener("DOMContentLoaded", function () {

  const comboImages = window.variantComboImages || {};
  const variants = window.productVariants || [];
  const variantSelect = document.querySelector('form[action^="/cart/add"] select[name="id"]');

  // 👉 GET CORRECT SWIPER INSTANCE
  const mainSliderEl = document.querySelector('#product-slider');
  const mainSwiperInstance = mainSliderEl ? mainSliderEl.swiper : null;

  const navSliderEl = document.querySelector('#product-slider-nav');
  const navSwiperInstance = navSliderEl ? navSliderEl.swiper : null;

  if (!variantSelect) {
    console.warn("❌ Variant select not found");
    return;
  }

  function updateImageFromVariant() {
    const variantId = variantSelect.value;
    const variant = variants.find(v => v.id == variantId);
    if (!variant) return;

    const comboKey = `${variant.options[1]}|${variant.options[2]}`;
    const imageUrl = comboImages[comboKey];

    if (!imageUrl) {
      console.warn("⚠️ No image found for combo:", comboKey);
      return;
    }

    // ✅ UPDATE FIRST SLIDE IMAGE
    const firstSlideImg = document.querySelector('#product-slider .swiper-slide:first-child img');

    if (firstSlideImg) {
      firstSlideImg.src = imageUrl;
      firstSlideImg.srcset = imageUrl;
      firstSlideImg.alt = comboKey;
    }

    // ✅ 🔥 RESET CORRECT SWIPER
    setTimeout(() => {
      if (mainSliderEl && mainSliderEl.swiper) {
        mainSliderEl.swiper.slideTo(0, 0); // 🔥 THIS IS THE REAL FIX
      }

      if (navSliderEl && navSliderEl.swiper) {
        navSliderEl.swiper.slideTo(0, 0);
      }
    }, 50);

    console.log("✅ Forced to first image");
  }

  // ✅ SINGLE EVENT
  variantSelect.addEventListener("change", updateImageFromVariant);

  // ✅ LOAD
  updateImageFromVariant();

});
</script>


    
