{% comment %}
  Recent Articles Section - Full Dynamic Shopify Section
  Features: Dynamic blog selection, desktop columns setting, load more, all colors dynamic
{% endcomment %}

{%- liquid
  assign blog_handle = section.settings.blog
  assign posts_per_page = section.settings.posts_per_page | default: 6
  assign desktop_columns = section.settings.desktop_columns | default: 3
  assign section_heading = section.settings.heading
  assign show_author = section.settings.show_author
  assign show_date = section.settings.show_date
  assign show_last_updated = section.settings.show_last_updated
  assign date_format = section.settings.date_format | default: 'abbreviated_date'
  assign button_label = section.settings.load_more_label | default: 'Load More'
-%}

<style>
  #shopify-section-{{ section.id }} {
    background-color: {{ section.settings.section_bg_color }};
    padding-top: {{ section.settings.section_padding_top }}px;
    padding-bottom: {{ section.settings.section_padding_bottom }}px;
  }



  .ra-{{ section.id }} .ra-grid {
    display: grid;
    grid-template-columns: repeat({{ desktop_columns }}, 1fr);
    gap: {{ section.settings.card_gap }}px;
    max-width: {{ section.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 {{ section.settings.container_padding }}px;
  }

  @media (max-width: 1024px) {
    .ra-{{ section.id }} .ra-grid {
      grid-template-columns: repeat({{ section.settings.tablet_columns | default: 2 }}, 1fr);
    }
  }

  @media (max-width: 640px) {
    .ra-{{ section.id }} .ra-grid {
      grid-template-columns: repeat({{ section.settings.mobile_columns | default: 1 }}, 1fr);
    }
  }

  .ra-{{ section.id }} .ra-card {
    background-color: {{ section.settings.card_bg_color }};
    border-radius: {{ section.settings.card_border_radius }}px;
    height:fit-content;
    border: {{ section.settings.card_border_width }}px solid {{ section.settings.card_border_color }};
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .ra-{{ section.id }} .ra-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0,0,0,0.12);
  }

  .ra-{{ section.id }} .ra-card-image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_aspect_ratio }};
    background-color: {{ section.settings.image_placeholder_color }};
  }

  .ra-{{ section.id }} .ra-card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }

  .ra-{{ section.id }} .ra-placeholder-box {
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0; left: 0;
    background-color: {{ section.settings.image_placeholder_color }};
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ra-{{ section.id }} .ra-placeholder-box svg {
    width: 48px;
    height: 48px;
    opacity: 0.35;
    fill: #fff;
  }

  .ra-{{ section.id }} .ra-card:hover .ra-card-image-wrap img {
    transform: scale(1.05);
  }

  .ra-{{ section.id }} .ra-card-body {
    padding: {{ section.settings.card_padding }}px;
  }

  .ra-{{ section.id }} .ra-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
    margin-bottom: 10px;
  }

  .ra-{{ section.id }} .ra-meta-item {
    font-size: {{ section.settings.meta_font_size }}px;
    color: {{ section.settings.meta_text_color }};
    line-height: 1.4;
  }

  .ra-{{ section.id }} .ra-meta-label {
    font-weight: 700;
    color: {{ section.settings.meta_label_color }};
  }

  .ra-{{ section.id }} .ra-card-title {
    font-size: {{ section.settings.title_font_size }}px;
    font-weight: {{ section.settings.title_font_weight }};
    color: {{ section.settings.title_color }};
    line-height: 1.35;
    margin-bottom: 16px;
    display: -webkit-box;
    -webkit-line-clamp: {{ section.settings.title_lines }};
    -webkit-box-orient: vertical;
    overflow: hidden;
    text-decoration: none;
  }

  .ra-{{ section.id }} .ra-card-title a {
    color: inherit;
    text-decoration: none;
  }

  .ra-{{ section.id }} .ra-card-title a:hover {
    color: {{ section.settings.title_hover_color }};
  }

  .ra-{{ section.id }} .ra-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .ra-{{ section.id }} .ra-author {
    font-size: {{ section.settings.meta_font_size }}px;
    color: {{ section.settings.author_color }};
  }

  .ra-{{ section.id }} .ra-read-more {
    font-size: {{ section.settings.read_more_font_size }}px;
    font-weight: {{ section.settings.read_more_font_weight }};
    color: {{ section.settings.read_more_color }};
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 4px;
    white-space: nowrap;
    transition: gap 0.2s ease;
  }

  .ra-{{ section.id }} .ra-read-more:hover {
    color: {{ section.settings.read_more_hover_color }};
    gap: 8px;
  }

  .ra-{{ section.id }} .ra-read-more-arrow {
    display: inline-block;
    transition: transform 0.2s ease;
  }

  .ra-{{ section.id }} .ra-read-more:hover .ra-read-more-arrow {
    transform: translateX(3px);
  }

  .ra-{{ section.id }} .ra-load-more-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    background-color: {{ section.settings.button_bg_color }};
    color: {{ section.settings.button_text_color }};
    border: {{ section.settings.button_border_width }}px solid {{ section.settings.button_border_color }};
    border-radius: {{ section.settings.button_border_radius }}px;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    font-size: {{ section.settings.button_font_size }}px;
    font-weight: {{ section.settings.button_font_weight }};
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.15s ease;
    text-decoration: none;
    min-width: 140px;
  }

  .ra-{{ section.id }} .ra-load-more-btn:hover {
    background-color: {{ section.settings.button_bg_hover_color }};
    color: {{ section.settings.button_text_hover_color }};
    transform: translateY(-2px);
  }

  .ra-{{ section.id }} .ra-load-more-btn:active {
    transform: translateY(0);
  }

  .ra-{{ section.id }} .ra-load-more-btn.loading {
    opacity: 0.7;
    pointer-events: none;
  }

  .ra-{{ section.id }} .ra-spinner {
    width: 16px;
    height: 16px;
    border: 2px solid transparent;
    border-top-color: currentColor;
    border-radius: 50%;
    animation: ra-spin 0.6s linear infinite;
    display: none;
  }

  .ra-{{ section.id }} .ra-load-more-btn.loading .ra-spinner {
    display: block;
  }

  .ra-{{ section.id }} .ra-card.ra-hidden {
    display: none;
  }

  @keyframes ra-spin {
    to { transform: rotate(360deg); }
  }

  @keyframes ra-fadeIn {
    from { opacity: 0; transform: translateY(16px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .ra-{{ section.id }} .ra-card.ra-animate {
    animation: ra-fadeIn 0.4s ease forwards;
  }

  .ra-{{ section.id }} .ra-no-articles {
    text-align: center;
    color: {{ section.settings.meta_text_color }};
    font-size: 16px;
    padding: 40px 0;
    grid-column: 1 / -1;
  }


@media(max-width: 768px){
    .ra-{{ section.id }} .ra-section-title {
    color: {{ section.settings.heading_color }};
    font-size: 24px;
    font-weight: {{ section.settings.heading_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: 10px;
    font-family: inherit;
    line-height: 1.2;
  }
    .ra-{{ section.id }} .ra-load-more-wrap {
    text-align: center;
    width: 90%;
    margin: 0 auto;
  }
}



@media(min-width: 768px){
    .ra-{{ section.id }} .ra-section-title {
    color: {{ section.settings.heading_color }};
    font-size: {{ section.settings.heading_font_size }}px;
    font-weight: {{ section.settings.heading_font_weight }};
    text-align: {{ section.settings.heading_alignment }};
    margin-bottom: {{ section.settings.heading_margin_bottom }}px;
    font-family: inherit;
    line-height: 1.2;
  }
    .ra-{{ section.id }} .ra-load-more-wrap {
    text-align: center;
    margin-top: {{ section.settings.button_margin_top }}px;
  }
}
</style>

<section class="ra-{{ section.id }}" id="recent-articles-{{ section.id }}">

  {%- if section_heading != blank -%}
    <h2 class="ra-section-title">{{ section_heading }}</h2>
  {%- endif -%}
    {%- if section.settings.heading1 != blank -%}
    <div class="ra-section-title-sub">{{ section.settings.heading1 }}</div>
  {%- endif -%}

  {%- if blog_handle != blank and blogs[blog_handle] != blank -%}
    {%- assign selected_blog = blogs[blog_handle] -%}
    {%- assign all_articles = selected_blog.articles -%}
    {%- assign total_articles = all_articles.size -%}

    <div class="ra-grid" id="ra-grid-{{ section.id }}"
      data-posts-per-page="{{ posts_per_page }}"
      data-total="{{ total_articles }}"
      data-visible="{{ posts_per_page }}">

      {%- for article in all_articles limit: total_articles -%}
        {%- assign is_hidden = false -%}
        {%- if forloop.index > posts_per_page -%}
          {%- assign is_hidden = true -%}
        {%- endif -%}

        <article class="ra-card{% if is_hidden %} ra-hidden{% endif %}" data-index="{{ forloop.index }}">
          <a href="{{ article.url }}" class="ra-card-image-wrap" tabindex="-1" aria-label="{{ article.title }}">
            {%- if article.image != blank -%}
              <img
                src="{{ article.image | image_url: width: 800 }}"
                alt="{{ article.image.alt | escape | default: article.title }}"
                loading="lazy"
                width="{{ article.image.width }}"
                height="{{ article.image.height }}"
              >
            {%- else -%}
              <div class="ra-placeholder-box">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M21 19V5c0-1.1-.9-2-2-2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-8.5-5.5l-2.51 3.01L7 13l-4 5h18l-5.5-6.5z"/>
                </svg>
              </div>
            {%- endif -%}
          </a>

          <div class="ra-card-body">
            {%- if show_date or show_last_updated -%}
              <div class="ra-meta">
                {%- if show_date -%}
                  <span class="ra-meta-item">
                    <span class="ra-meta-label">Published:</span>
                    {{ article.published_at | date: '%d %b %Y' }}
                  </span>
                {%- endif -%}
                {%- if show_last_updated -%}
                  <span class="ra-meta-item">
                    <span class="ra-meta-label">Last Updated:</span>
                    {{ article.updated_at | date: '%d %b %Y' }}
                  </span>
                {%- endif -%}
              </div>
            {%- endif -%}

            <h3 class="ra-card-title">
              <a href="{{ article.url }}">{{ article.title }}</a>
            </h3>

            <div class="ra-card-footer">
              {%- if show_author -%}
                <span class="ra-author">By {{ article.author }}</span>
              {%- endif -%}
              <a href="{{ article.url }}" class="ra-read-more">
                {{ section.settings.read_more_label | default: 'Read full article' }}
                <span class="ra-read-more-arrow">→</span>
              </a>
            </div>
          </div>
        </article>
      {%- endfor -%}

      {%- if total_articles == 0 -%}
        <p class="ra-no-articles">No articles found in this blog.</p>
      {%- endif -%}
    </div>

    {%- if total_articles > posts_per_page -%}
      <div class="ra-load-more-wrap">
        <button
          class="ra-load-more-btn"
          id="ra-load-more-{{ section.id }}"
          aria-label="{{ button_label }}"
        >
          <span class="ra-spinner"></span>
          <span class="ra-btn-text">{{ button_label }}</span>
        </button>
      </div>
    {%- endif -%}

  {%- else -%}
    <div style="text-align:center; padding: 40px; color: #999;">
      Please select a blog in section settings.
    </div>
  {%- endif -%}

</section>

<script>
(function() {
  var sectionId = '{{ section.id }}';
  var grid      = document.getElementById('ra-grid-' + sectionId);
  var btn       = document.getElementById('ra-load-more-' + sectionId);

  if (!grid || !btn) return;

  var postsPerPage = parseInt(grid.dataset.postsPerPage, 10);
  var total        = parseInt(grid.dataset.total, 10);
  var visible      = parseInt(grid.dataset.visible, 10);

  btn.addEventListener('click', function() {
    btn.classList.add('loading');

    setTimeout(function() {
      var cards    = grid.querySelectorAll('.ra-card.ra-hidden');
      var toShow   = Array.prototype.slice.call(cards, 0, postsPerPage);
      var delay    = 0;

      toShow.forEach(function(card) {
        card.style.animationDelay = delay + 'ms';
        card.classList.remove('ra-hidden');
        card.classList.add('ra-animate');
        delay += 80;
      });

      visible += toShow.length;
      grid.dataset.visible = visible;

      btn.classList.remove('loading');

      if (visible >= total) {
        btn.closest('.ra-load-more-wrap').style.display = 'none';
      }
    }, 400);
  });
})();
</script>

