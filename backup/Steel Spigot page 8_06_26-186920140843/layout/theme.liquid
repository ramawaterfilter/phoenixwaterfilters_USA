     <script>
      document.addEventListener("DOMContentLoaded", function () {
        const spans = document.querySelectorAll(".essential_annoucement_bar_running_line_title_2e6862de-d0c0-4ae0-8f85-4edc49c3b78c span");

        spans.forEach(span => {
          let html = span.innerHTML;

          // 60 Years of Pure Excellence
          if (html.includes("60 Years of Pure Excellence")) {
            html = html.replace(
              /60 Years of Pure Excellence/,
              '<span class="custom-excellence-text">60 Years of Pure Excellence</span>'
            );
          }

          // Free Shipping on Orders $99+
          if (html.includes("Free Shipping on Orders $99+")) {
            html = html.replace(
              /Free Shipping on Orders \$99\+/,
              '<span class="custom-shipping-text">Free Shipping on Orders $99+</span>'
            );
          }

          // NSF Certified
          if (html.includes("NSF Certified")) {
            html = html.replace(
              /NSF Certified/,
              '<span class="custom-nsf-text">NSF Certified</span>'
            );
          }

              // NSF Certified
          if (html.includes("PRE BLACK FRIDAY SALE")) {
            html = html.replace(
              /NSF Certified/,
              '<span class="custom-pre-text">PRE BLACK FRIDAY SALE</span>'
            );
          }
          // Questions? Call Us at...
          if (html.includes("Questions? Call Us at")) {
            html = html.replace(
              /Questions\? Call Us at 1 \(800\) 917-0455/,
              '<span class="custom-call-text">Questions? Call Us at 1 (800) 917-0455</span>'
            );
          }

          span.innerHTML = html;
        });
      });


      document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.disclosure__button').forEach(button => {
    button.addEventListener('click', function() {
      const list = button.nextElementSibling;
      const expanded = button.getAttribute('aria-expanded') === 'true';
      button.setAttribute('aria-expanded', !expanded);
      list.hidden = expanded;
    });
  });
});
