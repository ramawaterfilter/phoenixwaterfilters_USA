<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Is It Essential To Prime The Carbon Filter Elements?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Priming the Carbon Filter Elements is the first step to ensuring your filters are completely free of any residuals from the manufacturing process. The residuals are completely normal and safe but can lead to cloudy water if the filters are not correctly primed. We recommend priming your Carbon Filter Elements for at least three minutes. If not primed sufficiently, the first four rounds of filtered water may have cloudy white particles that can be safely discarded."
      }
    },
    {
      "@type": "Question",
      "name": "Why Is My Water Cloudy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Don't worry, cloudy water after initial installation is normal and completely harmless. It's simply safe residual dust from the manufacturing process. It can occur if the filters are not correctly primed. If it is not primed, it can take about four rounds of filtered water to clear."
      }
    },
    {
      "@type": "Question",
      "name": "How Long Will My Carbon Filter Elements Last?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "We recommend replacing your Carbon Filter Elements every 12 months."
      }
    },
    {
      "@type": "Question",
      "name": "How Frequently Do I Need To Change My Filters?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "This depends on usage frequency and water quality. As a guide, Carbon Filter Elements should be replaced every 12 months, while POSTreat and FluoRid Media Refill should be replaced every 4 months."
      }
    }
  ]
}
</script>

