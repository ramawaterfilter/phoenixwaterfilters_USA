addon-element-box {\n      flex-direction: row;\n      align-items: center;\n      gap: 12px;\n      padding: 14px 12px;\n      border-radius: 16px;\n    }\n\n    .addon-element-box__icon {\n      flex: 0 0 40px;\n      width: 40px;\n      height: 40px;\n    }\n\n    .addon-element-box__icon img {\n      width: 40px;\n      height: 40px;\n    }\n\n    .addon-element-box__label {\n      margin-bottom: 4px;\n      font-size: 10px;\n      letter-spacing: 1.3px;\n    }\n\n    .addon-element-box__title {\n      margin-bottom: 4px;\n      font-size: 15px;\n      line-height: 1.3;\n    }\n\n    .addon-element-box__description {\n      font-size: 12px;\n      line-height: 1.4;\n    }\n  }\n</style>",
