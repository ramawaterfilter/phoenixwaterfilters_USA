          "name": "Custom code",
          "settings": {
            "custom_html": "<div class=\"warranty-banner\">\n  <div class=\"warranty-banner__badge\">\n    <img class=\"warranty-banner__image\" src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/10_year_warranty_-_Icon_9da089e9-2768-4875-b6a2-76d4b5ccb25c.png?v=1792150482\" alt=\"10 Years Warranty\" loading=\"lazy\" width=\"400\" height=\"400\">\n  </div>\n\n  <div class=\"warranty-banner__content\">\n    <div class=\"warranty-banner__eyebrow\">\n      10-YEAR WARRANTY\n    </div>\n\n    <h2 class=\"warranty-banner__heading\">\n      Built to last a decade. Backed for ten years.\n    </h2>\n\n    <p class=\"warranty-banner__description\">\n      The AISI 304 stainless steel casing carries a full 10-year warranty on defects in materials. Only the FluoRid media is replaced, every 4 months or about 1,060 gallons.\n    </p>\n  </div>\n</div>\n\n<style>\n  \n.warranty-banner__badge {\n  flex: 0 0 200px;\n  width: 200px;\n}\n\n.warranty-banner__image {\n  display: block;\n  width: 100%;\n  height: auto;\n  object-fit: contain;\n}\n\n@media screen and (max-width: 749px) {\n  .warranty-banner__badge {\n    flex: 0 0 130px;\n    width: 130px;\n  }\n}\n\n</style>",
            "custom_css": ".warranty-banner {\n  display: flex;\n  flex-direction: row;\n  align-items: center;\n  gap: 22px;\n  width: 100%;\n  box-sizing: border-box;\n  padding: 26px 30px;\n  background: #0b1638;\n  border-radius: 20px;\n  color: #ffffff;\n  font-family: inherit;\n}\n\n.warranty-banner__badge {\n  position: relative;\n  flex: 0 0 90px;\n  width: 90px;\n  height: 112px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n}\n\n.warranty-banner__shield {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.warranty-banner__badge-text {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n}\n\n.warranty-banner__number {\n  font-size: 34px;\n  font-weight: 700;\n  line-height: 1;\n  color: #ffffff;\n}\n\n.warranty-banner__years {\n  margin-top: 5px;\n  color: #EBA06A;\n  font-size: 10px;\n  font-weight: 400;\n  letter-spacing: 1.5px;\n  line-height: 1;\n}\n\n.warranty-banner__content {\n  flex: 1;\n  min-width: 0;\n}\n\n.warranty-banner__eyebrow {\n  margin: 0 0 5px;\n  color: #fff;\n  font-size: 11px;\n  font-weight: 400;\n  letter-spacing: 1.5px;\n  line-height: 1.4;\n}\n\n.warranty-banner__heading {\n  margin: 0 0 7px;\n  padding: 0;\n  color: #ffffff;\n  font-family: inherit;\n  font-size: 25px;\n  font-weight: 700;\n  line-height: 1.2;\n  letter-spacing: 0;\n}\n\n.warranty-banner__description {\n  margin: 0;\n  padding: 0;\n  color: #E8EFF0;\n  font-size: 14px;\n  font-weight: 400;\n  line-height: 1.55;\n}\n\n/* Tablet */\n@media screen and (max-width: 749px) {\n  .warranty-banner {\n    flex-direction: row;\n    align-items: center;\n    gap: 15px;\n    padding: 20px 18px;\n    border-radius: 16px;\n  }\n\n  .warranty-banner__badge {\n    flex: 0 0 68px;\n    width: 68px;\n    height: 88px;\n  }\n\n  .warranty-banner__number {\n    font-size: 27px;\n  }\n\n  .warranty-banner__years {\n    font-size: 8px;\n    letter-spacing: 1px;\n  }\n\n  .warranty-banner__eyebrow {\n    font-size: 9px;\n    letter-spacing: 1px;\n    margin-bottom: 4px;\n  }\n\n  .warranty-banner__heading {\n    font-size: 19px;\n    line-height: 1.25;\n    margin-bottom: 6px;\n  }\n\n  .warranty-banner__description {\n    font-size: 12px;\n    line-height: 1.45;\n  }\n}\n\n/* Mobile — keep the shield and text horizontal */\n@media screen and (max-width: 480px) {\n  .warranty-banner {\n    flex-direction: row;\n    align-items: center;\n    gap: 10px;\n    padding: 16px 12px;\n    border-radius: 14px;\n  }\n\n  .warranty-banner__badge {\n    flex: 0 0 54px;\n    width: 54px;\n    height: 72px;\n  }\n\n  .warranty-banner__number {\n    font-size: 22px;\n  }\n\n  .warranty-banner__years {\n    margin-top: 3px;\n    font-size: 7px;\n    letter-spacing: 0.8px;\n  }\n\n  .warranty-banner__eyebrow {\n    font-size: 8px;\n    letter-spacing: 0.8px;\n    line-height: 1.3;\n    margin-bottom: 4px;\n  }\n\n  .warranty-banner__heading {\n    font-size: 16px;\n    line-height: 1.25;\n    margin-bottom: 5px;\n  }\n\n  .warranty-banner__description {\n    font-size: 11px;\n    line-height: 1.45;\n  }\n}",
