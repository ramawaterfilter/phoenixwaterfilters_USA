    "custom_accordion_tabs_z8hfDR": {
      "type": "custom-accordion-tabs",
      "blocks": {
        "tab_BNKGR7": {
          "type": "tab",
          "name": "Set Up",
          "settings": {
            "tab_title": "Setup"
          }
        },
        "question_answer_8z76f4": {
          "type": "question_answer",
          "name": "Set Up Question and answer",
          "settings": {
            "question": "How long do the POSTreat Steel Filter elements last?",
            "answer": "<p>The AISI 304 stainless steel casing is built to last 10+ years and is covered by a 10-year warranty. The FluoRid media inside — which does the fluoride capturing — needs to be replaced every 4 months or approximately every 1,060 gallons of filtration, whichever comes first. Only the media changes; the steel casing stays for a decade.<br/></p>"
          }
        },
        "question_answer_HetfrQ": {
          "type": "question_answer",
          "name": "Set Up Question and answer",
          "settings": {
            "question": "How often do I need to replace the FluoRid media?",
            "answer": "<p>Every 4 months or after approximately 1,060 gallons of filtered water — whichever milestone you hit first. If your household uses more water (5+ people), you may reach the gallon threshold sooner. Signing up for our FluoRid Media Refill subscription means we track it for you and ship on schedule. Subscribers also save 5% per order.</p>"
          }
        },
        "question_answer_Jd9ERA": {
          "type": "question_answer",
          "name": "Set Up Question and answer",
          "settings": {
            "question": "Can I install and replace these myself?",
            "answer": "<p>Absolutely. No specialist tools, no plumber, no electrician. POSTreat Steel Filter elements thread directly onto the primary carbon filter elements using your hands — full step-by-step instructions are included in every box. If you ever get stuck, our team is one call away at 1 (800) 917-0455.</p>"
          }
        },
        "question_answer_dNeGxz": {
          "type": "question_answer",
          "name": "Set Up Question and answer",
          "settings": {
            "question": "Do I need a stainless steel casing if I just want to replace the media?",
            "answer": "<p>Yes — the AISI 304 stainless steel casing is essential. It creates the controlled contact environment that allows the FluoRid media to intercept fluoride effectively. Without it, the media cannot function properly. The casing is reusable for 10+ years; you only ever need to replace the media inside.</p>"
          }
        },
        "question_answer_CBmXVy": {
          "type": "question_answer",
          "name": "Set Up Question and answer",
          "settings": {
            "question": "How frequently do I need to replace the carbon filters?",
            "answer": "<p>Phoenix Gravity Carbon Filter Elements should be replaced annually (every 12 months). On the same schedule, you will also refill the FluoRid media — so at the 12-month mark you refresh both primary and post-treatment filtration in one simple maintenance session.</p>"
          }
        },
        "tab_tVffLY": {
          "type": "tab",
          "name": "Filtration",
          "settings": {
            "tab_title": "Filtration"
          }
        },
        "question_answer_iRdQ8D": {
          "type": "question_answer",
          "name": "Filtration Question and answer",
          "settings": {
            "question": "Does POSTreat Steel Filter remove fluoride?",
            "answer": "<p>Yes. The proprietary FluoRid media is specifically formulated to reduce both fluoride from drinking water. These two contaminants often co-occur in tap and well water, and our media addresses both in a single pass through the lower chamber.</p>"
          }
        },
        "question_answer_iK84z7": {
          "type": "question_answer",
          "name": "Filtration Question and answer",
          "settings": {
            "question": "Does it remove healthy minerals from the water?",
            "answer": "<p>No. Unlike reverse osmosis, POSTreat Steel Filter is designed to target fluoride specifically — not the broad spectrum of dissolved minerals your body needs for hydration and cellular function. Calcium, magnesium, and trace minerals remain intact in your filtered water.</p>"
          }
        },
        "question_answer_cik4Hy": {
          "type": "question_answer",
          "name": "Filtration Question and answer",
          "settings": {
            "question": "Is the FluoRid media aluminum-free?",
            "answer": "<p>Yes — this is a key differentiator. Many competing fluoride filters use aluminum oxide (alumina) as their active medium, which introduces the concern of aluminum leaching into filtered water. The POSTreat Steel Filter FluoRid media is aluminum-free, non-toxic, and does not leach polyurethane or microplastics into your water.</p>"
          }
        },
        "question_answer_MBfpyP": {
          "type": "question_answer",
          "name": "Filtration Question and answer",
          "settings": {
            "question": "Is it compatible with Black Berkey® filter elements?",
            "answer": "<p>Yes. POSTreat Steel Filter Elements are cross-compatible with Black Berkey® Replacement Elements, making them a popular upgrade for existing Berkey system owners who want to add professional-grade fluoride reduction without buying a new system.</p>"
          }
        },
        "question_answer_P9XUWc": {
          "type": "question_answer",
          "name": "Filtration Question and answer",
          "settings": {
            "question": "Does the POSTreat Steel Filter stage slow down water flow?",
            "answer": "<p>There is a slight reduction in flow rate compared to running carbon elements alone, as the water passes through a second stage of filtration. This is expected and normal. The FluoRid media is engineered to balance thorough fluoride capture with excellent flow performance.</p>"
          }
        },
        "tab_mVN9gK": {
          "type": "tab",
          "name": "Subscriptions",
          "settings": {
            "tab_title": "Subscriptions"
          }
        },
        "question_answer_w9bQgQ": {
          "type": "question_answer",
          "name": "Subscriptions Question and answer",
          "settings": {
            "question": "Can I subscribe to receive FluoRid media refills automatically?",
            "answer": "<p>Yes — and we strongly recommend it. Our FluoRid Media Refill subscription sends your replacement media automatically every 4 months so you never accidentally drink under-filtered water. Subscribers save 5% per order. We track your replacement schedule so you don't have to.</p>"
          }
        },
        "question_answer_TDDXD7": {
          "type": "question_answer",
          "name": "Subscriptions Question and answer",
          "settings": {
            "question": "Can I pause, skip, or cancel my subscription?",
            "answer": "<p>Yes — you have full control at any time. Log into your Phoenix Gravity account, navigate to Subscriptions, and make any changes. You can skip a shipment, adjust frequency, or cancel entirely. Note: cancelling forfeits your subscriber pricing, and re-subscribing later may not recover the original rate.</p>"
          }
        },
        "question_answer_rxBypD": {
          "type": "question_answer",
          "name": "Subscriptions Question and answer",
          "settings": {
            "question": "What is the Complete Lifestyle Plan?",
            "answer": "<p>The Complete Lifestyle Plan is our all-in-one auto-delivery solution: it covers annual Carbon Filter Element delivery plus FluoRid Media Refills every 4 months. You never have to think about your filter schedule again — we handle everything and ship automatically to your door.</p>"
          }
        },
        "tab_RxdNrX": {
          "type": "tab",
          "name": "Shipping",
          "settings": {
            "tab_title": "Shipping"
          }
        },
        "question_answer_gPMnaF": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "Where does Phoenix Gravity ship?",
            "answer": "<p>We ship across the contiguous United States from our US-based warehouse. Orders over $99 qualify for free standard shipping. Most orders ship within 3–7 business days via UPS or USPS. Note: UPS does not ship to PO Boxes or Military Addresses.</p>"
          }
        },
        "question_answer_NtFtmw": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "Why can't I order if I live in California or Iowa?",
            "answer": "<p>POSTreat Steel Filter Fluoride Reduction Filter Elements are currently unavailable to ship to California or Iowa due to state-specific regulations and compliance requirements governing how certain contaminant-reduction claims must be certified. We are actively working toward compliance in these states. For updates, contact us at hello@phoenixwaterfilters.com.</p>"
          }
        },
        "question_answer_T9knWL": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>Returns on POSTreat Steel Filter  filter elements can be initiated within 30 days of purchase. The item must arrive back to us in resalable condition in original packaging. Customers are responsible for return shipping costs. Once received and inspected, we refund via your original payment method within 10 business days. Note: the 100-Day Money-Back Guarantee applies to the complete Phoenix Gravity System purchase only, not filter accessories purchased separately.</p>"
          }
        },
        "question_answer_PrWibJ": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "My order arrived damaged — what do I do?",
            "answer": "<p>We're sorry to hear that. Please email hello@phoenixwaterfilters.com with a photo of the full order including packaging, along with your order number. Our team will respond within 24 hours and make it right as a priority.</p>"
          }
        },
        "tab_8Vgqzf": {
          "type": "tab",
          "name": "Warranty",
          "settings": {
            "tab_title": "Warranty"
          }
        },
        "question_answer_U9fT6i": {
          "type": "question_answer",
          "name": "Warranty Question and answer",
          "settings": {
            "question": "What does the 10-year warranty cover?",
            "answer": "<p>The 10-year warranty covers defects in materials and workmanship on the POSTreat Steel Filter  AISI 304 stainless steel casings under normal use conditions. If your steel casing fails due to a manufacturing defect within 10 years, we will replace it. The FluoRid media is a consumable refill item and is not covered under the structural warranty, but it carries a separate performance guarantee.</p>"
          }
        },
        "question_answer_3wrDKa": {
          "type": "question_answer",
          "name": "Warranty Question and answer",
          "settings": {
            "question": "Does the 100-Day Money-Back Guarantee apply to POSTreat Steel Filter",
            "answer": "<p>The 100-Day Money-Back Guarantee applies exclusively to the complete Phoenix Gravity System purchased through our website. It does not extend to replacement filter elements or accessories, including POSTreat Steel Filter elements purchased separately. However, POSTreat Steel Filter elements are covered by our standard 30-day return policy.</p>"
          }
        }
