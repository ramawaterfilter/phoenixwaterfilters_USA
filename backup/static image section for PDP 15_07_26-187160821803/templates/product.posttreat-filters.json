    "kk_fws_tap_warning": {
      "type": "kk-fws-tap-warning",
      "blocks": {
        "paragraph_intro": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Every year, millions of Americans fall ill from ingesting harmful chemicals in tap water. Phoenix Gravity is designed to improve taste and reduce certain non-microbiological contaminants in municipally treated tap water. It is not a microbiological purifier.</p>"
          }
        },
        "paragraph_effects": {
          "type": "paragraph",
          "settings": {
            "text": "<p>These contaminants have been linked to a range of serious health issues, including liver and kidney damage, thyroid disease, cancer, and even “blue baby syndrome” in infants.</p>"
          }
        },
        "paragraph_filter": {
          "type": "paragraph",
          "settings": {
            "text": "<p>Phoenix Gravity Water Filters use activated carbon filtration technology to remove 99.9% of contaminants from tap water, making it safe to drink no matter where you live in the U.S.</p>"
          }
        }
      },
      "block_order": [
        "paragraph_intro",
        "paragraph_effects",
        "paragraph_filter"
      ],
      "settings": {
        "image": "shopify://shop_images/tap_water.png",
        "mirror_image": true,
