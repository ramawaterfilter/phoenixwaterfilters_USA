        "268fbfd8-392e-437f-b2bf-8b826c84550c": {
          "type": "text",
          "settings": {
            "quote": "<p><strong>I’m really happy that I made this choice.</strong>&nbsp;</p><p>I looked into electric and natural steam filters and found that they would cost a lot of time and energy waste by needing up to 4hrs to purify water.&nbsp;</p>",
            "reviewer": "Victoria"
          }
        }
