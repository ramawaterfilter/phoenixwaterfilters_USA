{%- comment -%}
  KK FWS Rating Strip — Figma `7809:14951`.

  A navy summary card (eyebrow, score, stars, review count, "read all reviews" link) followed by
  one pale card per Quote block (stars, quote mark, quote, verified-owner line). Every piece of
  copy is an editor field and renders nothing when empty.

  The palette is fixed to the design rather than exposed as colour settings, matching the
  kk-fws-offer panel it sits beside; only the strip background is a setting.
{%- endcomment -%}

{%- liquid
  assign quote_blocks = section.blocks | where: 'type', 'quote'
  assign stars_image = section.settings.custom_stars
-%}

<section
  class="kk-fws-rating-strip"
  style="--kk-fws-rating-strip-background: {{ section.settings.background_color }};"
>
  <div class="kk-fws-rating-strip__container">
    <div class="kk-fws-rating-strip__summary" data-kk-fws-reveal>
      {%- if section.settings.eyebrow != blank -%}
        <p class="kk-fws-rating-strip__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endif -%}

      <div class="kk-fws-rating-strip__rating">
        {%- if section.settings.score != blank -%}
          <p class="kk-fws-rating-strip__score">{{ section.settings.score }}</p>
        {%- endif -%}

        {%- if stars_image != blank -%}
          {{
            stars_image
            | image_url: width: 280
            | image_tag: loading: 'lazy', class: 'kk-fws-rating-strip__stars', alt: ''
          }}
        {%- else -%}
          <img
            class="kk-fws-rating-strip__stars"
            src="{{ 'kk-fws-icon-stars-gold.svg' | asset_url }}"
            alt=""
            width="140"
            height="23"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.review_count != blank -%}
          <p class="kk-fws-rating-strip__count">{{ section.settings.review_count }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.link_label != blank and section.settings.link != blank -%}
        <a class="kk-fws-rating-strip__link" href="{{ section.settings.link }}">
          {{- section.settings.link_label -}}
          <img
            class="kk-fws-rating-strip__link-icon"
            src="{{ 'kk-fws-icon-arrow-right.svg' | asset_url }}"
            alt=""
            width="14"
            height="14"
            aria-hidden="true"
            loading="lazy"
          >
        </a>
      {%- endif -%}
    </div>

    {%- if quote_blocks.size > 0 -%}
      <ul class="kk-fws-rating-strip__quotes">
        {%- for block in quote_blocks -%}
          {%- assign badge = block.settings.badge | default: section.settings.quote_badge -%}
          <li class="kk-fws-rating-strip__quote" data-kk-fws-reveal {{ block.shopify_attributes }}>
            <div class="kk-fws-rating-strip__quote-head" aria-hidden="true">
              <img
                class="kk-fws-rating-strip__quote-stars"
                src="{{ 'kk-fws-icon-stars-gold.svg' | asset_url }}"
                alt=""
                width="96"
                height="16"
                loading="lazy"
              >
              <img
                class="kk-fws-rating-strip__quote-mark"
                src="{{ 'kk-fws-icon-quote.svg' | asset_url }}"
                alt=""
                width="30"
                height="23"
                loading="lazy"
              >
            </div>

            <blockquote class="kk-fws-rating-strip__quote-text">{{ block.settings.text }}</blockquote>

            {%- if badge != blank -%}
              <p class="kk-fws-rating-strip__quote-badge">
                <img
                  class="kk-fws-rating-strip__quote-badge-icon"
                  src="{{ 'kk-fws-icon-check-blue.svg' | asset_url }}"
                  alt=""
                  width="16"
                  height="16"
                  aria-hidden="true"
                  loading="lazy"
                >
                {{- badge -}}
              </p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>


{% stylesheet %}
  /* Figma `7809:14951`: a white band, 56px top and bottom, 64px gutters (the same 1312px
     container as kk-fws-offer), and a soft shadow underneath. */
  .kk-fws-rating-strip {
    --kk-fws-rating-strip-ink: var(--primary);
    --kk-fws-rating-strip-blue: var(--primary-600);
    --kk-fws-rating-strip-pale: #e3ebff;

    position: relative;
    padding: 5.6rem 0;
    background: var(--kk-fws-rating-strip-background, #ffffff);
    box-shadow: 0 1rem 1.4rem rgba(11, 22, 56, 0.06);
  }

  /* 300px summary + three 317px quote cards, 20px apart. */
  .kk-fws-rating-strip__container {
    display: grid;
    grid-template-columns: minmax(0, 300fr) minmax(0, 951.9fr);
    gap: 2rem;
    align-items: center;
    width: min(100% - 12.8rem, 131.2rem);
    margin: 0 auto;
  }

  .kk-fws-rating-strip__summary {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
    box-sizing: border-box;
    padding: 2.6rem;
    border-radius: 1.8rem;
    background: var(--kk-fws-rating-strip-ink);
  }

  .kk-fws-rating-strip__eyebrow {
    margin: 0;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: 0.16rem;
    text-transform: uppercase;
    color: var(--kk-fws-rating-strip-pale);
  }

  .kk-fws-rating-strip__rating {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.2rem;
  }

  .kk-fws-rating-strip__score {
    margin: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 8rem;
    line-height: 0.9;
    white-space: nowrap;
    color: #ffffff;
  }

  .kk-fws-rating-strip__stars {
    display: block;
    width: 14rem;
    height: 2.3rem;
    object-fit: contain;
    object-position: left center;
  }

  .kk-fws-rating-strip__count {
    margin: 0;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.2;
    color: var(--kk-fws-rating-strip-pale);
  }

  .kk-fws-rating-strip__link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    align-self: flex-start;
    margin-top: -0.2rem;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.2;
    text-decoration: none;
    color: #ffffff;
  }

  .kk-fws-rating-strip__link:hover,
  .kk-fws-rating-strip__link:focus-visible {
    color: #ffffff;
    text-decoration: underline;
  }

  .kk-fws-rating-strip__link-icon {
    display: block;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
    transition: transform 0.2s ease;
  }

  .kk-fws-rating-strip__link:hover .kk-fws-rating-strip__link-icon {
    transform: translateX(0.2rem);
  }

  .kk-fws-rating-strip__quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kk-fws-rating-strip__quote {
    display: flex;
    flex-direction: column;
    gap: 1.54rem;
    box-sizing: border-box;
    min-width: 0;
    padding: 2.6rem;
    border-radius: 1.8rem;
    background: var(--light);
  }

  .kk-fws-rating-strip__quote-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.2rem;
  }

  .kk-fws-rating-strip__quote-stars {
    display: block;
    width: 9.6rem;
    height: 1.6rem;
    object-fit: contain;
    object-position: left center;
  }

  .kk-fws-rating-strip__quote-mark {
    display: block;
    flex-shrink: 0;
    width: 3rem;
    height: 2.3rem;
  }

  /* Grows so the rule and verified line sit on one baseline across the three cards. */
  .kk-fws-rating-strip__quote-text {
    flex: 1 1 auto;
    margin: 0;
    padding: 0;
    border: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-style: normal;
    font-size: 2.2rem;
    line-height: 1.4;
    color: var(--kk-fws-rating-strip-ink);
  }

  .kk-fws-rating-strip__quote-badge {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin: 0;
    padding-top: 1.4rem;
    border-top: 1px solid #e1e5f0;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.2;
    color: var(--kk-fws-rating-strip-blue);
  }

  .kk-fws-rating-strip__quote-badge-icon {
    display: block;
    flex-shrink: 0;
    width: 1.6rem;
    height: 1.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .kk-fws-rating-strip__link-icon {
      transition: none;
    }
  }

  /* Tablet: the summary spans the top, the three quotes sit beneath it. */
  @media (max-width: 1199px) {
    .kk-fws-rating-strip__container {
      grid-template-columns: minmax(0, 1fr);
    }

    .kk-fws-rating-strip__summary {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr);
      align-items: end;
      column-gap: 2.4rem;
        padding: 8rem 2.2rem;
    }

    .kk-fws-rating-strip__eyebrow {
      grid-column: 1 / -1;
    }

    .kk-fws-rating-strip__rating {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: flex-end;
      column-gap: 2rem;
    }

    .kk-fws-rating-strip__link {
      justify-self: end;
      align-self: end;
    }
  }

  @media (max-width: 989px) {
    .kk-fws-rating-strip__container {
      width: min(100% - 4rem, 131.2rem);
    }

    .kk-fws-rating-strip__quote-text {
      font-size: 1.9rem;
    }
  }

  @media (max-width: 749px) {
    .kk-fws-rating-strip {
      padding: 4rem 0;
    }

    .kk-fws-rating-strip__container {
      width: min(100% - 4rem, 54rem);
      gap: 1.2rem;
    }

    /* Back to a left-aligned column: the tablet grid's `align-items: end` would otherwise
       push every child to the right edge of the card. */
    .kk-fws-rating-strip__summary {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.4rem;
      padding: 2.2rem;
      text-align: left;
      border-radius: 1.6rem;
    }

    .kk-fws-rating-strip__rating {
      flex-direction: column;
      align-items: flex-start;
      gap: 1rem;
    }

    .kk-fws-rating-strip__score {
      font-size: 4.4rem;
    }

    .kk-fws-rating-strip__link {
      align-self: flex-start;
    }

    .kk-fws-rating-strip__quotes {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2rem;
    }

    .kk-fws-rating-strip__quote {
      gap: 1.2rem;
      padding: 2.2rem;
      border-radius: 1.6rem;
    }

    .kk-fws-rating-strip__quote-text {
      font-size: 1.9rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KK FWS Rating Strip",
  "tag": "div",
  "class": "section-kk-fws-rating-strip",
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Summary card",
      "info": "Leave any field empty to hide it."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "text",
      "id": "score",
      "label": "Rating score",
      "default": "4.8"
    },
    {
      "type": "image_picker",
      "id": "custom_stars",
      "label": "Custom star graphic",
      "info": "Overrides the built-in 5-star graphic on the summary card."
    },
    {
      "type": "text",
      "id": "review_count",
      "label": "Review count",
      "default": "1,092 verified reviews"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The link shows only when it has both a label and a URL, e.g. #kk-fws-testimonials."
    },
    {
      "type": "header",
      "content": "Quote cards"
    },
    {
      "type": "text",
      "id": "quote_badge",
      "label": "Verified line",
      "info": "Shown under every quote. A quote's own \"Verified line\" overrides it."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Quote",
          "default": "“Set it up myself in five minutes flat”"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Verified line",
          "info": "Leave empty to use the section's verified line."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KK FWS Rating Strip",
      "blocks": [
        {
          "type": "quote",
          "settings": { "text": "“Tastes like bottled water, straight from the tap”" }
        },
        {
          "type": "quote",
          "settings": { "text": "“Set it up myself in five minutes flat”" }
        },
        {
          "type": "quote",
          "settings": { "text": "“We cancelled our bottled water delivery”" }
        }
      ]
    }
  ]
}
{% endschema %}
