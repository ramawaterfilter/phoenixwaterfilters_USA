<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">

  {% if section.settings.section_bgimg %}
    <div class="background-image-container view-animation">
      {{ section.settings.section_bgimg | image_url: width: 1920 | image_tag: loading: "lazy" }}
    </div>
  {% endif %}

  <div class="container">
    <div class="row align-items-center justify-content-center">
      <div class="col-12 col-md-10 col-lg-9">

        {% if section.settings.eyebrow != '' %}
          <p class="eyebrow text-center">{{ section.settings.eyebrow | replace: '[month]', '<span class="dyn-month"></span>' }}</p>
        {% endif %}

        {% if section.settings.heading != '' %}
          <h2 class="text-center">{{ section.settings.heading | replace: '[month]', '<span class="dyn-month"></span>' }}</h2>
        {% endif %}
      </div>

      <div class="col-12">
        {% if section.settings.column_img != blank %}
          <img
            src="{{ section.settings.column_img | image_url: width: 1920 }}"
            class="img-fluid d-block mx-auto mb-5"
            {% if section.settings.img_width %}
            width="{{ section.settings.img_width }}"
            {% endif %}
            loading="lazy" />
        {% endif %}
      </div>

      <div class="col-12 col-md-10 col-lg-9">

        {% if section.settings.content != blank %}
          {{ section.settings.content | replace: '[month]', '<span class="dyn-month"></span>' }}
        {% endif %}

        {% if section.settings.buttonlink %}
          {% render 'button' %}
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
  {
    "name": "Offer Section",
    "tag": "section",
    "class": "section-offer",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "eyebrow",
        "label": "Eyebrow"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }, {
        "type": "image_picker",
        "id": "column_img",
        "label": "Image"
      }, {
        "type": "number",
        "id": "img_width",
        "label": "Image Width (px)"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "checkbox",
        "id": "button_arrow",
        "label": "Show arrow on button",
        "default": true
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "default": "primary",
        "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary" }
        ]
      }, {
        "type": "checkbox",
        "id": "show_trust_items",
        "label": "Show trust items under the button",
        "default": false
      }, {
        "type": "text",
        "id": "trust_text_1",
        "label": "Trust item 1",
        "default": "100-day trial"
      }, {
        "type": "text",
        "id": "trust_text_2",
        "label": "Trust item 2",
        "default": "Cancel any time"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes/ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }, {
        "type": "image_picker",
        "id": "section_bgimg",
        "label": "Background Image"
      }
    ],
    "presets": [
      {
        "name": "Offer Section"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}