{% assign description = product.metafields.custom.product_description %}
{% assign specifications = product.metafields.custom.specifications %}

{% assign row_styles = 'row justify-content-center mb-5' %}
{% assign column_styles = 'col-11 col-md-12' %}
{% if section.settings.accordion_styles == 'center' %}
  {% assign row_styles = 'row justify-content-center mb-5 accordion-padding' %}
  {% assign column_styles = 'col-11 col-md-8' %}
{% endif %}

<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="container">
    <div class="{{ row_styles }}">
      {% if section.settings.content != blank or section.settings.heading != blank %}
        <div class="col-12 text-center">
          {% if section.settings.heading %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {{ section.settings.content }}
        </div>
      {% endif %}

      <div class="{{ column_styles }}">
