<script>
  document.addEventListener('DOMContentLoaded', function () {
    let currentId = null;

    function updateAccordionContent() {
      const select = document.querySelector('form[action*="/cart/add"] select[name="id"]');
      const newId = select ? select.value : null;

      if (newId !== currentId) {
        currentId = newId;

        document.querySelectorAll('.accordion-stand').forEach((el) => {
          const id = el.getAttribute('data-variant-id');
          el.style.display = id === currentId ? 'block' : 'none';
        });
      }
    }

    setInterval(updateAccordionContent, 300);
  });
</script>

