              <dt>{{ 'products.product.description' | t }}</dt>
              <dd>
                <div class="accordion-item__inner">
                  {{ description | metafield_tag }}
                </div>
              </dd>
            </div>
          {% endif %}

          <script>
            document.addEventListener('DOMContentLoaded', function () {
              const accordions = document.querySelectorAll('.tech-accordion[data-size]');
              const variantIdAccordions = document.querySelectorAll('.tech-accordion[data-variant-id]');
              if (!accordions.length && !variantIdAccordions.length) return;

              const variantOptions = {
                {% for variant in product.variants %}
                  '{{ variant.id }}': {{ variant.options | json }}{% unless forloop.last %},{% endunless %}
                {% endfor %}
              };

              const variantTechnicalImages = {
                {% for variant in product.variants %}
                  {% liquid
                    assign technical_images_metafield = variant.metafields.custom.technical_specifications_product_images
                    assign technical_image = blank
                    if technical_images_metafield != blank
                      if technical_images_metafield.type contains 'list.'
                        assign technical_image = technical_images_metafield.value | first
                      else
                        assign technical_image = technical_images_metafield.value
                      endif
                    endif
                  %}
                  '{{ variant.id }}': {% if technical_image != blank %}{
                    src: {{ technical_image | image_url: width: 2000 | json }},
                    alt: {{ technical_image.alt | default: variant.title | json }},
                    width: {{ technical_image.width | default: 2000 | json }},
                    height: {{ technical_image.height | default: 2000 | json }}
                  }{% else %}null{% endif %}{% unless forloop.last %},{% endunless %}
                {% endfor %}
              };

              const specifications = {
                '1.5 Gallon': {
                  height: '18.8 in',
                  diameter: '7.4 in',
                  weightNormal: '8.65 Pounds',
                  weightPostreat: '10.47 Pounds'
                },
                '2.25 Gallon': {
                  height: '19.2 in',
                  diameter: '8.6 in',
                  weightNormal: '10.41 Pounds',
                  weightPostreat: '11.9 Pounds'
                },
                '3.25 Gallon': {
                  height: '23.2 in',
                  diameter: '9.4 in',
                  weightNormal: '12.46 Pounds',
                  weightPostreat: '14.2 Pounds'
                }
              };

              const variantSelect =
                document.querySelector('[data-variant-select]') ||
                document.querySelector('#product-selectors') ||
                document.querySelector('select[name=id]');

              function updateTechnicalImage(accordion, variantId) {
                const imageData = variantTechnicalImages[String(variantId)];
                if (!imageData) return;

                const image = accordion.querySelector('.tech-accordion-image img');
                if (!image) return;

                image.src = imageData.src;
                image.removeAttribute('srcset');
                image.alt = imageData.alt || image.alt;
                image.width = imageData.width || image.width;
                image.height = imageData.height || image.height;
              }

              function updateVariantIdAccordions(variantId) {
                variantIdAccordions.forEach(function (accordion) {
                  const active = accordion.dataset.variantId === String(variantId);
                  accordion.style.display = active ? 'flex' : 'none';
                  if (active) updateTechnicalImage(accordion, variantId);
                });
              }

              function updateAccordion(variantId) {
                const options = variantOptions[String(variantId)];
                if (!options) return;

                const size = options[0];
                const filterType = options[1] || '';
                const details = specifications[size];
                const hasPostreat = filterType.toLowerCase().includes('postreat');

                accordions.forEach(function (accordion) {
                  const active = accordion.dataset.size === size;
                  accordion.style.display = active ? 'flex' : 'none';
                  if (!active) return;

                  updateTechnicalImage(accordion, variantId);

                  if (!details) return;

                  const dimensionsCell = accordion.querySelector('.tech-dimensions-row td:last-child');
                  const lifespanCell = accordion.querySelector('.tech-filter-lifespan-row td:last-child');
                  const lifespanMonths = accordion.closest('[data-starter-kit-specs]') ? '6 months' : '12 months';

                  if (dimensionsCell) {
                    dimensionsCell.innerHTML =
                      'Height - ' + details.height + '<br>' +
                      'Diameter - ' + details.diameter + '<br>' +
                      'Weight - ' + (hasPostreat ? details.weightPostreat : details.weightNormal);
                  }

                  if (lifespanCell) {
                    lifespanCell.innerHTML = hasPostreat
                      ? '<ul class=tech-lifespan-list><li>Rated up to 5,500 gallons; replace at ' + lifespanMonths + ' or 5,500 gallons, whichever comes first (typical family use: ' + lifespanMonths + ').</li><li>Up to 1,060 gallons per pair of POSTreat Filter Elements</li></ul>'
                      : '<ul class=tech-lifespan-list><li>Rated up to 5,500 gallons; replace at ' + lifespanMonths + ' or 5,500 gallons, whichever comes first (typical family use: ' + lifespanMonths + ').</li></ul>';
                  }
                });
              }

              function updateTechnicalSpecifications(variantId) {
                updateAccordion(variantId);
                updateVariantIdAccordions(variantId);
              }

              if (variantSelect) {
                variantSelect.addEventListener('change', function () {
                  updateTechnicalSpecifications(variantSelect.value);
                });
              }

              ['variant:change', 'product:variant-change'].forEach(function (eventName) {
                document.addEventListener(eventName, function (event) {
                  const variant = event.detail && event.detail.variant;
                  updateTechnicalSpecifications(variant && variant.id ? variant.id : variantSelect && variantSelect.value);
                });
              });

              setTimeout(function () {
                updateTechnicalSpecifications(variantSelect ? variantSelect.value : {{ product.selected_or_first_available_variant.id | json }});
              }, 0);
            });
          </script>

