          "default": "Choose the Family Protection Plan"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Subscribe to the replacement Star plan at $99 / 6 months That's everything your household needs to stay protected"
        }
      ]
    },
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KK FWS How It Works",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "number": "1",
            "title": "Choose the Family Protection Plan",
            "body": "Subscribe to the replacement Star plan at $99 / 6 months That's everything your household needs to stay protected"
          }
        },
        {
          "type": "step",
          "settings": {
            "number": "2",
            "title": "We Ship You the Full Tower...Free",
            "body": "Your complete $249 stainless steel housing unit arrives at your door. You pay nothing for It-just cover shipping"
