{%- comment -%}
  KK FWS How It Works — Figma `7809:15141`.

  Heading, three image-led steps joined by a dashed line through their numbers, then a CTA and
  a trust row. Each "Step" block has its own image; the first three fall back to the photos
  from the design (assets/kk-fws-how-it-works-step-N.jpg) until one is chosen.
{%- endcomment -%}

{%- liquid
  assign step_blocks = section.blocks | where: 'type', 'step'
  assign trust_blocks = section.blocks | where: 'type', 'trust'
-%}

<section
  class="kk-fws-how-it-works kk-fws-section"
  id="kk-fws-how-it-works"
  style="--kk-fws-hiw-background: {{ section.settings.background_color }};"
>
  <div class="kk-fws-how-it-works__container kk-fws-container">
    {%- if section.settings.heading != blank -%}
      <h2 class="kk-fws-how-it-works__heading kk-fws-heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if step_blocks.size > 0 -%}
      <ol class="kk-fws-how-it-works__steps" style="--kk-fws-hiw-columns: {{ step_blocks.size | at_most: 4 }};">
        {%- for block in step_blocks -%}
          <li class="kk-fws-how-it-works__step" {{ block.shopify_attributes }}>
            <div class="kk-fws-how-it-works__media">
              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 900
                  | image_tag:
                    class: 'kk-fws-how-it-works__image',
                    loading: 'lazy',
                    widths: '420, 640, 900',
                    sizes: '(max-width: 749px) calc(100vw - 4rem), (max-width: 989px) calc((100vw - 8rem) / 3), 413px'
                }}
              {%- elsif forloop.index <= 3 -%}
                {%- assign fallback = 'kk-fws-how-it-works-step-' | append: forloop.index | append: '.jpg' -%}
                <img
                  class="kk-fws-how-it-works__image"
                  src="{{ fallback | asset_url }}"
                  alt=""
                  width="900"
                  height="675"
                  loading="lazy"
                >
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag: 'kk-fws-how-it-works__image' }}
              {%- endif -%}
            </div>

            <span class="kk-fws-how-it-works__step-number" aria-hidden="true">
              {{- block.settings.number | default: forloop.index -}}
            </span>

            {%- if block.settings.title != blank -%}
              <h3 class="kk-fws-how-it-works__step-title">{{ block.settings.title }}</h3>
            {%- endif -%}

            {%- if block.settings.body != blank -%}
              <p class="kk-fws-how-it-works__step-body">{{ block.settings.body }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}

    {%- render 'kk-fws-cta', section: section, prefix: 'kk-fws-how-it-works', trust_blocks: trust_blocks, icon_size: 22 -%}
  </div>
</section>

{% stylesheet %}
  /* Figma `7809:15141`: white, 88px top and bottom, 1312px container (64px gutters). */
  .kk-fws-how-it-works {
    --kk-fws-hiw-ink: var(--primary);
    --kk-fws-hiw-muted: var(--primary-100);
    --kk-fws-hiw-blue: var(--primary-600);
    --kk-fws-hiw-number: 6rem;
    --kk-fws-hiw-media-gap: 3.6rem;
    /* Image height. Shared by the images and the dashed line's offset. */
    --kk-fws-hiw-media-height: 31rem;
    /* kk-fws-base.css overrides */
    --kk-fws-heading-size-md: 4rem;
    --kk-fws-cta-margin-sm: 3.2rem;

    background: var(--kk-fws-hiw-background, #ffffff);
  }

  .kk-fws-how-it-works__heading {
    max-width: 48.4rem;
    text-align: center;
  }

  /* Three 413px columns, 36px apart. */
  .kk-fws-how-it-works__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--kk-fws-hiw-columns, 3), minmax(0, 1fr));
    gap: 3.6rem;
    width: 100%;
    margin: 4rem 0 0;
    padding: 0;
    list-style: none;
  }

  /* The dashed line through the numbers (Figma `7809:15149`): from the first number's centre
     to the last's, i.e. inset half a column at each end, at the numbers' centre height. It sits
     behind the numbers, whose white ring masks it either side of each circle. */
  .kk-fws-how-it-works__steps::before {
    content: '';
    position: absolute;
    top: calc(var(--kk-fws-hiw-media-height) + var(--kk-fws-hiw-media-gap) + var(--kk-fws-hiw-number) / 2 - 1px);
    left: calc(50% / var(--kk-fws-hiw-columns, 3));
    right: calc(50% / var(--kk-fws-hiw-columns, 3));
    height: 2px;
    background: repeating-linear-gradient(90deg, #a9c1ff 0 0.6rem, transparent 0.6rem 1.4rem);
  }

  .kk-fws-how-it-works__step {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 0;
    text-align: center;
  }

  .kk-fws-how-it-works__media {
    width: 100%;
    height: var(--kk-fws-hiw-media-height);
    overflow: hidden;
    border-radius: 2rem;
    background: var(--light);
  }

  .kk-fws-how-it-works__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* 60px blue disc with a 10px white ring (masking the dashed line) and a soft blue shadow. */
  .kk-fws-how-it-works__step-number {
    position: relative;
    z-index: 1;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: var(--kk-fws-hiw-number);
    height: var(--kk-fws-hiw-number);
    margin-top: var(--kk-fws-hiw-media-gap);
    border-radius: 50%;
    background: var(--kk-fws-hiw-blue);
    box-shadow:
      0 0 0 1rem #ffffff,
      0 0.8rem 2rem rgba(39, 100, 255, 0.22);
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1;
    color: #ffffff;
  }

  .kk-fws-how-it-works__step-title {
    max-width: 35.3rem;
    margin: 2.4rem 0 0;
    padding: 0 1rem;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 3rem;
    line-height: 1.3;
    text-transform: none;
    color: var(--kk-fws-hiw-ink);
  }

  .kk-fws-how-it-works__step-body {
    max-width: 35.3rem;
    margin: 1.4rem 0 0;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.5;
    color: var(--kk-fws-hiw-muted);
  }

  /* CTA + trust row — Figma `7809:15203`. */

  @media (max-width: 989px) {

    .kk-fws-how-it-works {
      --kk-fws-hiw-media-height: 20rem;
    }

    .kk-fws-how-it-works__steps {
      gap: 2rem;
    }

    .kk-fws-how-it-works__step-title {
      font-size: 2.2rem;
    }

    .kk-fws-how-it-works__step-body {
      font-size: 1.6rem;
    }
  }

  /* Mobile: one column, so the connecting line has nothing to connect and is dropped. */
  @media (max-width: 749px) {
    .kk-fws-how-it-works {
      --kk-fws-hiw-number: 5rem;
      --kk-fws-hiw-media-gap: 2.4rem;

    }

    .kk-fws-how-it-works__heading {
      max-width: none;
    }

    .kk-fws-how-it-works__steps {
      grid-template-columns: minmax(0, 1fr);
      gap: 4rem;
      margin-top: 2.4rem;
    }

    .kk-fws-how-it-works__steps::before {
      display: none;
    }

    .kk-fws-how-it-works {
      --kk-fws-hiw-media-height: auto;
    }

    .kk-fws-how-it-works__media {
      aspect-ratio: 4 / 3;
      border-radius: 1.6rem;
    }

    .kk-fws-how-it-works__step-number {
      font-size: 2rem;
    }

    .kk-fws-how-it-works__step-title {
      margin-top: 1.8rem;
      font-size: 2.2rem;
    }

    .kk-fws-how-it-works__step-body {
      margin-top: 1rem;
      font-size: 1.7rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KK FWS How It Works",
  "tag": "div",
  "class": "section-kk-fws-how-it-works",
  "max_blocks": 8,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Here's Exactly How the Free Tower Works"
    },
    {
      "type": "header",
      "content": "Call to action",
      "info": "The button shows only when it has both a label and a link. Add \"Trust item\" blocks for the row underneath."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "E.g. #kk-fws-offer to jump to the offer section."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Section background",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Shown at 413 x 310 on desktop. The first three steps fall back to the photos from the design."
        },
        {
          "type": "text",
          "id": "number",
