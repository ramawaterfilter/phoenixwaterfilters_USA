{%- comment -%}
  Features — restyled to match sections/kk-fws-cards.liquid (Figma `7809:15889`).

  Phoenix mark, heading and optional copy, then the product media with the features as white
  callout cards around it, each joined to the media by a line and dot. Then the shared CTA.

  Placement follows block order, as before: odd features on the left, even on the right (the
  "Left"/"Right" block types are labels only). Below 1200px the cards drop into a grid under
  the media.

  Media: the Wistia video (16:9, scaled to the frame's height and cropped to the middle, where
  the tower is), else the image, else the kk-fws tower photo. The stage keeps the
  .trigger-observer class: src/js/wistia.js pairs the Nth trigger on the page with the Nth
  Wistia video, so there must stay exactly one of each here.
{%- endcomment -%}

{%- liquid
  assign feature_count = 0
  for block in section.blocks
    if block.settings.title != blank
      assign feature_count = feature_count | plus: 1
    endif
  endfor
-%}

<div class="background-image-container {{ section.settings.style | default: 'bg-light' }}"></div>

<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="features-stage">
    {%- if section.settings.show_logo or section.settings.logo != blank or section.settings.heading != blank or section.settings.content != blank -%}
      <div class="features-stage__intro">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 96
            | image_tag: class: 'features-stage__logo', width: 48, height: 44, loading: 'lazy', alt: ''
          }}
        {%- elsif section.settings.show_logo -%}
          <img
            class="features-stage__logo"
            src="{{ 'kk-fws-phoenix-mark.png' | asset_url }}"
            alt=""
            width="48"
            height="44"
            loading="lazy"
          >
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="features-stage__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.content != blank -%}
          <div class="features-stage__copy">{{ section.settings.content }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="features-stage__stage trigger-observer">
      <div class="features-stage__media">
        {%- if section.settings.section_video_bg != blank -%}
          <div
            class="features-stage__video"
            data-wistia-vid-id="{{ section.settings.section_video_bg | escape }}"
          ></div>
        {%- elsif section.settings.banner_image != blank -%}
          {{
            section.settings.banner_image
            | image_url: width: 1200
            | image_tag:
              class: 'features-stage__image',
              loading: 'lazy',
              widths: '400, 600, 900, 1200',
              sizes: '(max-width: 749px) 80vw, 582px'
          }}
        {%- else -%}
          <img
            class="features-stage__image"
            src="{{ 'kk-fws-cards-tower.jpg' | asset_url }}"
            alt=""
            width="562"
            height="720"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      {%- if feature_count > 0 -%}
        <ul class="features-stage__list">
          {%- assign feature_index = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.settings.title != blank -%}
              {%- liquid
                assign feature_index = feature_index | plus: 1
                assign side_check = feature_index | modulo: 2
                if side_check == 1
                  assign side = 'left'
                else
                  assign side = 'right'
                endif
                assign row = feature_index | plus: 1 | divided_by: 2

                assign icon_is_svg = false
                if block.settings.icon != blank
                  assign icon_path = block.settings.icon.src | split: '?' | first | downcase
                  if icon_path contains '.svg'
                    assign icon_is_svg = true
                  endif
                endif
              -%}
              <li
                class="features-stage__card features-stage__card--{{ side }} features-stage__card--row-{{ row }}"
                {{ block.shopify_attributes }}
              >
                {%- if block.settings.icon != blank -%}
                  <span class="features-stage__icon-box" aria-hidden="true">
                    {%- if icon_is_svg -%}
                      {%- comment -%} SVG icons are recoloured to primary-600 via a mask, as in the Cards Section. {%- endcomment -%}
                      <span
                        class="features-stage__icon-svg"
                        style="--features-stage-icon: url('{{ block.settings.icon | image_url }}');"
                      ></span>
                    {%- else -%}
                      {{
                        block.settings.icon
                        | image_url: width: 52
                        | image_tag: class: 'features-stage__icon', width: 26, height: 26, loading: 'lazy', alt: ''
                      }}
                    {%- endif -%}
                  </span>
                {%- endif -%}

                <span class="features-stage__title">{{ block.settings.title }}</span>

                <span class="features-stage__connector" aria-hidden="true"></span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>

    {%- if section.settings.buttonlink != blank -%}
      <div class="features-stage__cta">
        {% render 'button', class: 'mx-auto text-center' %}
      </div>
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  /* Same layout and sizes as .kk-fws-cards: a 1312 x 746 stage, media centred, callouts around it.
     The section colour comes from the "Background" setting on .background-image-container, as in
     Copy + Image. */
  .features-stage {
    --features-stage-ink: var(--primary);
    --features-stage-blue: var(--primary-600);

    width: min(100% - 4rem, 131.2rem);
    margin: 0 auto;
  }

  .features-stage__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.3rem;
    max-width: 84rem;
    margin: 0 auto 4rem;
    text-align: center;
  }

  .features-stage__logo {
    display: block;
    width: 4.8rem;
    height: 4.4rem;
    object-fit: contain;
  }

  /* Outranks the legacy "section.section-features h2" rule in src/css/sections/_features.scss
     (72% top padding on mobile, 8rem margin), which still ships in main.css. */
  section.section-features .features-stage__heading {
    margin: 0;
    padding: 0;
    text-align: center;
  }

  .features-stage__copy p:last-child {
    margin-bottom: 0;
  }

  .features-stage__stage {
    position: relative;
    width: 100%;
    height: 74.6rem;
  }

  .features-stage__media {
    position: absolute;
    top: 0;
    left: 50%;
    width: 58.2rem;
    height: 100%;
    overflow: hidden;
    transform: translateX(-50%);
    mix-blend-mode: multiply;
  }

  .features-stage__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* The 16:9 video at the frame's full height, centred, so the frame shows the middle (the
     tower). Width = frame height x 16/9 = frame width x (746 / 582) x (16 / 9) = 227.86%;
     videoFoam then sets the embed's height from that width. Multiply blends the video's white
     backdrop into the section background. */
  .features-stage__video {
    position: absolute;
    top: 0;
    left: 50%;
    width: 227.86%;
    height: 100%;
    transform: translateX(-50%);
    mix-blend-mode: multiply;
  }

  .features-stage__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .features-stage__card {
    position: absolute;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 1.6rem;
    box-sizing: border-box;
    width: 37rem;
    margin: 0;
    padding: 2.2rem 2.4rem;
    border: 1px solid #e6e9f0;
    border-radius: 2.2rem;
    background: #ffffff;
    box-shadow: 0 1rem 1.4rem rgba(11, 22, 56, 0.05);
  }

  /* Rows at 123 / 353 / 574px; the outer edge steps in 50 / 10 / 80px, mirrored right. */
  .features-stage__card--row-1 { top: 12.3rem; }
  .features-stage__card--row-2 { top: 35.3rem; }
  .features-stage__card--row-3 { top: 57.4rem; }

  .features-stage__card--left.features-stage__card--row-1 { left: 5rem; }
  .features-stage__card--left.features-stage__card--row-2 { left: 1rem; }
  .features-stage__card--left.features-stage__card--row-3 { left: 8rem; }

  .features-stage__card--right.features-stage__card--row-1 { right: 5rem; }
  .features-stage__card--right.features-stage__card--row-2 { right: 1rem; }
  .features-stage__card--right.features-stage__card--row-3 { right: 8rem; }

  .features-stage__icon-box {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 5.2rem;
    height: 5.2rem;
    border-radius: 1.6rem;
    background: #f2f6ff;
  }

  .features-stage__icon {
    display: block;
    width: 2.6rem;
    height: 2.6rem;
    object-fit: contain;
  }

  .features-stage__icon-svg {
    display: block;
    width: 2.6rem;
    height: 2.6rem;
    background-color: var(--features-stage-blue);
    -webkit-mask: var(--features-stage-icon) center / contain no-repeat;
    mask: var(--features-stage-icon) center / contain no-repeat;
  }

  .features-stage__title {
    min-width: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 2.1rem;
    line-height: 1.25;
    color: var(--features-stage-ink);
  }

  /* A 60px line ending in a 12px dot, off the card's inner edge. */
  .features-stage__connector {
    position: absolute;
    top: 50%;
    width: 6rem;
    height: 1px;
    background: rgba(39, 100, 255, 0.35);
  }

  .features-stage__connector::after {
    content: '';
    position: absolute;
    top: 50%;
    width: 1.2rem;
    height: 1.2rem;
    border-radius: 50%;
    background: var(--features-stage-blue);
    transform: translateY(-50%);
  }

  .features-stage__card--left .features-stage__connector {
    left: 100%;
  }

  .features-stage__card--left .features-stage__connector::after {
    right: -0.6rem;
  }

  .features-stage__card--right .features-stage__connector {
    right: 100%;
  }

  .features-stage__card--right .features-stage__connector::after {
    left: -0.6rem;
  }

  .features-stage__cta {
    margin-top: 4rem;
  }

  /* Below 1200px the cards can't orbit the media: media first, then a grid of cards. */
  @media (max-width: 1199px) {
    .features-stage__stage {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3.2rem;
      height: auto;
    }

    .features-stage__media {
      position: relative;
      left: auto;
      width: min(100%, 42rem);
      height: auto;
      aspect-ratio: 582 / 746;
      transform: none;
    }

    .features-stage__list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1.6rem;
      width: 100%;
    }

    .features-stage .features-stage__card {
      position: relative;
      top: auto;
      right: auto;
      left: auto;
      width: auto;
    }

    .features-stage__connector {
      display: none;
    }
  }

  @media (max-width: 749px) {
    .features-stage__intro {
      gap: 1.4rem;
      margin-bottom: 2.4rem;
    }

    .features-stage__logo {
      width: 3.6rem;
      height: 3.3rem;
    }

    .features-stage__stage {
      gap: 2rem;
    }

    .features-stage__media {
      width: min(100%, 30rem);
    }

    .features-stage__list {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.2rem;
    }

    .features-stage .features-stage__card {
      padding: 1.8rem;
      border-radius: 1.8rem;
    }

    .features-stage__title {
      font-size: 1.6rem;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Features",
    "tag": "section",
    "class": "section-features",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Background",
        "default": "bg-light",
        "options": [
          {
            "label": "White",
            "value": "bg-white"
          }, {
            "label": "Light",
            "value": "bg-light"
          }
        ]
      },
      {
        "type": "checkbox",
        "id": "show_logo",
        "label": "Show Phoenix logo above the heading",
        "default": true
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom logo",
        "info": "Replaces the Phoenix logo. Shown at 48 × 44px."
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Copy below heading",
        "info": "Optional. Leave empty to hide."
      },
      {
        "type": "text",
        "id": "section_video_bg",
        "label": "Product video",
        "info": "Wistia video ID. Shown in the middle of the features, cropped to the centre of the video."
      }, {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Product image",
        "info": "Used when there's no video. Shown at 582 × 746px. Leave both empty for the default tower photo."
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "checkbox",
        "id": "button_arrow",
        "label": "Show arrow on button",
        "default": true
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "default": "primary",
        "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary" }
        ]
      }, {
        "type": "checkbox",
        "id": "show_trust_items",
        "label": "Show trust items under the button",
        "default": false
      }, {
        "type": "text",
        "id": "trust_text_1",
        "label": "Trust item 1",
        "default": "100-day trial"
      }, {
        "type": "text",
        "id": "trust_text_2",
        "label": "Trust item 2",
        "default": "Cancel any time"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }

    ],
    "blocks": [
      {
        "type": "feature_col_1",
        "name": "Features Left",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title Left",
            "info": "Features alternate left and right in block order."
          }, {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }
        ]
      }, {
        "type": "feature_col_2",
        "name": "Features Right",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title Right",
            "info": "Features alternate left and right in block order."
          }, {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Features"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}