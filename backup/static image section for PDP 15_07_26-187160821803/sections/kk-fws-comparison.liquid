            "feature": "Durable Stainless Steel",
            "phoenix": true,
            "in_home": true,
            "bottled": false,
            "pitchers": false
          }
        },
        {
          "type": "feature",
          "settings": {
            "feature": "100-day Risk-Free Trial",
