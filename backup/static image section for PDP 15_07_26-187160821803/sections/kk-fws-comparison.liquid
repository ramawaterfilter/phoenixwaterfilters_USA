{%- liquid
  assign column_keys = 'phoenix,in_home,bottled,pitchers' | split: ','
  assign feature_blocks = section.blocks | where: 'type', 'feature'
-%}

<section
  class="kk-fws-comparison"
  style="
    --kk-fws-comparison-background: {{ section.settings.background_color }};
    --kk-fws-comparison-heading: {{ section.settings.heading_color }};
    --kk-fws-comparison-feature-background: {{ section.settings.feature_background_color }};
    --kk-fws-comparison-highlight: {{ section.settings.highlight_color }};
    --kk-fws-comparison-pill: {{ section.settings.highlight_label_color }};
    --kk-fws-comparison-button-background: {{ section.settings.button_background_color }};
    --kk-fws-comparison-button-text: {{ section.settings.button_text_color }};
  "
>
  <div class="kk-fws-comparison__container">
    {%- if section.settings.heading != blank -%}
      <h2 class="kk-fws-comparison__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if feature_blocks.size > 0 -%}
      <div class="kk-fws-comparison__table-wrap" id="kk-fws-comparison-{{ section.id }}" data-comparison-table>
        <div
          class="kk-fws-comparison__toggles"
          role="group"
          aria-label="{{ section.settings.toggles_label | escape }}"
        >
          {%- for key in column_keys -%}
            {%- assign label_key = 'column_' | append: key | append: '_label' -%}
            <button
              type="button"
              class="kk-fws-comparison__toggle"
              data-show="{{ forloop.index | plus: 1 }}"
              data-active="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
            >
              {{ section.settings[label_key] }}
            </button>
          {%- endfor -%}
        </div>

        <table class="kk-fws-comparison__table">
          <caption class="kk-fws-comparison__sr">{{ section.settings.table_label }}</caption>

          <colgroup>
            <col class="kk-fws-comparison__col kk-fws-comparison__col--feature">
            {%- for key in column_keys -%}
              <col class="kk-fws-comparison__col">
            {%- endfor -%}
          </colgroup>

          <thead>
            <tr>
              <th class="kk-fws-comparison__th kk-fws-comparison__th--feature" scope="col">
                <span class="kk-fws-comparison__sr">{{ section.settings.feature_column_label }}</span>
              </th>
              {%- for key in column_keys -%}
                {%- assign label_key = 'column_' | append: key | append: '_label' -%}
                <th
                  class="kk-fws-comparison__th{% if forloop.first %} kk-fws-comparison__th--phoenix{% endif %}"
                  scope="col"
                >
                  <span class="kk-fws-comparison__th-label">{{ section.settings[label_key] }}</span>
                </th>
              {%- endfor -%}
            </tr>
          </thead>

          <tbody>
            {%- for block in feature_blocks -%}
              <tr class="kk-fws-comparison__row" {{ block.shopify_attributes }}>
                <th class="kk-fws-comparison__row-header" scope="row">{{ block.settings.feature }}</th>

                {%- for key in column_keys -%}
                  {%- liquid
                    assign has_feature = block.settings[key]
                    if has_feature
                      assign mark_src = 'kk-fws-icon-tick.svg'
                      assign mark_modifier = 'yes'
                      assign mark_text = section.settings.yes_label
                    else
                      assign mark_src = 'kk-fws-icon-cross.svg'
                      assign mark_modifier = 'no'
                      assign mark_text = section.settings.no_label
                    endif
                  -%}
                  <td class="kk-fws-comparison__cell{% if forloop.first %} kk-fws-comparison__cell--phoenix{% endif %}">
                    <img
                      class="kk-fws-comparison__mark kk-fws-comparison__mark--{{ mark_modifier }}"
                      src="{{ mark_src | asset_url }}"
                      alt=""
                      aria-hidden="true"
                      loading="lazy"
                      width="30"
                      height="30"
                    >
                    <span class="kk-fws-comparison__sr">{{ mark_text }}</span>
                  </td>
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="kk-fws-comparison__cta">
        <a
          class="kk-fws-comparison__button"
          href="{{ section.settings.button_link | default: '#' }}"
        >
          {{ section.settings.button_label }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('kk-fws-comparison-{{ section.id }}');
    if (!root) return;

    var buttons = root.querySelectorAll('.kk-fws-comparison__toggle');
    if (!buttons.length) return;

    Array.prototype.forEach.call(buttons, function (button) {
      button.addEventListener('click', function () {
        Array.prototype.forEach.call(buttons, function (other) {
          var isActive = other === button;
          other.setAttribute('data-active', isActive ? 'true' : 'false');
          other.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
      });
    });
  })();
</script>

{% stylesheet %}
  .kk-fws-comparison {
    background: var(--kk-fws-comparison-background, #f5f3f1);
    padding: 11.09rem 0;
  }

  .kk-fws-comparison__container {
    width: min(100% - 3.2rem, 114rem);
    margin: 0 auto;
  }

  .kk-fws-comparison__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .kk-fws-comparison__heading {
    max-width: 85.1rem;
    margin: 0 auto;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 5.2rem;
    line-height: 1.1;
    text-align: center;
    text-transform: none;
    color: var(--kk-fws-comparison-heading, #153a5b);
  }

  .kk-fws-comparison__table-wrap {
    margin-top: 6.2rem;
  }

  /* Mobile-only column switcher — hidden at every other breakpoint. */
  .kk-fws-comparison__toggles {
    display: none;
  }

  .kk-fws-comparison__table {
    width: 100%;
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }

  .kk-fws-comparison__col {
    width: 18.4875%;
  }

  .kk-fws-comparison__col--feature {
    width: 26.05%;
  }

  .kk-fws-comparison__th {
    height: 14.693rem;
    padding: 1.2rem 0.8rem;
    vertical-align: middle;
    background: transparent;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 2.4787rem;
    line-height: 1.1;
    text-align: center;
    color: var(--kk-fws-comparison-heading, #153a5b);
  }

  .kk-fws-comparison__th--phoenix {
    background: var(--kk-fws-comparison-highlight, #ffffff);
    border-radius: 1.1665rem 1.1665rem 0 0;
  }

  .kk-fws-comparison__th-label {
    display: block;
  }

  .kk-fws-comparison__th--phoenix .kk-fws-comparison__th-label {
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
  }

  .kk-fws-comparison__row-header {
    height: 9.6rem;
    padding: 0 0.726rem;
    vertical-align: middle;
    background: var(--kk-fws-comparison-feature-background, #f5f3f1);
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 2.4787rem;
    line-height: 1.595;
    text-align: left;
    color: var(--kk-fws-comparison-heading, #153a5b);
  }

  .kk-fws-comparison__cell {
    height: 9.6rem;
    padding: 0 0.8rem;
    vertical-align: middle;
    text-align: center;
  }

  .kk-fws-comparison__cell--phoenix {
    background: var(--kk-fws-comparison-highlight, #ffffff);
  }

  .kk-fws-comparison__row:last-child .kk-fws-comparison__cell--phoenix {
    border-radius: 0 0 1.1665rem 1.1665rem;
  }

  .kk-fws-comparison__mark {
    display: inline-block;
    vertical-align: middle;
    object-fit: contain;
  }

  .kk-fws-comparison__mark--yes {
    width: 2.9132rem;
    height: 2.9132rem;
  }

  .kk-fws-comparison__mark--no {
    width: 2.0384rem;
    height: 2.0384rem;
  }

  .kk-fws-comparison__cta {
    display: flex;
    justify-content: center;
    margin-top: 5.07rem;
  }

  .kk-fws-comparison__button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54.8535rem;
    max-width: 100%;
    min-height: 6.5427rem;
    padding: 1.2rem 4.4rem;
    box-sizing: border-box;
    background: var(--kk-fws-comparison-button-background, #153a5b);
    border-radius: 23.027rem;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 2.4rem;
    line-height: 1.14;
    letter-spacing: 0.13816rem;
    text-align: center;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--kk-fws-comparison-button-text, #ffffff);
    transition: opacity 0.2s ease;
  }

  .kk-fws-comparison__button:hover,
  .kk-fws-comparison__button:focus-visible {
    opacity: 0.9;
    color: var(--kk-fws-comparison-button-text, #ffffff);
  }

  @media (max-width: 989px) {
    .kk-fws-comparison {
      padding: 6.4rem 0;
    }

    .kk-fws-comparison__heading {
      font-size: 3.8rem;
    }

    .kk-fws-comparison__table-wrap {
      margin-top: 4rem;
    }

    .kk-fws-comparison__th {
      height: 10rem;
      font-size: 1.9rem;
    }

    .kk-fws-comparison__row-header,
    .kk-fws-comparison__cell {
      height: 7.4rem;
    }

    .kk-fws-comparison__row-header {
      font-size: 1.9rem;
      line-height: 1.3;
    }

    .kk-fws-comparison__cta {
      margin-top: 3.6rem;
    }

    .kk-fws-comparison__button {
      font-size: 1.9rem;
      letter-spacing: 0.1rem;
    }
  }

  @media (max-width: 749px) {
    .kk-fws-comparison {
      padding: 4rem 0;
    }

    .kk-fws-comparison__container {
      width: min(100% - 4rem, 54rem);
    }

    .kk-fws-comparison__heading {
      max-width: none;
      font-size: 2.8rem;
    }

    .kk-fws-comparison__table-wrap {
      margin-top: 1.8rem;
    }

    /* Toggle card — Figma 7511:398 (335x56, 6px padding, 6px gap, 8px radius). */
    .kk-fws-comparison__toggles {
      display: flex;
      gap: 0.6rem;
      padding: 0.6rem;
      background: var(--kk-fws-comparison-highlight, #ffffff);
      border-radius: 0.8rem;
    }

    .kk-fws-comparison__toggle {
      display: flex;
      flex: 1 1 0;
      align-items: center;
      justify-content: center;
      min-width: 0;
      min-height: 4.4rem;
      margin: 0;
      padding: 0.8rem 0.4rem;
      background: transparent;
      border: 0;
      border-radius: 0.8rem;
      font-family: 'Value Sans Bold', sans-serif;
      font-weight: 700;
      font-size: 1.3rem;
      line-height: 1.1;
      text-align: center;
      word-break: break-word;
      color: var(--kk-fws-comparison-heading, #153a5b);
      cursor: pointer;
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .kk-fws-comparison__toggle[data-active='true'] {
      background: var(--kk-fws-comparison-pill, #153a5b);
      color: var(--kk-fws-comparison-button-text, #ffffff);
    }

    .kk-fws-comparison__toggle:focus-visible {
      outline: 2px solid var(--kk-fws-comparison-heading, #153a5b);
      outline-offset: 2px;
    }

    /* The toggle card replaces the visible header row; keep the <th scope="col">
       cells in the accessibility tree rather than display:none-ing them away. */
    .kk-fws-comparison__table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0 0 0 0);
      clip-path: inset(50%);
      white-space: nowrap;
      border: 0;
    }

    .kk-fws-comparison__table {
      table-layout: auto;
      margin-top: 1.8rem;
    }

    .kk-fws-comparison__col,
    .kk-fws-comparison__col--feature {
      width: auto;
    }

    /* One comparison column at a time: hide them all, then reveal the one whose
       toggle is active. Column 1 is the feature column and always shows. */
    .kk-fws-comparison__table tbody tr > :nth-child(n + 2) {
      display: none;
    }

    .kk-fws-comparison__table-wrap:has(.kk-fws-comparison__toggle[data-active='true'][data-show='2'])
      .kk-fws-comparison__table tbody tr > :nth-child(2),
    .kk-fws-comparison__table-wrap:has(.kk-fws-comparison__toggle[data-active='true'][data-show='3'])
      .kk-fws-comparison__table tbody tr > :nth-child(3),
    .kk-fws-comparison__table-wrap:has(.kk-fws-comparison__toggle[data-active='true'][data-show='4'])
      .kk-fws-comparison__table tbody tr > :nth-child(4),
    .kk-fws-comparison__table-wrap:has(.kk-fws-comparison__toggle[data-active='true'][data-show='5'])
      .kk-fws-comparison__table tbody tr > :nth-child(5) {
      display: table-cell;
    }

    .kk-fws-comparison__row-header {
      width: 50%;
      height: auto;
      padding: 1.6rem;
      font-size: 1.6rem;
      line-height: 1.2;
    }

    /* Any column can be the visible one on mobile, so every cell takes the
       highlight treatment rather than only the Phoenix column. */
    .kk-fws-comparison__cell {
      height: auto;
      padding: 2rem 1.6rem;
      background: var(--kk-fws-comparison-highlight, #ffffff);
    }

    .kk-fws-comparison__table-wrap .kk-fws-comparison__row:first-child .kk-fws-comparison__cell {
      border-radius: 0.8rem 0.8rem 0 0;
    }

    .kk-fws-comparison__table-wrap .kk-fws-comparison__row:last-child .kk-fws-comparison__cell {
      border-radius: 0 0 0.8rem 0.8rem;
    }

    .kk-fws-comparison__mark--yes {
      width: 2.9132rem;
      height: 2.9132rem;
    }

    .kk-fws-comparison__mark--no {
      width: 1.8rem;
      height: 1.8rem;
    }

    .kk-fws-comparison__cta {
      margin-top: 1.8rem;
    }

    .kk-fws-comparison__button {
      width: 100%;
      min-height: 6.2rem;
      padding: 1.2rem 2rem;
      font-size: 1.7rem;
      line-height: 1.14;
      letter-spacing: 0.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .kk-fws-comparison__toggle,
    .kk-fws-comparison__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
