{%- liquid
  assign copy_centered = false
  if section.settings.content_align == 'center'
    assign copy_centered = true
  endif

  assign is_dark = false
  if section.settings.style == 'bg-dark'
    assign is_dark = true
  endif

  assign column_image_width = section.settings.img_width | default: 0 | plus: 0
  assign background_image_width = column_image_width
  if column_image_width <= 0
    assign column_image_width = section.settings.column_img.width
    assign background_image_width = section.settings.section_bgimg.width
  endif
-%}

<div class="{{ section.settings.custom_class }} layout-{{ section.settings.layout }}{% if is_dark %} copy-image--dark{% endif %}" id="{{ section.settings.custom_id }}">

  {% assign col_one_class = 'col-md-10 col-lg-6' %}
  {% assign col_two_class = 'col-11 col-md-10 col-lg-6 copy-col' %}
  {% assign animation_class = 'view-animation fade-up' %}
  {% assign row_settings = 'justify-content-center justify-content-md-start' %}
  {% assign h2_setting = 'col-lg-11' %}
  {% assign li_width = 'd-flex align-items-start py-2 me-3' %}
  
  {% if section.settings.layout == 'copy' %}
  {% assign col_one_class = 'col-11 col-md-10 col-lg-10' %}
    {% assign col_two_class = 'copy-col col-11 col-md-10 col-lg-10 ' %}
    {% assign animation_class = 'view-animation' %}
     {% assign row_settings = 'justify-content-center' %}
     {% assign h2_setting = 'col-10 col-md-12 text-lg-start' %}
  {% endif %}

  {% if section.settings.layout == 'copy-image-copy' %}
    {% assign col_two_class = 'copy-col col-11 col-md-10 col-lg-10' %}
    {% assign animation_class = 'view-animation fade-left my-5' %}
      {% assign row_settings = 'justify-content-center' %}
  {% endif %}

  {% if section.settings.layout == 'copy-image' %}
    {% assign col_one_class = 'col-md-10 col-lg-6 order-1 order-lg-2' %}
    {% assign col_two_class = 'col-11 col-md-10 col-lg-6 order-2 order-lg-1 copy-col' %}
    {% assign animation_class = 'view-animation fade-left' %}
  {% endif %}

  {% if section.settings.layout == 'centered-copy' %}
    {% assign col_one_class = 'col-10 col-lg-12 order-2 ' %}
    {% assign col_two_class = 'col-11 col-lg-8 order-1 copy-col' %}
    {% assign row_settings = 'justify-content-center' %}
    {% assign animation_class = 'view-animation fade-up' %}
    {% assign h2_setting = 'col-10 text-center mb-5' %}
  {% endif %}

  {% if section.settings.large_image == 'img-lrg' and section.settings.layout == 'copy-image' %} 
    {% assign col_one_class = 'col-12 col-lg-4 order-1 order-lg-2 mt-5 mt-lg-0 mo-pad' %}
    {% assign col_two_class = 'col-11 col-lg-8 order-2 order-lg-1 copy-col' %}
    {% assign row_settings = 'justify-content-center justify-content-md-start' %}
    {% assign animation_class = 'view-animation fade-up img-lrg' %}
    {% assign li_width = 'd-flex align-items-start py-2 me-lg-3 max-li-width' %}
  {% endif %}

  <div
    class="background-image-container {% if section.settings.section_randoimg != blank %}overflow{% endif %} {{ section.settings.style }} {{ section.settings.bg_image_style }}"
     >

    {% if section.settings.section_randoimg != blank %}
      {% if section.settings.section_randoimg_position == 'top' %}
        {{ section.settings.section_randoimg | image_url: width: 600 | image_tag: class: "view-animation float-right float-img top" }}
      {% endif %}
    {% endif %}

    {% if section.settings.section_bgimg != blank   %} 
     {{ section.settings.section_bgimg | image_url: width: 1920 | image_tag: class: "d-none d-lg-block"  }}
    {% endif %}
  </div>


  <div class="container">
    <div class="row {{ section.settings.vertical_align }} {{ row_settings }}">

      <div class="{{ col_one_class }}">
        {% assign img_classes = 'img-fluid d-block mx-auto mb-5 mb-lg-0 rounded' %}

        {% if section.settings.layout == 'copy' %}
          {% assign img_classes = 'img-fluid d-block mb-5 max-width-image rounded' %}
          {% if copy_centered %}{% assign img_classes = img_classes | append: ' mx-auto' %}{% endif %}
        {% elsif section.settings.layout == 'copy-image-copy' %}
          {% assign img_classes = 'img-fluid d-block mx-auto rounded mt-5' %}
        {% endif %}

        {% if section.settings.layout != 'copy-image-copy' %}
          
          {% if section.settings.video_id != blank %}
             <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ section.settings.video_id }}"></div>
          {% endif %}

          {% if section.settings.column_img != blank %} 
            <img
              src="{{ section.settings.column_img | image_url: width: 1920 }}"
              class="{{ img_classes }} {{ animation_class }}" alt="Phoenix Gravity Water Filter"
              width="{{ column_image_width }}"
              height="{{ column_image_width | divided_by: section.settings.column_img.aspect_ratio | round }}"
              loading="lazy" />

              {% elsif section.settings.section_bgimg != blank and section.settings.layout == 'image-copy' %} 

                 <img
              src="{{ section.settings.section_bgimg | image_url: width: 1920 }}"
              class="{{ img_classes }} {{ animation_class }} d-lg-none" alt="Phoenix Gravity Water Filter"
              width="{{ background_image_width }}"
              height="{{ background_image_width | divided_by: section.settings.section_bgimg.aspect_ratio | round }}"
              loading="lazy" />

          {% endif %}
        {% endif %}
      </div>

      <div class="{{ col_two_class }}{% if section.settings.large_image == 'img-lrg' %} mo-pad {% endif %}{% if copy_centered %} copy-col--center text-center{% endif %}">

        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 96
            | image_tag: class: 'copy-col__logo', width: 48, height: 44, loading: 'lazy', alt: ''
          }}
        {%- elsif section.settings.show_logo -%}
          <img
            class="copy-col__logo"
            src="{% if is_dark %}{{ 'kk-fws-phoenix-mark-white.png' | asset_url }}{% else %}{{ 'kk-fws-phoenix-mark.png' | asset_url }}{% endif %}"
            alt=""
            width="48"
            height="44"
            loading="lazy"
          >
        {%- endif -%}

        {% if section.settings.heading != '' %}
          <h2 class="{{ h2_setting }}">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.content != blank %}
          {{ section.settings.content | replace: '[month]', '<span class="dyn-month"></span>' }}
        {% endif %}

        {% if section.settings.layout == 'copy-image-copy' %}
          {% if section.settings.video_id != blank %}
            <div class="video-preview-container my-5">    
                <script src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}.jsonp" async></script><div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;"><div class="wistia_responsive_wrapper" style="height:100%;left:0;position:absolute;top:0;width:100%;"><div class="wistia_embed wistia_async_{{ section.settings.video_id }} seo=true videoFoam=true" style="height:100%;position:relative;width:100%"><div class="wistia_swatch" style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;"><img src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}/swatch" style="filter:blur(5px);height:100%;object-fit:contain;width:100%;" alt="" aria-hidden="true" onload="this.parentNode.style.opacity=1;" />
                </div></div></div></div>
              </div>
          {% endif %}

          {% if section.settings.column_img != blank %}
            <img
              src="{{ section.settings.column_img | image_url: width: 1920 }}"
              class="{{ img_classes }} {{ animation_class }}" alt="Phoenix Gravity Water Filter"
              width="{{ column_image_width }}"
              height="{{ column_image_width | divided_by: section.settings.column_img.aspect_ratio | round }}"
              loading="lazy" />

          {% endif %}

          {% if section.settings.second_content != blank %}
            {{ section.settings.second_content }}
          {% endif %}
        {% endif %}

        {% if section.blocks != blank %}
           {% if section.settings.section_randoimg != blank and section.settings.section_randoimg_position == 'bottom' %}
            <div class="d-flex flex-row justify-content-between flex-wrap">
           {% endif %}

          <ul class="features d-flex flex-wrap px-0 pt-5{% if section.settings.section_randoimg != blank and section.settings.section_randoimg_position == 'bottom' %}col-12 col-lg-8{% endif %}">
              {% for block in section.blocks %}
                <li class="{{ li_width  }}">
                  {% if block.settings.feature_icon != blank %}
                    {{ block.settings.feature_icon | image_url: width: 200 | image_tag: class: "img-fluid feature-icon  me-3", loading: "lazy" }}
                  {% else %}
                    
                      <img src="{{ 'icon-features-tick.svg' | asset_url }}" class="img-fluid feature-icon  me-3" alt="Phoenix Gravity Water Filter" width="24" height="24" loading="lazy" />
                    
                  {% endif %}

                  <p>{{ block.settings.feature_text }}</p>
                </li>
              {% endfor %}
            </ul>
        {% endif %}

        {% if section.settings.section_randoimg != blank and section.settings.section_randoimg_position == 'bottom' %}
          <div class="col-10 col-lg-3 text-center">
          {{ section.settings.section_randoimg | image_url: width: 600 | image_tag: class: "view-animation float-bottom" }}
          </div>
        </div>
      {% endif %}


{% if section.settings.buttonlink != blank %}
        <div class="row">
          <div class="col-12">
            {%- if copy_centered -%}
              {% render 'button', class: 'mx-auto' %}
            {%- else -%}
              {% render 'button' %}
            {%- endif -%}
          </div>
        </div>
{% endif  %}
      </div>
    </div>

  </div>
</div>

{% stylesheet %}
  .section-copy-image img.img-fluid.rounded {
    height: auto;
    object-fit: contain;
  }

  .section-copy-image img.img-fluid.img-lrg {
    position: static;
    transform: none;
  }

  /* Phoenix mark above the heading, as in the Cards Section (Figma `7809:10190`). */
  .copy-col__logo {
    display: block;
    width: 48px;
    height: 44px;
    margin-bottom: 2.8rem;
    object-fit: contain;
  }

  /* "Centered" content alignment: overrides the layouts' text-lg-start and column widths. */
  .copy-col--center,
  .copy-col--center h2,
  .copy-col--center .h2 {
    text-align: center !important;
  }

  .copy-col--center h2,
  .copy-col--center .h2,
  .copy-col--center .copy-col__logo {
    margin-right: auto;
    margin-left: auto;
  }

  .copy-col--center .features {
    justify-content: center;
  }

  /* "Dark" background: primary-900 with white text. */
  .section-copy-image .background-image-container.bg-dark {
    background: var(--primary-900);
  }

  .copy-image--dark :is(h1, h2, h3, h4, h5, h6, .h1, .h2, .h3, .h4, p, li, span, strong, em, b, i),
  .copy-image--dark .kk-fws-button-trust__item {
    color: #ffffff;
  }

  .copy-image--dark a:not(.kk-fws-button) {
    color: #ffffff;
    text-decoration: underline;
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Copy + Image",
    "tag": "section",
    "class": "section-copy-image trigger-observer",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Background",
        "default": "bg-white",
        "options": [
          {
            "label": "White",
            "value": "bg-white"
          }, {
            "label": "Light",
            "value": "bg-light"
          }, {
            "label": "Dark",
            "value": "bg-dark"
          }
        ]
      },
      {
        "type": "select",
        "id": "layout",
        "label": "Layout",
        "options": [
          {
            "value": "centered-copy",
            "label": "Single Column, Copy First"
          },
          {
            "value": "image-copy",
            "label": "2 Columns, Image first"
          },
          {
            "value": "copy-image",
            "label": "2 Columns, Copy first"
          },
          {
            "value": "copy",
            "label": "Copy"
          }, {
            "value": "copy-image-copy",
            "label": "Copy, Image, Copy"
          }
        ]
      },
      {
        "type": "select",
        "id": "vertical_align",
        "label": "Vertical Alignment",
        "default": "align-items-center",
        "options": [
          {
            "value": "align-items-start",
            "label": "Align Top"
          }, {
            "value": "align-items-center",
            "label": "Align Center"
          }, {
            "value": "align-items-end",
            "label": "Align Bottom"
          }
        ]
      },
      {
        "type": "select",
        "id": "content_align",
        "label": "Content alignment",
        "default": "left",
        "options": [
          { "value": "left", "label": "Left" },
          { "value": "center", "label": "Centered" }
        ],
        "info": "Centres the heading, copy, features and button horizontally. In the Copy layout it centres the image too."
      },
      {
        "type": "checkbox",
        "id": "show_logo",
        "label": "Show Phoenix logo above the heading",
        "default": false
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom logo",
        "info": "Replaces the Phoenix logo. Shown at 48 × 44px."
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      }, {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }, {
        "type": "image_picker",
        "id": "column_img",
        "label": "Image"
      }, {
        "type": "text",
        "id": "video_id",
        "label": "Wisita Video ID"
      }, {

        "type": "number",
        "id": "img_width",
        "label": "Image Width (px)"
      }, {
        "type": "select",
        "id": "large_image", 
        "label": "Increase Image Size",
        "default": "img-standard",
        "options": [
          {
            "value": "img-lrg",
            "label": "On"
          }, {
            "value": "img-standard",
            "label": "Off"
          }
        ]
      }, {
        "type": "richtext",
        "id": "second_content",
        "label": "Content Below Image",
        "info": "Second Content block for Copy Image Copy layout"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "checkbox",
        "id": "button_arrow",
        "label": "Show arrow on button",
        "default": true
      },
      {
        "type": "select",
        "id": "button_style",
        "label": "Button style",
        "default": "primary",
        "options": [
          { "value": "primary", "label": "Primary" },
          { "value": "secondary", "label": "Secondary" }
        ]
      }, {
        "type": "checkbox",
        "id": "show_trust_items",
        "label": "Show trust items under the button",
        "default": false
      }, {
        "type": "text",
        "id": "trust_text_1",
        "label": "Trust item 1",
        "default": "100-day trial"
      }, {
        "type": "text",
        "id": "trust_text_2",
        "label": "Trust item 2",
        "default": "Cancel any time"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes/ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }, {
        "type": "image_picker",
        "id": "section_bgimg",
        "label": "Background Image"
      },{
        "type": "select",
        "id": "bg_image_style",
        "label": "BG Image Style",
        "default": "contain",
        "options": [
          {
            "label": "Contain",
            "value": "contain"
          }, {
            "label": "Cover",
            "value": "cover"
          }
        ]
      },  {
        "type": "select",
        "id": "section_randoimg_position",
        "label": "Float Position",
        "default": "top",
        "options": [
          {
            "label": "top",
            "value": "top"
          }, {
            "label": "bottom",
            "value": "bottom"
          }
        ]
      }, {
        "type": "image_picker",
        "id": "section_randoimg",
        "label": "Floating Image"
      } 
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Features",
        "settings": [
          {
            "type": "image_picker",
            "id": "feature_icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "feature_text",
            "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Copy Image"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}
