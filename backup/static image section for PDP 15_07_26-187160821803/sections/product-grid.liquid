{%- comment -%}
  Toolbar — Figma `7809:13958`: "Showing 13 products" on the left, and a pill on the right
  showing the current sort ("Sort by: Featured" with a chevron). The native select sits
  invisibly over the pill, so it keeps the keyboard and the native picker.
{%- endcomment -%}
{%- liquid
  assign current_sort = collection.sort_by | default: collection.default_sort_by
  assign current_sort_name = ''
  for option in collection.sort_options
    if option.value == current_sort
      assign current_sort_name = option.name
    endif
  endfor
-%}
<div class="container">
  <div class="product-grid-toolbar">
    <p class="product-grid-toolbar__count">
      Showing <strong>{{ collection.products_count }}</strong>
      {{ collection.products_count | pluralize: 'product', 'products' }}
    </p>

    <div class="product-grid-toolbar__sort">
      <label class="product-grid-toolbar__sort-label" for="sort">
        {{- 'products.facets.sort_by_label' | t | capitalize -}}
      </label>
      <span class="product-grid-toolbar__sort-value" aria-hidden="true">{{ current_sort_name }}</span>
      <img
        class="product-grid-toolbar__sort-icon"
        src="{{ 'product-grid-icon-chevron.svg' | asset_url }}"
        alt=""
        width="14"
        height="14"
        aria-hidden="true"
      >
      <select class="product-grid-toolbar__select" name="sort_by" id="sort">
        {%- for option in collection.sort_options -%}
          <option
            value="{{ option.value | escape }}"
            {% if option.value == current_sort %}
              selected="selected"
            {% endif %}
          >
            {{ option.name | escape }}
          </option>
        {%- endfor -%}
      </select>
    </div>
  </div>
  {% paginate collection.products by 16 %}




              
    <div class="row justify-content-center mb-5">

      {% comment %} <div class="col-12 col-lg-3" >
                                        {% render 'filters'
                                          , collection: collection %}
                              </div> {% endcomment %}
      <div class="col-12 col-lg-12">
        <div class="collection-grid">

          {% if collection.products.size > 0 %}
            
         {% comment %}Modified on June 3, for Appstle      {% endcomment %}
{% for product in collection.products %}
  {% unless product.title == "Phoenix Gravity Carbon filter Elements (Appstle)" or product.title == "POSTreat FluoRid Refill Media (Appstle)" %}
    <div class="collection-grid__item">
      {% render 'collection-card', product: product %}
    </div>
  {% endunless %}
{% endfor %}
<!-- Start of Judge.me code -->
      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->
 {% comment %}Modified on June 3, for Appstle      {% endcomment %}

          
          {% else %}
            <div class="col-12 text-center">
              <p>{{ 'sections.collection_template.empty' | t }}.</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>







              
    {% if paginate.pages > 1 %}
      <div class="row justify-content-center">
        <div class="col-12">
          {% render 'pagination'
            , paginate: paginate %}
        </div>
      </div>
    {% endif %}

  {% endpaginate %}

</div>


<script>
    Shopify.queryParams = {};

        // Preserve existing query parameters
    if (location.search.length) {
        var params = location.search.substr(1).split('&');
        for (var i = 0; i < params.length; i++) {
            var keyValue = params[i].split('=');

            if (keyValue.length) {
                // Check if the parameter is already an array (in case of multiple selections)
                if (Shopify.queryParams[decodeURIComponent(keyValue[0])]) {
                    if (Array.isArray(Shopify.queryParams[decodeURIComponent(keyValue[0])])) {
                        Shopify.queryParams[decodeURIComponent(keyValue[0])].push(decodeURIComponent(keyValue[1]));
                    } else {
                        Shopify.queryParams[decodeURIComponent(keyValue[0])] = [
                            Shopify.queryParams[decodeURIComponent(keyValue[0])],
                            decodeURIComponent(keyValue[1]),
                        ];
                    }
                } else {
                    Shopify.queryParams[decodeURIComponent(keyValue[0])] = decodeURIComponent(keyValue[1]);
                }
            }
        }
    }

    // Update sort_by query parameter on select change
    document.querySelectorAll('[name="sort_by"]').forEach(function(el, index) {
        el.addEventListener('change', function(e) {
            var value = e.target.value;
            Shopify.queryParams.sort_by = value;
            location.search = unescape(new URLSearchParams(Shopify.queryParams).toString());
        });
    });
</script>

{% stylesheet %}
  .product-grid-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem 2.4rem;
    margin: 0 0 3rem;
    padding-top: 7.2rem;
  }

  .product-grid-toolbar__count {
    margin: 0;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.2;
    color: #6b7085;
  }

  .product-grid-toolbar__count strong {
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    color: #0b1638;
  }

  /* Pill — Figma `7809:13961`: 1px #e1e6f0, 20px / 16.5px in, 10px between label, value and
     chevron. */
  .product-grid-toolbar__sort {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 1rem;
    padding: 1.65rem 2rem;
    border: 1px solid #e1e6f0;
    border-radius: 99.9rem;
    font-size: 1.5rem;
    line-height: 1.2;
    color: #0b1638;
    transition: border-color 0.2s ease;
  }

  .product-grid-toolbar__sort:hover,
  .product-grid-toolbar__sort:focus-within {
    border-color: #0b1638;
  }

  .product-grid-toolbar__sort-label {
    margin: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    letter-spacing: 0;
    text-transform: none;
  }

  .product-grid-toolbar__sort-value {
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
  }

  .product-grid-toolbar__sort-icon {
    display: block;
    flex-shrink: 0;
    width: 1.4rem;
    height: 1.4rem;
  }

  /* The real select covers the whole pill, invisible. */
  .product-grid-toolbar__select {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    opacity: 0;
    cursor: pointer;
    appearance: none;
    font-size: 1.6rem;
  }

  /* Product cards — Figma `7809:13970`: three 418.69px columns, 28px apart, in the 1312px
     container. Cards in a row share a height, the button pinned to the bottom. */
  .collection-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 2.8rem;
  }

  .collection-grid > .col-12 {
    grid-column: 1 / -1;
  }

  /* Judge.me's stray badge after the loop has no product, so it would take a grid cell. */
  .collection-grid > .jdgm-preview-badge {
    display: none;
  }

  .collection-grid__item {
    display: flex;
    min-width: 0;
  }

  .collection-card {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding-top: 1.2rem;
    overflow: hidden;
    border-radius: 2rem;
    background: #f5f6f8;
    color: #0b1638;
    text-decoration: none;
  }

  .collection-card:hover,
  .collection-card:focus-visible {
    color: #0b1638;
    text-decoration: none;
  }

  /* White image panel: 12px in from the card, 16px corners, image 192px tall. */
  .collection-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 1.2rem;
    padding: 4.8rem 2.4rem 2.8rem;
    overflow: hidden;
    border-radius: 1.6rem;
    background: #ffffff;
  }

  .collection-card__image {
    display: block;
    width: auto;
    max-width: 100%;
    height: 19.2rem;
    object-fit: contain;
    transition: transform 0.4s ease;
  }

  .collection-card:hover .collection-card__image {
    transform: scale(1.04);
  }

  .collection-card__badge {
    position: absolute;
    top: 2.2rem;
    left: 2.2rem;
    z-index: 1;
    padding: 0.78rem 1.2rem;
    border-radius: 99.9rem;
    background: #0b1638;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    line-height: 1.2;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
    white-space: nowrap;
    color: #ffffff;
  }

  .collection-card__badge--saving {
    background: #2764ff;
  }

  .collection-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 1.6rem;
    padding: 1.8rem 3.2rem 2.8rem;
  }

  .collection-card__info {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .collection-card__rating {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.8rem;
  }

  /* Grey stars with the gold set clipped to the rating. */
  .collection-card__stars {
    position: relative;
    display: block;
    flex-shrink: 0;
    width: 10rem;
    height: 1.6rem;
  }

  .collection-card__stars svg {
    display: block;
    width: 10rem;
    height: 1.6rem;
  }

  .collection-card__stars-empty {
    color: #e1e4ea;
  }

  .collection-card__stars-full {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--collection-card-fill, 100%);
    overflow: hidden;
    color: #fbbc04;
  }

  .collection-card__stars path {
    fill: currentColor;
  }

  .collection-card__rating-text {
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1.2;
    color: #6b7085;
  }

  .collection-card__title {
    margin: 0;
    padding: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: #0b1638;
  }

  .collection-card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.8rem;
    margin: 0;
    padding-top: 0.6rem;
  }

  .collection-card__price-now {
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1.2;
    color: #0b1638;
  }

  .collection-card__price-was {
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1.2;
    color: #a3a7bf;
  }

  /* Buy now — Figma `7809:14001`: full width, 17px tall padding, 15px label, 18px arrow. */
  .collection-card__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-top: auto;
    padding: 1.7rem 2rem;
    border-radius: 99.9rem;
    background: #2764ff;
    box-shadow: 0 0.8rem 0.9rem rgba(39, 100, 255, 0.22);
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: 0.14rem;
    text-transform: uppercase;
    color: #ffffff;
    transition: background 0.2s ease;
  }

  .collection-card:hover .collection-card__button,
  .collection-card:focus-visible .collection-card__button {
    background: #1f57e6;
  }

  .collection-card__button-icon {
    display: block;
    flex-shrink: 0;
    width: 1.8rem;
    height: 1.8rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .collection-card__image {
      transition: none;
    }

    .collection-card:hover .collection-card__image {
      transform: none;
    }
  }

  @media (max-width: 989px) {
    .collection-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }

    .collection-card__body {
      padding: 1.6rem 2.4rem 2.4rem;
    }
  }

  /* Mobile: two across, scaled down. */
  @media (max-width: 749px) {
    .collection-grid {
      gap: 1.2rem;
    }

    .collection-card {
      padding-top: 0.6rem;
      border-radius: 1.4rem;
    }

    .collection-card__media {
      margin: 0 0.6rem;
      padding: 3.6rem 1rem 1.4rem;
      border-radius: 1rem;
    }

    .collection-card__image {
      height: 12rem;
    }

    .collection-card__badge {
      top: 0.8rem;
      left: 0.8rem;
      padding: 0.5rem 0.8rem;
      font-size: 1rem;
      letter-spacing: 0.08rem;
    }

    .collection-card__body {
      gap: 1.2rem;
      padding: 1.2rem 1.2rem 1.4rem;
    }

    .collection-card__info {
      gap: 0.6rem;
    }

    .collection-card__stars,
    .collection-card__stars svg {
      width: 7.5rem;
      height: 1.2rem;
    }

    .collection-card__rating-text {
      font-size: 1.2rem;
    }

    .collection-card__title {
      font-size: 1.5rem;
    }

    .collection-card__price {
      gap: 0.6rem;
      padding-top: 0.2rem;
    }

    .collection-card__price-now {
      font-size: 1.9rem;
    }

    .collection-card__price-was {
      font-size: 1.4rem;
    }

    .collection-card__button {
      gap: 0.6rem;
      padding: 1.2rem 1rem;
      font-size: 1.2rem;
      letter-spacing: 0.1rem;
    }

    .collection-card__button-icon {
      width: 1.4rem;
      height: 1.4rem;
    }
  }

  @media (max-width: 749px) {
    .product-grid-toolbar {
      gap: 1.2rem;
      margin-bottom: 2.4rem;
      padding-top: 4.2rem;
    }

    .product-grid-toolbar__count {
      font-size: 1.5rem;
    }

    .product-grid-toolbar__sort {
      gap: 0.8rem;
      padding: 1.2rem 1.6rem;
      font-size: 1.4rem;
    }
  }
{% endstylesheet %}

{% schema %}
  {
    "name": "Product Grid",
    "tag": "section",
    "class": "section-productgrid",
    "presets": [
      {
        "name": "Product Grid"
      }
    ],
    "enabled_on": {
      "templates": ["collection"]
    }
  }
{% endschema %}