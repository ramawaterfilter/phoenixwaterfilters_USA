      "type": "header",
      "content": "Video",
      "info": "The feature cards overlap the bottom of the video. Leave the media ID empty to hide the video."
    },
    {
      "type": "text",
      "id": "media_id",
      "label": "Wistia media ID",
      "default": "t5p83isk4k",
      "info": "The hashed ID from the Wistia media URL."
    },
    {
      "type": "text",
      "id": "video_title",
      "label": "Accessible label",
