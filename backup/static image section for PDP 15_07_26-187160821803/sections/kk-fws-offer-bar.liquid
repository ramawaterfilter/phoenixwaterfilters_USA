{%- liquid
  assign bar_text = section.settings.text
  assign bar_link = section.settings.link
-%}

<section
  class="kk-fws-offer-bar"
  style="
    --kk-fws-offer-bar-background: {{ section.settings.background_color }};
    --kk-fws-offer-bar-text: {{ section.settings.text_color }};
  "
>
  {%- if bar_text != blank -%}
    {%- if bar_link != blank -%}
      <a class="kk-fws-offer-bar__inner kk-fws-offer-bar__inner--link" href="{{ bar_link }}">
        <span class="kk-fws-offer-bar__text">
          {{- bar_text | replace: '[month]', '<span class="dyn-month"></span>' -}}
        </span>
      </a>
    {%- else -%}
      <div class="kk-fws-offer-bar__inner">
        <span class="kk-fws-offer-bar__text">
          {{- bar_text | replace: '[month]', '<span class="dyn-month"></span>' -}}
        </span>
      </div>
    {%- endif -%}
  {%- endif -%}
</section>

{% stylesheet %}
  /* Campaign landing page replaces the global header group (nav + trust bar +
     announcement bar), which theme.liquid wraps in a single <header class="site-header">.
     Owned by this section because it is the first campaign section on the page. */
  .site-header {
    display: none;
  }

  /* The global header is position:fixed, so the theme reserves space for it with
     `body { padding-top: 84px }` (115px at another breakpoint) and
     `main { margin-top: 50px }`. With the header hidden that becomes 134px of dead
     space above the page, so the compensation has to be undone here too.
     !important because these compete with equal-specificity rules in the global
     bundles and the bundle order is not guaranteed. */
  body {
    padding-top: 0 !important;
  }

  main {
    margin-top: 0 !important;
  }

  .kk-fws-offer-bar {
    display: block;
    /* Explicit zero: the theme applies a global `section { padding: 20px 0 }`, which
       would add 40px on top of the band. The 43px Figma height comes from
       `.kk-fws-offer-bar__inner`'s own min-height, so the root adds nothing. */
    padding: 0;
    background: var(--kk-fws-offer-bar-background, #153a5b);
  }

  .kk-fws-offer-bar__inner {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(100% - 3.2rem, 114rem);
    min-height: 4.3rem;
    margin: 0 auto;
    padding: 1.3rem 0;
    box-sizing: border-box;
    text-decoration: none;
  }

  .kk-fws-offer-bar__inner--link:hover,
  .kk-fws-offer-bar__inner--link:focus-visible {
    text-decoration: none;
  }

  .kk-fws-offer-bar__text {
    display: block;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.2rem;
    line-height: 1.7rem;
    letter-spacing: 0.1rem;
    text-align: center;
    text-transform: uppercase;
    color: var(--kk-fws-offer-bar-text, #ffffff);
  }

  .kk-fws-offer-bar__inner--link .kk-fws-offer-bar__text {
    transition: opacity 0.2s ease;
  }

  .kk-fws-offer-bar__inner--link:hover .kk-fws-offer-bar__text,
  .kk-fws-offer-bar__inner--link:focus-visible .kk-fws-offer-bar__text {
    opacity: 0.85;
  }

  @media (max-width: 749px) {
    .kk-fws-offer-bar__inner {
      width: min(100% - 4rem, 54rem);
      min-height: 6rem;
      padding: 1.8rem 0;
    }

    .kk-fws-offer-bar__text {
      max-width: 30.9rem;
      margin: 0 auto;
      line-height: 1.3;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KK FWS Offer Bar",
  "tag": "div",
  "class": "section-kk-fws-offer-bar",
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "limited [month] offer - claim your free filter system today",
      "info": "Use [month] for the current month. Rendered uppercase."
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link",
      "info": "The whole bar links to the on-page offer section, e.g. #kk-fws-offer."
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#153a5b"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "KK FWS Offer Bar"
    }
  ]
}
{% endschema %}
