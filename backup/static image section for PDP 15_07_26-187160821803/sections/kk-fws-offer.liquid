  .kk-fws-offer__pay-input:checked + .kk-fws-offer__pay-card .kk-fws-offer__pay-radio::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 60%;
    height: 60%;
    transform: translate(-50%, -50%);
