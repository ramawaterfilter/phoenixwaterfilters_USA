  /* Tick badge straddles the card's top-right corner (Figma 7423:1593). */
  .kk-fws-offer__size-tick {
    position: absolute;
    /* Absolute offsets resolve against the padding box, so the card's border has to be
       added back to land the tick on the border-box corner as Figma has it. */
    top: calc(-1.13rem - 0.2215rem);
    right: calc(-1.13rem - 0.2215rem);
    display: none;
    width: 2.2594rem;
    height: 2.2594rem;
  }

  .kk-fws-offer__size-input:checked + .kk-fws-offer__size-card .kk-fws-offer__size-tick {
