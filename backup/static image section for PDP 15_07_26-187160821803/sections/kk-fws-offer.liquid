    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Square nav buttons flush to the image edges, vertically centred — Figma 7420:1080/1084.
     Deliberately NOT `.swiper-button-prev/next`: those classes pull in Swiper's own 27x44
     styling and its ::after icon font. The theme wires navigation off `.swiper-prev` /
     `.swiper-next`, which is all Swiper actually needs. */
  /* Scoped with the section root for specificity, not for readability: Swiper sets the
     `disabled` attribute on <button> nav elements at the ends of a non-looping slider, and
     the theme's `button[disabled]` rule in main.css (0,1,1) would otherwise beat a single
     class and strip the fill and border off whichever arrow is currently at the end. */
  .kk-fws-offer .kk-fws-offer__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
