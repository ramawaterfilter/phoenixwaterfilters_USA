    justify-content: center;
    gap: 0.4053rem;
    box-sizing: border-box;
    height: 100%;
    min-height: 11.0873rem;
    padding: 1.6rem 1.2rem;
    /* Transparent rather than absent so selecting a card does not resize it. */
    border: 0.2215rem solid transparent;
    border-radius: 0.8106rem;
    background: var(--kk-fws-offer-card-background, #f5f3f1);
    text-align: center;
