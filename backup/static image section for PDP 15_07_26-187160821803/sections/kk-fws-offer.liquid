      font-size: 1.6rem;
    }

    .kk-fws-offer__size-list {
      gap: 0.8rem;
    }

    .kk-fws-offer__size-card {
      padding: 1.2rem 0.6rem;
      border-radius: 1.2rem;
    }

    .kk-fws-offer__size-name {
      font-size: 1.5rem;
    }

    .kk-fws-offer__size-description {
      font-size: 1.2rem;
    }

    .kk-fws-offer__plan-list {
      gap: 3.2rem;
    }

    .kk-fws-offer__plan-card {
      padding: 2rem 1.2rem 1.6rem;
      border-radius: 1.2rem;
    }

    .kk-fws-offer__plan-ribbon {
      left: 1.2rem;
      padding: 0.3rem 0.8rem;
      font-size: 1.2rem;
      letter-spacing: 0.08rem;
    }

    .kk-fws-offer__plan-name {
      gap: 0.8rem;
    }

    .kk-fws-offer__plan-radio {
      width: 1.6rem;
      height: 1.6rem;
    }

    .kk-fws-offer__plan-input:checked + .kk-fws-offer__plan-card .kk-fws-offer__plan-radio {
      border-width: 0.5rem;
    }

    .kk-fws-offer__plan-label {
