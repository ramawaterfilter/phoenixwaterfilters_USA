  /* PHASE 1: hide the Appstle subscription widget inside this section.
     The app injects its own "Purchase Options" UI (Subscribe / One Time Purchase, with
     its own prices and a 55%-off badge) into every product form. Those numbers are the
     evergreen PDP's, not the campaign's, and they contradict item 5's offer two sections
     above. Its inputs are also disabled by the script at the foot of this file, so leaving
     the widget visible would show controls that look selectable but do nothing.
     Hiding is NOT sufficient alone - a hidden input still submits, which is why the script
     disables them too. Both are required.
     Scoped to this section; the widget still works everywhere else on the site.
     PHASE 2: remove this and the script when the real plan picker lands. */
  .kk-fws-offer [class*='appstle'],
  .kk-fws-offer [id*='appstle'] {
    display: none !important;
  }

  .kk-fws-offer__layout {
    display: grid;
    /* minmax(0, 1fr) not 1fr: a grid item defaults to min-width:auto, so the Swiper
       track (a flex row of square slides) can force its column far wider than 1fr.
       Without this the media column measured 27018px wide in the browser. */
    /* 569px gallery + 541px panel + 30.9px gutter = the 1140px campaign container. */
    grid-template-columns: minmax(0, 569fr) minmax(0, 541fr);
    column-gap: 3.1rem;
    align-items: start;
    margin-top: 4rem;
  }

  .kk-fws-offer__media {
