  /* Step 1's badges are the ONE-TIME size deltas (Free / +$30 / +$60). Ruled by the user: they
     do not show on a one-time purchase, where the tower is charged and nothing is free. The
     attribute is set server-side and kept in step by the picker script, so there is no flash of
     the wrong state on load. */
  .kk-fws-offer[data-kk-fws-pay-mode='onetime'] .kk-fws-offer__size-badge {
    display: none;
  }

  .kk-fws-offer__size-badge {
