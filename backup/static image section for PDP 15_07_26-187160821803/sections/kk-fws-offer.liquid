  /* Only ever shown on the subscribe card, and only when the selected size/plan pair has
     no allocation — otherwise it would read as a permanent disclaimer. */
  .kk-fws-offer__pay-unavailable {
    display: none;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.4rem;
    line-height: 1.4;
