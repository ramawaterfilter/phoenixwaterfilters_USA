  .kk-fws-offer__pay-input:disabled + .kk-fws-offer__pay-card .kk-fws-offer__pay-unavailable {
    display: block;
  }

  /* ORDER SUMMARY — desktop `7423:1692`, mobile `7511:336`. Dividers are inset from the card
     edge on desktop (Figma insets them by the 26.93px gutter) and full-bleed on mobile
     (`7511:344` spans the card), so they are row borders rather than separate elements. */
  .kk-fws-offer__summary {
    box-sizing: border-box;
    overflow: hidden;
    /* 2.05rem, not Figma's 2.35rem: the design's 23.52px is measured from the frame's outer
       edge, which includes the 3.068px border. */
    padding: 2.05rem 0 1.8rem;
    border: 0.3068rem solid var(--kk-fws-offer-card-background, #f5f3f1);
    border-radius: 0.8181rem;
    background: var(--kk-fws-offer-card-selected-background, #ffffff);
  }

  .kk-fws-offer__summary-title {
    margin: 0 0 0.9rem;
    padding: 0 2.693rem;
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.4rem;
    line-height: normal;
    letter-spacing: 0.14rem;
    text-transform: uppercase;
    color: var(--kk-fws-offer-heading, #153a5b);
  }

  .kk-fws-offer__summary-rows {
    padding: 0 2.693rem;
  }

  .kk-fws-offer__summary-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.6rem;
    padding: 2rem 0;
  }

  /* `hidden` alone loses to `display: flex`. */
  .kk-fws-offer__summary-row[hidden] {
    display: none;
  }

  /* Between rows only — Figma has no rule between the last row and the due-today band. The
     sibling selector also means a hidden row takes its divider with it. */
  .kk-fws-offer__summary-row + .kk-fws-offer__summary-row:not([hidden]) {
    border-top: 1px solid var(--kk-fws-offer-line, #efefef);
  }

  .kk-fws-offer__summary-label {
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.6rem;
    line-height: 1.3;
    color: var(--kk-fws-offer-text, #26303a);
  }

  .kk-fws-offer__summary-value {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1rem;
    text-align: right;
  }

  .kk-fws-offer__summary-amount {
    font-family: 'Value Sans Bold', sans-serif;
    font-weight: 700;
    font-size: 1.8rem;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--kk-fws-offer-heading, #153a5b);
  }

  /* Sits tight against the amount rather than in the row's 1rem gap — Figma renders
     "$99 / 6 months" as one phrase (`7423:1703`). */
  .kk-fws-offer__summary-cadence {
    margin-left: -0.6rem;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.8rem;
    line-height: 1.3;
    white-space: nowrap;
    color: var(--kk-fws-offer-heading, #153a5b);
