{% assign row_settings = 'justify-content-start align-items-center image-header' %}

{% if section.settings.sideimage == blank and section.settings.section_video_bg == blank %} 
    {% assign row_settings = 'justify-content-center align-items-center text-center standard-header' %}
    {% assign column_settings = 'col-12 col-md-10 col-lg-7 hero-copy' %}
{% endif %} 

{% if section.settings.sideimage == blank and section.settings.section_video_bg != blank %} 
    {% assign row_settings = 'justify-content-center justify-content-md-start align-items-center video-spacing' %}
    {% assign column_settings = 'col-11 col-md-10 col-lg-9 col-xl-6 hero-copy' %}
{% endif %}

<div class="section-hero__inner">

    {% if template == "index" and settings.entry_popup_side_button != blank %}
     
            <div class="section-hero__tab" style="display:none;" data-klaviyo="{{ settings.entry_popup_side_button_id }}">
         
            {{ settings.entry_popup_side_button }}
        
        </div> 
      
    {% endif %}

<div class="background-image-container bg-light  {%if section.settings.section_video_bg != blank %}video-right {% endif %}">
        {% if section.settings.section_bgimg != blank %}
            {{ section.settings.section_bgimg | image_url: width: 1920 | image_tag }}
        {% endif %}
   

    {% if section.settings.section_video_bg != blank %}
        <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ section.settings.section_video_bg }}"></div>
    {% endif %}
     </div>

    <div class="container">
        <div class="row {{ row_settings }}">
           
            {% if section.settings.sideimage == blank %}

                <div class="{{ column_settings }}">
                    {% if section.settings.eyebrow != blank %}
                        <p class="eyebrow">
                            {{ section.settings.eyebrow | replace: '[month]','<span class="dyn-month"></span>' }}
                        </p>
                    {% endif %}

                    <h1 class="h2 p-0">
                        {{ section.settings.heading }}
                    </h1>
               
                    {% if collection.description != blank or section.settings.content != blank %}
                    
                        {% if template == "collection" %}
                            {% if collection.description != blank %}
                                <div class="subheadline">{{ collection.description }}</div>
                            {% endif %}
                        {% else %}
                         <div class="subheadline">
                            {{ section.settings.content }}
                        </div>
                        {% endif %}

                        {% render 'button' %}

                    {% endif %}
                </div>

            {% else %}

                <div class="col-12 col-md-10 col-lg-6 copy-col">
                    {% if section.settings.eyebrow != blank %}
                        <p class="eyebrow">
                            {{ section.settings.eyebrow }}
                        </p>
                    {% endif %}
                    {% if section.settings.heading != blank %}
                        <h1 class="mb-4">
                            {{ section.settings.heading }}
                        </h1>
                    {% endif %}
                    {% if section.settings.content != blank %}
                     {{ section.settings.content }}
                    {% endif %}
                    {{ section.settings.sideimage | image_url: width: 1200 | image_tag: class: 'd-block pb-5 d-lg-none' }}
                    {% if section.settings.buttontext != blank and section.settings.buttonlink != blank  %}
                        {% render 'button', class: 'ms-lg-0 mt-5' %}
                    {% endif %}
                </div>

                <div class="col-12 col-lg-6 image-col d-none d-lg-block">
                    {{ section.settings.sideimage | image_url: width: 1200 | image_tag }}
                </div>
            {% endif %}

        </div>
    </div>

    {% for block in section.blocks %}
        {% if block.type == 'custom_code' and block.settings.custom_code != blank %}
            {% assign style_open = '<' | append: 'style>' %}
            {% assign style_close = '</' | append: 'style>' %}
            {% capture custom_style_open %}{{ style_open }}@scope (#hero-custom-code-{{ block.id }}) { {% endcapture %}
            {% capture custom_style_close %} } {{ style_close }}{% endcapture %}
            <div id="hero-custom-code-{{ block.id }}" class="hero-custom-code" {{ block.shopify_attributes }}>
                {{ block.settings.custom_code | replace: style_open, custom_style_open | replace: style_close, custom_style_close }}
            </div>
        {% endif %}
    {% endfor %}
</div>

{% stylesheet %}
    .section-hero .hero-custom-code {
        position: relative;
        width: 100%;
    }
{% endstylesheet %}

{% schema %}
{
    "name": "Hero",
    "tag": "section",
    "class": "section-hero p-0 trigger-observer",
    "settings": [
        {
            "type": "header",
            "content": "Content"
        },
        {
            "type": "text",
            "id": "eyebrow",
            "label": "Eyebrow"
        },
        {
            "type": "text",
            "id": "heading",
            "label": "Heading"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        },
        {
            "type": "image_picker",
            "id": "sideimage",
            "label": "Side Image"
        },
        {
            "type": "text",
            "id": "section_video_bg",
            "info": "Video ID",
            "label": "Background Video"
        },
        {
            "type": "url",
            "id": "buttonlink",
            "label": "Button Link"
        },
        {
            "type": "text",
            "id": "buttontext",
            "label": "Button Text"
        },
         
        {
            "type": "image_picker",
            "id": "section_bgimg",
            "label": "Background Image"
        }
    ],
    "blocks": [
        {
            "type": "custom_code",
            "name": "Custom code",
            "settings": [
                {
                    "type": "liquid",
                    "id": "custom_code",
                    "label": "HTML, CSS, JS, or Liquid code",
                    "info": "Use style and script tags when adding CSS or JavaScript."
                }
            ]
        }
    ],
    "presets": [
        {
            "name": "Hero"
        }
    ],
    "disabled_on": {
        "groups": ["header","footer"]
    }
}
{% endschema %}
