<div class="background-image-container bg-light-gradient trigger-observer">
  {% if section.settings.section_video_bg != blank %}

    <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ section.settings.section_video_bg }}">

      {% comment %}      
                        <script src="https://fast.wistia.com/embed/medias/{{ section.settings.section_video_bg }}.jsonp" async></script></script><div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;"><div class="wistia_responsive_wrapper" style="height:100%;left:0;position:absolute;top:0;width:100%;"><div class="wistia_embed wistia_async_{{ section.settings.section_video_bg }} seo=true videoFoam=true" style="height:100%;position:relative;width:100%"><div class="wistia_swatch" style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;"><img src="https://fast.wistia.com/embed/medias/{{ section.settings.section_video_bg }}/swatch" style="filter:blur(5px);height:100%;object-fit:contain;width:100%;" alt="" aria-hidden="true" onload="this.parentNode.style.opacity=1;"   loading="lazy"/></div></div></div></div> {% endcomment %}

    </div>
  {% elsif section.settings.banner_image != blank and section.settings.section_video_bg == blank %}
    {{ section.settings.banner_image | image_url: width: 1920 | image_tag }}
  {% else %}
    <!-- Image does not exist, layout is not 'copy', display the placeholder -->

    {{ 'image' | placeholder_svg_tag }}

  {% endif %}

</div>

<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="container">


    <div class="row justify-content-center mb-5">
      <div class="col-10 col-md-8 col-lg-8 text-center">

        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading }}</h2>

        {% else %}
          <div class="spacer"></div>
        {% endif %}

        {{ section.settings.content }}
      </div>
    </div>


    <div class="row justify-content-between mb-5 feature-row">
      <div class="col-12 col-md-4">
        <ul class="features left">
          {% for block in section.blocks %}
            {% if block.type == "feature_col_1" %}

              {% if block.settings.title %}
                <li class="mb-4 feature-item ">
                  {% if block.settings.title %}
                    <p class="title">{{ block.settings.title }}</p>
                  {% endif %}

                  {% if block.settings.icon != blank and block.settings.title != blank %}
                    <div class="divider"></div>
                  {% endif %}

                  {% if block.settings.icon %}
                    <div class="feature-icon">
                      {{ block.settings.icon | image_url: width: 120 | image_tag: class: 'icon feature' }}
                    </div>
                  {% endif %}
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}

          {% for block in section.blocks %}
            {% if block.type == "feature_col_2" %}

              {% if block.settings.title %}
                <li class="mb-4 feature-item d-md-none">
                  <p class="title">{{ block.settings.title }}</p>
                  <div class="divider"></div>
                  {% if block.settings.icon %}
                    <div class="feature-icon">
                      {{ block.settings.icon | image_url: width: 120 | image_tag: class: 'icon feature' }}
                    </div>
                  {% endif %}
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="col-12 col-md-4 d-none d-md-block">
        <ul class="features right">
          {% for block in section.blocks %}
            {% if block.type == "feature_col_2" %}

              {% if block.settings.title %}
                <li class="mb-4 feature-item ">
                  <p class="title">{{ block.settings.title }}</p>
                  <div class="divider"></div>
                  {% if block.settings.icon %}
                    <div class="feature-icon">
                      {{ block.settings.icon | image_url: width: 120 | image_tag: class: 'icon feature' }}
                    </div>
                  {% endif %}
                </li>
              {% endif %}
            {% endif %}
          {% endfor %}
        </ul>
      </div>

    </div>
    {% if section.settings.buttonlink %}
      <div class="row justify-content-center">
        <div class="col-12 col-md-8">
          {% render 'button' %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Features",
    "tag": "section",
    "class": "section-features",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      },
      {
        "type": "text",
        "id": "section_video_bg",
        "label": "Background Video",
        "info": "Video ID"
      }, {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Background Image"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }

    ],
    "blocks": [
      {
        "type": "feature_col_1",
        "name": "Features Left",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title Left",
            "info": "This Feature will appear on the left"
          }, {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }
        ]
      }, {
        "type": "feature_col_2",
        "name": "Features Right",
        "settings": [
          {
            "type": "text",
            "id": "title",
            "label": "Title Right",
            "info": "This Feature will appear on the right"
          }, {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Features"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}