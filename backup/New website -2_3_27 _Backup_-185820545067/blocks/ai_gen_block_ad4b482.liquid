{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ugc-reels-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_desktop }}px 20px;
  }

  .ugc-reels-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_max_width }}px;
    margin: 0 auto;
  }

  .ugc-reels-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.desktop_columns }}, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ugc-card-{{ ai_gen_id }} {
    background: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    box-shadow: {{ block.settings.card_shadow }};
    overflow: hidden;
    transition: all 0.4s ease;
    display: flex;
    flex-direction: column;
    position: relative;
    cursor: pointer;
  }

  .ugc-card-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_card_background }} !important;
    transform: translateY({{ block.settings.active_card_lift }}px);
    box-shadow: {{ block.settings.active_card_shadow }};
  }

  .ugc-card-video-heading-{{ ai_gen_id }} {
    padding: {{ block.settings.video_heading_padding }}px;
    font-size: {{ block.settings.video_heading_size }}px;
    font-weight: {{ block.settings.video_heading_weight }};
    color: {{ block.settings.video_heading_color }};
    margin: 0;
    line-height: 1.3;
    text-align: {{ block.settings.video_heading_align }};
    transition: all 0.3s ease;
  }

  .ugc-card-{{ ai_gen_id }}.active .ugc-card-video-heading-{{ ai_gen_id }} {
    font-size: calc({{ block.settings.video_heading_size }}px * 1.1);
  }

  .ugc-influencer-info-top-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.influencer_gap }}px;
    padding: 0 {{ block.settings.video_heading_padding }}px {{ block.settings.video_heading_padding }}px;
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transition: all 0.4s ease;
  }

  .ugc-card-{{ ai_gen_id }}.active .ugc-influencer-info-top-{{ ai_gen_id }} {
    opacity: 1;
    max-height: 50px;
  }

  .ugc-influencer-name-top-{{ ai_gen_id }} {
    font-size: {{ block.settings.influencer_font_size }}px;
    color: {{ block.settings.influencer_color }};
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: {{ block.settings.influencer_gap }}px;
  }

  .ugc-influencer-name-top-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ugc-instagram-icon-top-{{ ai_gen_id }} {
    width: {{ block.settings.instagram_icon_size }}px;
    height: {{ block.settings.instagram_icon_size }}px;
    flex-shrink: 0;
    fill: {{ block.settings.instagram_icon_color }};
  }

  .ugc-card-video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: {{ block.settings.video_aspect_ratio }};
    overflow: hidden;
    background: {{ block.settings.video_background }};
  }

  .ugc-wistia-embed-{{ ai_gen_id }} {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
  }

  .ugc-wistia-embed-{{ ai_gen_id }} iframe,
  .ugc-wistia-embed-{{ ai_gen_id }} video,
  .ugc-wistia-embed-{{ ai_gen_id }} .wistia_embed,
  .ugc-wistia-embed-{{ ai_gen_id }} div {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
  }

  .ugc-card-content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_content_padding }}px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.content_gap }}px;
  }

  .ugc-card-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin: 0;
    color: {{ block.settings.heading_color }};
    text-align: {{ block.settings.heading_align }};
  }

  .ugc-product-info-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.product_gap }}px;
    margin-top: auto;
  }

  .ugc-product-image-{{ ai_gen_id }} {
    width: {{ block.settings.product_image_size }}px;
    height: {{ block.settings.product_image_size }}px;
    flex-shrink: 0;
    border-radius: {{ block.settings.product_image_radius }}px;
    overflow: hidden;
    background: {{ block.settings.product_image_bg }};
  }

  .ugc-product-image-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ugc-product-link-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_font_size }}px;
    color: {{ block.settings.product_color }};
    text-decoration: none;
    font-weight: {{ block.settings.product_font_weight }};
    flex-grow: 1;
  }

  .ugc-product-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
    color: {{ block.settings.product_hover_color }};
  }

  .ugc-pagination-{{ ai_gen_id }} {
    display: none;
    justify-content: center;
    gap: {{ block.settings.pagination_gap }}px;
    margin-top: {{ block.settings.pagination_margin_top }}px;
  }

  .ugc-dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: {{ block.settings.dot_radius }}px;
    background: {{ block.settings.dot_color }};
    transition: background 0.3s ease, width 0.3s ease;
    cursor: pointer;
  }

  .ugc-dot-{{ ai_gen_id }}.active {
    background: {{ block.settings.dot_active_color }};
    width: {{ block.settings.dot_active_width }}px;
    border-radius: {{ block.settings.dot_active_radius }}px;
  }

  {{ block.settings.custom_css }}

  @media screen and (max-width: 768px) {
    .ugc-reels-{{ ai_gen_id }} {
      padding: {{ block.settings.section_padding_mobile }}px 0;
    }

    .ugc-reels-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.mobile_card_gap }}px;
      padding: 0 20px;
      scrollbar-width: none;
    }

    .ugc-reels-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ugc-card-{{ ai_gen_id }} {
      flex: 0 0 {{ block.settings.mobile_card_width }}%;
      scroll-snap-align: center;
    }

    .ugc-pagination-{{ ai_gen_id }} {
      display: flex;
    }

    .ugc-card-video-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.video_heading_size_mobile }}px;
      padding: {{ block.settings.video_heading_padding_mobile }}px;
    }

    .ugc-card-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
    }

    .ugc-card-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_content_padding_mobile }}px;
    }
  }
{% endstyle %}

<div class="ugc-reels-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ugc-reels-container-{{ ai_gen_id }}">
    <ugc-reels-{{ ai_gen_id }} class="ugc-reels-grid-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        {% liquid
          assign video_heading_key = 'card_' | append: i | append: '_video_heading'
          assign heading_key = 'card_' | append: i | append: '_heading'
          assign influencer_key = 'card_' | append: i | append: '_influencer'
          assign instagram_key = 'card_' | append: i | append: '_instagram_url'
          assign wistia_key = 'card_' | append: i | append: '_wistia_embed'
          assign product_key = 'card_' | append: i | append: '_product_name'
          assign product_url_key = 'card_' | append: i | append: '_product_url'
          assign product_img_key = 'card_' | append: i | append: '_product_image'

          assign video_heading = block.settings[video_heading_key]
          assign heading = block.settings[heading_key]
          assign influencer = block.settings[influencer_key]
          assign instagram_url = block.settings[instagram_key]
          assign wistia_embed = block.settings[wistia_key]
          assign product_name = block.settings[product_key]
          assign product_url = block.settings[product_url_key]
          assign product_image = block.settings[product_img_key]
        %}

        <div class="ugc-card-{{ ai_gen_id }}" data-card-index="{{ i }}">
          {% if video_heading != blank %}
            <h3 class="ugc-card-video-heading-{{ ai_gen_id }}">{{ video_heading }}</h3>
          {% endif %}

          {% if influencer != blank %}
            <div class="ugc-influencer-info-top-{{ ai_gen_id }}">
              {% if instagram_url != blank %}
                <a href="{{ instagram_url }}" class="ugc-influencer-name-top-{{ ai_gen_id }}" target="_blank" rel="noopener" onclick="event.stopPropagation();">
                  <svg class="ugc-instagram-icon-top-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
                  </svg>
                  {{ influencer }}
                </a>
              {% else %}
                <span class="ugc-influencer-name-top-{{ ai_gen_id }}">
                  <svg class="ugc-instagram-icon-top-{{ ai_gen_id }}" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                    <path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/>
                  </svg>
                  {{ influencer }}
                </span>
              {% endif %}
            </div>
          {% endif %}

          <div class="ugc-card-video-wrapper-{{ ai_gen_id }}">
            {% if wistia_embed != blank %}
              <div class="ugc-wistia-embed-{{ ai_gen_id }}" data-wistia-container data-card="{{ i }}">
                {{ wistia_embed }}
              </div>
            {% else %}
              <div style="width: 100%; height: 100%; background: #f4f4f4; display: flex; align-items: center; justify-content: center; color: #999; font-size: 14px;">
                Add Wistia embed code
              </div>
            {% endif %}
          </div>

          <div class="ugc-card-content-{{ ai_gen_id }}">
            {% if heading != blank %}
              <h3 class="ugc-card-heading-{{ ai_gen_id }}">{{ heading }}</h3>
            {% endif %}

            {% if product_name != blank or product_image != blank %}
              <div class="ugc-product-info-{{ ai_gen_id }}">
                {% if product_image != blank %}
                  <div class="ugc-product-image-{{ ai_gen_id }}">
                    <img 
                      src="{{ product_image | image_url: width: 100 }}" 
                      alt="{{ product_name | escape }}"
                      loading="lazy"
                      width="50"
                      height="50"
                    >
                  </div>
                {% endif %}
                {% if product_name != blank %}
                  {% if product_url != blank %}
                    <a href="{{ product_url }}" class="ugc-product-link-{{ ai_gen_id }}" onclick="event.stopPropagation();">{{ product_name }} →</a>
                  {% else %}
                    <span class="ugc-product-link-{{ ai_gen_id }}">{{ product_name }}</span>
                  {% endif %}
                {% endif %}
              </div>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    </ugc-reels-{{ ai_gen_id }}>

    <div class="ugc-pagination-{{ ai_gen_id }}">
      {% for i in (1..5) %}
        <div class="ugc-dot-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" data-dot-index="{{ i }}"></div>
      {% endfor %}
    </div>
  </div>
</div>

<script src="https://fast.wistia.com/assets/external/E-v1.js" async></script>

<script>
  (function() {
    class UGCReels{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.cards = [];
        this.videos = {};
        this.currentActiveCard = null;
        this.isMobile = window.innerWidth <= 768;
        this.scrollTimeout = null;
        this.wistiaCheckAttempts = 0;
        this.maxWistiaAttempts = 100;
      }

      connectedCallback() {
        this.init();
      }

      init() {
        this.cards = Array.from(this.querySelectorAll('.ugc-card-{{ ai_gen_id }}'));
        this.waitForWistia();
        this.setupScrollPagination();
        this.setupResizeListener();
        this.setupCardClicks();
      }

      setupCardClicks() {
        this.cards.forEach((card, index) => {
          card.addEventListener('click', (e) => {
            if (!e.target.closest('a')) {
              this.togglePlay(index);
            }
          });
        });
      }

      waitForWistia() {
        if (typeof window.Wistia !== 'undefined') {
          this.initializeWistiaVideos();
        } else if (this.wistiaCheckAttempts < this.maxWistiaAttempts) {
          this.wistiaCheckAttempts++;
          setTimeout(() => this.waitForWistia(), 100);
        } else {
          console.warn('Wistia API did not load');
        }
      }

      initializeWistiaVideos() {
        setTimeout(() => {
          this.cards.forEach((card, index) => {
            const wistiaContainer = card.querySelector('[data-wistia-container]');
            if (!wistiaContainer) return;

            const videoId = this.extractWistiaId(wistiaContainer);
            if (!videoId) {
              console.warn('Could not find Wistia video ID for card', index + 1);
              return;
            }

            console.log('Found Wistia video ID:', videoId, 'for card', index + 1);

            window._wq = window._wq || [];
            window._wq.push({
              id: videoId,
              onReady: (video) => {
                console.log('Wistia video ready:', videoId);
                this.videos[index] = {
                  player: video,
                  card: card,
                  index: index,
                  videoId: videoId
                };

                video.bind('play', () => {
                  console.log('Video playing:', videoId);
                  this.setActiveCard(index);
                });

                video.bind('pause', () => {
                  console.log('Video paused:', videoId);
                });

                video.bind('end', () => {
                  console.log('Video ended:', videoId);
                  if (this.isMobile) {
                    this.playNextVideo(index);
                  }
                });
              }
            });
          });
        }, 1000);
      }

      extractWistiaId(container) {
        const iframe = container.querySelector('iframe');
        if (iframe && iframe.src) {
          const match = iframe.src.match(/wistia\.com\/embed\/iframe\/([a-zA-Z0-9]+)/);
          if (match) return match[1];
        }

        const asyncDiv = container.querySelector('[class*="wistia_async_"]');
        if (asyncDiv) {
          const classList = Array.from(asyncDiv.classList);
          for (const className of classList) {
            if (className.startsWith('wistia_async_')) {
              return className.replace('wistia_async_', '');
            }
          }
        }

        const idDiv = container.querySelector('[id*="wistia_"]');
        if (idDiv && idDiv.id) {
          const match = idDiv.id.match(/wistia_([a-zA-Z0-9]+)/);
          if (match) return match[1];
        }

        return null;
      }

      togglePlay(index) {
        const videoData = this.videos[index];
        if (!videoData || !videoData.player) {
          console.warn('Video not ready for card', index + 1);
          return;
        }

        const isPlaying = videoData.player.state() === 'playing';

        this.pauseAllVideos();

        if (!isPlaying) {
          videoData.player.play();
          videoData.card.classList.add('active');
        } else {
          videoData.player.pause();
          videoData.card.classList.remove('active');
        }
      }

      pauseAllVideos() {
        Object.values(this.videos).forEach((videoData) => {
          if (videoData && videoData.player) {
            videoData.player.pause();
            videoData.card.classList.remove('active');
          }
        });
      }

      setActiveCard(index) {
        this.cards.forEach((card) => card.classList.remove('active'));
        if (this.videos[index]) {
          this.videos[index].card.classList.add('active');
          this.currentActiveCard = index;
        }
      }

      playNextVideo(currentIndex) {
        const nextIndex = currentIndex + 1;
        if (nextIndex < this.cards.length && this.videos[nextIndex]) {
          this.scrollToCard(nextIndex);
          setTimeout(() => {
            this.togglePlay(nextIndex);
          }, 300);
        }
      }

      scrollToCard(index) {
        if (!this.isMobile) return;

        const card = this.cards[index];
        if (card) {
          card.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }
      }

      setupScrollPagination() {
        if (!this.isMobile) return;

        const dots = document.querySelectorAll('.ugc-dot-{{ ai_gen_id }}');

        this.addEventListener('scroll', () => {
          clearTimeout(this.scrollTimeout);
          this.scrollTimeout = setTimeout(() => {
            this.updateActiveDot();
          }, 100);
        });

        dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.scrollToCard(index);
          });
        });
      }

      updateActiveDot() {
        if (!this.isMobile) return;

        const scrollLeft = this.scrollLeft;
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.mobile_card_gap }};
        const activeIndex = Math.round(scrollLeft / (cardWidth + gap));

        const dots = document.querySelectorAll('.ugc-dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === activeIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      setupResizeListener() {
        window.addEventListener('resize', () => {
          this.isMobile = window.innerWidth <= 768;
        });
      }
    }

    customElements.define('ugc-reels-{{ ai_gen_id }}', UGCReels{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "UGC influencer stories",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "container_max_width",
      "min": 1000,
      "max": 2000,
      "step": 100,
      "unit": "px",
      "label": "Container width",
      "default": 1400
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "min": 3,
      "max": 6,
      "step": 1,
      "label": "Desktop columns",
      "default": 5
    },
    {
      "type": "range",
      "id": "card_gap",
      "min": 10,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card gap",
      "default": 20
    },
    {
      "type": "range",
      "id": "section_padding_desktop",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Section padding desktop",
      "default": 40
    },
    {
      "type": "range",
      "id": "section_padding_mobile",
      "min": 10,
      "max": 60,
      "step": 5,
      "unit": "px",
      "label": "Section padding mobile",
      "default": 30
    },
