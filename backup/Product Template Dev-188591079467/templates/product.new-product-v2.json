    "copy_image_yifhAn": {
      "type": "copy-image",
      "settings": {
        "style": "bg-white",
        "layout": "copy",
        "vertical_align": "align-items-center",
        "heading": "Why risk harmful toxins when you can enjoy fresh, clean, completely safe water?",
        "content": "<p><br/>Your tap water could be contaminated without you even knowing. Chemicals can enter from nearby farms, industrial operations, or stormwater. Harmful substances such as lead, copper, and nitrate may leach into your drinking water at the source or even after treatment in the distribution system.<br/><br/>Why take the risk when you don’t know what’s lurking in your water? Phoenix Gravity Water Filters remove 99.9% of contaminants instantly, providing fresh, great-tasting water and peace of mind for your whole family.</p>",
        "video_id": "",
        "large_image": "img-standard",
