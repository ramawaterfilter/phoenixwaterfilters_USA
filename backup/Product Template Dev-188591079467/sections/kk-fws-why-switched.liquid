{%- liquid
  assign feature_blocks = section.blocks | where: 'type', 'feature'
  assign media_image = section.settings.image
-%}

<section
  id="kk-fws-why-switched"
  class="kk-fws-why-switched"
  style="
    --kk-fws-why-switched-background: {{ section.settings.background_color }};
    --kk-fws-why-switched-heading: {{ section.settings.heading_color }};
    --kk-fws-why-switched-text: {{ section.settings.text_color }};
    --kk-fws-why-switched-card-background: {{ section.settings.card_background_color }};
    --kk-fws-why-switched-line: {{ section.settings.line_color }};
  "
>
  <div class="kk-fws-why-switched__container">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="kk-fws-why-switched__intro">
        {%- if section.settings.heading != blank -%}
          <h2 class="kk-fws-why-switched__heading">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <p class="kk-fws-why-switched__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if feature_blocks.size > 0 or section.settings.show_media -%}
      <div class="kk-fws-why-switched__grid">
        {%- for block in feature_blocks -%}
          <div class="kk-fws-why-switched__card" {{ block.shopify_attributes }}>
            {%- render 'kk-fws-why-switched-icon', block: block -%}

            {%- if block.settings.heading != blank -%}
              <h3 class="kk-fws-why-switched__card-heading">{{ block.settings.heading }}</h3>
            {%- endif -%}

            {%- if block.settings.text != blank -%}
              <p class="kk-fws-why-switched__card-text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}

        {%- if section.settings.show_media -%}
          <div class="kk-fws-why-switched__media">
            {%- if media_image != blank -%}
              {{
                media_image
                | image_url: width: 1600
                | image_tag:
                  class: 'kk-fws-why-switched__image',
                  loading: 'lazy',
                  widths: '375, 750, 1100, 1600',
                  sizes: '(max-width: 749px) calc(100vw - 4rem), (max-width: 989px) calc(100vw - 3.2rem), 759px'
              }}
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'kk-fws-why-switched__image kk-fws-why-switched__image--placeholder' }}
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .kk-fws-why-switched {
    background: var(--kk-fws-why-switched-background, #ffffff);
    padding: 10rem 0;
  }

  .kk-fws-why-switched__container {
    width: min(100% - 3.2rem, 114rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.75rem;
  }

  .kk-fws-why-switched__intro {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2rem;
    width: 100%;
    text-align: center;
  }

  .kk-fws-why-switched__heading {
    margin: 0;
    max-width: 76.662rem;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 5.2rem;
    line-height: 1.1;
    color: var(--kk-fws-why-switched-heading, #153a5b);
    text-transform: none;
  }

  .kk-fws-why-switched__subheading {
    margin: 0;
    max-width: 51.588rem;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 2.2rem;
    line-height: 1.4;
    color: var(--kk-fws-why-switched-text, #26303a);
  }

  /* 1px grid gap over a line-coloured background reproduces Figma's
     collapsed 1px card borders without doubling them up. */
  .kk-fws-why-switched__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    grid-auto-rows: minmax(45.148rem, auto);
    gap: 1px;
    width: 100%;
    background: var(--kk-fws-why-switched-line, #e7e7e7);
    border: 1px solid var(--kk-fws-why-switched-line, #e7e7e7);
  }

  .kk-fws-why-switched__card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding: 6rem 3.4rem;
    background: var(--kk-fws-why-switched-card-background, #ffffff);
  }

  .kk-fws-why-switched__icon-box {
    display: block;
    flex-shrink: 0;
    width: 7.5rem;
    height: 7.5rem;
  }

  .kk-fws-why-switched__icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Figma clips these two glyphs inside their 75px frame; reproduce the inset
     so they don't render oversized next to the other icons. */
  .kk-fws-why-switched__icon--certified {
    padding: 6.26% 9.275%;
    box-sizing: border-box;
  }

  .kk-fws-why-switched__icon--setup {
    padding: 3.605% 5.825%;
    box-sizing: border-box;
  }

  .kk-fws-why-switched__card-heading {
    margin: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 2.4787rem;
    line-height: 1.2;
    color: var(--kk-fws-why-switched-heading, #153a5b);
    text-transform: none;
  }

  .kk-fws-why-switched__card-text {
    margin: 0;
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 2.2rem;
    line-height: 1.4;
    color: var(--kk-fws-why-switched-text, #26303a);
  }

  .kk-fws-why-switched__media {
    position: relative;
    grid-column: span 2;
    overflow: hidden;
    background: var(--kk-fws-why-switched-line, #e7e7e7);
  }

  .kk-fws-why-switched__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @media (max-width: 989px) {
    .kk-fws-why-switched {
      padding: 6rem 0;
    }

    .kk-fws-why-switched__heading {
      font-size: 4rem;
    }

    .kk-fws-why-switched__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(38rem, auto);
    }

    .kk-fws-why-switched__card {
      padding: 4rem 2.8rem;
    }

    .kk-fws-why-switched__card-heading {
      font-size: 2.2rem;
    }

    .kk-fws-why-switched__card-text {
      font-size: 1.8rem;
    }
  }

  @media (max-width: 749px) {
    .kk-fws-why-switched {
      padding: 4rem 0;
    }

    .kk-fws-why-switched__container {
      width: min(100% - 4rem, 54rem);
      gap: 1.8rem;
    }

    .kk-fws-why-switched__intro {
      gap: 1.8rem;
    }

    .kk-fws-why-switched__heading {
      font-size: 2.8rem;
      max-width: none;
    }

    .kk-fws-why-switched__subheading {
      font-size: 1.6rem;
      max-width: none;
    }

    .kk-fws-why-switched__grid {
      grid-template-columns: 1fr;
      grid-auto-rows: auto;
    }

    .kk-fws-why-switched__card {
      gap: 1.6rem;
      padding: 2rem;
    }

    .kk-fws-why-switched__icon-box {
      width: 5.2rem;
      height: 5.2rem;
    }

    .kk-fws-why-switched__card-heading {
      font-size: 2rem;
    }

    .kk-fws-why-switched__card-text {
      font-size: 1.6rem;
    }

    .kk-fws-why-switched__media {
      grid-column: span 1;
      min-height: 32rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KK FWS Why Switched",
  "tag": "div",
  "class": "section-kk-fws-why-switched",
  "max_blocks": 6,
  "settings": [
