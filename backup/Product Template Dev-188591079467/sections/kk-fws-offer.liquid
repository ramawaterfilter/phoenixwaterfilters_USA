  /* PHASE 1: hide the Appstle subscription widget inside this section.
     The app injects its own "Purchase Options" UI (Subscribe / One Time Purchase, with
     its own prices and a 55%-off badge) into every product form. Those numbers are the
     evergreen PDP's, not the campaign's, and they contradict item 5's offer two sections
     above. Its inputs are also disabled by the script at the foot of this file, so leaving
     the widget visible would show controls that look selectable but do nothing.
     Hiding is NOT sufficient alone - a hidden input still submits, which is why the script
     disables them too. Both are required.
     Scoped to this section; the widget still works everywhere else on the site.
     PHASE 2: remove this and the script when the real plan picker lands. */
  .kk-fws-offer [class*='appstle'],
  .kk-fws-offer [id*='appstle'] {
    display: none !important;
  }

  .kk-fws-offer__layout {
    display: grid;
    /* minmax(0, 1fr) not 1fr: a grid item defaults to min-width:auto, so the Swiper
       track (a flex row of square slides) can force its column far wider than 1fr.
       Without this the media column measured 27018px wide in the browser. */
    /* 569px gallery + 541px panel + 30.9px gutter = the 1140px campaign container. */
    grid-template-columns: minmax(0, 569fr) minmax(0, 541fr);
    column-gap: 3.1rem;
    align-items: start;
    margin-top: 4rem;
  }

  .kk-fws-offer__media {
    position: relative;
    min-width: 0;
    max-width: 100%;
  }

  .kk-fws-offer__slider {
    position: relative;
    overflow: hidden;
    width: 100%;
    max-width: 100%;
  }

  .kk-fws-offer__slide {
    display: flex;
    max-width: 100%;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    background: var(--kk-fws-offer-nav-background, #f5f3f1);
  }

  .kk-fws-offer__slide-image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
  }

  /* Square nav buttons flush to the image edges, vertically centred — Figma 7420:1080/1084.
     Deliberately NOT `.swiper-button-prev/next`: those classes pull in Swiper's own 27x44
     styling and its ::after icon font. The theme wires navigation off `.swiper-prev` /
     `.swiper-next`, which is all Swiper actually needs. */
  /* Scoped with the section root for specificity, not for readability: Swiper sets the
     `disabled` attribute on <button> nav elements at the ends of a non-looping slider, and
     the theme's `button[disabled]` rule in main.css (0,1,1) would otherwise beat a single
     class and strip the fill and border off whichever arrow is currently at the end. */
  .kk-fws-offer .kk-fws-offer__nav {
    position: absolute;
    top: 50%;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.687rem;
    height: 4.687rem;
    margin: 0;
    padding: 0;
    transform: translateY(-50%);
    border: 0;
    border-radius: 0;
    background: var(--kk-fws-offer-nav-background, #f5f3f1);
    cursor: pointer;
    transition: opacity 0.2s ease;
  }

  .kk-fws-offer .kk-fws-offer__nav--prev {
    left: 0;
  }

  .kk-fws-offer .kk-fws-offer__nav--next {
    right: 0;
  }

  .kk-fws-offer__nav-icon {
    display: block;
    width: 2.0603rem;
    height: 1.2232rem;
  }

  .kk-fws-offer .kk-fws-offer__nav--prev .kk-fws-offer__nav-icon {
    transform: rotate(-90deg);
  }

  .kk-fws-offer .kk-fws-offer__nav--next .kk-fws-offer__nav-icon {
    transform: rotate(90deg);
  }

  .kk-fws-offer .kk-fws-offer__nav.swiper-button-disabled {
    opacity: 0.35;
    cursor: default;
  }

  .kk-fws-offer .kk-fws-offer__nav.swiper-button-lock {
