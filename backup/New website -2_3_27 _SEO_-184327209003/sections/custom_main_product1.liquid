            <!-- Loop through each option and display its name and values -->

            {% for option in product.options_with_values %}
                <div class="step step-{{ option.name | downcase | replace: ' ', '-' }} mb-3" style="justify-content: space-between; width: 100%;">
                    <div style="display: flex; align-items: center; gap: 1rem;"> 
