                      <div class="step-title">Select {{ option.name }}
                        - 
                        {% for value in option.values %}
                          <span class="{{ value }}" style="display:{% if forloop.first %}unset;{% else %} none;{% endif %}">
                            {% if option.name == 'Size' %}
                              {% capture size_for_key %}size_for_{{ forloop.index }}{% endcapture %}
                              {{ settings[size_for_key] }}
                            {% else %}
                              {{ value }}
                            {% endif %}
                          </span>
                        {% endfor %}
                      </div>
                    </div>
                    {% if option.name contains 'Size' %}
                  <!--    <span class="Size-Guide">Size Guide</span> -->
                    {% endif %}
                </div>

                <div id="{{ option.name | downcase | replace: ' ', '-' }}-options" class="info-field-container d-flex flex-row radio-selectors mb-3">
                   
                  {% for value in option.values %}


                    {% assign variant_match = false %}
                    {% for variant in product.variants %}
                      {% for option_index in (0..product.options.size) %}
                        {% assign variant_option_name = product.options[option_index] %}
                        {% assign variant_option_value = variant.options[option_index] %}
                        {% if variant_option_name == option.name and variant_option_value == value %}
                          {% assign variant_match = variant %}
                        {% endif %}
                      {% endfor %}
                    {% endfor %}

                    
                    <div class="radio-option d-flex">
                   
                    <input type="radio" data-variant-id="{{ variant_match.id }}" id="{{ option.name | downcase | append: '-' | append: value }}" name="{{ option.name | downcase }}" value="{{ value }}"  {% if forloop.first %}checked{% endif %} aria-labelledby="label">
                     
                  {% if option.name == 'Filter Type' %}
