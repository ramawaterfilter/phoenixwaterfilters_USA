{% assign current_variant = product.selected_or_first_available_variant %}

<div class="container">
  <div class="row justify-content-center">
    <div class="col-11 col-lg-6">
      <div class="position-relative {% if product.images.size <= 0 %}h-100{% endif %}">
        {% render 'product-badge'
          , product: product %}

        {% if product.images.size > 1 %}

          <div
            class="swiper-container swiper"
            data-slidestoshow="1"
            id="product-slider">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% assign thisVariantID = "" %}

                {% for variant in product.variants %}
                  {% if variant.featured_image == media.src %}
                    {% assign thisVariantID = variant.id %}
                  {% endif %}
                {% endfor %}

                {% if media.media_type == "image" %}
                  <div
                    class="swiper-slide"
                    data-variant-id="{{ thisVariantID }}"
                    data-slide-index="{{ forloop.index }}">
                    <a
                      data-fancybox="gallery"
                      href="{{ media | image_url: width: 2560 }}"
                      class="product-image d-block">
                      {{ media | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% elsif media.media_type == "external_video" %}
                  <div
                    class="swiper-slide"
                    data-variant-id="{{ thisVariantID }}"
                    data-slide-index="{{ forloop.index }}">
                    <a
                      data-fancybox="gallery"
                      href="{{ media | external_video_url: autoplay: 'true' }}"
                      class="product-image product-image--video d-block">
                      {{ media.preview_image | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                  {% elsif media.media_type == "video" %}
                    <div class="swiper-slide">
                      <a
                        data-fancybox="gallery" aria-label="Play product video"
                        href="{{ media.sources[1].url }}"
                        class="product-image--video">
                        {{ media.preview_image | image_url: width: 1200 | image_tag }}
                      </a>
                    </div>
                  {% endif %}                  
              {% endfor %}                
            </div>
          </div>
          {% comment %} <div class="swiper-container swiper control {% if product.media.size == 3 %} control-three {% endif %} {% if product.media.size == 5 %}control-five {% else %}product-thumbnails{% endif %}" id="product-slider-nav">
            <div class="swiper-wrapper {% if product.media.size == 3 or product.media.size == 5 %}wide{% endif %}">
              {% for media in product.media %}
                {% if media.media_type == "external_video" %}
