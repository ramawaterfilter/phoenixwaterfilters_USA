  window.variantDescriptions = {
    {% for variant in product.variants %}
      "{{ variant.id }}": {{ variant.metafields.custom.product_main_description.value | json }}{% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  document.addEventListener("change", function(e) {

  if (!e.target.closest("form[action*='/cart/add']")) return;

  const form = e.target.closest("form[action*='/cart/add']");
  const variantInput = form.querySelector("[name='id']");
  const container = document.getElementById("variant-main-description");

  if (!variantInput || !container) return;

  const variantId = variantInput.value;
  const description = window.variantDescriptions[variantId];

  container.innerHTML = description ? description : "";

});
</script>




      
