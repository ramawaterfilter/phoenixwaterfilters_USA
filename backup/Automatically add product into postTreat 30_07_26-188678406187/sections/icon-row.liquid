{% unless template_suffix == 'page.article' %}

{% assign container ='icon-padding'%}
{% assign row ='row justify-content-center mb-5 text-center'%}
{% assign columns ='col-12 col-sm-10 col-md-9 col-lg-9 col-xl-8 text-center'%}
{% assign bg ='style="opacity: 0.5;
background: linear-gradient(180deg, #F5F3F1 0%, rgba(245, 243, 241, 0.00) 100%);"' %}
  
 
{% unless section.settings.styles == 'standard' or section.settings.styles == 'medium' %}
  {% assign container ='extended'%}
  {% assign row ='row justify-content-start mb-5'%}
  {% assign columns ='col-12 '%}
 {% assign bg ='' %} 
{% endunless %}

{% if section.settings.styles == 'medium' %}
 {% assign container ='medium-padding'%}
{% endif %}

  <div class="background-image-container {{ section.settings.style }}" {% if section.settings.style == "none" %} {{ bg }} {% endif %} >
    {% if section.settings.section_bgimg %}
      {% if section.settings.section_bgimg != blank %}
        {{ section.settings.section_bgimg | image_url: width: 1920 | image_tag: class: '' }}
      {% endif %}
    {% endif %}
  </div>


  <div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
    <div class="container {{ container }}">

      {% if section.settings.heading or section.settings.paragraph %}
        <div class="{{ row }}">
          <div class="{{ columns }} ">
            {% if section.settings.heading %}
              <h2>{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.paragraph %}
              {{ section.settings.paragraph | tag: class: 'mb-5' }}
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="{{ row }}">
        <div class="col-12 cards {{ section.settings.styles }}">
          
          {% unless section.settings.styles == 'standard' or section.settings.styles == 'medium' %}
          <div
            class="swiper-container icon-row"
            data-slidesperview="3"
            data-spacebetween="30">
            <div class="swiper-wrapper">
{% endunless %}

              {% for block in section.blocks %}
                <div class="card swiper-slide">
                  <div class="card__icon">
                    {% if block.settings.icon %}
                      {{ block.settings.icon | image_url: width: 1920 | image_tag: class: 'img-fluid', loading: "lazy" }}
                    {% else: %}
                      {{ forloop.index }}
                    {% endif; %}
                  </div>
                  <div class="card__content">
                    {% if block.settings.heading %}
                      <p class="card__content__description">
                        {{ block.settings.heading }}
                      </p>
                    {% endif %}

                  </div>
                </div>
              {% endfor %}
             {% unless section.settings.styles == 'standard' or section.settings.styles == 'medium' %}
             </div>
          </div>
          <div class="swiper-pagination mt-lg-3"></div>
          {% endunless %}
        </div>
      </div>

      {% if section.settings.buttonlink %}
        <div class="row justify-content-center text-center ">
          <div class="col-12 col-md-10 col-lg-8">
            {% render 'button'
              , class: 'mx-auto' %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endunless %}
{% schema %}
  {
    "name": "Icon Row",
    "tag": "section",
    "class": "section-icon-row p-0",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Background",
        "default": "none",
        "options": [
          {
            "label": "Gradient",
            "value": "none"
          },
          {
            "label": "White",
            "value": "bg-white"
          }, {
            "label": "Light",
            "value": "bg-light"
          }
        ]
      },
      {
        "type": "select",
        "id": "styles",
        "label": "Style",
        "default": "compact",
        "options": [
          {
            "label": "compact",
            "value": "compact"
          }, {
            "label": "medium",
            "value": "medium"
          },
          {
            "label": "standard",
            "value": "standard"

          }
        ]
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Headline"
      },
      {
        "type": "richtext",
        "id": "paragraph",
        "label": "Paragraph"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Icon Blocks",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          }, {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Icon Row Section"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}