</style>
<script>
(() => {
  if (!window.PhoenixNiceProduct) {
    class NiceProduct {
      constructor(root) {
        this.root = root;
        this.data = JSON.parse(root.querySelector('[data-product-json]').textContent);
        this.variants = this.data.variants;
        this.form = root.querySelector('form');
        this.select = root.querySelector('[data-variant-select]');
        this.qty = root.querySelector('[data-quantity]');
        this.button = root.querySelector('[data-add]');
        this.buttonText = root.querySelector('[data-add-text]');
        this.status = root.querySelector('[data-status]');
        this.description = root.querySelector('[data-description]');
        this.slider = root.querySelector('.custom-nice-product__slider');
        this.slides = root.querySelector('[data-live-slides]');
        this.thumbs = root.querySelector('[data-live-thumbs]');
        this.sectionId = root.dataset.sectionId;
        this.galleryKey = root.dataset.galleryKey;
        this.galleryCache = new Map([
          [
            this.galleryKey,
            {
              slides: this.slides.innerHTML,
              thumbs: this.thumbs.innerHTML,
            },
          ],
        ]);
        this.galleryRequest = 0;
        this.galleryController = null;
        this.baseMin = Number(root.dataset.min) || 1;
        this.baseMax = Number(root.dataset.max) || Number.MAX_SAFE_INTEGER;
        this.variant = this.find(this.select.value) || this.variants[0];
        this.busy = false;
        this.lastFocus = null;

        this.change = this.change.bind(this);
        this.click = this.click.bind(this);
        this.submit = this.submit.bind(this);
        this.keydown = this.keydown.bind(this);

        root.addEventListener('change', this.change);
        root.addEventListener('click', this.click);
        this.form.addEventListener('submit', this.submit, true);
        document.addEventListener('keydown', this.keydown);

        this.apply(this.variant, false, false);
        setTimeout(() => this.setupGallery(this.variant.media), 0);
      }

      destroy() {
        this.root.removeEventListener('change', this.change);
        this.root.removeEventListener('click', this.click);
        this.form.removeEventListener('submit', this.submit, true);
        document.removeEventListener('keydown', this.keydown);
        this.galleryController?.abort();
        this.pauseVideos();
        if (this.slider?.swiper) this.slider.swiper.destroy(true, true);
      }

      find(id) {
        return this.variants.find(v => String(v.id) === String(id));
      }

      selections() {
        return [...this.root.querySelectorAll('[data-option-index]')].map(
          g => g.querySelector('[data-option]:checked')?.value || ''
        );
      }

      change(e) {
        const input = e.target.closest('[data-option]');
        if (!input) return;
        const group = input.closest('[data-option-index]');
        const changed = Number(group.dataset.optionIndex);
        const selected = this.selections();

        let variant = this.variants.find(v =>
          v.options.every((x, i) => x === selected[i])
        );

        if (!variant || (!variant.available && changed < selected.length - 1)) {
          const matches = this.variants.filter(v =>
            v.options.slice(0, changed + 1).every((x, i) => x === selected[i])
          );
          variant = matches.find(v => v.available) || variant || matches[0];
        }

        if (!variant) return;
        this.sync(variant);
        this.apply(variant, true, true);
      }

      sync(variant) {
        this.root.querySelectorAll('[data-option-index]').forEach(g => {
          const i = Number(g.dataset.optionIndex);
          const input = [...g.querySelectorAll('[data-option]')].find(
            x => x.value === variant.options[i]
          );
          if (input) input.checked = true;
        });
      }

      availability(variant) {
        const selected = variant.options;
        this.root.querySelectorAll('[data-option-index]').forEach(g => {
          const i = Number(g.dataset.optionIndex);
          const label = g.querySelector('[data-selected]');
          if (label) label.textContent = selected[i];

          g.querySelectorAll('[data-option]').forEach(input => {
            const available = this.variants.some(
              v =>
                v.available &&
                v.options.slice(0, i).every((x, j) => x === selected[j]) &&
                v.options[i] === input.value
            );
            const card = input.closest('.custom-nice-product__card');
            input.disabled = !available && !input.checked;
            card.classList.toggle('is-unavailable', !available);
            card.setAttribute('aria-disabled', String(!available));
          });
        });
      }

      apply(variant, url, emit) {
        this.variant = variant;
        this.select.value = String(variant.id);
        this.availability(variant);

        const price = this.root.querySelector('[data-price]');
        const compare = this.root.querySelector('[data-compare]');
        const show = Number(variant.compare) > Number(variant.price);

        if (price) price.textContent = this.money(variant.price);
        if (compare) {
          compare.hidden = !show;
          compare.querySelector('s').textContent = show
            ? this.money(variant.compare)
            : '';
        }

        if (this.description) {
          this.description.innerHTML =
            variant.descriptionOverride || this.data.defaultDescription || '';
        }

        const preorder =
          variant.available &&
          variant.management &&
          Number(variant.inventory) <= 0 &&
          variant.policy === 'continue';
        const stock = this.root.querySelector('[data-stock]');

        if (stock) {
          stock.textContent = variant.available
            ? preorder
              ? this.data.strings.preorder
              : this.data.strings.stock
            : this.data.strings.sold;
          stock.classList.toggle('is-in', variant.available);
          stock.classList.toggle('is-out', !variant.available);
        }

        if (this.button) this.button.disabled = !variant.available;
        if (this.buttonText) {
          this.buttonText.textContent = variant.available
            ? preorder
              ? this.data.strings.preorder
              : this.data.strings.add
            : this.data.strings.sold;
        }

        const rules = this.rules(variant);
        this.qty.value = rules.min;
        this.qty.min = rules.min;
        this.qty.step = rules.increment;
        if (Number.isFinite(rules.max)) {
          this.qty.max = rules.max;
        } else {
          this.qty.removeAttribute('max');
        }

        if (this.status) {
          this.status.textContent = '';
        }

        this.updateGallery(variant);

        if (url) {
          const next = new URL(location.href);
          next.searchParams.set('variant', variant.id);
          history.replaceState({ path: next.href }, '', next.href);
        }

        if (emit) {
          this.select.dispatchEvent(new Event('change', { bubbles: true }));
          document.dispatchEvent(
            new CustomEvent('variant:change', { detail: { variant } })
          );
          document.dispatchEvent(
            new CustomEvent('product:variant-change', { detail: { variant } })
          );
        }
      }

      rules(v) {
        const nativeMin = Number(v.min) || 1;
        const increment = Number(v.increment) || 1;
        let min = Math.max(this.baseMin, nativeMin);
        min =
          nativeMin +
          Math.ceil(Math.max(0, min - nativeMin) / increment) * increment;
        let max = this.baseMax;
        if (Number(v.max) > 0) max = Math.min(max, Number(v.max));
        if (max >= 999999) max = Infinity;
        return { min, max, increment };
      }

      money(cents) {
        return window.Shopify?.formatMoney
          ? window.Shopify.formatMoney(cents, this.data.moneyFormat)
          : new Intl.NumberFormat(undefined, {
              style: 'currency',
              currency: this.data.currency,
            }).format(Number(cents || 0) / 100);
      }

      async updateGallery(v) {
        const key = v.customGallery ? String(v.id) : 'product';
        const request = ++this.galleryRequest;
        this.galleryController?.abort();
        this.galleryController = null;
        this.slider.classList.remove('is-fading');

        if (key === this.galleryKey) {
          this.slider.removeAttribute('aria-busy');
          const index = v.customGallery ? 0 : this.mediaIndex(v.media);
          if (this.slider.swiper) {
            this.slider.swiper.slideToLoop(index, 0);
          }
          this.activeThumb(index);
          return;
        }

        this.slider.setAttribute('aria-busy', 'true');

        try {
          let gallery = this.galleryCache.get(key);

          if (!gallery) {
            const controller = new AbortController();
            this.galleryController = controller;
            gallery = await this.fetchGallery(v.id, key, controller.signal);
            this.galleryCache.set(key, gallery);
          }

          if (request !== this.galleryRequest || !this.root.isConnected) return;

          this.pauseVideos();
          this.slider.classList.add('is-fading');
          await new Promise(resolve => setTimeout(resolve, 260));

          if (request !== this.galleryRequest || !this.root.isConnected) return;
          if (this.slider.swiper) this.slider.swiper.destroy(true, true);

          this.slides.innerHTML = gallery.slides;
          this.thumbs.innerHTML = gallery.thumbs;
          this.galleryKey = key;
          this.root.dataset.galleryKey = key;

          setTimeout(() => {
            if (request !== this.galleryRequest || !this.root.isConnected) return;
            this.setupGallery(v.media);
            this.slider.classList.remove('is-fading');
            this.slider.removeAttribute('aria-busy');
          }, 0);
        } catch (error) {
          if (error.name !== 'AbortError') {
            console.error('Unable to load the selected variant gallery.', error);
          }
          if (request === this.galleryRequest) {
            this.slider.classList.remove('is-fading');
            this.slider.removeAttribute('aria-busy');
          }
        } finally {
          if (request === this.galleryRequest) this.galleryController = null;
        }
      }

      async fetchGallery(variantId, expectedKey, signal) {
        const url = new URL(location.href);
        url.searchParams.set('variant', variantId);
        url.searchParams.set('section_id', this.sectionId);

        const response = await fetch(url, {
          signal,
          headers: { 'X-Requested-With': 'XMLHttpRequest' },
        });
        if (!response.ok) {
          throw new Error(`Gallery request failed with status ${response.status}`);
        }

        const document = new DOMParser().parseFromString(
          await response.text(),
          'text/html'
        );
        const rendered = document.getElementById(
          `CustomNiceProduct-${this.sectionId}`
        );
        const slides = rendered?.querySelector('[data-live-slides]');
        const thumbs = rendered?.querySelector('[data-live-thumbs]');

        if (
          !rendered ||
          rendered.dataset.galleryKey !== expectedKey ||
          !slides ||
          !thumbs
        ) {
          throw new Error('The selected variant gallery was missing from the response.');
        }

        return {
          slides: slides.innerHTML,
          thumbs: thumbs.innerHTML,
        };
      }

      mediaIndex(id) {
        if (!id) return 0;
        const i = [...this.slides.querySelectorAll('.swiper-slide')].findIndex(
          x => String(x.dataset.mediaId) === String(id)
        );
        return i < 0 ? 0 : i;
      }

      setupGallery(media) {
        if (!this.slider?.isConnected) return;
        if (!this.slider.swiper && typeof window.initSlider === 'function') {
          window.initSlider(this.slider, 0, 'section, aside');
        }

        const swiper = this.slider.swiper;
        const index =
          this.galleryKey === 'product' ? this.mediaIndex(media) : 0;

        if (swiper) {
          swiper.autoplay?.stop();
          swiper.slideToLoop(index, 0);
          swiper.on('slideChange', () => {
            this.activeThumb(swiper.realIndex ?? swiper.activeIndex ?? 0);
            this.pauseVideos(true);
          });
        }

        this.activeThumb(index);
        this.pauseVideos(true);
      }

      pauseVideos(inactiveOnly = false) {
        this.slides.querySelectorAll('video').forEach(video => {
          if (!inactiveOnly || !video.closest('.swiper-slide-active')) {
            video.pause();
          }
        });
      }

      activeThumb(index) {
        let activeThumb = null;

        this.thumbs.querySelectorAll('[data-thumb]').forEach(x => {
          const active = Number(x.dataset.thumb) === Number(index);
          x.classList.toggle('is-active', active);
          x.setAttribute('aria-current', String(active));
          if (active) activeThumb = x;
        });

        if (!activeThumb) return;

        const containerRect = this.thumbs.getBoundingClientRect();
        const thumbRect = activeThumb.getBoundingClientRect();
        const left =
          this.thumbs.scrollLeft +
          thumbRect.left -
          containerRect.left -
          (containerRect.width - thumbRect.width) / 2;
        const reduceMotion = window.matchMedia?.(
          '(prefers-reduced-motion: reduce)'
        ).matches;

        this.thumbs.scrollTo({
          left: Math.max(0, left),
          behavior: reduceMotion ? 'auto' : 'smooth',
        });
      }

      click(e) {
        const thumb = e.target.closest('[data-thumb]');
        if (thumb && this.root.contains(thumb)) {
          this.slider.swiper?.slideToLoop(Number(thumb.dataset.thumb));
          return;
        }

        const open = e.target.closest('[data-guide-open]');
        if (open) {
          this.openGuide(open);
          return;
        }

        if (e.target.closest('[data-guide-close]')) {
          this.closeGuide();
          return;
        }

        const modal = e.target.closest('[data-guide]');
        if (modal && e.target === modal) this.closeGuide();
      }

      standValue() {
        return (
          this.root.querySelector('[data-kind=stand] [data-option]:checked')
            ?.value || ''
        );
      }

      standType() {
        const s = this.standValue().toLowerCase();
        if (
          s.includes('no stand') ||
          s.includes('pas de support') ||
          s.includes('without')
        )
          return 'none';
        if (
          s.includes('wood') ||
          s.includes('teak') ||
          s.includes('teck')
        )
          return 'wood';
        return 'stainless';
      }

      guide() {
        return {
          none: {
            title: 'Without Stand',
            image: {% if section.settings.guide_no_stand != blank %}{{ section.settings.guide_no_stand | image_url: width: 1600 | json }}{% else %}'https://cdn.shopify.com/s/files/1/2644/2852/files/WITHOUT_STAND.jpg?v=1778562490'{% endif %},
          },
          stainless: {
            title: 'Stainless Steel Stand',
            image: {% if section.settings.guide_stainless != blank %}{{ section.settings.guide_stainless | image_url: width: 1600 | json }}{% else %}'https://cdn.shopify.com/s/files/1/2644/2852/files/12-Available_Sizes_SS_Stand.jpg?v=1778652902'{% endif %},
          },
          wood: {
            title: 'Teak Wood Stand',
            image: {% if section.settings.guide_wood != blank %}{{ section.settings.guide_wood | image_url: width: 1600 | json }}{% else %}'https://cdn.shopify.com/s/files/1/2644/2852/files/11-Available_Sizes_TStand.jpg?v=1778652902'{% endif %},
          },
        };
      }

      openGuide(trigger) {
        const modal = this.root.querySelector('[data-guide]');
        const data = this.guide()[this.standType()];
        modal.querySelector('[data-guide-title]').textContent = data.title;
        const image = modal.querySelector('[data-guide-image]');
        image.src = data.image;
        image.alt = data.title + ' size guide';
        this.lastFocus = trigger;
        modal.hidden = false;
        document.body.style.overflow = 'hidden';
        modal.querySelector('[data-guide-close]').focus();
      }

      closeGuide() {
        const modal = this.root.querySelector('[data-guide]');
        if (modal.hidden) return;
        modal.hidden = true;
        document.body.style.overflow = '';
        this.lastFocus?.focus();
      }

      keydown(e) {
        const modal = this.root.querySelector('[data-guide]');
        if (!modal || modal.hidden) return;

        if (e.key === 'Escape') {
          e.preventDefault();
          this.closeGuide();
          return;
        }

        if (e.key !== 'Tab') return;

        const nodes = [
          ...modal.querySelectorAll(
            'button:not([disabled]),a[href],[tabindex]:not([tabindex="-1"])'
          ),
        ].filter(x => x.offsetParent !== null);

        if (!nodes.length) return;

        const first = nodes[0];
        const last = nodes.at(-1);

        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }

      async submit(e) {
        if (!this.button) return;

        const formData = new FormData(this.form);
        const sellingPlan = String(formData.get('selling_plan') || '').trim();
        const addSubscriptionItem =
          sellingPlan &&
          this.variant.options.includes(
            '2 Carbon Filters + POSTreat Fluoride and Arsenic Reduction Filter Elements'
          );

        if (!window.enable_ajax_cart && !addSubscriptionItem) return;
        e.preventDefault();
        e.stopImmediatePropagation();
        if (this.busy || !this.variant.available) return;

        this.busy = true;
        this.button.disabled = true;
        this.button.setAttribute('aria-busy', 'true');
        if (this.buttonText) this.buttonText.textContent = this.data.strings.adding;
        if (this.status) {
          this.status.textContent = '';
        }

        try {
          const params = new URLSearchParams(formData);
          let addUrl = `${window.Shopify.routes.root}cart/add.js?${params}&sections=cart-live`;
          const options = {
            method: 'POST',
            headers: { Accept: 'application/json' },
          };

          if (addSubscriptionItem) {
            const mainItem = {
              id: Number(formData.get('id')),
              quantity: Number(formData.get('quantity')) || 1,
              selling_plan: Number(sellingPlan),
            };
            const properties = {};

            for (const [name, value] of formData) {
              const match = name.match(/^properties\[(.+)\]$/);
              if (match && value !== '') properties[match[1]] = value;
            }
            if (Object.keys(properties).length) mainItem.properties = properties;

            addUrl = `${window.Shopify.routes.root}cart/add.js`;
            options.headers['Content-Type'] = 'application/json';
            options.body = JSON.stringify({
              items: [
                mainItem,
                {
                  id: 44525415694379,
                  quantity: 1,
                  selling_plan: 9802219563,
                },
              ],
              sections: 'cart-live',
              sections_url: window.location.pathname,
            });
          }

          const response = await fetch(addUrl, options);
          const result = await response.json();
          if (!response.ok) {
            throw new Error(
              result.description || result.message || this.data.strings.error
            );
          }

          if (result.sections && result.sections['cart-live']) {
            try {
              const match = result.sections['cart-live'].match(/<!--CARTJSON-->([\s\S]*?)<!--\/CARTJSON-->/);
              if (match) result._cart = JSON.parse(match[1]);
            } catch (_) {}
          }

          const qty = Number(this.qty.value) || 1;
          const addedQty = qty + (addSubscriptionItem ? 1 : 0);

          if (!window.enable_ajax_cart) {
            window.location.assign(`${window.Shopify.routes.root}cart`);
            return;
          }

          document.querySelectorAll('.cart-icon span, [data-cartcount]').forEach(el => {
            el.textContent = (Number(el.textContent) || 0) + addedQty;
          });

          if (this.buttonText) {
            this.buttonText.textContent = this.data.strings.added;
            setTimeout(() => {
              if (this.button.isConnected && this.buttonText) {
                this.buttonText.textContent = this.variant.available
                  ? this.data.strings.add
                  : this.data.strings.sold;
              }
            }, 1800);
          }

          if (typeof window._updateCartTotals === 'function') {
            window._updateCartTotals(result, true, result._cart || null);
          }
        } catch (error) {
          if (this.status) {
            this.status.textContent =
              error.message || this.data.strings.error;
          }
          if (this.buttonText) {
            this.buttonText.textContent = this.variant.available
              ? this.data.strings.add
              : this.data.strings.sold;
          }
        } finally {
          this.busy = false;
          this.button.disabled = !this.variant.available;
          this.button.removeAttribute('aria-busy');
        }
      }
    }

    const controllers = new Map();

    window.PhoenixNiceProduct = {
      mount(root) {
        if (!root || controllers.has(root.id)) return;
        controllers.set(root.id, new NiceProduct(root));
      },
      unmount(root) {
        const controller = root && controllers.get(root.id);
        controller?.destroy();
        if (root) controllers.delete(root.id);
      },
    };

    document.addEventListener('shopify:section:load', e =>
      window.PhoenixNiceProduct.mount(
        e.target.querySelector('.custom-nice-product')
      )
    );
    document.addEventListener('shopify:section:unload', e =>
      window.PhoenixNiceProduct.unmount(
        e.target.querySelector('.custom-nice-product')
      )
    );
  }

  const mount = () =>
    window.PhoenixNiceProduct.mount(
      document.getElementById('CustomNiceProduct-{{ section.id }}')
    );

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', mount, { once: true });
  } else {
    mount();
  }
})();
</script>
