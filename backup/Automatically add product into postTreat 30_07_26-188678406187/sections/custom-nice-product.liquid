{% comment %}Variant-aware product section. Uses custom.variant_images with product.media fallback.{% endcomment %}
{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign variant_images = current_variant.metafields.custom.variant_images.value
  assign custom_gallery = false
  if variant_images != blank and variant_images.size > 0
    assign custom_gallery = true
  endif
  assign active_media_id = current_variant.featured_media.id | default: product.featured_media.id
  assign form_id = 'CustomNiceProductForm-' | append: section.id
  assign gallery_image_sizes = '(min-width: 1200px) 540px, (min-width: 992px) 450px, (min-width: 768px) 630px, (min-width: 576px) 465px, calc(91.6667vw - 30px)'
  assign min_buy = 1
  assign max_buy = 999999
  if settings.enable_minmax_buys
    assign min_buy = product.metafields.custom.min_buy_quantity.value | default: settings.min_buy_qty | default: 1
    assign max_buy = product.metafields.custom.max_buy_quantity.value | default: settings.max_buy_qty | default: 999999
  endif
  assign badge_text = section.settings.badge_text | default: product.metafields.custom.product_badge_text.value
%}
<div
  id="CustomNiceProduct-{{ section.id }}"
  class="custom-nice-product"
  data-section-id="{{ section.id }}"
  data-gallery-key="{% if custom_gallery %}{{ current_variant.id }}{% else %}product{% endif %}"
  data-min="{{ min_buy }}"
  data-max="{{ max_buy }}"
>
  <div class="container">
    <div class="row justify-content-center custom-nice-product__layout">
      <div class="col-11 col-lg-6">
        <div class="custom-nice-product__media">
          {% if section.settings.show_badge and badge_text != blank %}
            <div class="product-badge">{{ badge_text | escape }}</div>
          {% endif %}
          <div
            id="CustomNiceProductSlider-{{ section.id }}"
            class="swiper-container swiper custom-nice-product__slider"
            data-slidestoshow="1"
            aria-label="{{ product.title | escape }} media gallery"
          >
            <div class="swiper-wrapper" data-live-slides>
              {% if custom_gallery %}
                {% for media in variant_images %}
                  {% liquid
                    assign media_alt = media.alt | default: product.title
                    assign loading = 'lazy'
                    assign priority = 'low'
                    if forloop.first
                      assign loading = 'eager'
                      assign priority = 'high'
                    endif
                  %}
                  <div
                    class="swiper-slide"
                    data-media-id="variant-{{ current_variant.id }}-{{ forloop.index0 }}"
                    data-media-type="{{ media.media_type }}"
                  >
                    {% case media.media_type %}
                      {% when 'video' %}
                        <div class="custom-nice-product__video swiper-no-swiping">
                          {{- media | video_tag: image_size: '1946x', controls: true, preload: 'metadata' -}}
                        </div>
                      {% else %}
                        <a
                          class="product-image d-block"
                          href="{{ media | image_url: width: 2560 }}"
                          data-fancybox="nice-gallery-{{ section.id }}"
                        >
                          {{-
                            media
                            | image_url: width: 1946
                            | image_tag:
                              widths: '352, 600, 832, 1200, 1600, 1946',
                              sizes: gallery_image_sizes,
                              loading: loading,
                              fetchpriority: priority,
                              alt: media_alt
                          -}}
                        </a>
                    {% endcase %}
                  </div>
                {% endfor %}
              {% else %}
                {% assign rendered_media = 0 %}
                {% for media in product.media %}
                  {% if section.settings.hide_variant_media and media.attached_to_variant? %}{% continue %}{% endif %}
                  {% assign rendered_media = rendered_media | plus: 1 -%}
                  {%- assign media_alt = media.alt | default: product.title -%}
                  {%- assign loading = 'lazy' -%}
                  {%- assign priority = 'low' -%}
                  {%- if media.id == active_media_id or active_media_id == blank and rendered_media == 1 -%}
                    {%- assign loading = 'eager' -%}
                    {%- assign priority = 'high' -%}
                  {%- endif %}
                  <div class="swiper-slide" data-media-id="{{ media.id }}" data-media-type="{{ media.media_type }}">
                    {% case media.media_type %}
                      {% when 'image' -%}
                        <a
                          class="product-image d-block"
                          href="{{ media | image_url: width: 2560 }}"
                          data-fancybox="nice-gallery-{{ section.id }}"
                        >
                          {{-
                            media
                            | image_url: width: 1946
                            | image_tag:
                              widths: '352, 600, 832, 1200, 1600, 1946',
                              sizes: gallery_image_sizes,
                              loading: loading,
                              fetchpriority: priority,
                              alt: media_alt
                          -}}
                        </a>
                      {% when 'external_video' -%}
                        <a
                          class="product-image product-image--video d-block"
                          href="{{ media | external_video_url: autoplay: 'true' }}"
                          data-fancybox="nice-gallery-{{ section.id }}"
                          aria-label="Play {{ media_alt | escape }}"
                        >
                          {{-
                            media.preview_image
                            | image_url: width: 1200
                            | image_tag: loading: loading, alt: media_alt
                          -}}
                        </a>
                      {% when 'video' -%}
                        <a
                          class="product-image product-image--video d-block"
                          href="{{ media.sources.first.url }}"
                          data-fancybox="nice-gallery-{{ section.id }}"
                          aria-label="Play {{ media_alt | escape }}"
                        >
                          {{-
                            media.preview_image
                            | image_url: width: 1200
                            | image_tag: loading: loading, alt: media_alt
                          -}}
                        </a>
                      {% when 'model' %}
                        <div class="custom-nice-product__model">
                          {{ media | media_tag: image_size: '1200x', toggleable: true }}
                        </div>
                    {% endcase %}
                  </div>
                {% endfor %}
                {% if rendered_media == 0 %}
                  <div class="swiper-slide">
                    <div class="custom-nice-product__placeholder">
                      {% if product.featured_image -%}
                        {{-
                          product.featured_image
                          | image_url: width: 1200
                          | image_tag: loading: 'eager', fetchpriority: 'high', alt: product.title
                        -}}
                      {%- else -%}
                        {{- 'product-1' | placeholder_svg_tag -}}
                      {%- endif %}
                    </div>
                  </div>
                {% endif %}
              {% endif %}
            </div>
            <div class="swiper-nav">
              <button class="swiper-button-prev swiper-prev" type="button" aria-label="Previous product media"></button
              ><button class="swiper-button-next swiper-next" type="button" aria-label="Next product media"></button>
            </div>
          </div>
          <div class="swiper-pagination custom-nice-product__pagination"></div>
          <div class="custom-nice-product__thumbs" data-live-thumbs aria-label="Product media thumbnails">
            {% if custom_gallery %}
              {% for media in variant_images -%}
                {%- assign media_alt = media.alt | default: product.title -%}
                <button
                  type="button"
                  class="custom-nice-product__thumb{% if forloop.first %} is-active{% endif %}"
                  data-thumb="{{ forloop.index0 }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-label="Show {{ media.media_type | default: 'media' }} {{ forloop.index }}"
                >
                  {{-
                    media.preview_image
                    | image_url: width: 220
                    | image_tag: loading: 'lazy', alt: media_alt
                  -}}
                  {%- if media.media_type == 'video' -%}
                    <span class="custom-nice-product__play" aria-hidden="true">&#9654;</span>
                  {%- endif -%}
                </button>
              {%- endfor %}
            {% else %}
              {% assign thumb_index = 0 -%}
              {%- for media in product.media -%}
                {%- if section.settings.hide_variant_media and media.attached_to_variant? %}{% continue %}{% endif -%}
                <button
                  type="button"
                  class="custom-nice-product__thumb"
                  data-thumb="{{ thumb_index }}"
                  data-media-id="{{ media.id }}"
                  aria-current="false"
                  aria-label="Show {{ media.media_type | replace: '_', ' ' }} {{ thumb_index | plus: 1 }}"
                >
                  {{
                    media.preview_image
                    | image_url: width: 220
                    | image_tag: loading: 'lazy', alt: media.alt
                    | default: product.title
                  -}}
                  {%- unless media.media_type == 'image' -%}
                    <span class="custom-nice-product__play">▶</span>
                  {%- endunless %}
                </button>
                {%- assign thumb_index = thumb_index | plus: 1 -%}
              {%- endfor %}
            {% endif %}
          </div>
        </div>
      </div>
      <div class="col-11 col-lg-6 mt-3 mt-lg-0 custom-nice-product__info">
        {% form 'product',
          product,
          id: form_id,
          class: 'custom-nice-product__form disable-ajax',
          novalidate: 'novalidate'
        %}
          <select
            name="id"
            data-variant-select
            class="custom-nice-product__select"
            aria-label="{{ 'products.product.product_variants' | t }}"
          >
            {% for variant in product.variants %}
              <option
                value="{{ variant.id }}"
                {% if variant.id == current_variant.id %}
                  selected
                {% endif %}
              >
                {{ variant.title }}
              </option>
            {% endfor %}
          </select>
          <input type="hidden" name="quantity" value="{{ min_buy }}" data-quantity>
          {% render 'variant-cart-image-property', product: product, current_variant: current_variant %}
          {% for block in section.blocks %}
            {% case block.type %}
              {% when '@app' %}
                <div class="custom-nice-product__block custom-nice-product__block--app" {{ block.shopify_attributes }}>
                  {% render block %}
                </div>

              {% when 'title' %}
                <div
                  class="custom-nice-product__block custom-nice-product__block--title"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.show_vendor %}
                    <p class="custom-nice-product__vendor">{{ product.vendor | escape }}</p>
                  {% endif %}
                  <h1>{{ product.title }}</h1>
                </div>

              {% when 'rating' %}
                {% if product.metafields.judgeme.badge != blank %}
                  <div
                    class="custom-nice-product__block custom-nice-product__block--rating jdgm-widget jdgm-preview-badge"
                    data-id="{{ product.id }}"
                    data-auto-install="false"
                    {{ block.shopify_attributes }}
                  >
                    {{ product.metafields.judgeme.badge }}
                  </div>
                {% elsif request.design_mode %}
                  <div
                    class="custom-nice-product__block custom-nice-product__editor-placeholder"
                    {{ block.shopify_attributes }}
                  >
                    Judge.me rating appears here when available.
                  </div>
                {% endif %}

              {% when 'description' %}
                <div
                  class="custom-nice-product__block product-description custom-nice-product__description"
                  {{ block.shopify_attributes }}
                >
                  <div data-description>
                    {% if current_variant.metafields.custom.variant_level_description != blank -%}
                      {{- current_variant.metafields.custom.variant_level_description | metafield_tag -}}
                    {%- else -%}
                      {{- product.description -}}
                    {%- endif %}
                  </div>
                  {% if block.settings.show_usps and product.metafields.custom.product_usps.value.size > 0 %}
                    <ul>
                      {% for usp in product.metafields.custom.product_usps.value %}
                        <li>{{ usp }}</li>
                      {% endfor %}
                    </ul>
                  {% endif %}
                </div>

              {% when 'variant_picker' %}
                <div
                  class="custom-nice-product__block custom-nice-product__variants"
                  {{ block.shopify_attributes }}
                >
                  {% if product.variants.size > 1 %}
                    {% for option in product.options_with_values %}
                      {% liquid
                        assign option_index = option.position | minus: 1
                        assign selected_value = current_variant.options[option_index]
                        assign option_name = option.name | downcase
                        assign option_kind = 'generic'
                        if option_name contains 'size' or option_name contains 'taille'
                          assign option_kind = 'size'
                        elsif option_name contains 'filter' or option_name contains 'cartouches' or option_name contains 'cartuchos'
                          assign option_kind = 'filter'
                        elsif option_name contains 'stand' or option_name contains 'support' or option_name contains 'soporte'
                          assign option_kind = 'stand'
                        endif
                      %}
                      <fieldset
                        class="custom-nice-product__group"
                        data-option-index="{{ option_index }}"
                        data-kind="{{ option_kind }}"
                      >
                        <legend class="custom-nice-product__legend">
                          {% if block.settings.show_step_numbers %}
                            <span class="step-number">{{ option.position }}</span>
                          {% endif %}
                          <span>
                            <b>
                              {%- if block.settings.label_prefix != blank -%}
                                {{ block.settings.label_prefix | escape }}
                              {% endif -%}
                              {{ option.name | escape -}}
                            </b>
                            - <span data-selected>{{ selected_value }}</span>
                          </span>
                          {%- if option_kind == 'stand' and block.settings.show_size_guide -%}
                            <button
                              type="button"
                              data-guide-open
                              aria-haspopup="dialog"
                              aria-controls="NiceGuide-{{ section.id }}"
                            >
                              {{ block.settings.size_guide_label | escape }}
                            </button>
                          {%- endif %}
                        </legend>
                        <div class="custom-nice-product__values">
                          {% for value in option.values %}
                            {% liquid
                              assign option_image = blank
                              assign primary = value
                              assign secondary = blank
                              if option_kind == 'filter'
                                assign key = 'filter_image_' | append: forloop.index
                                assign option_image = settings[key]
                              elsif option_kind == 'size'
                                assign key = 'size_icon_' | append: forloop.index
                                assign primary_key = 'size_for_' | append: forloop.index
                                assign secondary_key = 'size_content_' | append: forloop.index
                                assign option_image = settings[key]
                                assign primary = settings[primary_key] | default: value
                                assign secondary = settings[secondary_key]
                              elsif option_kind == 'stand'
                                assign key = 'stand_' | append: forloop.index
                                assign option_image = settings[key]
                              endif
                              assign input_id = 'NiceOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index
                            %}
                            <label class="custom-nice-product__card" for="{{ input_id }}"
                              ><input
                                id="{{ input_id }}"
                                type="radio"
                                name="options[{{ option.name | escape }}]"
                                value="{{ value | escape }}"
                                data-option
                                {% if selected_value == value %}
                                  checked
                                {% endif %}

                              ><span class="custom-nice-product__card-content">
                                {%- if option_image != blank -%}
                                  <span class="custom-nice-product__option-image">
                                    {{-
                                      option_image
                                      | image_url: width: 180
                                      | image_tag: loading: 'lazy', widths: '80, 120, 180', alt: value
                                    -}}
                                  </span>
                                {%- endif -%}
                                <span class="custom-nice-product__option-copy"
                                  ><b>{{ primary }}</b>
                                  {%- if secondary != blank -%}
                                    <span>{{ secondary }}</span>
                                  {%- elsif primary != value -%}
                                    <span>{{ value }}</span>
                                  {%- endif -%}</span
                                ><small>{{ 'products.product.sold_out' | t }}</small></span
                              ></label
                            >
                          {% endfor %}
                        </div>
                      </fieldset>
                    {% endfor %}
                  {% elsif request.design_mode %}
                    <p class="custom-nice-product__editor-placeholder">Variant options appear here when available.</p>
                  {% endif %}
                </div>

              {% when 'price' %}
                <div
                  class="custom-nice-product__block custom-nice-product__block--price"
                  {{ block.shopify_attributes }}
                >
                  <div class="custom-nice-product__price-stock">
                    <div class="priceline">
                      <span data-price>{{ current_variant.price | money }}</span
                      ><span
                        data-compare
                        {% unless current_variant.compare_at_price > current_variant.price %}
                          hidden
                        {% endunless %}
                        ><s>{{ current_variant.compare_at_price | money }}</s></span
                      >
                    </div>
                    {% if block.settings.show_stock %}
                      <p
                        class="custom-nice-product__stock {% if current_variant.available %}is-in{% else %}is-out{% endif %}"
                        data-stock
                        role="status"
                      >
                        {% if current_variant.available -%}
                          {{- 'products.product.inventory_in_stock' | t -}}
                        {%- else -%}
                          {{- 'products.product.sold_out' | t -}}
                        {%- endif %}
                      </p>
                    {% endif %}
                  </div>
                  {% if block.settings.show_tax and cart.taxes_included %}
                    <p class="custom-nice-product__tax">{{ 'products.product.include_taxes' | t }}</p>
                  {% endif %}
                </div>

              {% when 'buy_buttons' %}
                <div
                  class="custom-nice-product__block custom-nice-product__block--buy-buttons"
                  {{ block.shopify_attributes }}
                >
                  <button
                    class="btn btn-large btn-secondary btn-product custom-nice-product__add"
                    type="submit"
                    name="add"
                    data-add
                    {% unless current_variant.available %}
                      disabled
                    {% endunless %}
                  >
                    <span data-add-text>
                      {%- if current_variant.available -%}
                        {{- 'products.product.add_to_cart' | t -}}
                      {%- else -%}
                        {{- 'products.product.sold_out' | t -}}
                      {%- endif -%}
                    </span>
                  </button>
                  {% if block.settings.show_dynamic_checkout %}
                    {{ form | payment_button }}
                  {% endif %}
                  <p class="custom-nice-product__status" data-status role="status" aria-live="polite"></p>
                </div>

              {% when 'shipping' %}
                {% if block.settings.text != blank %}
                  <div
                    class="custom-nice-product__block shipping-estimate-time custom-nice-product__shipping custom-nice-product__shipping--{{ block.settings.alignment }}"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {% endif %}

              {% when 'payment_icons' %}
                <div
                  class="custom-nice-product__block custom-nice-product__block--payments"
                  {{ block.shopify_attributes }}
                >
                  {% if block.settings.heading != blank %}
                    <p class="custom-nice-product__payments-heading">{{ block.settings.heading | escape }}</p>
                  {% endif %}
                  <div
                    class="payment-icons custom-nice-product__payments"
                    aria-label="{{ block.settings.accessibility_label | escape }}"
                  >
                    {% for type in shop.enabled_payment_types limit: block.settings.icon_limit %}
                      {{ type | payment_type_svg_tag }}
                    {% else %}
                      {% if request.design_mode %}
                        <span class="custom-nice-product__editor-placeholder"
                          >Enabled payment methods appear here.</span
                        >
                      {% endif %}
                    {% endfor %}
                  </div>
                </div>

              {% when 'trust_badges' %}
                <div
                  class="custom-nice-product__block below-atc-icons custom-nice-product__trust"
                  style="--trust-columns: {{ block.settings.columns_desktop }}; --trust-mobile-columns: {{ block.settings.columns_mobile }};"
                  {{ block.shopify_attributes }}
                >
                  {% for index in (1..6) %}
                    {% liquid
                      assign icon_key = 'badge_' | append: index | append: '_icon'
                      assign text_key = 'badge_' | append: index | append: '_text'
                      assign link_key = 'badge_' | append: index | append: '_link'
                      assign icon = block.settings[icon_key]
                      assign text = block.settings[text_key]
                      assign link = block.settings[link_key]
                      assign fallback_asset = blank
                      assign fallback_url = blank
                      case index
                        when 1
                          assign fallback_asset = 'icon-truck.png'
                        when 2
                          assign fallback_asset = 'icon-tag.png'
                        when 3
                          assign fallback_asset = 'icon-award.png'
                        when 4
                          assign fallback_asset = 'icon-headset.png'
                        when 5
                          assign fallback_url = 'https://cdn.shopify.com/s/files/1/2644/2852/files/nsf-01.png?v=1751276325'
                        when 6
                          assign fallback_url = 'https://cdn.shopify.com/s/files/1/2644/2852/files/product_warehouse.png'
                      endcase
                    %}
                    {% if text != blank %}
                      <div class="custom-nice-product__trust-item">
                        {% if link != blank %}
                          <a href="{{ link }}">
                        {% endif %}
                        {% if icon != blank %}
                          {{ icon | image_url: width: 96 | image_tag: loading: 'lazy', widths: '48, 96', alt: '' }}
                        {% elsif fallback_asset != blank %}
                          <img src="{{ fallback_asset | asset_url }}" alt="" width="48" height="48" loading="lazy">
                        {% elsif fallback_url != blank %}
                          <img src="{{ fallback_url }}" alt="" width="48" height="48" loading="lazy">
                        {% endif %}
                        <span>{{ text | escape }}</span>
                        {% if link != blank %}
                          </a>
                        {% endif %}
                      </div>
                    {% endif %}
                  {% endfor %}
                </div>

              {% when 'text' %}
                {% if block.settings.text != blank %}
                  <div
                    class="custom-nice-product__block custom-nice-product__text rte"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.text }}
                  </div>
                {% endif %}

              {% when 'custom_liquid' %}
                <div
                  class="custom-nice-product__block custom-nice-product__custom-liquid"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.custom_liquid }}
                </div>
            {% endcase %}
          {% endfor %}
        {% endform %}
      </div>
    </div>
  </div>
  <div
    id="NiceGuide-{{ section.id }}"
    class="custom-nice-product__modal"
    data-guide
    role="dialog"
    aria-modal="true"
    aria-labelledby="NiceGuideTitle-{{ section.id }}"
    hidden
  >
    <div class="custom-nice-product__modal-panel">
      <button type="button" data-guide-close aria-label="{{ 'accessibility.close' | t }}">&times;</button>
      <h2 id="NiceGuideTitle-{{ section.id }}" data-guide-title>Size Guide</h2>
      <p>Choose the right size for your space.</p>
      <img data-guide-image alt="" width="900" height="900">
    </div>
  </div>
  <script type="application/json" data-product-json>
    {
      "moneyFormat": {{ shop.money_format | json }}, "currency": {{ cart.currency.iso_code | default: shop.currency | json }},
      "defaultDescription": {{ product.description | json }},
      "strings": {"add":{{ 'products.product.add_to_cart' | t | json }},"sold":{{ 'products.product.sold_out' | t | json }},"preorder":{{ 'products.product.pre_order' | t | json }},"stock":{{ 'products.product.inventory_in_stock' | t | json }},"adding":"Adding…","added":"Added to cart","error":"Unable to add this item. Please try again."},
      "variants": [{% for variant in product.variants %}{% assign images = variant.metafields.custom.variant_images.value %}{"id":{{ variant.id | json }},"options":{{ variant.options | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"compare":{{ variant.compare_at_price | json }},"inventory":{{ variant.inventory_quantity | json }},"management":{{ variant.inventory_management | json }},"policy":{{ variant.inventory_policy | json }},"media":{{ variant.featured_media.id | default: 0 | json }},"min":{{ variant.quantity_rule.min | default: 1 | json }},"max":{{ variant.quantity_rule.max | json }},"increment":{{ variant.quantity_rule.increment | default: 1 | json }},"customGallery":{% if images != blank and images.size > 0 %}true{% else %}false{% endif %}{% if variant.metafields.custom.variant_level_description != blank %}{% capture description_override %}{{ variant.metafields.custom.variant_level_description | metafield_tag }}{% endcapture %},"descriptionOverride":{{ description_override | strip | json }}{% endif %}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
</div>
<style>
  #CustomNiceProduct-{{ section.id }} {
    --blue: #153a5b;
    --pale: #eaf7fc;
    --soft: #f5f3f1;
    --red: #c93434;
    color: #242329;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__layout {
    align-items: flex-start;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__media {
    position: relative;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__slider {
    position: relative;
    overflow: hidden;
    clip-path: inset(0);
    border: 0 !important;
    transition: opacity 0.25s ease;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__slider.is-fading {
    opacity: 0;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__slider .swiper-slide {
    aspect-ratio: 1;
    background: #fff;
  }

  #CustomNiceProduct-{{ section.id }} .custom-nice-product__slider .swiper-slide > a,
  #CustomNiceProduct-{{ section.id }} .custom-nice-product__video,
  #CustomNiceProduct-{{ section.id }} .custom-nice-product__model,
  #CustomNiceProduct-{{ section.id }} .custom-nice-product__placeholder {
