{% capture feature_badges_items %}
  {% if section.settings.item_1_text != blank %}
    <div class="feature-badges__item">
      <span class="feature-badges__icon">
        {% if section.settings.item_1_image != blank %}
          {{ section.settings.item_1_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
        {% else %}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M9 3h6M10 3v6.4l-4.6 7.9A2.5 2.5 0 0 0 7.6 21h8.8a2.5 2.5 0 0 0 2.2-3.7L14 9.4V3"/>
            <path d="M8 16h8"/>
          </svg>
        {% endif %}
      </span>
      <span class="feature-badges__text">{{ section.settings.item_1_text | escape }}</span>
    </div>
  {% endif %}
  {% if section.settings.item_2_text != blank %}
    <div class="feature-badges__item">
      <span class="feature-badges__icon feature-badges__icon--blue">
        {% if section.settings.item_2_image != blank %}
          {{ section.settings.item_2_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
        {% else %}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="M12 3 18 5v5.4c0 4-2.4 7.6-6 9.2-3.6-1.6-6-5.2-6-9.2V5l6-2Z"/>
          </svg>
        {% endif %}
      </span>
      <span class="feature-badges__text">{{ section.settings.item_2_text | escape }}</span>
    </div>
  {% endif %}
  {% if section.settings.item_3_text != blank %}
    <div class="feature-badges__item">
      <span class="feature-badges__icon feature-badges__icon--red">
        {% if section.settings.item_3_image != blank %}
          {{ section.settings.item_3_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
        {% else %}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="8"/>
            <path d="m7 7 10 10"/>
          </svg>
        {% endif %}
      </span>
      <span class="feature-badges__text">{{ section.settings.item_3_text | escape }}</span>
    </div>
  {% endif %}
  {% if section.settings.item_4_text != blank %}
    <div class="feature-badges__item">
      {% if section.settings.item_4_image != blank %}
        <span class="feature-badges__icon">
          {{ section.settings.item_4_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
        </span>
      {% else %}
        <span class="feature-badges__icon feature-badges__icon--text">US</span>
      {% endif %}
      <span class="feature-badges__text">{{ section.settings.item_4_text | escape }}</span>
    </div>
  {% endif %}
  {% if section.settings.item_5_text != blank %}
    <div class="feature-badges__item">
      <span class="feature-badges__icon feature-badges__icon--green">
        {% if section.settings.item_5_image != blank %}
          {{ section.settings.item_5_image | image_url: width: 96 | image_tag: alt: '', loading: 'lazy' }}
        {% else %}
          <svg aria-hidden="true" focusable="false" viewBox="0 0 24 24">
            <path d="m7.8 7.8 2-3.4a2.5 2.5 0 0 1 4.4 0l.9 1.6"/>
            <path d="m13.3 5.3 1.8.7-.7 1.8"/>
            <path d="M16.5 10.3h3.9a2.5 2.5 0 0 1 2.2 3.8l-.9 1.6"/>
            <path d="m21.4 13.7.3 1.9-1.9.3"/>
            <path d="M12 18.8H7.6a2.5 2.5 0 0 1-2.2-3.8l.9-1.6"/>
            <path d="m6 16.1.3-1.9 1.9.3"/>
          </svg>
        {% endif %}
      </span>
      <span class="feature-badges__text">{{ section.settings.item_5_text | escape }}</span>
    </div>
  {% endif %}
{% endcapture %}

{% assign feature_badges_items_output = feature_badges_items | strip %}
{% if feature_badges_items_output != blank %}
  <div
    class="feature-badges feature-badges--{{ section.settings.layout }}"
    style="--feature-badges-background: {{ section.settings.background_color }}; --feature-badges-padding-top: {{ section.settings.padding_top }}px; --feature-badges-padding-right: {{ section.settings.padding_right }}px; --feature-badges-padding-bottom: {{ section.settings.padding_bottom }}px; --feature-badges-padding-left: {{ section.settings.padding_left }}px;"
  >
    {% if section.settings.layout == 'marquee' %}
      <div class="feature-badges__marquee" aria-label="{{ section.settings.accessibility_label | escape }}">
        <div class="feature-badges__track">
          {{ feature_badges_items }}
        </div>
        <div class="feature-badges__track" aria-hidden="true">
          {{ feature_badges_items }}
        </div>
      </div>
    {% else %}
      <div class="feature-badges__grid" aria-label="{{ section.settings.accessibility_label | escape }}">
        {{ feature_badges_items }}
      </div>
    {% endif %}
  </div>
{% endif %}

<style>
  .feature-badges {
    width: 100%;
    margin: 1.4rem 0 0;
    padding: var(--feature-badges-padding-top, 1.6rem) var(--feature-badges-padding-right, 1.8rem) var(--feature-badges-padding-bottom, 1.6rem) var(--feature-badges-padding-left, 1.8rem);
    background: var(--feature-badges-background, #eef7fd);
    overflow: hidden;
    box-sizing: border-box;
  }

  .feature-badges__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.8rem 2rem;
    align-items: center;
  }

  .feature-badges__marquee {
    display: flex;
    width: 100%;
    overflow: hidden;
  }

  .feature-badges__track {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: 3.2rem;
    min-width: max-content;
    padding-right: 3.2rem;
    animation: feature-badges-marquee 26s linear infinite;
  }

  .feature-badges__item {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: 1.1rem;
  }

  .feature-badges--marquee .feature-badges__item {
    flex: 0 0 auto;
    min-width: max-content;
  }

  .feature-badges__icon {
    display: inline-flex;
    flex: 0 0 3.6rem;
    align-items: center;
    justify-content: center;
    width: 3.6rem;
    height: 3.6rem;
    color: #7b66d9;
    background: #ffffff;
    border: .1rem solid #cfe1ee;
    border-radius: 50%;
    box-shadow: 0 .1rem .3rem rgba(20, 48, 72, .08);
    box-sizing: border-box;
  }

  .feature-badges__icon svg {
    display: block;
    width: 1.9rem;
    height: 1.9rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .feature-badges__icon img {
    display: block;
    width: 2rem;
    height: 2rem;
    object-fit: contain;
  }

  .feature-badges__icon--blue {
    color: #4aaee8;
  }

  .feature-badges__icon--red {
    color: #ff566f;
  }

  .feature-badges__icon--green {
    color: #20b86f;
  }

  .feature-badges__icon--text {
    color: #142f47;
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1;
  }

  .feature-badges__text {
    min-width: 0;
    color: #142f47;
    font-size: 1.4rem;
    font-weight: 800;
    line-height: 1.35;
    letter-spacing: 0;
    overflow-wrap: anywhere;
  }

  @keyframes feature-badges-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-badges__track {
      animation: none;
    }
  }

  @media (max-width: 575px) {
    .feature-badges__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Feature Badges",
  "tag": "section",
  "class": "section-feature-badges",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "grid",
          "label": "Static grid"
        },
        {
          "value": "marquee",
          "label": "Marquee"
        }
      ],
      "default": "grid"
    },
    {
      "type": "text",
      "id": "accessibility_label",
      "label": "Accessibility label",
      "default": "Product benefits"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#eef7fd"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_right",
      "label": "Padding right",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_left",
      "label": "Padding left",
      "min": 0,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Item 1"
    },
    {
      "type": "image_picker",
      "id": "item_1_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "item_1_text",
      "label": "Text",
      "default": "Independently Lab Tested"
    },
    {
      "type": "header",
      "content": "Item 2"
    },
    {
      "type": "image_picker",
      "id": "item_2_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "item_2_text",
      "label": "Text",
      "default": "10-Year Steel Casing Warranty"
    },
    {
      "type": "header",
      "content": "Item 3"
    },
    {
      "type": "image_picker",
      "id": "item_3_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "item_3_text",
      "label": "Text",
      "default": "Aluminum-Free & Non-Toxic"
    },
    {
      "type": "header",
      "content": "Item 4"
    },
    {
      "type": "image_picker",
      "id": "item_4_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "item_4_text",
      "label": "Text",
      "default": "Ships from US Warehouse"
    },
    {
      "type": "header",
      "content": "Item 5"
    },
    {
      "type": "image_picker",
      "id": "item_5_image",
      "label": "Icon image"
    },
    {
      "type": "text",
      "id": "item_5_text",
      "label": "Text",
      "default": "Refillable - Zero-Waste Design"
    }
  ],
  "presets": [
    {
      "name": "Feature Badges"
    }
  ]
}
{% endschema %}
