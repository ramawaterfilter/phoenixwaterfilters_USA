    "blocks_NnKDpK": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_866760f_aFXUai": {
          "type": "ai_gen_block_866760f",
          "settings": {
            "custom_html": "<section class=\"flrd-health-section\">\n\n    <!-- Header -->\n    <div class=\"flrd-section-header\">\n        <h2>Removes &gt;95% of Fluoride  withthe first refillable stainless steel fluoride filter designed for home gravity systems.</h2>\n\n  <p>\n  Fluoride is added to public drinking water for approximately three out of four Americans. However, \n  <a href=\"https://pmc.ncbi.nlm.nih.gov/articles/PMC3876610/\" target=\"_blank\" style=\"color:#2B2B4E;\">\n    growing scientific research has raised concerns that excessive fluoride exposure may potentially impact brain health and could be associated with an increased risk of osteosarcoma.\n  </a>\n</p>\n    </div>\n\n    <!-- Cards -->\n    <div class=\"flrd-cards-wrap\">\n\n        <!-- Card 1 -->\n        <div class=\"flrd-card\">\n            <img class=\"flrd-card-img\" src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/03.Skeletal_Health.jpg?v=1779951273\" alt=\"Dental and Skeletal Fluorosis\">\n\n            <div class=\"flrd-card-body\">\n                <h3 class=\"flrd-card-title\">\n                   Neurological Health\n                </h3>\n\n                <p class=\"flrd-card-desc\">\n                   Emerging research has raised concerns about the potential impact of excessive fluoride exposure on neurological health, particularly in developing children. Long term consumption of drinking water with elevated fluoride levels has been associated in studies with cognitive and neurodevelopmental effects, highlighting the importance of maintaining safe fluoride concentrations in everyday drinking water.\n                </p>\n            </div>\n        </div>\n\n        <!-- Card 2 -->\n        <div class=\"flrd-card\">\n            <img class=\"flrd-card-img\" src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/01.Neurological_Health.jpg?v=1779951272\" alt=\"Neurological Effects\">\n\n            <div class=\"flrd-card-body\">\n                <h3 class=\"flrd-card-title\">\n                    Thyroid Function\n                </h3>\n\n                <p class=\"flrd-card-desc\">\n                    The thyroid plays a vital role in regulating metabolism, energy levels, and overall hormonal balance. Studies suggest that prolonged exposure to high fluoride concentrations may interfere with normal thyroid activity, especially in individuals with iodine deficiency, making cleaner, fluoride reduced water an important consideration for overall wellness.\n                </p>\n            </div>\n        </div>\n\n        <!-- Card 3 -->\n        <div class=\"flrd-card\">\n            <img class=\"flrd-card-img\" src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/02.Thyroid_Function.jpg?v=1779951272\" alt=\"Thyroid Function\">\n\n            <div class=\"flrd-card-body\">\n                <h3 class=\"flrd-card-title\">\n                    Skeletal Health\n                </h3>\n\n                <p class=\"flrd-card-desc\">\n                    While fluoride is often associated with dental health at controlled levels, excessive intake over time may adversely affect bones and joints. Elevated fluoride concentrations in drinking water have been linked to skeletal fluorosis, a condition that can lead to joint stiffness, discomfort, and changes in bone structure with prolonged exposure.\n                </p>\n            </div>\n        </div>\n\n        <!-- Card 4 -->\n        <div class=\"flrd-card\">\n            <img class=\"flrd-card-img\" src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/04._Low_Birth_Weight.jpg?v=1779951272\" alt=\"Kidney Health\">\n\n            <div class=\"flrd-card-body\">\n                <h3 class=\"flrd-card-title\">\n                    Low Birth Weight and Preterm Birth\n                </h3>\n\n                <p class=\"flrd-card-desc\">\n                    Scientific studies have explored the potential connection between high fluoride exposure during pregnancy and adverse birth outcomes. Research suggests that elevated fluoride levels in drinking water may be associated with increased risks of low birth weight and preterm birth, underscoring the importance of safer drinking water for maternal and infant health.\n                </p>\n            </div>\n        </div>\n\n    </div>\n\n</section>",
            "custom_css": ".flrd-health-section{\n    width:75%;\n    max-width:1280px;\n    margin:0 auto;\n    padding:10px 20px;\n    box-sizing:border-box;\n    background:#ffffff;\n}\np a {\n    color: #132555;\n     text-decoration: none; \n}\n/* =========================\nHEADER\n========================= */\n\n.flrd-section-header{\n    width:100%;\n    max-width:760px;\n    margin:0px auto 20px 0px ;\n    text-align:left;\n}\n\n.flrd-section-header h2{\n    margin:0 0 5px;\n    font-size:42px;\n    line-height:50px;\n    font-weight:500;\n    color:#1a2433;\n    letter-spacing:-0.5px;\n}\n\n.flrd-section-header p{\n    margin:0 auto;\n    max-width:760px;\n    font-size:16px;\n    line-height:28px;\n    color:#5a6475;\n    font-weight:400;\n}\n\n.flrd-section-header p strong{\n    color:#1a2433;\n    font-weight:600;\n}\n\n/* =========================\nCARDS WRAPPER\n========================= */\n\n.flrd-cards-wrap{\n    display:grid;\n    grid-template-columns:repeat(4, 1fr);\n    gap:24px;\n    align-items:stretch;\n}\n\n/* =========================\nCARD\n========================= */\n\n.flrd-card{\n    background:#ffffff;\n    border-radius:18px;\n    overflow:hidden;\n    border:1px solid #edf1f5;\n    box-shadow:0 4px 14px rgba(0,0,0,0.04);\n    transition:all 0.3s ease;\n    display:flex;\n    flex-direction:column;\n    height:100%;\n}\n\n.flrd-card:hover{\n    transform:translateY(-6px);\n    box-shadow:0 12px 28px rgba(0,0,0,0.08);\n}\n\n/* =========================\nIMAGE\n========================= */\n\n.flrd-card-img{\n    width:100%;\n    height:220px;\n    object-fit:cover;\n    display:block;\n}\n\n/* =========================\nBODY\n========================= */\n\n.flrd-card-body{\n    padding:24px 22px 28px;\n    display:flex;\n    flex-direction:column;\n    gap:12px;\n    flex:1;\n}\n\n.flrd-card-title{\n    margin:0;\n    font-size:20px;\n    line-height:28px;\n    font-weight:600;\n    color:#1a2433;\n    letter-spacing:-0.2px;\n}\n\n.flrd-card-desc{\n    margin:0;\n    font-size:15px;\n    line-height:26px;\n    color:#5a6475;\n}\n\n/* =========================\nTABLET\n========================= */\n\n@media (max-width: 991px){\n\n    .flrd-health-section{\n        padding:20px 18px;\nmargin:0 5px;\n    }\n.flrd-health-section{\n    width:90%;\n    \n}\n\n    .flrd-section-header{\n        margin-bottom:36px;\n    }\n\n    .flrd-section-header h2{\n        font-size:34px;\n        line-height:42px;\n    }\n\n    .flrd-section-header p{\n        font-size:15px;\n        line-height:26px;\n    }\n\n    .flrd-cards-wrap{\n        grid-template-columns:repeat(2,1fr);\n        gap:20px;\n    }\n\n    .flrd-card-img{\n        height:210px;\n    }\n}\n\n/* =========================\nMOBILE\n========================= */\n\n@media (max-width: 640px){\n\n    .flrd-health-section{\n        padding:10px 16px;\nmargin:0 5px;\n    }\n\n    .flrd-section-header{\n        text-align:left;\n        margin-bottom:28px;\n    }\n\n    .flrd-section-header h2{\n        font-size:28px;\n        line-height:36px;\n        margin-bottom:14px;\n    }\n\n    .flrd-section-header p{\n        font-size:14px;\n        line-height:24px;\n    }\n\n    .flrd-cards-wrap{\n        display:flex;\n        gap:16px;\n        overflow-x:auto;\n        scroll-snap-type:x mandatory;\n        padding-bottom:6px;\n        -webkit-overflow-scrolling:touch;\n        scrollbar-width:none;\n    }\n\n    .flrd-cards-wrap::-webkit-scrollbar{\n        display:none;\n    }\n\n    .flrd-card{\n        min-width:85%;\n        scroll-snap-align:start;\n    }\n\n    .flrd-card-img{\n        height:200px;\n    }\n\n    .flrd-card-body{\n        padding:20px;\n    }\n\n    .flrd-card-title{\n        font-size:18px;\n        line-height:26px;\n    }\n\n    .flrd-card-desc{\n        font-size:14px;\n        line-height:24px;\n    }\n}",
            "custom_js": "",
            "desktop_width_percent": 100
          },
          "blocks": {}
        }
      },
