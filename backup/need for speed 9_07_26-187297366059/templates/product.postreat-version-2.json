          "type": "ai_gen_block_866760f",
          "settings": {
            "custom_html": "<div class=\"tech-specs-section\">\n\n    <!-- HEADING -->\n    <div class=\"tech-specs-header\">\n        <span class=\"specs-subtitle\">PRODUCT DETAILS</span>\n        <h2>Technical Specifications</h2>\n        \n    </div>\n\n    <!-- MAIN CONTENT -->\n    <div class=\"custom-accessory-specs\">\n\n        <!-- LEFT IMAGE -->\n        <div class=\"specs-images\">\n            <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Artboard_1.jpg?v=1778851286\" alt=\"POSTreat Fluoride Filter Elements\">\n        </div>\n\n        <!-- RIGHT CONTENT -->\n        <div class=\"specs-text\">\n\n            <div class=\"spec-item\">\n                <div class=\"spec-title\">Material</div>\n                <div class=\"spec-content\">\n                    Casing made of  AISI 304 stainless steel — rust-resistant and non-leaching.\n                </div>\n            </div>\n\n            <div class=\"spec-item\">\n                <div class=\"spec-title\">Filtration Capacity</div>\n                <div class=\"spec-content\">\n                    Up to 1,100 gallons per pair.\n                </div>\n            </div>\n\n            <div class=\"spec-item\">\n                <div class=\"spec-title\">Compatible Filters</div>\n                <div class=\"spec-content\">\n                    Phoenix Gravity Carbon Filter Elements<br>\n                    Black Berkey® Replacement Elements\n                </div>\n            </div>\n\n            <div class=\"spec-item\">\n                <div class=\"spec-title\">Composition</div>\n                <div class=\"spec-content\">\n                    FlouRid media comprises a specialised blend of activated carbon and a proprietary media specifically formulated to address fluoride.\n                </div>\n            </div>\n\n            <div class=\"spec-item\">\n                <div class=\"spec-title\">Warranty</div>\n                <div class=\"spec-content\">\n                    10-year warranty covering defects in materials or performance under normal use conditions.\n                </div>\n            </div>\n\n        </div>\n    </div>\n</div>",
            "custom_css": ".tech-specs-section {\n    max-width: 1200px;   /* total width */\n    width: 74%;          /* 70% of screen */\n    margin: 0 auto;\n    padding: 5px 0;\n}\n\n/* =========================\n   HEADER\n========================= */\n\n.tech-specs-header {\n    margin-bottom: 45px;\n    width: 73%;\n}\n\n.specs-subtitle {\n    display: inline-block;\n    font-size: 11px;\n    font-weight: 500;\n    letter-spacing: 0.15em;\n    text-transform: uppercase;\n    color: #8a8a8a;\n    margin-bottom: 14px;\n}\n\n.tech-specs-header h2 {\n    font-size: 42px;\n    line-height: 1.15;\n    font-weight: 500;\n    color: #111;\n    margin: 0 0 16px;\n}\n\n.tech-specs-header p {\n    font-size: 16px;\n    line-height: 1.8;\n    color: #666;\n    margin: 0;\n}\n\n/* =========================\n   MAIN FLEX LAYOUT\n========================= */\n\n.custom-accessory-specs {\n    display: flex;\n    align-items: stretch;\n    gap: 60px;\n}\n\n/* =========================\n   LEFT IMAGE SIDE\n========================= */\n\n.specs-images {\n    width: 42%;\n    max-width: 500px;\n    display: flex;\n    flex-shrink: 0;\n}\n\n.specs-images img {\n    width: 100%;\n    max-width: 500px;\n    height: 100%;\n    object-fit: cover;\n    border-radius: 14px;\n    display: block;\n    background: #f8f8f8;\n}\n\n/* =========================\n   RIGHT CONTENT SIDE\n========================= */\n\n.specs-text {\n    flex: 1;\n    display: flex;\n    flex-direction: column;\n    justify-content: space-between;\n}\n\n.spec-item {\n    padding: 5px 0;\n    border-bottom: 1px solid #e6e6e6;\n}\n\n.spec-item:first-child {\n    padding-top: 0;\n}\n\n.spec-item:last-child {\n    border-bottom: none;\n    padding-bottom: 0;\n}\n\n/* LABEL */\n\n.spec-title {\n    font-size: 12px;\n    font-weight: 700;\n    text-transform: uppercase;\n    letter-spacing: 0.1em;\n    color: #8c8c8c;\n    margin-bottom: 10px;\n}\n\n/* CONTENT */\n\n.spec-content {\n    font-size: 17px;\n    line-height: 1.8;\n    color: #222;\n    font-weight: 400;\n}\n\n/* =========================\n   TABLET\n========================= */\n\n@media screen and (max-width: 991px) {\n\n    .tech-specs-section {\n        width: 90%;\n    }\n\n    .custom-accessory-specs {\n        gap: 40px;\n    }\n\n    .tech-specs-header h2 {\n        font-size: 34px;\n    }\n\n    .specs-images {\n        max-width: 420px;\n    }\n}\n\n/* =========================\n   MOBILE\n========================= */\n\n@media screen and (max-width: 768px) {\n\n    .tech-specs-section {\n        width: 92%;\n        padding: 5px 0;\n    }\n\n    .custom-accessory-specs {\n        flex-direction: column;\n        gap: 30px;\n    }\n\n    .specs-images,\n    .specs-text,\n    .tech-specs-header {\n        width: 100%;\n        max-width: 100%;\n    }\n\n    .specs-images img {\n        height: auto;\n        max-height: 420px;\n        object-fit: contain;\n    }\n\n    .tech-specs-header {\n        margin-bottom: 30px;\n    }\n\n    .tech-specs-header h2 {\n        font-size: 28px;\n    }\n\n    .tech-specs-header p {\n        font-size: 15px;\n        line-height: 1.7;\n    }\n\n    .spec-content {\n        font-size: 15px;\n        line-height: 1.7;\n    }\n.custom-accessory-specs {\n\n     margin-bottom:10px; \n\n}\n}",
