        "ai_gen_block_866760f_jiptDU": {
          "type": "ai_gen_block_866760f",
          "settings": {
            "custom_html": "<section class=\"flt-main-section\">\n\n  <div class=\"flt-label-tag\">MAINTENANCE MADE EASY</div>\n\n  <h1 class=\"flt-main-heading\">Filter Lifespan Timeline</h1>\n\n  <p class=\"flt-description-text\">\n    Know exactly when to replace each component.\n  </p>\n\n  <!-- Timeline -->\n  <div class=\"flt-timeline-container\">\n\n    <div class=\"flt-progress-line\"></div>\n\n    <div class=\"flt-timeline-row\">\n\n      <div class=\"flt-stage-block\">\n        <div class=\"flt-status-dot flt-status-dot-blue\"></div>\n        <div class=\"flt-time-label\">Month 0</div>\n        <p>Install &amp; start filtering</p>\n      </div>\n\n      <div class=\"flt-stage-block\">\n        <div class=\"flt-status-dot flt-status-dot-gold\"></div>\n        <div class=\"flt-time-label\">Month 4</div>\n        <p>Replace FluoRid Media (~1,060 gal)</p>\n      </div>\n\n      <div class=\"flt-stage-block\">\n        <div class=\"flt-status-dot flt-status-dot-gold\"></div>\n        <div class=\"flt-time-label\">Month 8</div>\n        <p>Replace FluoRid Media again</p>\n      </div>\n\n      <div class=\"flt-stage-block\">\n        <div class=\"flt-status-dot flt-status-dot-gold\"></div>\n        <div class=\"flt-time-label\">Month 12</div>\n        <p>Replace Carbon Elements + FluoRid</p>\n      </div>\n\n    </div>\n\n  </div>\n\n  <!-- Cards -->\n  <div class=\"flt-info-grid\">\n\n    <div class=\"flt-info-card flt-card-gold-accent\">\n\n      <div class=\"flt-icon-circle flt-icon-green\">\n  <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Fluoride_Media_Refil.jpg?v=1779960156\" alt=\"FluoRid Icon\" class=\"flt-card-icon\">\n</div>\n\n      <div>\n        <h3>FluoRid Media Refill</h3>\n\n        <p>\n          Replace every <strong>4 months</strong>\n          or 1,060 gallons. The AISI 304 steel casing\n          is reusable for years — only the media\n          needs topping up.\n        </p>\n      </div>\n\n    </div>\n\n  </div>\n\n</section>",
            "custom_css": ".flt-main-section{\n  max-width:1125px;\n  margin:15px auto;\n  padding:0 15px;\n}\n.flt-card-icon{\n  width:60px;\n  height:60px;\n  object-fit:contain;\n}\n\n.flt-icon-circle{\n  width:46px;\n  height:46px;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  flex-shrink:0;\n  overflow:hidden;\n}\n.flt-label-tag{\n  color:#2B2B4E;\n  font-size:11px;\n  font-weight:700;\n  letter-spacing:3px;\n  text-transform:uppercase;\n  margin-bottom:12px;\n}\n\n.flt-main-heading{\n  font-size:24px;\n  line-height:1.1;\n  font-weight:700;\n  margin-bottom:16px;\n  color:#0b1d35;\n}\n\n.flt-description-text{\n  font-size:16px;\n  line-height:1.6;\n  color:#5a6b80;\n  max-width:700px;\n  margin-bottom:25px;\n}\n\n/* Timeline */\n\n.flt-timeline-container{\n  position:relative;\n  margin-bottom:25px;\n}\n\n.flt-progress-line{\n  position:absolute;\n  top:12px;\n  left:0;\n  width:100%;\n  height:4px;\n  border-radius:10px;\n  background:#d7dbea;\n  z-index:1;\n}\n\n.flt-timeline-row{\n  display:flex;\n  justify-content:space-between;\n  position:relative;\n  z-index:2;\n  gap:15px;\n}\n\n.flt-stage-block{\n  width:180px;\n}\n\n.flt-status-dot{\n  width:24px;\n  height:24px;\n  border-radius:50%;\n  margin-bottom:18px;\n  position:relative;\n}\n\n/* Brand Color */\n\n.flt-status-dot-blue{\n  background:#4a4abe;\n \n}\n\n.flt-status-dot-gold{\n  background:#2B2B4E;\n}\n\n.flt-time-label{\n  font-size:18px;\n  font-weight:700;\n  margin-bottom:8px;\n  color:#0b1d35;\n}\n\n.flt-stage-block p{\n  font-size:14px;\n  line-height:1.5;\n  color:#607086;\n  margin:0;\n}\n\n/* Cards */\n\n.flt-info-grid{\n  display:grid;\n  gap:18px;\n  grid-auto-flow:column;\n}\n\n.flt-info-card{\n  background:#f7f8fc;\n  border-radius:18px;\n  padding:22px;\n  display:flex;\n  gap:16px;\n  align-items:flex-start;\n  border:1px solid #e4e7f2;\n  transition:all 0.3s ease;\n}\n\n.flt-info-card:hover{\n  transform:translateY(-2px);\n  box-shadow:0 10px 20px rgba(43,43,78,0.08);\n}\n\n.flt-card-blue-accent{\n  border-left:4px solid #2B2B4E;\n}\n\n.flt-card-gold-accent{\n  border-left:4px solid #2B2B4E;\n}\n\n.flt-icon-circle{\n  width:46px;\n  height:46px;\n  border-radius:50%;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-size:20px;\n  flex-shrink:0;\n}\n\n.flt-icon-purple{\n  background:linear-gradient(135deg,#2B2B4E,#44446d);\n  color:white;\n}\n\n.flt-icon-green{\n  background:linear-gradient(135deg,#2B2B4E,#44446d);\n  color:white;\n}\n\n.flt-info-card h3{\n  font-size:20px;\n  margin-bottom:8px;\n  color:#0b1d35;\n}\n\n.flt-info-card p{\n  font-size:14px;\n  line-height:1.6;\n  color:#5f7085;\n  margin:0;\n}\n\n.flt-info-card strong{\n  color:#0b1d35;\n}\n\n/* Mobile */\n\n@media (max-width:768px){\n\n  .flt-timeline-row{\n    flex-direction:row;\n    align-items:flex-start;\n    gap:12px;\n    overflow-x:auto;\n    flex-wrap:nowrap;\n    padding-bottom:10px;\n    justify-content:space-between;\n  }\n\n  .flt-info-grid{\n    display:grid;\n    gap:18px;\n    grid-auto-flow:row !important;\n  }\n\n  .flt-stage-block{\n    min-width:60px;\n    width:60px;\n    flex:0 0 auto;\n  }\n\n  .flt-info-grid{\n    display:grid;\n    gap:18px;\n  }\n\n  .flt-status-dot{\n    width:18px;\n    height:18px;\n    margin-bottom:10px;\n  }\n\n  .flt-time-label{\n    font-size:14px;\n    margin-bottom:6px;\n  }\n\n  .flt-stage-block p{\n    font-size:12px;\n    line-height:1.4;\n  }\n}",
