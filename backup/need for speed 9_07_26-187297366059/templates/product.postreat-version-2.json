          "settings": {
            "custom_html": "<section class=\"pt-trust-section\">\n  <div class=\"pt-wrap\">\n\n    <div class=\"pt-label\">Built on Trust</div>\n\n    <h2 class=\"pt-heading\">\n      2,400+ Americans Trust Their Water to POSTreat™\n    </h2>\n\n    <p class=\"pt-sub\">\n      Certified, tested, and verified — backed by real customers who've made the switch.\n    </p>\n\n    <!-- CERTIFICATION BADGES -->\n    <div class=\"pt-cert-badges\">\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/NSF.jpg?v=1779876841\" alt=\"NSF Certification\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>NSF/ANSI 42 &amp; 372</h5>\n        </div>\n      </div>\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/LAB_Tested.jpg?v=1779876982\" alt=\"Lab Tested\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>Lab Tested</h5>\n        </div>\n      </div>\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/10_year_warranty.jpg?v=1779876982\" alt=\"10 Year Warranty\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>10-Year Warranty</h5>\n        </div>\n      </div>\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/ALuminum-Free.jpg?v=1779876982\" alt=\"Aluminum Free\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>Aluminum-Free</h5>\n        </div>\n      </div>\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Non-Toxic.jpg?v=1779876982\" alt=\"Non Toxic\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>Non-Toxic</h5>\n        </div>\n      </div>\n\n      <div class=\"pt-cert-badge\">\n        <div class=\"pt-ci\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/100-year_Warranty.jpg?v=1779876982\" alt=\"100 Day Trial\">\n        </div>\n        <div class=\"pt-cert-content\">\n          <h5>100-Day Trial</h5>\n        </div>\n      </div>\n\n    </div>\n\n  </div>\n</section>",
            "custom_css": "/* SECTION */\n.pt-trust-section {\n  padding: 20px 20px;\n  text-align: left;\n}\n\n/* CONTAINER */\n.pt-wrap {\n  max-width: 1120px;\n  width: 100%;\n  margin: 0 auto;\n}\n\n/* CERTIFICATION GRID */\n.pt-cert-badges {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 18px;\n  margin-top: 10px;\n}\n\n/* SINGLE BOX */\n.pt-cert-badge {\n  background: #ffffff;\n  border: 1px solid #e4e8f1;\n  border-radius: 20px;\n  padding: 22px 20px;\n  text-align: left;\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  box-shadow: 0 4px 14px rgba(0,0,0,0.04);\n}\n\n/* IMAGE ICON */\n.pt-ci {\n  width: 48px;\n  height: 48px;\n  min-width: 48px;\n  border-radius: 14px;\n  overflow: hidden;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: #f5f5f5;\n}\n\n.pt-ci img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n/* TEXT */\n.pt-cert-content h5 {\n  font-size: 15px;\n  font-weight: 700;\n  color: #1d2433;\n  margin: 0;\n}\n\n/* TABLET */\n@media (max-width: 900px) {\n  .pt-cert-badges {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n\n  .pt-trust-section {\n    padding: 40px 16px;\n  }\n\n  .pt-cert-badges {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n\n  .pt-cert-badge {\n    padding: 18px;\n    border-radius: 18px;\n  }\n\n  .pt-ci {\n    width: 42px;\n    height: 42px;\n    min-width: 42px;\n  }\n\n  .pt-cert-content h5 {\n    font-size: 14px;\n  }\n}",
