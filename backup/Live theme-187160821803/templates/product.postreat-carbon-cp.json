          }
        },
        "question_answer_qKVKbG": {
          "type": "question_answer",
          "name": "Warranty Question and answer",
          "settings": {
            "question": "How Does The 100-Day Money-Back Guarantee Work?",
            "answer": "<p>The 100-Day Money Back Guarantee is applicable only to the Phoenix Gravity Systems purchased with the AISI 304 Grade Stainless Steel housings housings, via our website. The trial is not applicable for replacement filters and accessories purchased separately.<br/><br/>Here’s how it works:<br/><br/>Purchase your Phoenix Gravity Water Filter System via our website. Once it arrives, start using it straight away.<br/><br/>If you don’t fall in love with your Phoenix Gravity System within 100 days of use from the date of delivery, contact our support team to initiate a return. The return must be initiated within 100 days from the date of delivery.<br/><br/>The system must be returned complete with all original parts and packaging. The AISI 304 Grade Stainless Steel housing should not be dented or otherwise damaged. The filter elements must not be cracked or damaged upon our receipt of the return.<br/><br/>Upon safe receipt of the system and inspection of condition, we will be in touch to initiate a full refund to your original payment method. This process may take up to 10 business days to complete.<br/><br/><a href=\"https://phoenixwaterfilters.com/pages/contact-us\" target=\"_blank\" title=\"https://phoenixwaterfilters.com/pages/contact-us\">Talk To Us About The 100-Day Money Back Guarantee</a>.</p>"
          }
        },
        "question_answer_7Dhfgq": {
          "type": "question_answer",
          "name": "Warranty Question and answer",
          "settings": {
            "question": "Is The 100-Day Return Policy Valid If I Order From Amazon?",
            "answer": "<p>No. Your Phoenix Gravity Filter system must be purchased via our website to qualify for our 100-day money back guarantee.</p>"
          }
        },
        "question_answer_jhyJgE": {
          "type": "question_answer",
          "settings": {
            "question": "How Does The Warranty Work?",
            "answer": "<p>We offer a 1 year warranty on Phoenix Gravity 304 Grade Stainless Steel Spigots and Carbon Elements. You’re protected against any defects in material and workmanship.<br/><br/>We offer a 6 month warranty on all other parts and accessories. You’re protected against any defects in material and workmanship.</p>"
          }
        }
