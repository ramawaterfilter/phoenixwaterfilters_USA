        "question_answer_zcAHcN": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "Where Does Phoenix Gravity Ship To?",
            "answer": "<p>We currently ship to the US. We’re working on shipping to more locations.</p>"
          }
        },
        "question_answer_dMViCy": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "What is your return policy?",
            "answer": "<p>We offer a <strong>100-day money-back guarantee on complete Gravity Water Filter Systems</strong>, starting from the date your order is delivered. For <strong>filters, replacement parts, and accessories</strong>, we accept returns initiated within <strong>30 days of purchase</strong>. All returned items must be <strong>undamaged and in resalable condition</strong>. Where applicable, items should be returned in their original packaging.</p>"
          }
        },
        "question_answer_8VGVaE": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "What is covered by the 30-day return policy?",
            "answer": "<p>Filters, replacement parts, and accessories are eligible for return when the return is initiated within 30 days of purchase, provided the item is undamaged and in resalable condition.</p>"
          }
        },
        "question_answer_Pyrwam": {
          "type": "question_answer",
          "name": "Shipping Question and answer",
          "settings": {
            "question": "Who pays for return shipping?",
            "answer": "<p>If the return is required because we made an error, such as sending the wrong item or an incorrect order, we will cover the return shipping costs. For returns that are not due to an error on our part, the customer is responsible for return shipping costs.</p>"
          }
        },
        "question_answer_yNtKHN": {
          "type": "question_answer",
          "settings": {
            "question": "How do I start a return?",
            "answer": "<p>Please contact our customer support team at hello@phoenixwaterfilters.com with your order details and the reason for your return. We’ll provide the return instructions and any information needed to complete the process.</p>"
          }
        },
        "question_answer_UQWH8n": {
          "type": "question_answer",
          "settings": {
            "question": "When will I receive my refund?",
            "answer": "<p>Once we receive and approve your return, we’ll issue the refund to your original payment method within 10 business days. Please note that your bank or payment provider may require additional time to post the refund to your account.</p>"
          }
        },
        "question_answer_FXGEEr": {
          "type": "question_answer",
          "settings": {
            "question": "Does the 100-Day Money-Back Guarantee apply to filters and accessories?",
            "answer": "<p>No. The 100-Day Money-Back Guarantee applies to complete Gravity Water Filter Systems only. Filters, replacement parts, and accessories are covered by our 30-day return policy.</p>"
          }
        },
        "question_answer_w9cmGz": {
          "type": "question_answer",
          "settings": {
            "question": "My Item Has Arrived Damaged Or Incorrect, What Can I Do?",
            "answer": "<p>Please send a photograph of your full order including the packaging along with your order number to our support team at hello@phoenixwaterfilters.com, and we’ll get back to you as a matter of priority within 24 hours.</p>"
          }
        },
        "tab_UJzMRA": {
          "type": "tab",
          "name": "Warranty",
          "settings": {
