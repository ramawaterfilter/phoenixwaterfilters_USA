{%- comment -%}
  Footer — Figma `7809:11029` (desktop) and `7809:12316` (mobile).

  Four columns over a ruled bottom bar: logo with the address details (Column 1 Text, then
  the phone and email settings), two link columns (Column 2 / 3 Text: the first bold line is
  the column heading, then a bulleted list of links), and the newsletter sign-up. The bottom
  bar holds the copyright (Disclaimer, [dyn-year] = current year) and the Terms.
  Styles: src/css/components/_footer.scss.
{%- endcomment -%}

<div class="site-footer__container kk-fws-container">
  <div class="site-footer__inner">
    <div class="site-footer__col1">
      {% if section.settings.footer-logo %}
        <a class="site-footer__logo" href="{{ routes.root_url }}" aria-label="Home">
          {%- if section.settings.logo_max_width != blank -%}
            {%- capture logo_style %}max-width: {{ section.settings.logo_max_width }}px;{% endcapture -%}
            {{ section.settings.footer-logo | image_url: width: 1000 | image_tag: style: logo_style }}
          {%- else -%}
            {{ section.settings.footer-logo | image_url: width: 1000 | image_tag }}
          {%- endif -%}
        </a>
      {% endif %}

      <div class="site-footer__details">
        {{ section.settings.col1_text }}
        {%- if section.settings.phone != blank -%}
          <p><strong>Phone:</strong> <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a></p>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <p><strong>Email:</strong> <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></p>
        {%- endif -%}
      </div>
    </div>

    <div class="site-footer__col2 site-footer__links">
      {{ section.settings.col2_text }}
    </div>

    <div class="site-footer__col3 site-footer__links">
      {{ section.settings.col3_text }}
    </div>

    <div class="site-footer__col4">
      {%- if section.settings.newsletter_title != blank -%}
        <p class="site-footer__heading">{{ section.settings.newsletter_title }}</p>
      {%- endif -%}
      {%- if section.settings.newsletter_text != blank -%}
        <div class="site-footer__newsletter-text">{{ section.settings.newsletter_text }}</div>
      {%- endif -%}

      {% render 'newsletter-form',
        hide_title: true,
        arrow: 'kk-fws-icon-footer-arrow.svg',
        success_message: section.settings.newsletter_success
      %}

      {%- if section.settings.show_socials -%}
        <div class="footer-socials">
          {%- if section.settings.socials_title != blank -%}
            <p><strong>{{ section.settings.socials_title }}</strong></p>
          {%- endif -%}

          <ul class="socials">
            {% if section.settings.socials_fb != blank %}
              <li>
                <a href="{{ section.settings.socials_fb }}" target="_blank">
                  <img src="{{ 'icon-facebook.svg' | asset_url }}" loading="lazy" alt="Facebook" />
                </a>
              </li>
            {% endif %}
            {% if section.settings.socials_tw != blank %}
              <li>
                <a href="{{ section.settings.socials_tw }}" target="_blank">
                  <img src="{{ 'icon-x-twitter.svg' | asset_url }}" loading="lazy" alt="X" />
                </a>
              </li>
            {% endif %}
            {% if section.settings.socials_ig != blank %}
              <li>
                <a href="{{ section.settings.socials_ig }}" target="_blank">
                  <img src="{{ 'icon-instagram.svg' | asset_url }}" loading="lazy" alt="Instagram" />
                </a>
              </li>
            {% endif %}
            {% if section.settings.socials_yt != blank %}
              <li>
                <a href="{{ section.settings.socials_yt }}" target="_blank">
                  <img src="{{ 'icon-youtube.svg' | asset_url }}" loading="lazy" alt="YouTube" />
                </a>
              </li>
            {% endif %}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.disclaimer != blank or section.settings.terms != blank -%}
    <div class="site-footer__bottom">
      {%- if section.settings.disclaimer != blank -%}
        {%- assign current_year = 'now' | date: '%Y' -%}
        <div class="site-footer__copyright">
          {{ section.settings.disclaimer | replace: '[dyn-year]', current_year }}
        </div>
      {%- endif -%}
      {%- if section.settings.terms != blank -%}
        <div class="site-footer__terms">{{ section.settings.terms }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% schema %}
  {
    "name": "Footer",
    "tag": "footer",
    "class": "site-footer",
    "settings": [
      {
        "type": "image_picker",
        "id": "footer-logo",
        "label": "Footer Logo"
      },
      {
        "type": "number",
        "id": "logo_max_width",
        "label": "Footer logo max width (px)",
        "info": "Optional. Leave blank for the default 200px."
      },
      {
        "type": "richtext",
        "id": "col1_text",
        "label": "Column 1 Text",
        "info": "Address details. Start each with a bold label, e.g. **Address:** then the address. Phone and email are added underneath from their settings below."
      },
      {
        "type": "richtext",
        "id": "col2_text",
        "label": "Column 2 Text",
        "info": "A bold first line for the column heading, then a bulleted list of links."
      },
      {
        "type": "richtext",
        "id": "col3_text",
        "label": "Column 3 Text",
        "info": "A bold first line for the column heading, then a bulleted list of links."
      }, {
        "type": "text",
        "id": "newsletter_title",
        "label": "Newsletter heading",
        "default": "Stay in the loop"
      }, {
        "type": "richtext",
        "id": "newsletter_text",
        "label": "Newsletter text",
        "default": "<p>An easy, affordable way to enjoy clean, great-tasting filtered water.</p>"
      }, {
        "type": "text",
        "id": "newsletter_success",
        "label": "Newsletter success message",
        "info": "Shown after someone signs up.",
        "default": "Thank you, your subscription has been received."
      }, {
        "type": "checkbox",
        "id": "show_socials",
        "label": "Show social icons",
        "info": "Under the newsletter sign-up. Not part of the current design.",
        "default": false
      }, {
        "type": "text",
        "id": "socials_title",
        "label": "Socials Title",
        "default": "Follow Us On"
      }, {
        "type": "text",
        "id": "socials_fb",
        "label": "Facebook URL"
      }, {
        "type": "text",
        "id": "socials_tw",
        "label": "Twitter URL"
      }, {
        "type": "text",
        "id": "socials_ig",
        "label": "Instagram URL"
      }, {
        "type": "text",
        "id": "socials_yt",
        "label": "Youtube URL"
      }, {
        "type": "text",
        "id": "contact_title",
        "label": "Contacts Title",
        "info": "No longer shown in the footer."
      }, {
        "type": "text",
        "id": "phone",
        "label": "Phone #"
      }, {
        "type": "text",
        "id": "email",
        "label": "Email"
      }, {
        "type": "richtext",
        "id": "terms",
        "label": "Terms"
      }, {
        "type": "richtext",
        "id": "disclaimer",
        "label": "Disclaimer",
        "info": "Copyright line. [dyn-year] shows the current year."
      }
    ],
    "presets": [
      {
        "name": "Footer"
      }
    ],
    "enabled_on": {
      "groups": ["footer"]
    }
  }
{% endschema %}