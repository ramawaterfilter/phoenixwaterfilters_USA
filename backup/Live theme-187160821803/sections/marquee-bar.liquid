<div class="swiper-container marquee-bar-swiper">
	<div class="swiper-wrapper">
		{% for block in section.blocks %}
			<div class="swiper-slide d-flex justify-content-center align-items-center">
				<p>{{ block.settings.text }}</p>
			</div>
		{% endfor %}
	</div>
</div>

{% schema %}
	{
		"name": "Marquee Bar",
		"tag": "section",
		"class": "section-marquee-bar",
		"blocks": [
			{
				"name": "Slide",
				"type": "slide",
				"settings": [
					{
						"type": "text",
						"id": "text",
						"label": "Slide Text"
					}
				]
			}
		],
		"presets": [
			{
				"name": "Marquee Bar"
			}
		],
	    "disabled_on": {
	        "groups": ["header"]
	    }
	}
{% endschema %}