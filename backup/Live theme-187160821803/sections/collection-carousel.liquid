<div class="container kji">
	<div class="row justify-content-center">
		<div class="col-md-10 col-lg-8">
			<h2 class="text-center">
				{{ section.settings.heading }}
			</h2>
		</div>
	</div>

	<div class="row justify-content-center">
		<div class="col-md-10 col-lg-12">
			<div
			class="swiper-container collections-carousel-swiper"
			data-slidesperview="{{ section.settings.slides_per_view }}"
			data-spacebetween="30">
				<div class="swiper-wrapper">

					{%- for collection in section.settings.collection_list -%}

					<div class="swiper-slide">
						<div class="swiper-slide__inner d-flex justify-content-center align-items-center">
							{% render 'collection-tile', collection: collection %}
						</div>
					</div>

					{%- endfor -%}

				</div>

				<div class="swiper-pagination"></div>
			</div>
		</div>
	</div>
</div>
{% if template == 'collection' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {
        "@type": "ListItem",
        "position": 1,
        "name": "Home",
        "item": "{{ shop.url }}"
      },
      {
        "@type": "ListItem",
        "position": 2,
        "name": "{{ collection.title | escape }}",
        "item": "{{ shop.url }}{{ collection.url }}"
      }
    ]
  }
  </script>
{% endif %}

{% schema %}
{
	"name": "Collections Carousel",
	"tag": "section",
	"class": "section-collections-carousel",
	"presets": [
		{
			"name": "Collections Carousel"
		}
	],
	"settings": [
		{
			"type": "text",
			"id": "heading",
			"label": "Section Heading",
			"default": "Collection Carousel"
		}, 
		{
			"type": "collection_list",
			"id": "collection_list",
			"label": "Collections",
			"limit": 16
		},
		{
			"type": "number",
			"id": "slides_per_view",
			"label": "Slides Per View",
			"default": 3
		}
	],
    "disabled_on": {
        "groups": ["header"]
    }
}
{% endschema %}