{{ 'subscribe-save.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} .ss-costs { --ss-bg: {{ section.settings.background_color }}; --ss-ink: {{ section.settings.text_color }}; --ss-pad: {{ section.settings.desktop_padding }}px; --ss-pad-mobile: {{ section.settings.mobile_padding }}px; }
{% endstyle %}
<section id="{{ section.settings.anchor_id | escape }}" class="ss ss-costs">
  <div class="ss-wrap">
    <header class="ss-intro">
      <p class="ss-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="ss-intro-copy">
        {% render 'ss-qa-body',
          body: section.settings.body,
          qa_1: section.settings.qa_1,
          qa_2: section.settings.qa_2,
          qa_3: section.settings.qa_3
        %}
      </div>
    </header>
    <div class="ss-cost-metrics">
      {% for block in section.blocks -%}
        {%- if block.settings.mode == 'metric' %}
          <div class="ss-card" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.value | escape }}</strong><span>{{ block.settings.label | escape }}</span
            ><small>{{ block.settings.support | escape }}</small>
          </div>
        {% endif -%}
      {%- endfor %}
    </div>
    <div class="ss-table-wrap">
      <table>
        <caption class="ss-visually-hidden">
          Annual subscription cost comparison
        </caption>
        <thead>
          <tr>
            <th scope="col">A year of filtered water</th>
            <th scope="col">Deliveries</th>
            <th scope="col">One-time price</th>
            <th scope="col">Subscribe &amp; Save</th>
            <th scope="col">You save</th>
            <th scope="col">¢ / gal</th>
          </tr>
        </thead>
        <tbody>
          {% for block in section.blocks -%}
            {%- if block.settings.mode == 'row' %}
              <tr {{ block.shopify_attributes }}>
                <th scope="row">
                  {{ block.settings.label | escape -}}
                  <small>{{ block.settings.support | escape }}</small>
                </th>
                <td data-label="Deliveries">{{ block.settings.deliveries | escape }}</td>
                <td data-label="One-time price">{{ block.settings.one_time | escape }}</td>
                <td data-label="Subscribe & Save">{{ block.settings.subscriber | escape }}</td>
                <td data-label="You save">{{ block.settings.saving | escape }}</td>
                <td data-label="¢ / gal">{{ block.settings.per_gallon | escape }}</td>
              </tr>
            {% endif -%}
          {%- endfor %}
        </tbody>
      </table>
    </div>
    <div class="ss-small">{{ section.settings.footnote }}</div>
  </div>
</section>
{% schema %}
{
  "name": "Subscribe Save Costs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body copy"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "default": "costs"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#153a5b"
    },
    {
      "type": "range",
      "id": "desktop_padding",
      "label": "Desktop vertical spacing",
      "default": 88,
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical spacing",
      "default": 56,
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px"
    },
    {
      "type": "richtext",
      "id": "footnote",
      "label": "Cost footnote"
    }
  ],
  "blocks": [
    {
      "type": "cost_item",
      "name": "Cost item",
      "settings": [
        {
          "type": "select",
          "id": "mode",
          "label": "Display as",
          "default": "metric",
          "options": [
            {
              "value": "metric",
              "label": "Metric"
            },
            {
              "value": "row",
              "label": "Table row"
            }
          ]
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Metric value"
        },
        {
          "type": "text",
          "id": "support",
          "label": "Supporting text"
        },
        {
          "type": "text",
          "id": "deliveries",
          "label": "Deliveries"
        },
        {
          "type": "text",
          "id": "one_time",
          "label": "One-time price"
        },
        {
          "type": "text",
          "id": "subscriber",
          "label": "Subscription price"
        },
        {
          "type": "text",
          "id": "saving",
          "label": "Saving"
        },
        {
          "type": "text",
          "id": "per_gallon",
          "label": "Cost per gallon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Subscribe Save Costs",
      "blocks": [
        {
          "type": "cost_item",
          "settings": {
            "mode": "metric",
            "value": "2.2¢",
            "label": "per gallon",
            "support": "carbon filtration"
          }
        },
        {
          "type": "cost_item",
          "settings": {
            "mode": "metric",
            "value": "5.6¢",
            "label": "per gallon",
            "support": "fluoride reduction"
          }
        },
        {
          "type": "cost_item",
          "settings": {
            "mode": "metric",
            "value": "$296",
            "label": "a year",
            "support": "with optional POSTreat"
          }
        }
      ]
    }
  ]
}
{% endschema %}
