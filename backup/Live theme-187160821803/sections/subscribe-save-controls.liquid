      "default": 88,
      "min": 40,
      "max": 160,
      "step": 8,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "mobile_padding",
      "label": "Mobile vertical spacing",
      "default": 56,
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px"
    },
    {
      "type": "image_picker",
      "id": "account_video_poster",
      "label": "Account video poster"
    },
