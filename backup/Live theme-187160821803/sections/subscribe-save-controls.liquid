    },
    {
      "type": "inline_richtext",
      "id": "account_video_heading",
      "label": "Video heading"
    },
    {
      "type": "richtext",
      "id": "account_video_body",
      "label": "Video copy"
    },
    {
      "type": "text",
      "id": "account_video_status",
      "label": "Video status"
    },
    {
      "type": "richtext",
      "id": "account_video_transcript",
      "label": "Video transcript"
    },
    {
      "type": "richtext",
      "id": "promises",
      "label": "Account promises"
    },
    {
      "type": "text",
      "id": "account_button",
      "label": "Account button label"
    },
    {
      "type": "richtext",
      "id": "canceled_note",
      "label": "Canceled note"
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Example account label"
    },
    {
      "type": "image_picker",
      "id": "portal_image",
      "label": "Example product image"
    },
    {
      "type": "text",
      "id": "portal_title",
      "label": "Example product title"
    },
    {
      "type": "text",
