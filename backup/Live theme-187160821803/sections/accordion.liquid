{%- comment -%}
  The panel list lives in `snippets/accordion-panels.liquid` so that
  `sections/kk-fws-offer.liquid` can render the same panels inside its media column.
  This section keeps the container, the heading/content and the schema; the snippet
  owns every `<dt>`/`<dd>` and the metafield lookups behind them.
{%- endcomment -%}

{% assign row_styles = 'row justify-content-center mb-5' %}
{% assign column_styles = 'col-11 col-md-12' %}
{% if section.settings.accordion_styles == 'center' %}
  {% assign row_styles = 'row justify-content-center mb-5 accordion-padding' %}
  {% assign column_styles = 'col-11 col-md-8' %}
{% endif %}

<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="container">
    <div class="{{ row_styles }}">
      {% if section.settings.content != blank or section.settings.heading != blank %}
        <div class="col-12 text-center">
          {% if section.settings.heading %}
            <h2>{{ section.settings.heading }}</h2>
          {% endif %}
          {{ section.settings.content }}
        </div>
      {% endif %}

      <div class="{{ column_styles }}">
        {% render 'accordion-panels', blocks: section.blocks %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Dropdown Accordion",
  "tag": "section",
  "class": "section-accordion p-0",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "content",
      "label": "Content"
    },
    {
      "type": "select",
      "id": "accordion_styles",
      "label": "Style",
      "default": "full-width",
      "options": [
        {
          "label": "Full Width",
          "value": "full-width"
        },
        {
          "label": "Centered",
          "value": "center"
        }
      ]
    },
    {
      "type": "header",
      "content": "Custom Code",
      "info": "Add classes or ID to the section"
    },
    {
      "type": "text",
      "id": "custom_id",
      "label": "Custom ID"
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom Class"
    }
  ],
  "blocks": [
    {
      "type": "text",
      "name": "Accordion Item",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Dropdown Accordion"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  }
}
{% endschema %}
