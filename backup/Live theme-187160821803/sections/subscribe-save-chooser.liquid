{{ 'subscribe-save.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} .ss-chooser { --ss-bg: {{ section.settings.background_color }}; --ss-ink: {{ section.settings.text_color }}; --ss-pad: {{ section.settings.desktop_padding }}px; --ss-pad-mobile: {{ section.settings.mobile_padding }}px; }
{% endstyle %}
<section id="{{ section.settings.anchor_id | escape }}" class="ss ss-chooser">
  <div class="ss-wrap">
    <header class="ss-intro">
      <p class="ss-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <h2>{{ section.settings.heading }}</h2>
      <div class="ss-intro-copy">
        {% render 'ss-qa-body',
          body: section.settings.body,
          qa_1: section.settings.qa_1,
          qa_2: section.settings.qa_2,
          qa_3: section.settings.qa_3
        %}
      </div>
    </header>
    <div class="ss-decision-grid">
      {% for block in section.blocks -%}
        {%- if block.type == 'choice_step' %}
          <article
            class="ss-card {% if block.settings.style == 'featured' %}ss-card-featured{% endif %}"
            {{ block.shopify_attributes }}
          >
            <span class="ss-mono">{{ block.settings.eyebrow | escape }}</span>
            <h3>{{ block.settings.title }}</h3>
            <div class="ss-copy">{{ block.settings.body }}</div>
            {% if block.settings.button_url != blank -%}
              <a class="ss-text-link" href="{{ block.settings.button_url }}">
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif %}
          </article>
        {% endif -%}
      {%- endfor %}
    </div>
    <aside class="ss-recommendation">
      <strong class="ss-mono">{{ section.settings.recommendation_label | escape }}</strong>
      <div class="ss-copy">{{ section.settings.recommendation_body }}</div>
    </aside>
    <div class="ss-parts-heading">
      <p class="ss-eyebrow">{{ section.settings.parts_eyebrow | escape }}</p>
      <h3>{{ section.settings.parts_heading }}</h3>
    </div>
    <div class="ss-parts-grid">
      {% for block in section.blocks -%}
        {%- if block.type == 'replacement_item' %}
          <article class="ss-card" {{ block.shopify_attributes }}>
            <div class="ss-part-image">
              {% if block.settings.image != blank -%}
                {{-
                  block.settings.image
                  | image_url: width: 720
                  | image_tag:
                    widths: '320, 480, 720',
                    sizes: '(min-width: 900px) 28vw, 90vw',
                    loading: 'lazy',
                    alt: block.settings.image_alt
                -}}
              {%- else %}
                <div class="ss-media-placeholder" aria-hidden="true"></div>
              {% endif %}
            </div>
            <h4>{{ block.settings.title }}</h4>
            <div class="ss-copy">{{ block.settings.body }}</div>
            {% if block.settings.button_url != blank -%}
              <a class="ss-text-link" href="{{ block.settings.button_url }}">
                {{- block.settings.button_label | escape -}}
              </a>
            {%- endif %}
          </article>
        {% endif -%}
      {%- endfor %}
    </div>
    <div class="ss-video-layout ss-refill-preview">
      <div class="ss-video-frame">
        {% if section.settings.walkthrough_media_type == 'video' and section.settings.walkthrough_video != blank -%}
          {%- assign walkthrough_video_poster = section.settings.walkthrough_poster
            | default: section.settings.walkthrough_video.preview_image
          -%}
          <video
            controls
            preload="none"
            playsinline
            aria-label="{{ section.settings.walkthrough_heading | strip_html | escape }}"
            {% if walkthrough_video_poster != blank %}
              poster="{{ walkthrough_video_poster | image_url: width: 1200 }}"
            {% endif %}
          >
            {% for source in section.settings.walkthrough_video.sources %}
              <source src="{{ source.url | escape }}" type="{{ source.mime_type | escape }}">
            {% endfor %}
          </video>
        {%- elsif section.settings.walkthrough_poster != blank -%}
          {{-
            section.settings.walkthrough_poster
            | image_url: width: 1200
            | image_tag:
              widths: '480, 720, 960, 1200',
              sizes: '(min-width: 900px) 52vw, 100vw',
              loading: 'lazy',
              alt: section.settings.walkthrough_heading
          -}}
        {%- else %}
          <div class="ss-media-placeholder" aria-hidden="true"></div>
        {% endif %}
      </div>
      <div>
        <p class="ss-eyebrow">{{ section.settings.walkthrough_eyebrow | escape }}</p>
        <h3>{{ section.settings.walkthrough_heading }}</h3>
        <div class="ss-copy">{{ section.settings.walkthrough_body }}</div>
        <p class="ss-small">{{ section.settings.walkthrough_status | escape }}</p>
      </div>
    </div>
    <div class="ss-refill-guide">
      <figure>
        {% if section.settings.refill_image != blank -%}
          {{-
            section.settings.refill_image
            | image_url: width: 960
            | image_tag:
              widths: '480, 720, 960',
              sizes: '(min-width: 900px) 38vw, 100vw',
              loading: 'lazy',
              alt: section.settings.refill_caption
          -}}
        {%- else %}
          <div class="ss-media-placeholder" aria-hidden="true"></div>
        {% endif %}
        <figcaption>{{ section.settings.refill_caption | escape }}</figcaption>
      </figure>
      <div>
        <h3>{{ section.settings.refill_heading }}</h3>
        {% if section.settings.refill_intro != blank %}
          <div class="ss-copy">{{ section.settings.refill_intro }}</div>
        {% endif %}
        <ol class="ss-refill-steps">
          {% for block in section.blocks -%}
            {%- if block.type == 'info_card' %}
              <li {{ block.shopify_attributes }}>
                <span class="ss-step-number">{{ block.settings.number | escape }}</span>
                {{- block.settings.title | escape }}
              </li>
            {% endif -%}
          {%- endfor %}
        </ol>
        <div class="ss-copy">{{ section.settings.refill_closing }}</div>
        {% if section.settings.help_link != blank -%}
          <a class="ss-text-link" href="{{ section.settings.help_link }}">
            {{- section.settings.help_link_label | escape -}}
          </a>
        {%- else -%}
          <span class="ss-small">
            {%- render 'ss-qa-body', body: '%%QA1%%', qa_1: section.settings.help_link_placeholder -%}
          </span>
        {%- endif %}
      </div>
    </div>
  </div>
</section>
{% schema %}
