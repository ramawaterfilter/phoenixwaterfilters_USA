{%- comment -%}
  KK FWS Marquee — Figma `7809:15045`.

  A navy strip of icon + text items, separated by small dots, scrolling continuously with the
  edges faded out. Each item is an "Item" block.

  Built on the boilerplate marquee pattern (boilerplate/marquee): the blocks render ONCE as the
  repeat unit (`[data-kk-fws-marquee-items]`), and the script below clones that unit until the
  track is at least twice the strip's width, so the CSS animation can loop by exactly one unit
  without a gap. Clones are aria-hidden, so assistive tech reads the list once. It re-measures
  on resize and after the icons load. With reduced motion requested, nothing is cloned and the
  first unit simply sits still (scrollable sideways if it overflows).

  Optional title — Figma `7809:10066` (desktop), `7809:11434` (mobile): the title and a short
  divider sit on the left of the container and the items scroll in their own window, fading out
  before they reach the title. Items can carry a lighter description (e.g. "99.99%"), and the
  separator dots can be turned off (that design spaces items 56px apart with no dots).
{%- endcomment -%}

{%- assign item_blocks = section.blocks | where: 'type', 'item' -%}

{%- if item_blocks.size > 0 -%}
  <section
    class="kk-fws-marquee{% if section.settings.pause_on_hover %} kk-fws-marquee--pausable{% endif %}{% if section.settings.direction == 'right' %} kk-fws-marquee--reverse{% endif %}{% if section.settings.title != blank %} kk-fws-marquee--titled{% endif %}{% unless section.settings.show_dots %} kk-fws-marquee--no-dots{% endunless %}"
    data-kk-fws-marquee
    style="
      --kk-fws-marquee-background: {{ section.settings.background_color }};
      --kk-fws-marquee-text: {{ section.settings.text_color }};
      --kk-fws-marquee-duration: {{ section.settings.duration }}s;
    "
  >
    <div class="kk-fws-marquee__inner">
      {%- if section.settings.title != blank -%}
        <p class="kk-fws-marquee__title">{{ section.settings.title }}</p>
        <span class="kk-fws-marquee__divider" aria-hidden="true"></span>
      {%- endif -%}
      <div class="kk-fws-marquee__viewport">
        <div class="kk-fws-marquee__track" data-kk-fws-marquee-track>
          <ul class="kk-fws-marquee__items" data-kk-fws-marquee-items>
            {%- for block in item_blocks -%}
              {%- if block.settings.text != blank -%}
                <li class="kk-fws-marquee__item" {{ block.shopify_attributes }}>
                  {%- if block.settings.custom_icon != blank -%}
                    {{
                      block.settings.custom_icon
                      | image_url: width: 56
                      | image_tag: class: 'kk-fws-marquee__icon', width: 28, height: 28, loading: 'eager', alt: ''
                    }}
                  {%- elsif block.settings.icon != 'none' -%}
                    <img
                      class="kk-fws-marquee__icon"
                      src="{{ 'kk-fws-icon-' | append: block.settings.icon | append: '.svg' | asset_url }}"
                      alt=""
                      width="28"
                      height="28"
                      aria-hidden="true"
                    >
                  {%- endif -%}
                  <span class="kk-fws-marquee__text">{{ block.settings.text }}</span>
                  {%- if block.settings.description != blank -%}
                    <span class="kk-fws-marquee__description">{{ block.settings.description }}</span>
                  {%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      var root = document.currentScript && document.currentScript.previousElementSibling;
      if (!root || !root.hasAttribute('data-kk-fws-marquee')) return;

      var track = root.querySelector('[data-kk-fws-marquee-track]');
      var viewport = track && track.parentNode;
      var unit = root.querySelector('[data-kk-fws-marquee-items]');
      if (!track || !unit) return;

      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        root.classList.add('is-static');
        return;
      }

      function fill() {
        var unitWidth = unit.getBoundingClientRect().width;
        if (!unitWidth) return;

        var clones = track.querySelectorAll('[data-kk-fws-marquee-clone]');
        var needed = Math.max(1, Math.ceil((viewport.clientWidth * 2) / unitWidth) - 1);

        for (var i = clones.length; i < needed; i++) {
          var clone = unit.cloneNode(true);
          clone.removeAttribute('data-kk-fws-marquee-items');
          clone.setAttribute('data-kk-fws-marquee-clone', '');
          clone.setAttribute('aria-hidden', 'true');
          [].forEach.call(clone.querySelectorAll('[data-shopify-editor-block]'), function (node) {
            node.removeAttribute('data-shopify-editor-block');
          });
          track.appendChild(clone);
        }

        root.classList.add('is-running');
      }

      // Measure only once the icons have their size, as the boilerplate marquee does.
      var pending = [].filter.call(unit.querySelectorAll('img'), function (img) {
        return !img.complete;
      });
      var waiting = pending.length;
      var settle = function () {
        waiting -= 1;
        if (waiting <= 0) fill();
      };
      pending.forEach(function (img) {
        img.addEventListener('load', settle, { once: true });
        img.addEventListener('error', settle, { once: true });
      });
      if (!waiting) fill();

      if ('ResizeObserver' in window) {
        new ResizeObserver(fill).observe(root);
      }
    })();
  </script>
{%- endif -%}

{% stylesheet %}
  /* Figma `7809:15045`: navy, 30px top and bottom, 44px between an item and a dot, 180px fades
     at both edges. */
  .kk-fws-marquee {
    --kk-fws-marquee-gap: 4.4rem;

    position: relative;
    overflow: hidden;
    padding: 3rem 0;
    background: var(--kk-fws-marquee-background, var(--primary));
  }

  .kk-fws-marquee::before,
  .kk-fws-marquee::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 1;
    width: min(18rem, 15%);
    pointer-events: none;
  }

  .kk-fws-marquee::before {
    left: 0;
    background: linear-gradient(90deg, var(--kk-fws-marquee-background, var(--primary)), transparent);
  }

  .kk-fws-marquee::after {
    right: 0;
    background: linear-gradient(270deg, var(--kk-fws-marquee-background, var(--primary)), transparent);
  }

  .kk-fws-marquee__track {
    display: flex;
    width: max-content;
    gap: var(--kk-fws-marquee-gap);
    padding-left: var(--kk-fws-marquee-gap);
  }

  /* Each repeat unit moves left by its own width plus one gap, then snaps back — the next unit
     has taken its place, so the loop is seamless. */
  .kk-fws-marquee.is-running .kk-fws-marquee__items {
    animation: kk-fws-marquee var(--kk-fws-marquee-duration, 40s) linear infinite;
  }

  .kk-fws-marquee--reverse.is-running .kk-fws-marquee__items {
    animation-direction: reverse;
  }

  .kk-fws-marquee--pausable:hover .kk-fws-marquee__items {
    animation-play-state: paused;
  }

  @keyframes kk-fws-marquee {
    from {
      transform: translateX(0);
    }

    to {
      transform: translateX(calc(-100% - var(--kk-fws-marquee-gap)));
    }
  }

  .kk-fws-marquee__items {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: var(--kk-fws-marquee-gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .kk-fws-marquee__item {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    gap: 1.4rem;
  }

  /* The 6px separator dot. Drawn after every item, including the last, because the next
     repeat unit follows it. */
  .kk-fws-marquee__item::after {
    content: '';
    flex-shrink: 0;
    width: 0.6rem;
    height: 0.6rem;
    margin-left: calc(var(--kk-fws-marquee-gap) - 1.4rem);
    border-radius: 50%;
    background: var(--primary-100);
  }

  .kk-fws-marquee__icon {
    display: block;
    flex-shrink: 0;
    width: 2.8rem;
    height: 2.8rem;
    object-fit: contain;
  }

  .kk-fws-marquee__text {
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 2rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--kk-fws-marquee-text, #ffffff);
  }

  .kk-fws-marquee__description {
    font-family: 'Value Sans', sans-serif;
    font-weight: 400;
    font-size: 1.7rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--kk-fws-marquee-text, #ffffff);
    opacity: 0.62;
  }

  /* No separator dots — Figma `7809:10066`: items 56px apart. */
  .kk-fws-marquee--no-dots {
    --kk-fws-marquee-gap: 5.6rem;
  }

  .kk-fws-marquee--no-dots .kk-fws-marquee__item::after {
    content: none;
  }

  /* Titled — Figma `7809:10066`: 44px top and bottom; title, a 56px divider and the scrolling
     window 28px apart inside the 1312px container. The strip-wide edge fades give way to a fade
     on the window itself, so items dissolve before they reach the divider and the title. */
  .kk-fws-marquee--titled {
    padding: 4.4rem 0;
  }

  .kk-fws-marquee--titled::before,
  .kk-fws-marquee--titled::after {
    content: none;
  }

  .kk-fws-marquee--titled .kk-fws-marquee__inner {
    display: flex;
    align-items: center;
    gap: 2.8rem;
    width: min(100% - 12.8rem, 131.2rem);
    margin: 0 auto;
  }

  .kk-fws-marquee__title {
    flex-shrink: 0;
    margin: 0;
    font-family: 'Value Sans Medium', sans-serif;
    font-weight: 500;
    font-size: 2.2rem;
    line-height: 1;
    white-space: nowrap;
    color: var(--kk-fws-marquee-text, #ffffff);
  }

  .kk-fws-marquee__divider {
    flex-shrink: 0;
    width: 5.6rem;
    height: 1px;
    background: var(--kk-fws-marquee-text, #ffffff);
    opacity: 0.35;
  }

  .kk-fws-marquee--titled .kk-fws-marquee__viewport {
    flex: 1 1 auto;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }

  .kk-fws-marquee--titled .kk-fws-marquee__item {
    gap: 1.4rem;
  }

  .kk-fws-marquee--titled .kk-fws-marquee__icon {
    width: 3.6rem;
    height: 3.6rem;
  }

  .kk-fws-marquee--titled .kk-fws-marquee__text {
    font-size: 2.2rem;
  }

  /* Reduced motion: no clones, no animation; the row can be scrolled by hand instead. */
  .kk-fws-marquee.is-static .kk-fws-marquee__track {
    width: auto;
    overflow-x: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .kk-fws-marquee .kk-fws-marquee__items {
      animation: none;
    }
  }

  @media (max-width: 749px) {
    .kk-fws-marquee {
      --kk-fws-marquee-gap: 2.8rem;

      padding: 2rem 0;
    }

    .kk-fws-marquee__item {
      gap: 1rem;
    }

    .kk-fws-marquee__item::after {
      margin-left: calc(var(--kk-fws-marquee-gap) - 1rem);
    }

    .kk-fws-marquee__icon {
      width: 2.2rem;
      height: 2.2rem;
    }

    .kk-fws-marquee__text,
    .kk-fws-marquee__description {
      font-size: 1.5rem;
    }

    .kk-fws-marquee--no-dots {
      --kk-fws-marquee-gap: 2.2rem;
    }

    /* Titled — Figma `7809:11434`: 14px top and bottom, 20px gutters, the title wrapping onto
       two lines at 68px, no divider. */
    .kk-fws-marquee--titled {
      padding: 1.4rem 0;
    }

    .kk-fws-marquee--titled .kk-fws-marquee__inner {
      gap: 1.5rem;
      width: calc(100% - 4rem);
    }

    .kk-fws-marquee__title {
      max-width: 6.8rem;
      font-size: 1.4rem;
      line-height: 1.15;
      white-space: normal;
    }

    .kk-fws-marquee__divider {
      display: none;
    }

    .kk-fws-marquee--titled .kk-fws-marquee__item {
      gap: 0.8rem;
    }

    .kk-fws-marquee--titled .kk-fws-marquee__icon {
      width: 2.6rem;
      height: 2.6rem;
    }

    .kk-fws-marquee--titled .kk-fws-marquee__text {
      font-size: 1.5rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KK FWS Marquee",
  "tag": "div",
  "class": "section-kk-fws-marquee",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "info": "Optional, e.g. \"Our Filters Remove\". Shown on the left; the items fade out before reaching it."
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show separator dots",
      "default": true
    },
    {
      "type": "range",
      "id": "duration",
      "label": "Seconds per loop",
      "info": "Lower is faster.",
      "min": 10,
      "max": 120,
      "step": 5,
      "unit": "s",
      "default": 40
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        { "value": "left", "label": "Right to left" },
        { "value": "right", "label": "Left to right" }
      ],
      "default": "left"
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#0b1638"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "lab-report", "label": "Lab report" },
            { "value": "shield-outline", "label": "Shield" },
            { "value": "water-drop", "label": "Water drop" },
            { "value": "none", "label": "None" }
          ],
          "default": "lab-report"
        },
        {
          "type": "image_picker",
          "id": "custom_icon",
          "label": "Custom icon",
          "info": "Overrides the icon selected above. Shown at 28 x 28."
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "info": "An item with no text is not shown."
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "info": "Optional lighter text after the item, e.g. \"99.99%\"."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "KK FWS Marquee",
      "blocks": [
        { "type": "item", "settings": { "icon": "lab-report" } },
        { "type": "item", "settings": { "icon": "shield-outline" } },
        { "type": "item", "settings": { "icon": "water-drop" } }
      ]
    }
  ]
}
{% endschema %}
