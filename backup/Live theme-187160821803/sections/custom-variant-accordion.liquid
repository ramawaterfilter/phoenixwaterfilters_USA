{{ 'custom-variant-accordion.css' | asset_url | stylesheet_tag }}
<script src="{{ 'custom-variant-accordion.js' | asset_url }}" defer="defer"></script>
{%- assign current_variant = product.selected_or_first_available_variant -%}
<custom-variant-accordion
  class="cva"
  data-section-id="{{ section.id }}"
  data-variant="{{ current_variant.id }}"
  data-product-url="{{ product.url }}"
  {% if section.settings.single_open %}single-open{% endif %}
>
  <div class="container">
    <div class="row justify-content-center mb-5">
      {% if section.settings.heading != blank or section.settings.content != blank %}
        <div class="col-12 text-center">
          {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
          {{ section.settings.content }}
        </div>
      {% endif %}
      <div class="{% if section.settings.width == 'center' %}col-11 col-md-8{% else %}col-11 col-md-12{% endif %}" data-accordion-body>
        {%- assign first_visible = true -%}
        {%- for block in section.blocks -%}
          {%- liquid
            assign owner = nil
            if block.settings.source == 'product'
              assign owner = product
            elsif block.settings.source == 'variant'
              assign owner = current_variant
            endif
            assign allowed_ids = block.settings.variant_ids | remove: ' ' | split: ','
            assign variant_id = current_variant.id | append: ''
            assign visible = false
            if block.settings.variant_ids == blank or allowed_ids contains variant_id
              assign visible = true
            endif
          -%}
          {%- capture content -%}
            {% render 'custom-accordion-value', owner: owner, key: block.settings.content_key, kind: 'richtext', fallback: block.settings.content %}
          {%- endcapture -%}
          {%- capture image -%}
            {% render 'custom-accordion-value', owner: owner, key: block.settings.image_key, kind: 'image', fallback: block.settings.image %}
          {%- endcapture -%}
          <details class="cva__panel" data-block-id="{{ block.id }}"
            {% unless visible %}hidden{% endunless %}
            {% if visible and first_visible and section.settings.open_first %}open{% endif %}
            {{ block.shopify_attributes }}
          >
            <summary>{{ block.settings.title | escape }}</summary>
            <div class="cva__body cva__body--{{ block.type }}">
              {%- case block.type -%}
                {%- when 'specifications' -%}
                  {{ content }}
                  <div class="cva__split">
                    <div class="cva__specs">
                      <table class="cva__table">
                        <tbody>
                          {%- for index in (1..6) -%}
                            {%- liquid
                              assign label_id = 'label_' | append: index
                              assign value_id = 'value_' | append: index
                              assign key_id = 'value_key_' | append: index
                            -%}
                            {%- capture value -%}
                              {% render 'custom-accordion-value', owner: owner, key: block.settings[key_id], kind: 'richtext', fallback: block.settings[value_id] %}
                            {%- endcapture -%}
                            {% if block.settings[label_id] != blank %}
                              <tr><th scope="row">{{ block.settings[label_id] | escape }}</th><td>{{ value }}</td></tr>
                            {% endif %}
                          {%- endfor -%}
                        </tbody>
                      </table>
                    </div>
                    {% if image != blank %}<div class="cva__image">{{ image }}</div>{% endif %}
                  </div>
                {%- when 'text_image' -%}
                  <div class="cva__split">
                    <div class="cva__text">{{ content }}</div>
                    {% if image != blank %}<div class="cva__image">{{ image }}</div>{% endif %}
                  </div>
                {%- when 'reports' -%}
                  {{ content }}
                  <div class="cva__reports">
                    {%- for index in (1..3) -%}
                      {%- liquid
                        assign title_id = 'report_title_' | append: index
                        assign title_key = 'report_title_key_' | append: index
                        assign image_id = 'report_image_' | append: index
                        assign image_key = 'report_image_key_' | append: index
                        assign url_id = 'report_url_' | append: index
                        assign url_key = 'report_url_key_' | append: index
                        assign link_label = 'report_link_label_' | append: index
                      -%}
                      {%- capture report_title -%}{% render 'custom-accordion-value', owner: owner, key: block.settings[title_key], kind: 'text', fallback: block.settings[title_id] %}{%- endcapture -%}
                      {%- capture report_image -%}{% render 'custom-accordion-value', owner: owner, key: block.settings[image_key], kind: 'image', fallback: block.settings[image_id] %}{%- endcapture -%}
                      {%- capture report_url -%}{% render 'custom-accordion-value', owner: owner, key: block.settings[url_key], kind: 'url', fallback: block.settings[url_id] %}{%- endcapture -%}
                      {% if report_title != blank or report_image != blank or report_url != blank %}
                        <div class="cva__report">
                          {{ report_image }}
                          {% if report_title != blank %}<h3>{{ report_title }}</h3>{% endif %}
                          {% if report_url != blank %}<a href="{{ report_url | escape }}" target="_blank" rel="noopener noreferrer">{{ block.settings[link_label] | escape }}</a>{% endif %}
                        </div>
                      {% endif %}
                    {%- endfor -%}
                  </div>
                {%- else -%}
                  {{ content }}
              {%- endcase -%}
            </div>
          </details>
          {%- if visible -%}{%- assign first_visible = false -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</custom-variant-accordion>
