<div class="container" >
    <div class="row">
        <div class="col-12">
            <div class="ratings d-flex justify-content-center flex-wrap">
                {% for block in section.blocks %}
                    {% if block.settings.logo != blank %}

                        <div class="ratings__logo mb-4 mb-md-0">
                            {{ block.settings.logo | image_url: width: 400 | image_tag }}
                        </div>
                    {% endif %}
                {% endfor %}
            </div>
        </div>
        <div class="col-12 text-center mt-5">
            <h5>{{ section.settings.tagline }}</h5>
        </div>
    </div>
</div>

{% schema %}
    {
        "name": "Ratings",
        "tag": "section",
        "class": "section-ratings",
        "settings": [
            {
                "id":"tagline",
                "type": "text",
                "label": "Tagline",
                "default": "Over 1100 x 5 star reviews"
            }
        ],
        "presets": [
            {
                "name": "Ratings"
            }
        ],
        "blocks": [
            {
                "name": "Logo",
                "type": "logo",
                "settings": [
                    {
                        "type": "image_picker",
                        "id": "logo",
                        "label": "Logo"
                    }
                ]
            }
        ],
        "disabled_on": {
            "groups": [
                "header",
                "footer"
            ]
        }
    }
{% endschema %}