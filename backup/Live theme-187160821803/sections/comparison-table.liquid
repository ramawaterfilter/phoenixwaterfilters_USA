        "type": "text",
        "id": "comparison_1",
        "label": "Comparison 1"
      }, {
        "type": "text",
        "id": "comparison_2",
        "label": "Comparison 2"
      }, {
        "type": "text",
        "id": "comparison_3",
        "label": "Comparison 3"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "checkbox",
        "id": "button_arrow",
        "label": "Show arrow on button",
        "default": true
      },
      {
        "type": "select",
        "id": "button_style",
