{% assign current_variant = product.selected_or_first_available_variant %}
<div class="container">
  <div class="row justify-content-center lk">
    <div class="col-11 jkl col-lg-6 pe-5">
      <div class="position-relative {% if product.images.size <= 0 %}h-100{% endif %}">
        {% render 'product-badge', product: product %}

        {% if product.images.size > 1 %}
          <div class="swiper-container swiper product-swiper" data-slidestoshow="1" id="product-slider">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% assign thisVariantID = "" %}
                {% for variant in product.variants %}
                  {% if variant.featured_image == media.src %}
                    {% assign thisVariantID = variant.id %}
                  {% endif %}
                {% endfor %}
                {% comment %} Add video check to conditional... maybe? {% endcomment %}
                {% if media.media_type == "external_video" %}
                  <div class="swiper-slide" data-variant-id="{{ thisVariantID }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | external_video_url: autoplay: 'true' }}" class="product-image product-image--video d-block">
                      {{ media.preview_image | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% elsif media.media_type == "image" %}
                  <div class="swiper-slide" data-variant-id="{{ thisVariantID }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | image_url: width: 2560 }}" class="product-image d-block">
                      {{ media | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="swiper-container swiper control {% if product.media.size == 3 %} control-three {% endif %} {% if product.media.size == 5 %}control-five{% endif %}" id="product-slider-nav">
            <div class="swiper-wrapper {% if product.media.size == 3 or product.media.size == 5 %}wide{% endif %}">
              {% for media in product.media %}
                {% if media.media_type == "external_video" %}
                  <div class="swiper-slide">
                    {{ media.preview_image | image_url: width: 600 | image_tag }}
                  </div>
                {% elsif media.media_type == "image" %}
                  <div class="swiper-slide">
                    {{ media | image_url: width: 1200 | image_tag }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="swiper-nav">
            <div class="swiper-button-prev swiper-prev"></div>
            <div class="swiper-button-next swiper-next"></div>
          </div>
        {% elsif product.featured_image %}
          <a data-fancybox="gallery" href="{{ product.featured_image | image_url: width: 2560 }}" class="product-image d-block">
            {{ product.featured_image | image_url: width: 1200| image_tag }}
          </a>
        {% else %}
          <div class="placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-11 gg col-lg-6 mt-3 mt-lg-0">
      {% render 'product-hero-countdown', section: section %}
      <h1>{{ product.title }}</h1>
      <div class="product-rating">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>
      {% render 'best-for-tag' %}
      {% if product.description != blank or product.metafields.custom.product_usps.value.size > 0 %}
        <div class="product-description">
          {{ product.description }}
          {% if product.metafields.custom.product_usps.value.size > 0 %}
            <ul class="product-description__usps">
              {% for usp in product.metafields.custom.product_usps.value %}
                <li>{{ usp }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}
      {% if settings.enable_minmax_buys %}
        {% assign min_buy = settings.min_buy_qty %}
        {% assign max_buy = settings.max_buy_qty %}
      {% endif %}
      <form action="/cart/add" method="post" enctype="multipart/form-data" id="add-to-cart" class="mb-5 main-add-to-cart" data-min="{{ min_buy }}" data-max="{{ max_buy }}">
        {% comment %} This handle is used with the min/max quantity js {% endcomment %}
        <input type="hidden" name="handle" value="{{ product.handle }}">
        {% comment %} Subscriptions Support {% endcomment %}
        {% if product.selling_plan_groups.size > 0 %}
          <div class="subscriptions d-none">
            {% for group in product.selling_plan_groups %}
              <div class="subscriptions__group">
                {% assign loop1 = forloop.index %}
                <p class="h4">{{ group.name }}</p>
                {% for selling_plan in group.selling_plans %}
                  <label for="plan-{{ forloop.index }}-{{ loop1 }}">
                    <input type="radio" id="plan-{{ forloop.index }}-{{ loop1 }}" name="selling_plan" value="{{ selling_plan.id }}" {% if forloop.index == 1 %}checked{% endif %} />
                    {{ selling_plan.name }}
                  </label>
                {% endfor %}
                {% comment %} If last loop {% endcomment %}
                {% if loop1 == product.selling_plan_groups.size and product.requires_selling_plan != true %}
                  <label for="plan-none">
                    <input type="radio" id="plan-none" name="selling_plan" value="" />
                    {{ 'products.product.no_selling_plan' | t }}
                  </label>
                {% endif %}
              </div>
            {% endfor %}
          </div>
        {% endif %}
        
        {% if product.available and product.variants.size > 1 %}
          <div id="product-variants">
            {% assign has_size_option = false %}
            
            {% if product.variants.size > 1 %}
                    

              <select id="product-selectors" name="id" data-productid="{{ product.id }}" data-label="{% if product.options.size == 1 %}{{ product.options[0] }}{% endif %}">
                {% for variant in product.variants %}
                  {% if variant.available %}

<!-- add by k for the product id  -->

                
                    <option {% if variant == current_variant %} selected="selected" {% endif %} value="{{ variant.id }}" data-price="{{ variant.price | money_with_currency }}" name="id" id="variant_{{ variant.id }}">
                      {{ variant.title }} <span class="small">({{ variant.price | money }} {{ cart.currency.iso_code }})</span>
                    </option>
                  {% else %}
                    <option disabled="disabled" data-price="{{ variant.price | money_with_currency }}" name="id"    id="variant_{{ variant.id }}" value="{{ variant.id }}">{{ variant.title }} - {{ 'products.product.inventory_out_of_stock' | t }}</option>
                  {% endif %}
                {% endfor %}
              </select>
             
             
            {% else %}
              <input name="id" data-productid="{{ product.id }}" value="{{ product.variants.first.id }}" type="hidden" />
            {% endif %}
          </div>
        {% elsif product.variants.size == 1 and product.available %}
          <input name="id" data-productid="{{ product.id }}" value="{{ product.variants.first.id }}" type="hidden" />
        {% endif %}
         

       

 {% if product.available %}
          {% comment %} <div class="product-quantity">
            <div class="qty-container">
              <label for="Quantity">{{ 'products.product.quantity.label' | t }} &nbsp; </label>
              <span class="qty-btn decrease js-qty-update">-</span>
              <input type="number" id="Quantity" name="quantity" data-qtt-id value="{{ min_buy }}" min="{{ min_buy }}" max="{{ max_buy }}">
              <span class="qty-btn increase js-qty-update">+</span>
              {% if current_variant.inventory_quantity >= 5 %}
                <span class="stock-indicator instock">
                  {{ 'products.product.inventory_in_stock' | t }}
                </span>
              {% elsif current_variant.inventory_quantity > 0 %}
                <span class="stock-indicator lowstock">
                  {{ 'products.product.inventory_low_stock' | t }}
                </span>
              {% elsif current_variant.inventory_management != null %}
                <span class="stock-indicator outofstock">
                  {{ 'products.product.inventory_out_of_stock' | t }}
                </span>
              {% endif %}
            </div>
          </div> 
        <div class="priceline">
          <span data-price class="product-dyn-price m-0">
            {{ product.variants.first.price | money }}
          </span> {{ shop.currency }}
          <span data-compare>
            <s>
              {% if product.variants.first.compare_at_price %}
                {{ product.variants.first.compare_at_price | money }}
              {% endif %}
            </s>
          </span>
        </div>{% endcomment %}
           {% comment %}  
          <p style="font-size:18px;text-align: center;margin-bottom: -11px;">Seal the deal! Use coupon <b><i>BIGDEAL20</i></b> to get an extra 20% Off. </p>
 {% endcomment %}
            <p class="js-availability-notice product-availability disabled {% if product.variants.size > 1 %} invalid {% endif %}">
              There are only <strong class="js-availablilty">{{ current_variant.inventory_quantity }}</strong> {{ product.title }}
              {% if product.variants.size > 1 %}
                <span class="js-varient">({{ product.variants.first.title.title }})</span>
              {% endif %}
              available in stock.
            </p>
            {% if current_variant.inventory_quantity > 0 or current_variant.inventory_management == null %}
              <div class="select-product d-flex flex-row align-items-center mt-5 ">
                 <span class="appstle_stand_alone_selector" data-product-handle="{{ product.handle }}" data-product-data="" style="display:none;"></span>
                <button class="btn btn-primary btn-product" type="submit" name="add" id="product-add-to-cart">
                  {{ 'products.product.add_to_cart' | t }}
                </button>
              
            {% elsif current_variant.inventory_policy == "continue" %}
              <div class="select-product d-flex flex-row align-items-center mt-5 ">
                <button class="btn btn-primary btn-product" type="submit" name="add" id="product-add-to-cart">
                  {{ 'products.product.pre_order' | t }}
                </button>
            {% endif %}
        {% else %}
          <div class="select-product d-flex flex-row align-items-center mt-5 "> 
            <input name="id" data-productid="{{ product.id }}" value="{{ product.variants.first.id }}" type="hidden" />
            <button class="btn btn-primary btn-product" name="add" disabled type="submit">
              {{ 'products.product.sold_out' | t }}
            </button>
        {% endif %}
         
   {% comment %} <div class="sale-badge">SALE</div> {% endcomment %}
