<script>
  (function() {
    class WistiaCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.videos = {};
        this.isWistiaReady = false;
        this.isMobile = window.innerWidth <= 767;
        this.currentIndex = 0;
        this.currentPlayingCardId = null;
      }

      connectedCallback() {
        this.loadWistiaScript();
        this.setupEventListeners();
        this.setupScrollObserver();
        
        window.addEventListener('resize', () => {
          this.isMobile = window.innerWidth <= 767;
        });
      }

      loadWistiaScript() {
        if (window._wq) {
          this.isWistiaReady = true;
          this.initializeVideos();
          return;
        }

        const script = document.createElement('script');
        script.src = 'https://fast.wistia.com/assets/external/E-v1.js';
        script.async = true;
        script.onload = () => {
          this.isWistiaReady = true;
          this.initializeVideos();
        };
        document.head.appendChild(script);
      }

      initializeVideos() {
        const videoContainers = this.querySelectorAll('[data-wistia-id]');
        
        videoContainers.forEach((container) => {
          const cardId = container.getAttribute('data-wistia-id');
          const embedCode = container.innerHTML;
          const match = embedCode.match(/wistia_async_([a-zA-Z0-9]+)/);
          
          if (match && match[1]) {
            const wistiaId = match[1];
            
            window._wq = window._wq || [];
            window._wq.push({
              id: wistiaId,
              onReady: (video) => {
                this.videos[cardId] = video;
                video.mute();
                video.pause();
                
                video.bind('play', () => {
                  this.handleVideoPlay(cardId);
                });
                
                video.bind('pause', () => {
                  this.handleVideoPause(cardId);
                });

                video.bind('end', () => {
                  this.handleVideoEnd(cardId);
                });
              }
            });
          }
        });
      }

      setupEventListeners() {
        const playPauseButtons = this.querySelectorAll('[data-play-pause]');
        const volumeButtons = this.querySelectorAll('[data-volume-toggle]');
        const dots = this.querySelectorAll('[data-dot-index]');
        const cards = this.querySelectorAll('.ai-wistia-carousel__card-{{ ai_gen_id }}');

        playPauseButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            const cardId = button.getAttribute('data-play-pause');
            this.togglePlayPause(cardId);
          });
        });

        volumeButtons.forEach((button) => {
          button.addEventListener('click', (e) => {
            e.stopPropagation();
            const cardId = button.getAttribute('data-volume-toggle');
            this.toggleVolume(cardId);
          });
        });

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const index = parseInt(dot.getAttribute('data-dot-index'));
            this.scrollToCard(index);
          });
        });

        cards.forEach((card) => {
          card.addEventListener('click', (e) => {
            if (e.target.closest('button') || e.target.closest('a')) {
              return;
            }
            const cardId = card.getAttribute('data-card-id');
            this.handleCardClick(cardId);
          });
        });
      }

      setupScrollObserver() {
        if (!this.isMobile) return;

        const grid = this.querySelector('[data-carousel-grid]');
        const cards = this.querySelectorAll('.ai-wistia-carousel__card-{{ ai_gen_id }}');
        
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
                const card = entry.target;
                const index = parseInt(card.getAttribute('data-card-index'));
                this.updateActiveDot(index);
                this.currentIndex = index;
              }
            });
          },
          {
            root: grid,
            threshold: 0.5
          }
        );

        cards.forEach((card) => {
          observer.observe(card);
        });
      }

      scrollToCard(index) {
        const grid = this.querySelector('[data-carousel-grid]');
        const cards = this.querySelectorAll('.ai-wistia-carousel__card-{{ ai_gen_id }}');
        const targetCard = Array.from(cards).find(
          (card) => parseInt(card.getAttribute('data-card-index')) === index
        );
        
        if (targetCard && grid) {
          const cardWidth = targetCard.offsetWidth;
          const gap = 16;
          const scrollPosition = (cardWidth + gap) * (index - 1);
          
          grid.scrollTo({
            left: scrollPosition,
            behavior: 'smooth'
          });
        }
      }

      updateActiveDot(index) {
        const dots = this.querySelectorAll('[data-dot-index]');
        dots.forEach((dot) => {
          const dotIndex = parseInt(dot.getAttribute('data-dot-index'));
          if (dotIndex === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      handleCardClick(cardId) {
        const video = this.videos[cardId];
        if (!video) return;

        if (this.currentPlayingCardId === cardId) {
          return;
        }

        this.pauseAllVideos();
        this.setActiveCard(cardId);
        video.play();
      }

      handleVideoPlay(cardId) {
        this.currentPlayingCardId = cardId;
        this.updatePlayButton(cardId, true);
        this.setActiveCard(cardId);
      }

      handleVideoPause(cardId) {
        if (this.currentPlayingCardId === cardId) {
          this.currentPlayingCardId = null;
        }
        this.updatePlayButton(cardId, false);
        this.removeActiveCard(cardId);
      }

      handleVideoEnd(cardId) {
        if (this.isMobile) {
          const cards = Array.from(this.querySelectorAll('.ai-wistia-carousel__card-{{ ai_gen_id }}'));
          const currentCard = this.querySelector(`[data-card-id="${cardId}"]`);
          const currentIndex = cards.indexOf(currentCard);
          
          if (currentIndex < cards.length - 1) {
            const nextIndex = currentIndex + 2;
            this.scrollToCard(nextIndex);
            
            setTimeout(() => {
              const nextCard = cards[currentIndex + 1];
              const nextCardId = nextCard.getAttribute('data-card-id');
              this.playVideo(nextCardId);
            }, 500);
          }
        }
      }

      togglePlayPause(cardId) {
        const video = this.videos[cardId];
        if (!video) return;

        if (video.state() === 'playing') {
          video.pause();
        } else {
          this.pauseAllVideos();
          video.play();
        }
      }

      playVideo(cardId) {
        const video = this.videos[cardId];
        if (!video) return;
        
        this.pauseAllVideos();
        video.play();
      }

      toggleVolume(cardId) {
        const video = this.videos[cardId];
        if (!video) return;

        const button = this.querySelector(`[data-volume-toggle="${cardId}"]`);
        const volumeIcon = button.querySelector('.volume-icon');
        const muteIcon = button.querySelector('.mute-icon');

        if (video.isMuted()) {
          video.unmute();
          volumeIcon.style.display = 'block';
          muteIcon.style.display = 'none';
        } else {
          video.mute();
          volumeIcon.style.display = 'none';
          muteIcon.style.display = 'block';
        }
      }

      pauseAllVideos() {
        Object.keys(this.videos).forEach((cardId) => {
          const video = this.videos[cardId];
          if (video && video.state() === 'playing') {
            video.pause();
          }
        });
      }

      updatePlayButton(cardId, isPlaying) {
        const button = this.querySelector(`[data-play-pause="${cardId}"]`);
        if (!button) return;

        const playIcon = button.querySelector('.play-icon');
        const pauseIcon = button.querySelector('.pause-icon');

        if (isPlaying) {
          playIcon.style.display = 'none';
          pauseIcon.style.display = 'block';
        } else {
          playIcon.style.display = 'block';
          pauseIcon.style.display = 'none';
        }
      }

      setActiveCard(cardId) {
        const allCards = this.querySelectorAll('.ai-wistia-carousel__card-{{ ai_gen_id }}');
        allCards.forEach((card) => {
          card.classList.remove('active');
        });

        const activeCard = this.querySelector(`[data-card-id="${cardId}"]`);
        if (activeCard) {
          activeCard.classList.add('active');
        }
      }

      removeActiveCard(cardId) {
        const card = this.querySelector(`[data-card-id="${cardId}"]`);
        if (card) {
          card.classList.remove('active');
        }
      }
    }

    customElements.define('wistia-carousel-{{ ai_gen_id }}', WistiaCarousel{{ ai_gen_id }});
  })();
</script>

