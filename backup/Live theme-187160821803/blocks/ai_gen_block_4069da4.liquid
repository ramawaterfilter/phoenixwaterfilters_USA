{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-wistia-carousel-{{ ai_gen_id }} {
    width: 100%;
    padding: 40px 0;
  }

  .ai-wistia-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-wistia-carousel__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }

  .ai-wistia-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: background-color 0.3s ease;
    cursor: pointer;
  }

  .ai-wistia-carousel__card-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.active_card_background }};
  }

  .ai-wistia-carousel__heading-{{ ai_gen_id }} {
    padding: 20px 20px 12px;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.3;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-wistia-carousel__influencer-{{ ai_gen_id }} {
    padding: 0 20px 12px;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    color: {{ block.settings.text_color }};
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: max-height 0.3s ease, opacity 0.3s ease, padding 0.3s ease;
  }

  .ai-wistia-carousel__card-{{ ai_gen_id }}.active .ai-wistia-carousel__influencer-{{ ai_gen_id }} {
    max-height: 50px;
    opacity: 1;
    padding: 0 20px 12px;
  }

  .ai-wistia-carousel__influencer-link-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    text-decoration: none;
    color: inherit;
  }

  .ai-wistia-carousel__instagram-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
  }

  .ai-wistia-carousel__video-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    aspect-ratio: 9 / 16;
    background-color: #000;
  }

  .ai-wistia-carousel__video-container-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
  }

  .ai-wistia-carousel__mobile-image-{{ ai_gen_id }} {
    display: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-wistia-carousel__controls-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    right: 12px;
    display: flex;
    gap: 8px;
    z-index: 10;
  }

  .ai-wistia-carousel__control-btn-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.9);
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background-color 0.2s;
  }

  .ai-wistia-carousel__control-btn-{{ ai_gen_id }}:hover {
    background-color: rgba(255, 255, 255, 1);
  }

  .ai-wistia-carousel__control-btn-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
  }

  .ai-wistia-carousel__product-{{ ai_gen_id }} {
    padding: 16px 20px 20px;
    margin-top: auto;
  }

  .ai-wistia-carousel__product-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    color: {{ block.settings.text_color }};
    margin: 0;
  }

  .ai-wistia-carousel__product-link-{{ ai_gen_id }} {
    color: inherit;
    text-decoration: none;
  }

  .ai-wistia-carousel__product-link-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-wistia-carousel__pagination-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 767px) {
    .ai-wistia-carousel__container-{{ ai_gen_id }} {
      padding: 0;
    }

    .ai-wistia-carousel__grid-{{ ai_gen_id }} {
      display: flex;
      gap: 16px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-behavior: smooth;
      padding: 0 0 0 0;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-wistia-carousel__grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-wistia-carousel__card-{{ ai_gen_id }} {
      flex: 0 0 80%;
      scroll-snap-align: start;
      margin-left: 0;
    }

    .ai-wistia-carousel__card-{{ ai_gen_id }}:first-child {
      margin-left: 0;
    }

    .ai-wistia-carousel__video-wrapper-{{ ai_gen_id }} {
      aspect-ratio: 9 / 16;
    }

    .ai-wistia-carousel__video-container-{{ ai_gen_id }} {
      display: block;
    }

    .ai-wistia-carousel__mobile-image-{{ ai_gen_id }} {
      display: none;
    }

    .ai-wistia-carousel__heading-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .ai-wistia-carousel__product-title-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .ai-wistia-carousel__pagination-{{ ai_gen_id }} {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      margin-top: 20px;
      padding: 0 20px;
    }

    .ai-wistia-carousel__dot-{{ ai_gen_id }} {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: #d0d0d0;
      border: none;
      padding: 0;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .ai-wistia-carousel__dot-{{ ai_gen_id }}.active {
      background-color: {{ block.settings.pagination_active_color }};
      width: 24px;
      border-radius: 4px;
    }
  }

  @media screen and (min-width: 768px) and (max-width: 1024px) {
    .ai-wistia-carousel__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  {{ block.settings.custom_css }}
{% endstyle %}

