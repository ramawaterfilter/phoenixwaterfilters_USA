{% doc %}
  @prompt
    Create a custom Shopify section with the following:
    
    Background color: #4196C0 (blue tone like in the image).
    
    Section heading centered at the top: "Say hello to healthier hydration."
    
    Below the heading, display 3 product blocks in one row.
    
    Each product block must include:
    
    Product image (dynamic, selected by merchant in the editor)
    
    “Shop” button below the image (yellow color #FFD84D, rounded corners, hover effect slightly darker).
    
    All product images should be centered and responsive.
    
    On mobile view, stack products vertically (one per row).
    
    Padding: 60px top and bottom, 20px sides.
    
    Section fully responsive and mobile-friendly.
    
    Allow merchant to change heading text and background color in the editor.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-showcase-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
    width: 100%;
  }

  .ai-product-showcase-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-product-showcase-heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    font-weight: 700;
    color: #ffffff;
    margin: 0 0 50px;
    line-height: 1.2;
  }

  .ai-product-showcase-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 30px;
    align-items: start;
  }

  .ai-product-showcase-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
  }

  .ai-product-showcase-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    border-radius: 8px;
    background-color: #ffffff;
  }

  .ai-product-showcase-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .ai-product-showcase-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-product-showcase-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 200px;
    max-height: 200px;
  }

  .ai-product-showcase-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 8px 16px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  .ai-product-showcase-button-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_color }};
    color: #000000;
    padding: 12px 40px;
    border: none;
    border-radius: 25px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background-color 0.3s ease, transform 0.2s ease;
  }

  .ai-product-showcase-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_color | color_darken: 10 }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .ai-product-showcase-{{ ai_gen_id }} {
      padding: 40px 20px;
    }

    .ai-product-showcase-heading-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 30px;
    }

    .ai-product-showcase-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    .ai-product-showcase-heading-{{ ai_gen_id }} {
      font-size: 32px;
    }

    .ai-product-showcase-grid-{{ ai_gen_id }} {
      gap: 25px;
    }
  }
{% endstyle %}

<div class="ai-product-showcase-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-product-showcase-container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-product-showcase-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-product-showcase-grid-{{ ai_gen_id }}">
      {% for i in (1..3) %}
        {% liquid
          assign product_key = 'product_' | append: i
          assign product = block.settings[product_key]
        %}

        <div class="ai-product-showcase-item-{{ ai_gen_id }}">
          <div class="ai-product-showcase-image-wrapper-{{ ai_gen_id }}">
            {% if product != blank and product.featured_image %}
              <img
                src="{{ product.featured_image | image_url: width: 600 }}"
                alt="{{ product.featured_image.alt | escape }}"
                width="600"
                height="600"
                loading="lazy"
                class="ai-product-showcase-image-{{ ai_gen_id }}"
              >
            {% else %}
              <div class="ai-product-showcase-image-placeholder-{{ ai_gen_id }}">
                {{ 'product-1' | placeholder_svg_tag }}
                <div class="ai-product-showcase-empty-state-{{ ai_gen_id }}">
                  Select a product
                </div>
              </div>
            {% endif %}
          </div>

          {% if product != blank %}
            <a
              href="{{ product.url }}"
              class="ai-product-showcase-button-{{ ai_gen_id }}"
            >
              {{ block.settings.button_text }}
            </a>
          {% else %}
            <span class="ai-product-showcase-button-{{ ai_gen_id }}" style="opacity: 0.5; cursor: default;">
              {{ block.settings.button_text }}
            </span>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Product showcase",
  "settings": [
    {
      "type": "header",
      "content": "Section content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Say hello to healthier hydration."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#4196C0"
    },
    {
      "type": "header",
      "content": "Button style"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Shop"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button color",
      "default": "#FFD84D"
    },
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Product 3"
    }
  ],
  "presets": [
    {
      "name": "Product showcase"
    }
  ]
}
{% endschema %}
