<script>
  (function() {
    class VideoCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.totalSlides = 0;
        this.startX = 0;
        this.currentX = 0;
        this.isDragging = false;
        this.threshold = 50;
      }

      connectedCallback() {
        this.setupElements();
        this.setupEventListeners();
        this.updateMobileView();
        
        window.addEventListener('resize', () => {
          this.updateMobileView();
        });
      }

      setupElements() {
        this.desktopGrid = this.querySelector('.ai-video-carousel-grid-{{ ai_gen_id }}');
        this.mobileCarousel = this.querySelector('.ai-video-carousel-mobile-{{ ai_gen_id }}');
        this.mobileWrapper = this.querySelector('.ai-video-carousel-mobile-wrapper-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-video-carousel-dot-{{ ai_gen_id }}');
        this.cards = this.querySelectorAll('.ai-video-carousel-card-{{ ai_gen_id }}');
        this.totalSlides = this.dots.length;
      }

      setupEventListeners() {
        this.cards.forEach((card, index) => {
          card.addEventListener('click', () => {
            this.selectCard(index);
          });
        });

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
          });
        });

        if (this.mobileWrapper) {
          this.mobileWrapper.addEventListener('touchstart', (e) => {
            this.handleTouchStart(e);
          });

          this.mobileWrapper.addEventListener('touchmove', (e) => {
            this.handleTouchMove(e);
          });

          this.mobileWrapper.addEventListener('touchend', (e) => {
            this.handleTouchEnd(e);
          });
        }
      }

      updateMobileView() {
        const isMobile = window.innerWidth <= 768;
        
        if (isMobile) {
          this.desktopGrid.style.display = 'none';
          this.mobileCarousel.style.display = 'block';
        } else {
          this.desktopGrid.style.display = 'grid';
          this.mobileCarousel.style.display = 'none';
        }
      }

      selectCard(index) {
        this.cards.forEach((card, i) => {
          if (i === index) {
            card.classList.add('selected');
          } else {
            card.classList.remove('selected');
          }
        });
      }

      goToSlide(index) {
        if (index < 0 || index >= this.totalSlides) return;
        
        this.currentSlide = index;
        const translateX = -index * 100;
        
        if (this.mobileWrapper) {
          this.mobileWrapper.style.transform = `translateX(${translateX}%)`;
        }

        this.dots.forEach((dot, i) => {
          if (i === index) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });

        this.selectCard(index);
      }

      handleTouchStart(e) {
        this.startX = e.touches[0].clientX;
        this.isDragging = true;
        this.mobileWrapper.style.transition = 'none';
      }

      handleTouchMove(e) {
        if (!this.isDragging) return;
        
        e.preventDefault();
        this.currentX = e.touches[0].clientX;
        const diffX = this.currentX - this.startX;
        const translateX = -this.currentSlide * 100 + (diffX / this.mobileWrapper.offsetWidth) * 100;
        
        this.mobileWrapper.style.transform = `translateX(${translateX}%)`;
      }

      handleTouchEnd(e) {
        if (!this.isDragging) return;
        
        this.isDragging = false;
        this.mobileWrapper.style.transition = 'transform 0.3s ease';
        
        const diffX = this.currentX - this.startX;
        
        if (Math.abs(diffX) > this.threshold) {
          if (diffX > 0 && this.currentSlide > 0) {
            this.goToSlide(this.currentSlide - 1);
          } else if (diffX < 0 && this.currentSlide < this.totalSlides - 1) {
            this.goToSlide(this.currentSlide + 1);
          } else {
            this.goToSlide(this.currentSlide);
          }
        } else {
          this.goToSlide(this.currentSlide);
        }
      }
    }

    customElements.define('video-carousel-{{ ai_gen_id }}', VideoCarousel{{ ai_gen_id }});
  })();
</script>

