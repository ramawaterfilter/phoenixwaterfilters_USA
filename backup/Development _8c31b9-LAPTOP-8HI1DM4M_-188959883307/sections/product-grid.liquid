          {{ 'products.facets.sort_by_label' | t }}</label>

        <div class="select-wrap">
          <select name="sort_by" id="sort">
            {%- for option in collection.sort_options -%}
              <option
                value="{{ option.value | escape }}"
                {% if option.value == collection.sort_by %}
                selected="selected"
                {% endif %}>
                {{ option.name | escape }}
              </option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    </div>
  </div>
  {% paginate collection.products by 16 %}




              
    <div class="row justify-content-center mb-5">

      {% comment %} <div class="col-12 col-lg-3" >
                                        {% render 'filters'
                                          , collection: collection %}
                              </div> {% endcomment %}
      <div class="col-12 col-lg-12">
        <div class="row p-3 p-lg-0">

          {% if collection.products.size > 0 %}
            
         {% comment %}Modified on June 3, for Appstle      {% endcomment %}
{% for product in collection.products %}
  {% unless product.title == "Phoenix Gravity Carbon filter Elements (Appstle)" or product.title == "POSTreat FluoRid Refill Media (Appstle)" %}
    <div class="products col-6 col-md-3 mb-5">
      {% render 'product-tile', product: product %}
    </div>
  {% endunless %}
{% endfor %}
<!-- Start of Judge.me code -->
      <div style='{{ jm_style }}' class='jdgm-widget jdgm-preview-badge' data-id='{{ product.id }}' data-auto-install='false'>
        {{ product.metafields.judgeme.badge }}
      </div>
      <!-- End of Judge.me code -->
 {% comment %}Modified on June 3, for Appstle      {% endcomment %}

          
          {% else %}
            <div class="col-12 text-center">
              <p>{{ 'sections.collection_template.empty' | t }}.</p>
            </div>
          {% endif %}
        </div>
      </div>

    </div>







              
    {% if paginate.pages > 1 %}
      <div class="row justify-content-center">
        <div class="col-12">
          {% render 'pagination'
            , paginate: paginate %}
        </div>
      </div>
    {% endif %}

  {% endpaginate %}

</div>


<script>
    Shopify.queryParams = {};

        // Preserve existing query parameters
    if (location.search.length) {
        var params = location.search.substr(1).split('&');
        for (var i = 0; i < params.length; i++) {
            var keyValue = params[i].split('=');

            if (keyValue.length) {
                // Check if the parameter is already an array (in case of multiple selections)
                if (Shopify.queryParams[decodeURIComponent(keyValue[0])]) {
                    if (Array.isArray(Shopify.queryParams[decodeURIComponent(keyValue[0])])) {
                        Shopify.queryParams[decodeURIComponent(keyValue[0])].push(decodeURIComponent(keyValue[1]));
                    } else {
                        Shopify.queryParams[decodeURIComponent(keyValue[0])] = [
                            Shopify.queryParams[decodeURIComponent(keyValue[0])],
                            decodeURIComponent(keyValue[1]),
                        ];
                    }
                } else {
                    Shopify.queryParams[decodeURIComponent(keyValue[0])] = decodeURIComponent(keyValue[1]);
                }
            }
        }
    }

    // Update sort_by query parameter on select change
    document.querySelectorAll('[name="sort_by"]').forEach(function(el, index) {
        el.addEventListener('change', function(e) {
            var value = e.target.value;
            Shopify.queryParams.sort_by = value;
            location.search = unescape(new URLSearchParams(Shopify.queryParams).toString());
        });
    });
</script>


{% schema %}
  {
    "name": "Product Grid",
    "tag": "section",
    "class": "section-productgrid",
    "presets": [
      {
        "name": "Product Grid"
      }
    ],
    "enabled_on": {
      "templates": ["collection"]
    }
  }
{% endschema %}