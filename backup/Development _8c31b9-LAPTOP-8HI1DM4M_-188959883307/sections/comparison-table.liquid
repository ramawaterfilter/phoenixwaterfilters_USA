<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
  <div class="background-image-container {{ section.settings.style }}"></div>
  <div class="container">
    <div class="row justify-content-center ">
      <div class="col-12 col-md-9 col-lg-10 col-xl-9">
        <h2 class="text-center">{{ section.settings.heading }}</h2>
      </div>
    </div>
    <div class="row justify-content-center ">
      <div class="col-12 table-wrapper columns-{{ section.settings.number_of_comparisons }}">
        <table class="table {{ section.settings.style }}">
          <tbody>
            <tr>
              <th class="text-start first-column feature">
                {{ section.settings.feature_header }}
              </th>
              <th class="text-center active-cell">
                {% if section.settings.company_logo %}
                  {{ section.settings.company_logo | image_url: width: 1920 | image_tag: class: 'img-fluid table-logo', loading: "lazy" }}
                {% elsif section.settings.company_name != blank %}
                  {{ section.settings.company_name }}
                {% else %}
                  {{ shop.name }}
                {% endif %}
              </th>
              <th class="text-center text-capitalize">
                {{ section.settings.comparison_1 }}
              </th>
              {% if section.settings.number_of_comparisons != "1" %}
                <th class="text-center text-capitalize">
                  {{ section.settings.comparison_2 }}
                </th>
              {% endif %}
              {% if section.settings.number_of_comparisons == "3" %}
                <th class="text-center text-capitalize">
                  {{ section.settings.comparison_3 }}
                </th>
              {% endif %}
            </tr>
            {% for block in section.blocks %}
              <tr>
                <td class="text-start first-column feature">
                  {{ block.settings.feature }}
                </td>
                <td class="text-center active-cell sells">
                  <p>
                  {% if block.settings.column_1 == 'yes' %}
  <span class="text-success"><img src=""><svg fill="#008001" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 335.765 335.765" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <polygon points="311.757,41.803 107.573,245.96 23.986,162.364 0,186.393 107.573,293.962 335.765,65.795 "></polygon> </g> </g> </g></svg>Yes</span>
{% else %}
  <span class="text-danger"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z" fill="#ff0000"></path> </g></svg>No</span>
{% endif %}
                  </p>
                </td>
                <td class="text-center text-capitalize">
                  <p>
              {% if block.settings.column_2 == 'yes' %}
  <span class="text-success"><svg fill="#008001" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 335.765 335.765" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <polygon points="311.757,41.803 107.573,245.96 23.986,162.364 0,186.393 107.573,293.962 335.765,65.795 "></polygon> </g> </g> </g></svg>Yes</span>
{% else %}
  <span class="text-danger"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z" fill="#ff0000"></path> </g></svg>No</span>
{% endif %}
                  </p>
                </td>
                {% if section.settings.number_of_comparisons != "1" %}
                  <td class="text-center text-capitalize">
                    <p>
                  {% if block.settings.column_3 == 'yes' %}
  <span class="text-success"><svg fill="#008001" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 335.765 335.765" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <polygon points="311.757,41.803 107.573,245.96 23.986,162.364 0,186.393 107.573,293.962 335.765,65.795 "></polygon> </g> </g> </g></svg>Yes</span>
{% else %}
  <span class="text-danger"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z" fill="#ff0000"></path> </g></svg>No</span>
{% endif %}
                    </p>
                  </td>
                {% endif %}
                {% if section.settings.number_of_comparisons == "3" %}
                  <td class="text-center text-capitalize">
                    <p>
                 {% if block.settings.column_4 == 'yes' %}
  <span class="text-success"><svg fill="#008001" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="64px" height="64px" viewBox="0 0 335.765 335.765" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <polygon points="311.757,41.803 107.573,245.96 23.986,162.364 0,186.393 107.573,293.962 335.765,65.795 "></polygon> </g> </g> </g></svg>Yes</span>
{% else %}
  <span class="text-danger"><svg width="64px" height="64px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6.99486 7.00636C6.60433 7.39689 6.60433 8.03005 6.99486 8.42058L10.58 12.0057L6.99486 15.5909C6.60433 15.9814 6.60433 16.6146 6.99486 17.0051C7.38538 17.3956 8.01855 17.3956 8.40907 17.0051L11.9942 13.4199L15.5794 17.0051C15.9699 17.3956 16.6031 17.3956 16.9936 17.0051C17.3841 16.6146 17.3841 15.9814 16.9936 15.5909L13.4084 12.0057L16.9936 8.42059C17.3841 8.03007 17.3841 7.3969 16.9936 7.00638C16.603 6.61585 15.9699 6.61585 15.5794 7.00638L11.9942 10.5915L8.40907 7.00636C8.01855 6.61584 7.38538 6.61584 6.99486 7.00636Z" fill="#ff0000"></path> </g></svg>No</span>
{% endif %}
                    </p>
                  </td>
                {% endif %}
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>


    {% if section.settings.buttonlink %}
      <div class="row justify-content-center text-center ">
        <div class="col-12 text-center">
          {% render 'button'
            , class: 'mx-auto text-center' %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
  {
    "name": "Comparison Table",
    "class": "section-table",
    "tag": "section",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "radio",
        "id": "number_of_comparisons",
        "label": "Number Of Comparisons",
        "default": "2",
        "options": [
          {
            "value": "1",
            "label": "1"
          }, {
            "value": "2",
            "label": "2"
          }, {
            "value": "3",
            "label": "3"
          }
        ]
      },
      {
        "type": "select",
        "id": "style",
        "label": "Style",
        "default": "style-1",
        "options": [
          {
            "value": "style-1",
            "label": "Style 1"
          }, {
            "value": "style-2",
            "label": "Style 2"
          }

        ]
      }, {
        "type": "header",
        "content": "Table Header",
        "info": "The titles of all the columns"
      }, {
        "type": "text",
        "id": "feature_header",
        "label": "Feature Column"
      }, {
        "type": "image_picker",
        "id": "company_logo",
        "label": "Company Logo"
      }, {
        "type": "text",
        "id": "company_name",
        "label": "Company Name"
      }, {
        "type": "text",
        "id": "comparison_1",
        "label": "Comparison 1"
      }, {
        "type": "text",
        "id": "comparison_2",
        "label": "Comparison 2"
      }, {
        "type": "text",
        "id": "comparison_3",
        "label": "Comparison 3"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Table Row",
        "settings": [
          {
            "type": "text",
            "id": "feature",
            "label": "Feature"
          },
          {
            "type": "radio",
            "id": "column_1",
            "label": "This Company",
            "default": "yes",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              }, {
                "value": "no",
                "label": "No"
              }
            ]
          },
          {
            "type": "radio",
            "id": "column_2",
            "label": "Comparison 1",
            "default": "no",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              }, {
                "value": "no",
                "label": "No"
              }
            ]
          },
          {
            "type": "radio",
            "id": "column_3",
            "label": "Comparison 2",
            "default": "no",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              }, {
                "value": "no",
                "label": "No"
              }
            ]
          }, {
            "type": "radio",
            "id": "column_4",
            "label": "Comparison 3",
            "default": "no",
            "options": [
              {
                "value": "yes",
                "label": "Yes"
              }, {
                "value": "no",
                "label": "No"
              }
            ]
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Comparison Table"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}