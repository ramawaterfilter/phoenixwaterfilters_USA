{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-embed-code-heading-{{ ai_gen_id }} {
    margin: {{ block.settings.heading_margin_top }}px {{ block.settings.heading_margin_right }}px {{ block.settings.heading_margin_bottom }}px {{ block.settings.heading_margin_left }}px;
    padding: {{ block.settings.heading_padding_top }}px {{ block.settings.heading_padding_right }}px {{ block.settings.heading_padding_bottom }}px {{ block.settings.heading_padding_left }}px;
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    text-align: center;
  }

  .ai-embed-code-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.embed_width }}px;
    height: {{ block.settings.embed_height }}px;
    max-width: 100%;
    margin: 0 auto;
  }

  @media screen and (max-width: 749px) {
    .ai-embed-code-wrapper-{{ ai_gen_id }} {
      height: auto;
    }
  }

  .ai-embed-code-wrapper-{{ ai_gen_id }} iframe {
    width: 100%;
    height: 100%;
    border: none;
  }

  .ai-embed-code-placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f4f4f4;
    color: #666;
    font-size: 14px;
  }
{% endstyle %}

<div {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-embed-code-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-embed-code-wrapper-{{ ai_gen_id }}{% if block.settings.embed_code == blank %} ai-embed-code-placeholder-{{ ai_gen_id }}{% endif %}">
    {% if block.settings.embed_code != blank %}
      {{ block.settings.embed_code }}
    {% else %}
      Add your embed code in the block settings
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Custom embed code",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 12,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Heading padding"
    },
    {
      "type": "range",
      "id": "heading_padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_padding_right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right",
      "default": 0
    },
    {
      "type": "header",
      "content": "Heading margin"
    },
    {
      "type": "range",
      "id": "heading_margin_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Top",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Bottom",
      "default": 20
    },
    {
      "type": "range",
      "id": "heading_margin_left",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Left",
      "default": 0
    },
    {
      "type": "range",
      "id": "heading_margin_right",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Right",
      "default": 0
    },
    {
      "type": "header",
      "content": "Embed code"
    },
    {
      "type": "html",
      "id": "embed_code",
      "label": "Embed code"
    },
    {
      "type": "range",
      "id": "embed_width",
      "min": 200,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Width",
      "default": 800
    },
    {
      "type": "range",
      "id": "embed_height",
      "min": 200,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "label": "Height",
      "default": 600
    }
  ],
  "presets": [
    {
      "name": "Custom embed code"
    }
  ]
}
{% endschema %}
