    "copy_image_JCKnek": {
      "type": "copy-image",
      "disabled": true,
      "settings": {
        "style": "bg-white",
        "layout": "copy",
        "vertical_align": "align-items-center",
        "heading": "100-Day Risk-Free Trial",
        "content": "<p>Worried the Phoenix Gravity Water Filter is too good to be true? Don’t believe it will really remove as many contaminants as we promise?<br/><br/>We stand behind our product 100% – so you can try our filter in your own home for 100 days risk-free. If you aren't fully satisfied with the purity of your water, send it back within 100 days for a full refund, no questions asked!<br/><br/>*T&Cs apply<br/></p>",
        "column_img": "shopify://shop_images/phoenix-guarantee.svg",
        "video_id": "",
        "large_image": "img-standard",
        "second_content": "",
