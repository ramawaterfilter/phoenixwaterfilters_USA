  {
    "name": "Variant Colours",
    "settings": [
      {
        "type": "textarea",
        "id": "variant_colours",
        "label": "Variant Colour Swatches",
        "info": "Overrides the hex colour value of any variant selector buttons on product pages. Should be formatted with the variant name, followed by a colon, followed by the hex value with a hash. Comma separate for multiple values. e.g red:#ed1c24,blue:#6BCFF7"
      }
    ]
  },
  {
    "name": "Min\/Max Buys",
    "settings": [
      {
        "type": "checkbox",
        "id": "enable_minmax_buys",
        "label": "Enable Min\/Max Buy",
        "info": "Quantities need to be set in the per product metafields. This enables the JS to work with them."
      }
    ]
  },
  {
    "name": "Min Buys",
    "settings": [
      {
        "type": "number",
        "id": "min_buy_qty",
        "label": "Enter Qty",
        "default": 1,
        "info": "Limit minimum qty product"
      }
    ]
  },
  {
    "name": "Max Buys",
    "settings": [
      {
        "type": "number",
        "id": "max_buy_qty",
        "label": "Enter Qty",
        "default": 10,
        "info": "Limit Maximum qty product"
      }
    ]
  },
  {
