        "label": "Eyebrow Text",
        "default": "Hey there!"
      },
      {
        "type": "text",
        "id": "entry_popup_heading",
        "label": "Popup Heading",
        "default": "Get 10% Off The Product"
      },
      {
        "type": "richtext",
        "id": "entry_popup_content",
        "label": "Popup Content",
        "default": "<p>Consider this as our goodwill gesture to help you achieve your big benefit<\/p>"
      },
      {
        "type": "text",
        "id": "entry_popup_button",
        "label": "Popup Button Text",
        "default": "GET MY 10% OFF"
      },
      {
        "type": "text",
        "id": "entry_popup_nothanks",
        "label": "Popup No Thanks Text",
        "default": "Not right now, thanks"
      },
      {
        "type": "textarea",
        "id": "entry_popup_disclaimer",
        "label": "Popup Disclaimer",
        "default": "By providing your email, you agree to our Privacy Policy and Terms & Conditions"
      },
      {
        "type": "textarea",
        "id": "entry_popup_fineprint",
        "label": "Popup Fine Print",
        "default": "No spam. We promise!"
      }
    ]
  },
