  {
    "name": "Header Spacing",
    "settings": [
      {
        "type": "range",
        "id": "body_padding_desktop",
        "label": "Body Top Padding (Desktop)",
        "default": 216,
        "unit": "px",
        "step": 2,
        "min": 100,
        "max": 300
      },
      {
        "type": "range",
        "id": "body_padding_mobile",
        "label": "Body Top Padding (Mobile)",
        "default": 116,
        "unit": "px",
        "step": 2,
        "min": 40,
        "max": 200
      }
    ]
  },
  {
    "name": "Entry Popup & size Guide Popup",
    "settings": [
      {
        "type": "header",
        "content": "Entry Popup"
      },
               {
      "type": "checkbox",
      "id": "enable_size_guide",
      "label": "Enable Size Guide (product page)",
      "default": true
    },
      {
        "type": "checkbox",
        "id": "show_entry_popup",
        "label": "Show Entry Popup",
        "default": false
      },
      {
        "type": "text",
        "id": "entry_popup_side_button",
        "label": "Side Hero Button Text",
        "default": "Get 10% Off"
      },
      {
        "type": "text",
        "id": "entry_popup_side_button_id",
        "label": "Klaviyo Form ID",
        "info": "This is the klavio form ID of the form that should be triggered by the side button",
        "default": "X76cnx"
      },
      {
        "type": "image_picker",
        "id": "entry_popup_image",
        "label": "Popup Image"
      },
      {
        "type": "text",
