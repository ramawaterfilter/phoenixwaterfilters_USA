{% assign current_variant = product.selected_or_first_available_variant %}
<div class="container">
  <div class="row justify-content-center lk">
    <div class="col-11 jkl col-lg-6 pe-5">
      {% render 'product-hero-media', product: product %}
    </div>
    <div class="col-11 gg col-lg-6 mt-3 mt-lg-0">
      {% if settings.enable_minmax_buys %}
        {% assign min_buy = settings.min_buy_qty %}
        {% assign max_buy = settings.max_buy_qty %}
      {% endif %}
      {% liquid
        assign has_product_hero_blocks = false
        assign has_variant_picker_block = false
        for block in section.blocks
          unless block.type == '@app' or block.type == 'upsell'
            assign has_product_hero_blocks = true
          endunless
          if block.type == 'variant_picker'
            assign has_variant_picker_block = true
          endif
        endfor
        assign render_variant_picker_select = has_variant_picker_block
        unless has_product_hero_blocks
          assign render_variant_picker_select = true
        endunless
      %}

      <form
        action="{{ routes.cart_add_url }}"
        method="post"
        enctype="multipart/form-data"
        id="add-to-cart"
        class="mb-5 main-add-to-cart"
        data-min="{{ min_buy }}"
        data-max="{{ max_buy }}"
      >
        <input type="hidden" name="handle" value="{{ product.handle }}">
        {% unless product.available and product.variants.size > 1 and render_variant_picker_select %}
          <input name="id" data-productid="{{ product.id }}" value="{{ product.variants.first.id }}" type="hidden">
        {% endunless %}
        {% render 'product-hero-subscriptions', product: product %}

        {% if has_product_hero_blocks %}
          {% for block in section.blocks %}
            <div class="product-hero-block product-hero-block--{{ block.type | handleize }}" {{ block.shopify_attributes }}>
              {% case block.type %}
                {% when 'countdown' %}
                  {% render 'product-hero-countdown', section: section %}
                {% when 'product_tag' %}
                  {% render 'product-hero-product-tag', block: block %}
                {% when 'title' %}
                  {% render 'product-hero-title', product: product %}
                {% when '@app' %}
                  <div class="product-rating">
                    {% render block %}
                  </div>
                {% when 'best_for_tag' %}
                  {% render 'best-for-tag' %}
                {% when 'description' %}
                  {% render 'product-hero-description', product: product %}
                {% when 'description_stats' %}
                  {% render 'product-hero-description-stats', section: section %}
                {% when 'variant_picker' %}
                  {% render 'product-hero-variant-picker', product: product, current_variant: current_variant %}
                {% when 'price' %}
                  {% render 'product-hero-price', product: product %}
                {% when 'paypal_message' %}
                  {% render 'product-hero-paypal-message', product: product %}
                {% when 'availability' %}
                  {% render 'product-hero-availability', product: product, current_variant: current_variant %}
                {% when 'notice_image' %}
                  {% assign notice_text = block.settings.notice_text %}
                  {% if notice_text == blank %}
                    {% assign notice_text = '<p>Due to state-specific regulations, POSTreat Filter Elements are currently unavailable for shipping to California or Iowa. Questions? Call <strong>1 (800) 917-0455</strong>.</p>' %}
                  {% endif %}
                  <div class="product-hero-notice-image" style="--notice-background: {{ block.settings.background_color }}; --notice-border-color: {{ block.settings.border_color }}; --notice-text-color: {{ block.settings.text_color }};">
                    {% if block.settings.notice_image != blank %}
                      {{
                        block.settings.notice_image
                        | image_url: width: 1200
                        | image_tag:
                          class: 'product-hero-notice-image__asset',
                          alt: block.settings.notice_image.alt | default: block.settings.alt_text,
                          loading: 'lazy'
                      }}
                    {% endif %}
                    <div class="product-hero-notice-image__text">
                      {{ notice_text }}
                    </div>
                  </div>
                {% when 'add_to_cart' %}
                  {% render 'product-hero-add-to-cart', product: product, current_variant: current_variant %}
                {% when 'scroll_button' %}
                  {% assign scroll_target_id = block.settings.target_id | strip | remove: '#' %}
                  {% if block.settings.label != blank and scroll_target_id != blank %}
                    <a
                      class="btn btn-primary btn-product product-hero-scroll-button"
                      href="#{{ scroll_target_id | escape }}"
                      style="--scroll-button-padding-top: {{ block.settings.padding_top }}px; --scroll-button-padding-bottom: {{ block.settings.padding_bottom }}px;"
                    >
                      {{ block.settings.label | escape }}
                    </a>
                  {% endif %}
                {% when 'payment_icons' %}
                  {% render 'product-hero-payment-icons' %}
                {% when 'trust_icons' %}
                  {% render 'product-hero-trust-icons' %}
                {% when 'upsell' %}
                  {% render 'product-hero-upsell', block: block %}
              {% endcase %}
            </div>
          {% endfor %}
        {% else %}
          <div class="product-hero-block product-hero-block--countdown">
            {% render 'product-hero-countdown', section: section %}
          </div>
          <div class="product-hero-block product-hero-block--product-tag">
            <div
              class="product-hero-tag"
              style="--tag-background: #20204a; --tag-color: #ffffff;"
            >
              WELLNESS SALE
            </div>
          </div>
          <div class="product-hero-block product-hero-block--title">
            {% render 'product-hero-title', product: product %}
          </div>
          {% for block in section.blocks %}
            {% if block.type == '@app' %}
              <div class="product-hero-block product-hero-block--app" {{ block.shopify_attributes }}>
                <div class="product-rating">
                  {% render block %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
          <div class="product-hero-block product-hero-block--best-for-tag">
            {% render 'best-for-tag' %}
          </div>
          <div class="product-hero-block product-hero-block--description">
            {% render 'product-hero-description', product: product %}
          </div>
          <div class="product-hero-block product-hero-block--description-stats">
            {% render 'product-hero-description-stats', section: section %}
          </div>
          <div class="product-hero-block product-hero-block--variant-picker">
            {% render 'product-hero-variant-picker', product: product, current_variant: current_variant %}
          </div>
          <div class="product-hero-block product-hero-block--price">
            {% render 'product-hero-price', product: product %}
          </div>
          <div class="product-hero-block product-hero-block--paypal-message">
            {% render 'product-hero-paypal-message', product: product %}
          </div>
          <div class="product-hero-block product-hero-block--availability">
            {% render 'product-hero-availability', product: product, current_variant: current_variant %}
          </div>
          <div class="product-hero-block product-hero-block--notice-image">
            <div class="product-hero-notice-image" style="--notice-background: #fffbe9; --notice-border-color: #d7c27a; --notice-text-color: #6f5f2a;">
              <div class="product-hero-notice-image__asset-wrap">
                <img
                  class="product-hero-notice-image__asset"
                  src="{{ 'postreat-filter-elements-notice.png' | asset_url }}"
                  alt="Due to state-specific regulations, POSTreat Filter Elements are currently unavailable for shipping to California or Iowa."
                  width="766"
                  height="150"
                  loading="lazy"
                >
              </div>
              <div class="product-hero-notice-image__text">
                Due to state-specific regulations, POSTreat Filter Elements are currently unavailable for shipping to California or Iowa. Questions? Call 1 (800) 917-0455.
              </div>
            </div>
          </div>
          <div class="product-hero-block product-hero-block--add-to-cart">
            {% render 'product-hero-add-to-cart', product: product, current_variant: current_variant %}
          </div>
          <div class="product-hero-block product-hero-block--payment-icons">
            {% render 'product-hero-payment-icons' %}
          </div>
          <div class="product-hero-block product-hero-block--trust-icons">
            {% render 'product-hero-trust-icons' %}
          </div>
          {% for block in section.blocks %}
            {% if block.type == 'upsell' %}
              <div class="product-hero-block product-hero-block--upsell" {{ block.shopify_attributes }}>
                {% render 'product-hero-upsell', block: block %}
              </div>
            {% endif %}
          {% endfor %}
        {% endif %}
      </form>
    </div>
  </div>
</div>

{% render 'sticky-add-to-cart' %}

{% unless product == empty %}
  {% comment %} Product Script {% endcomment %}
  <script>
    window.product = {{ product | json }} || {};
    {% if product.metafields.custom.product_badge_text.value != blank %}
      if(typeof product !== "undefined"){
        product['badge'] = "{{ product.metafields.custom.product_badge_text.value }}";
      }
    {% endif %}
    let metaInfo = product.handle + '?view=metafields';
    fetch(metaInfo)
      .then(response => response.json())
      .then(pageMeta => {
        window.product = Object.assign(product, pageMeta);

        if( document.readyState !== 'loading' ) {
          initProductScript(window.product, 'product-selectors', document);
        } else {
          document.addEventListener('DOMContentLoaded', function () {
            initProductScript(window.product, 'product-selectors', document);
          });
        }
      })
      .catch(error => {
        console.error('Error fetching page meta:', error);
      });
  </script>
{% endunless %}

