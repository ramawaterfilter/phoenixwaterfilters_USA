<script>
document.addEventListener('DOMContentLoaded', function () {
  const variantContainer = document.getElementById('product-variants');
  const select = document.getElementById('product-selectors');

  if (!variantContainer || !select) return;

  const boxes = variantContainer.querySelectorAll('.variant-img-box');
  const titleEl = document.getElementById('selected-variant-title');
  const productData = window.product || {{ product | json }};

  function formatVariantMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function' && window.money_format) {
      return Shopify.formatMoney(cents, window.money_format);
    }

    return '$' + (cents / 100).toFixed(2);
  }

  function updatePriceLine(variant) {
    const priceEl = document.querySelector('.priceline [data-price]');
    const compareWrapper = document.querySelector('.priceline [data-compare]');
    const paypalMessage = document.querySelector('[data-pp-message]');
    let compareEl = compareWrapper && compareWrapper.querySelector('s');

    if (priceEl) {
      priceEl.innerHTML = formatVariantMoney(variant.price);
    }

    if (compareWrapper && !compareEl) {
      compareWrapper.innerHTML = '<s></s>';
      compareEl = compareWrapper.querySelector('s');
    }

    if (compareEl) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.innerHTML = formatVariantMoney(variant.compare_at_price);
        compareEl.style.display = 'inline';
      } else {
        compareEl.innerHTML = '';
        compareEl.style.display = 'none';
      }
    }

    if (paypalMessage) {
      paypalMessage.setAttribute('data-pp-amount', (variant.price / 100).toFixed(2));
    }
  }

  function updateProductImage(variantId) {
    const slides = Array.from(document.querySelectorAll('#product-slider .swiper-slide'));
    const slideIndex = slides.findIndex(slide => slide.dataset.variantId === String(variantId));
    const productSlider = document.getElementById('product-slider');
    const swiper = productSlider && productSlider.swiper;

    if (swiper && slideIndex >= 0) {
      swiper.slideTo(slideIndex);
      return;
    }

    if (slides[slideIndex]) {
      slides[slideIndex].scrollIntoView({ behavior: 'smooth', inline: 'center' });
    }
  }

  function updateActiveBox(variantId) {
    boxes.forEach(item => {
      const isActive = item.dataset.id === String(variantId);
      item.classList.toggle('active', isActive);
      item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
    });
  }

  function updateTitle(variant) {
    if (variant && titleEl) {
      titleEl.textContent = variant.title;
    }
  }

  boxes.forEach(box => {
    box.addEventListener('click', function () {
      const variantId = this.dataset.id;
      const selectedVariant = productData.variants.find(variant => String(variant.id) === String(variantId));

      select.value = variantId;
      select.dispatchEvent(new Event('change', { bubbles: true }));

      if (selectedVariant) {
        updatePriceLine(selectedVariant);
        updateTitle(selectedVariant);
      }

      updateActiveBox(variantId);
      updateProductImage(variantId);
    });
  });

  select.addEventListener('change', function () {
    const selectedVariant = productData.variants.find(variant => String(variant.id) === String(this.value));
    if (selectedVariant) {
      updatePriceLine(selectedVariant);
      updateTitle(selectedVariant);
      updateActiveBox(selectedVariant.id);
      updateProductImage(selectedVariant.id);
    }
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const sliderEl = document.getElementById('product-slider');
  const navEl = document.getElementById('product-slider-nav');
  const mediaEl = sliderEl && sliderEl.closest('.product-hero-media');
  let attempts = 0;
  let eventsBound = false;

  if (!sliderEl || !navEl) return;

  function getVisibleThumbCount(total) {
    const count = window.matchMedia('(max-width: 768px)').matches ? 2 : 4;
    return Math.min(count, Math.max(total - 1, 1));
  }

  function updateNavHeight(mainSwiper) {
    if (!mediaEl) return;

    const activeSlide = mainSwiper.slides && mainSwiper.slides[mainSwiper.activeIndex];
    const imageFrame = activeSlide && activeSlide.querySelector('.product-image');
    const height = imageFrame && imageFrame.getBoundingClientRect().height;

    if (height) {
      mediaEl.style.setProperty('--active-product-image-height', `${height}px`);
    }
  }

  function updateVisibleThumbs() {
    const mainSwiper = sliderEl.swiper;
    const navSlides = Array.from(navEl.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)'));

    if (!navSlides.length) return;

    if (!mainSwiper) {
      attempts += 1;
      if (attempts <= 30) {
        window.setTimeout(updateVisibleThumbs, 100);
      }
      return;
    }

    const activeIndex = typeof mainSwiper.realIndex === 'number' ? mainSwiper.realIndex : mainSwiper.activeIndex || 0;
    const visibleCount = getVisibleThumbCount(navSlides.length);

    updateNavHeight(mainSwiper);

    if (!eventsBound) {
      mainSwiper.on('slideChange', updateVisibleThumbs);
      mainSwiper.on('activeIndexChange', updateVisibleThumbs);
      window.addEventListener('resize', updateVisibleThumbs);
      navSlides.forEach((slide, index) => {
        slide.addEventListener('click', function () {
          mainSwiper.slideTo(index);
        });
      });
      eventsBound = true;
    }

    navSlides.forEach(slide => {
      slide.classList.remove('is-visible-product-thumb');
    });

    for (let offset = 1; offset <= visibleCount; offset += 1) {
      const index = (activeIndex + offset) % navSlides.length;
      navSlides[index].classList.add('is-visible-product-thumb');
    }
  }

  updateVisibleThumbs();
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function () {
  document.querySelectorAll('.product-hero-scroll-button').forEach(button => {
    button.addEventListener('click', function (event) {
      const targetId = this.getAttribute('href').replace('#', '');
      const target = targetId && document.getElementById(decodeURIComponent(targetId));

      if (!target) return;

      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
});
</script>
