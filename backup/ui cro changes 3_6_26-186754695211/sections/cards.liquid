{% unless template_suffix == 'page.article' %}
  {% assign bg_style = 'bg-white' %}
  {% assign card_style = 'bg-light' %}

  {% if section.settings.style == 'light-cards' %}
    {% assign bg_style = 'bg-light' %}
    {% assign card_style = 'bg-white' %}
  {% endif %}

  <div class="background-image-container trigger-observer {{ bg_style }} ">
    {% if section.settings.section_bgimg %}
      {% if section.settings.section_bgimg != blank %}
        {{ section.settings.section_bgimg | image_url: width: 1920 | image_tag: class: 'view-animation fade-up' }}
      {% endif %}
    {% endif %}
  </div>

  <div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }}">
    <div class="container">
      {% if section.settings.heading or section.settings.paragraph %}
        <div class="row justify-content-center mb-5">
          <div class="col-11 col-md-10 col-lg-11">
            {% if section.settings.heading %}
              <h2 class="col-12 col-lg-10">{{ section.settings.heading }}</h2>
            {% endif %}
            {% if section.settings.paragraph %}
              {{ section.settings.paragraph | tag: class: 'mb-5' }}
            {% endif %}
          </div>
        </div>
      {% endif %}

      <div class="row justify-content-center mb-5">

        {% assign has_image_or_video = false %}
        {% for block in section.blocks %}
          {% if block.settings.image != blank or block.settings.video_id != blank %}
            {% assign has_image_or_video = true %}
            {% break %}
          {% endif %}
        {% endfor %}


        <div class="col-11 col-md-10 col-lg-11 cards {% if has_image_or_video %} feature {% endif %}">
          {% for block in section.blocks %}
            {% assign content_style = '' %}
            {% if block.settings.image != blank or block.settings.video_id != blank %}
              {% assign card_style_extra = 'bg-light p-0 copy-smaller' %}
              {% assign content_style = 'p-5' %}
            {% endif %}

            <div class="card {{ card_style }}">
              {% if block.settings.icon != blank %}
                <div class="card__icon">
                  {{ block.settings.icon | image_url: width: 400 | image_tag: class: 'view-animation fade-up img-fluid', loading: "lazy" }}
                </div>

              {% elsif block.settings.image != blank and block.settings.video_id == blank %}
                <div class="card__img">
                  {{ block.settings.image | image_url: width: 900 | image_tag: class: 'view-animation fade-up img-fluid', loading: "lazy" }}
                </div>

              {% elsif block.settings.video_id != blank %}
                <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ block.settings.video_id }}"></div>
              {% comment %} <div class="video-preview-container card__video">
                   
                   
                <script src="https://fast.wistia.com/embed/medias/{{ block.settings.video_id }}.jsonp" async></script></script><div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;"><div class="wistia_responsive_wrapper" style="height:100%;left:0;position:absolute;top:0;width:100%;"><div class="wistia_embed wistia_async_{{ block.settings.video_id }} seo=true videoFoam=true" style="height:100%;position:relative;width:100%"><div class="wistia_swatch" style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;"><img src="https://fast.wistia.com/embed/medias/{{ block.settings.video_id }}/swatch" style="filter:blur(5px);height:100%;object-fit:contain;width:100%;" alt="" aria-hidden="true" onload="this.parentNode.style.opacity=1;"   loading="lazy"/></div></div></div>
              </div></div> {% endcomment %}

              {% else: %}
                {{ forloop.index }}
              {% endif; %}


              <div class="card__content {{ content_style }} ">
                {% if block.settings.heading %}
                  <h3 class="card__content__title">
                    {{ block.settings.heading }}
                  </h3>
                {% endif %}
                {% if block.settings.copy %}
                  <p class="card__content__description {% if block.settings.image != blank %} alt {% endif %}">
                    {{ block.settings.copy | strip_html }}
                  </p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>

      {% if section.settings.buttonlink %}
        <div class="row justify-content-center text-center ">
          <div class="col-12 col-md-10 col-lg-11">
            {% render 'button'
              , class: 'mx-auto text-center' %}
          </div>
        </div>
      {% endif %}
    </div>
  </div>
{% endunless %}
{% schema %}
  {
    "name": "Cards Section",
    "tag": "section",
    "class": "section-cards",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "select",
        "id": "style",
        "label": "Cards Background",
        "default": "white-cards",
        "options": [
          {
            "label": "White",
            "value": "white-cards"
          }, {
            "label": "Light",
            "value": "light-cards"
          }
        ]
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Headline"
      },
      {
        "type": "richtext",
        "id": "paragraph",
        "label": "Paragraph"
      }, {
        "type": "image_picker",
        "id": "section_bgimg",
        "label": "Background Image"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button text"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Url"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "cards",
        "settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "richtext",
            "id": "copy",
            "label": "Copy"
          },
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Icon"
          },
          {
            "type": "image_picker",
            "id": "image",
            "label": "Image",
            "info": "Image "
          }, {
            "type": "text",
            "id": "video_id",
            "label": "Video ID",
            "info": "Wistia Video ID"
          }

        ]
      }
    ],
    "presets": [
      {
        "name": "Cards Section"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}