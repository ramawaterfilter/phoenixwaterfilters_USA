            "custom_css": "/* TRUST BAR */\n.trust-wrapper {\n  width: 100%;\n  background: #2B2B4E !important;\n  padding: 14px 0;\n  overflow: hidden;\n  border-top: 1px solid rgba(255,255,255,0.08);\n  border-bottom: 1px solid rgba(255,255,255,0.08);\n}\n\n/* MOVING CONTENT */\n.trust-bar-inner {\n  display: flex;\n  align-items: center;\n  gap: 30px;\n  width: max-content;\n  white-space: nowrap;\n  animation: marquee 28s linear infinite;\n}\n\n/* EACH ITEM */\n.trust-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  color: #ffffff;\n  font-size: 15px;\n  font-weight: 600;\n  flex-shrink: 0;\n}\n\n.trust-item span {\n  color: #5eead4;\n  font-size: 18px;\n}\n\n/* SCROLL ANIMATION */\n@keyframes marquee {\n  from {\n    transform: translateX(0);\n  }\n  to {\n    transform: translateX(-50%);\n  }\n}\n\n/* PAUSE ON HOVER */\n.trust-wrapper:hover .trust-bar-inner {\n  animation-play-state: paused;\n}\n\n/* MOBILE */\n@media (max-width: 768px) {\n  .trust-item {\n    font-size: 14px;\n  }\n\n  .trust-bar-inner {\n    gap: 32px;\n    animation-duration: 22s;\n  }\n}",
