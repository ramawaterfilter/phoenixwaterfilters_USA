            "custom_html": "<section class=\"promise-section\">\n\n  <div class=\"promise-container\">\n\n    <div class=\"promise-label\">\n      OUR PROMISE\n    </div>\n\n    <h2 class=\"promise-heading\">\n      Built on Trust. Backed by Science.\n    </h2>\n\n    <p class=\"promise-text\">\n      Every claim is tested, certified, and guaranteed — so you can drink with complete confidence.\n    </p>\n\n    <div class=\"promise-grid\">\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🏅</div>\n        <h3>NSF Certified</h3>\n        <p>Independently tested to meet NSF/ANSI drinking water standards.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🔩</div>\n        <h3>AISI 304 Steel</h3>\n        <p>Food-safe stainless steel that is rust-free and non-leaching.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🛡️</div>\n        <h3>10-Year Warranty</h3>\n        <p>Coverage for defects in materials and performance.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🚫</div>\n        <h3>Aluminum-Free</h3>\n        <p>Zero aluminum used in the filtration system.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">♻️</div>\n        <h3>Reusable Design</h3>\n        <p>Replace only the filter media — not the entire unit.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🌿</div>\n        <h3>Eco-Friendly</h3>\n        <p>No electricity, less waste, and natural carbon filtration.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">🏠</div>\n        <h3>Fast US Shipping</h3>\n        <p>Quick nationwide delivery with free shipping available.</p>\n      </div>\n\n      <div class=\"promise-card\">\n        <div class=\"promise-icon\">↩️</div>\n        <h3>100-Day Trial</h3>\n        <p>Try it risk-free with our money-back guarantee.</p>\n      </div>\n\n    </div>\n\n  </div>\n\n</section>",
            "custom_css": ".promise-section{\n  width:100%;\n  background:#ffffff;\n  padding:50px 0;\n}\n\n.promise-container{\n  width:100%;\n  max-width:1125px;\n  margin:0 auto;\n  padding:0 20px;\n}\n\n/* TOP TEXT */\n\n.promise-label{\n  color:#00b8d9;\n  font-size:10px;\n  letter-spacing:2px;\n  font-weight:700;\n  text-transform:uppercase;\n  margin-bottom:10px;\n}\n\n.promise-heading{\n  font-size:34px;\n  line-height:1.1;\n  font-weight:800;\n  color:#0f172a;\n  margin:0 0 14px;\n  max-width:700px;\n}\n\n.promise-text{\n  font-size:15px;\n  line-height:1.6;\n  color:#64748b;\n  max-width:640px;\n  margin:0 0 36px;\n}\n\n/* GRID */\n\n.promise-grid{\n  display:grid;\n  grid-template-columns:repeat(4,1fr);\n  gap:14px;\n}\n\n/* CARD */\n\n.promise-card{\n  background:#ffffff;\n  border:1px solid #e2e8f0;\n  border-radius:18px;\n  padding:20px 16px;\n  transition:all .25s ease;\n  box-shadow:0 2px 10px rgba(15,23,42,0.04);\n}\n\n.promise-card:hover{\n  transform:translateY(-3px);\n  border-color:#b6e7ef;\n  box-shadow:0 8px 22px rgba(15,23,42,0.08);\n}\n\n.promise-icon{\n  width:44px;\n  height:44px;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  background:#f0fbfd;\n  border-radius:12px;\n  font-size:22px;\n  margin-bottom:14px;\n}\n\n.promise-card h3{\n  font-size:16px;\n  line-height:1.3;\n  font-weight:700;\n  color:#0f172a;\n  margin:0 0 8px;\n}\n\n.promise-card p{\n  font-size:12px;\n  line-height:1.6;\n  color:#64748b;\n  margin:0;\n}\n\n/* TABLET */\n\n@media screen and (max-width:1024px){\n\n  .promise-grid{\n    grid-template-row:repeat(2,1fr);\n  }\n\n  .promise-heading{\n    font-size:30px;\n  }\n\n}\n\n/* MOBILE */\n\n@media screen and (max-width:768px){\n\n  .promise-section{\n    padding:40px 0;\n  }\n\n  .promise-container{\n    padding:0 14px;\n  }\n\n  .promise-heading{\n    font-size:26px;\n  }\n\n  .promise-text{\n    font-size:14px;\n    margin-bottom:28px;\n  }\n\n  .promise-grid{\n    gap:12px;\n  }\n\n  .promise-card{\n    padding:18px 14px;\n    border-radius:16px;\n  }\n\n  .promise-icon{\n    width:40px;\n    height:40px;\n    font-size:20px;\n    margin-bottom:12px;\n  }\n\n  .promise-card h3{\n    font-size:15px;\n  }\n\n  .promise-card p{\n    font-size:11px;\n  }\n\n}\n\n/* SMALL MOBILE */\n\n@media screen and (max-width:480px){\n\n  .promise-grid{\n    grid-template-columns:2fr;\n  }\n\n  .promise-heading{\n    font-size:22px;\n  }\n\n  .promise-text{\n    font-size:13px;\n  }\n\n}",
