    "blocks_LW8dxL": {
      "type": "_blocks",
      "blocks": {
        "ai_gen_block_866760f_imPyF7": {
          "type": "ai_gen_block_866760f",
          "settings": {
            "custom_html": "<section class=\"postreat-process-section\">\n  <div class=\"postreat-process-container\">\n\n    <p class=\"postreat-process-subtitle\">THE SCIENCE BEHIND IT</p>\n\n    <h2 class=\"postreat-process-heading\">\n      How POSTreat™ Filters Your Water\n    </h2>\n\n    <div class=\"postreat-process-steps-wrapper\">\n\n      <!-- CONNECTING LINE -->\n      <div class=\"postreat-process-line\"></div>\n\n      <!-- STEP 01 -->\n      <div class=\"postreat-process-step-card\">\n\n        <div class=\"postreat-process-circle\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Fill_the_upper_chamber.png?v=1779951781\" alt=\"Fill chamber icon\">\n        </div>\n\n        <span class=\"postreat-process-step-label\">STEP 01</span>\n\n        <h3 class=\"postreat-process-step-title\">\n          Fill Upper Chamber\n        </h3>\n\n        <p class=\"postreat-process-step-text\">\n          Pour tap water into the upper stainless steel chamber.\n        </p>\n      </div>\n\n      <!-- STEP 02 -->\n      <div class=\"postreat-process-step-card\">\n\n        <div class=\"postreat-process-circle\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Carbon_Filtration.png?v=1779951780\" alt=\"Carbon filtration icon\">\n        </div>\n\n        <span class=\"postreat-process-step-label\">STEP 02</span>\n\n        <h3 class=\"postreat-process-step-title\">\n          Carbon Filtration\n        </h3>\n\n        <p class=\"postreat-process-step-text\">\n          Coconut-shell carbon elements remove 99.9% of chlorine,\n          heavy metals, microplastics &amp; PFAS.\n        </p>\n      </div>\n\n      <!-- STEP 03 -->\n      <div class=\"postreat-process-step-card\">\n\n        <div class=\"postreat-process-circle\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/POSTreat_Stage.png?v=1779951780\" alt=\"Fluoride filtration icon\">\n        </div>\n\n        <span class=\"postreat-process-step-label\">STEP 03</span>\n\n        <h3 class=\"postreat-process-step-title\">\n          POSTreat™ Stage\n        </h3>\n\n        <p class=\"postreat-process-step-text\">\n          Water passes through FluoRid media inside AISI 304 steel casings,\n          capturing fluoride efficiently.\n        </p>\n      </div>\n\n      <!-- STEP 04 -->\n      <div class=\"postreat-process-step-card\">\n\n        <div class=\"postreat-process-circle\">\n          <img src=\"https://cdn.shopify.com/s/files/1/2644/2852/files/Pure_water.png?v=1779951781\" alt=\"Pure water icon\">\n        </div>\n\n        <span class=\"postreat-process-step-label\">STEP 04</span>\n\n        <h3 class=\"postreat-process-step-title\">\n          Pure Water Collected\n        </h3>\n\n        <p class=\"postreat-process-step-text\">\n          Clean, mineral-rich water collects in the lower chamber —\n          ready to drink.\n        </p>\n      </div>\n\n    </div>\n  </div>\n</section>",
            "custom_css": "/* =========================\n   RESET\n========================= */\n\n.postreat-process-section *,\n.postreat-process-section *::before,\n.postreat-process-section *::after {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\n/* =========================\n   SECTION\n========================= */\n\n.postreat-process-section {\n  background:\n    linear-gradient(\n      180deg,\n      #ffffff 0%,\n      #f8fbff 100%\n    );\n\n  padding: 100px 20px;\n  overflow: hidden;\n  position: relative;\n}\n\n.postreat-process-container {\n  width: 100%;\n  max-width: 1180px;\n  margin: 0 auto;\n}\n\n.postreat-process-subtitle {\n  color: #2B2B4E;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 4px;\n  margin-bottom: 18px;\n  text-transform: uppercase;\n  text-align: center;\n}\n\n.postreat-process-heading {\n  font-size: 48px;\n  line-height: 1.1;\n  font-weight: 800;\n  color: #07132a;\n  margin-bottom: 70px;\n  text-align: center;\n}\n\n/* =========================\n   STEPS WRAPPER\n========================= */\n\n.postreat-process-steps-wrapper {\n  position: relative;\n\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n\n  gap: 30px;\n  align-items: start;\n}\n\n/* =========================\n   CONNECTING LINE\n========================= */\n\n.postreat-process-line {\n  position: absolute;\n\n  top: 72px;\n  left: 12%;\n  width: 76%;\n  height: 4px;\n\n  background:\n    linear-gradient(\n      to right,\n      rgba(43, 43, 78, 0.08),\n      rgba(43, 43, 78, 0.5),\n      rgba(43, 43, 78, 0.08)\n    );\n\n  border-radius: 50px;\n  z-index: 0;\n}\n\n/* =========================\n   STEP CARD\n========================= */\n\n.postreat-process-step-card {\n  position: relative;\n  z-index: 2;\n\n  text-align: center;\n\n  padding: 20px 18px;\n\n  border-radius: 30px;\n\n  transition:\n    transform 0.35s ease,\n    box-shadow 0.35s ease;\n}\n\n.postreat-process-step-card:hover {\n  transform: translateY(-8px);\n}\n\n/* =========================\n   STEP LABEL\n========================= */\n\n.postreat-process-step-label {\n  display: inline-block;\n\n  margin-bottom: 18px;\n\n  color: #2B2B4E;\n\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 2px;\n\n  text-transform: uppercase;\n}\n\n/* =========================\n   ICON CIRCLE\n========================= */\n\n.postreat-process-circle {\n  position: relative;\n  z-index: 3;\n\n  width: 145px;\n  height: 145px;\n\n  margin: 0 auto 30px;\n\n  border-radius: 50%;\n\n  border: 2px solid rgba(43, 43, 78, 0.12);\n\n  background:\n    linear-gradient(\n      180deg,\n      #ffffff 0%,\n      #f5fbff 100%\n    );\n\n  display: flex;\n  align-items: center;\n  justify-content: center;\n\n  box-shadow:\n    0 15px 40px rgba(43, 43, 78, 0.08),\n    inset 0 0 20px rgba(43, 43, 78, 0.04);\n\n  transition:\n    transform 0.35s ease,\n    box-shadow 0.35s ease,\n    border-color 0.35s ease;\n}\n\n.postreat-process-circle img {\n    width: 173px;\n    height: 173px;\n    object-fit: contain;\n    transition: transform 0.35s ease;\n}\n\n.postreat-process-step-card:hover .postreat-process-circle {\n  transform: scale(1.06);\n\n  border-color: rgba(43, 43, 78, 0.22);\n\n  box-shadow:\n    0 24px 55px rgba(43, 43, 78, 0.16),\n    inset 0 0 20px rgba(43, 43, 78, 0.05);\n}\n\n.postreat-process-step-card:hover .postreat-process-circle img {\n  transform: scale(1.08);\n}\n\n/* =========================\n   TEXT\n========================= */\n\n.postreat-process-step-title {\n  font-size: 28px;\n  line-height: 1.25;\n\n  color: #07132a;\n\n  margin-bottom: 16px;\n\n  font-weight: 800;\n}\n\n.postreat-process-step-text {\n  font-size: 16px;\n  line-height: 1.8;\n\n  color: #667085;\n\n  max-width: 290px;\n  margin: 0 auto;\n}\n\n/* =========================\n   TABLET\n========================= */\n\n@media (max-width: 1100px) {\n\n  .postreat-process-section {\n    padding: 80px 20px;\n  }\n\n  .postreat-process-heading {\n    font-size: 38px;\n    margin-bottom: 50px;\n  }\n\n  .postreat-process-steps-wrapper {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 40px 30px;\n  }\n\n  .postreat-process-line {\n    display: none;\n  }\n}\n\n/* =========================\n   MOBILE\n========================= */\n\n@media (max-width: 768px) {\n\n  .postreat-process-section {\n    padding: 70px 16px;\n  }\n\n  .postreat-process-subtitle {\n    font-size: 11px;\n    letter-spacing: 3px;\n  }\n\n  .postreat-process-heading {\n    font-size: 30px;\n    line-height: 1.2;\n    margin-bottom: 40px;\n  }\n\n  .postreat-process-steps-wrapper {\n    grid-template-columns: 1fr;\n    gap: 24px;\n  }\n\n  .postreat-process-step-card {\n    background: #ffffff;\n\n    border: 1px solid #edf2f7;\n\n    padding: 32px 22px;\n\n    box-shadow:\n      0 10px 30px rgba(15, 23, 42, 0.05);\n  }\n\n  .postreat-process-circle {\n    width: 105px;\n    height: 105px;\n\n    margin-bottom: 22px;\n  }\n\n  .postreat-process-circle img {\n    width: 46px;\n    height: 46px;\n  }\n\n  .postreat-process-step-title {\n    font-size: 22px;\n    margin-bottom: 12px;\n  }\n\n  .postreat-process-step-text {\n    font-size: 15px;\n    line-height: 1.7;\n  }\n}\n\n/* =========================\n   SMALL MOBILE\n========================= */\n\n@media (max-width: 480px) {\n\n  .postreat-process-heading {\n    font-size: 24px;\n  }\n\n  .postreat-process-circle {\n    width: 88px;\n    height: 88px;\n  }\n\n  .postreat-process-circle img {\n    width: 40px;\n    height: 40px;\n  }\n\n  .postreat-process-step-card {\n    padding: 24px 18px;\n    border-radius: 24px;\n  }\n\n  .postreat-process-step-title {\n    font-size: 19px;\n  }\n\n  .postreat-process-step-text {\n    font-size: 14px;\n  }\n}",
