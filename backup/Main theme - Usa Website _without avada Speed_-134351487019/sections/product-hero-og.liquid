{% unless product == empty %}
	<script>
	    window.product = {{ product | json }} || {};

		// If product exists, add this metafield to to the product json.
		{% if product.metafields.custom.product_badge_text.value != blank %}
			if(typeof product !== "undefined"){
				product['badge'] = "{{ product.metafields.custom.product_badge_text.value }}";
			}
		{% endif %}

		let metaInfo = product.handle + '?view=metafields'

		// Get the metaInfo and add it to the product json.
		fetch(metaInfo)
			.then(response => response.json())
			.then(pageMeta => {
				// Combine all the information to 1 object
				window.product = Object.assign(product, pageMeta);

				if( document.readyState !== 'loading' ) {
					initProductScript(window.product, 'product-selectors', document);
				} else {
					document.addEventListener('DOMContentLoaded', function () {
						initProductScript(window.product, 'product-selectors', document);
					});
				}

			})
			.catch(error => {
				console.error('Error fetching page meta:', error);
			});


  ///  Variant Controller

  const selectElement = document.querySelector("#product-selectors");
  
  
  document.addEventListener('DOMContentLoaded', function() {
      
  // General function to set up synchronization between radio button groups
    function setupRadioSync(primarySelector, secondarySelector) {
      const primaryRadioButtons = document.querySelectorAll(primarySelector);

      // Function to update secondary radio buttons and dispatch a change event
      const updateSecondaryRadios = (selectedValue) => {
        const secondaryRadioButtons = document.querySelectorAll(secondarySelector);
        let foundMatch = false;

        secondaryRadioButtons.forEach(radio => {
          if (radio.value === selectedValue) {
            if (!radio.checked) {
              radio.checked = true;
              foundMatch = true;
              // Dispatch the change event
              radio.dispatchEvent(new Event('change', { 'bubbles': true }));
              selectElement.dispatchEvent(new Event('change', { 'bubbles': true }));
            }
          } else {
            if (radio.checked) {
              radio.checked = false;
              // Dispatch the change event for unchecked state as well if needed
              radio.dispatchEvent(new Event('change', { 'bubbles': true }));
              selectElement.dispatchEvent(new Event('change', { 'bubbles': true }));
            }
          }
        });
        if (!foundMatch) {
          console.log('No match found in secondary radios for value:', selectedValue);
        }
      };

      // Listen for changes on primary radio buttons
      primaryRadioButtons.forEach(radio => {
        radio.addEventListener('change', function() {
          if (radio.checked) {
            updateSecondaryRadios(radio.value);
          }
        });
      });
    }

    // Setup synchronization for both filter and size options
    setupRadioSync('#filter-typeoptions input[type="radio"]', '.radio-selector__option input[name="filter-type-radio"]');
    setupRadioSync('#size-options input[type="radio"]', '.radio-selector__option input[name="size-radio"]');
  });

