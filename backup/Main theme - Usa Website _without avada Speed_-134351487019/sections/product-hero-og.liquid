            <!-- Loop through each option and display its name and values -->

            {% for option in product.options_with_values %}
                <div class="step step-{{ option.name }}">
                    <div class="step-number">{{ forloop.index }}</div>
                    <div class="step-title">Select {{ option.name }}
                      - 
            
                      {% for value in option.values %}
                        <span class="{{ value }}" style="display:{% if forloop.first %}unset;{% else %} none;{% endif %}">
                           {% if option.name == 'Size' %}
  {% capture size_for_key %}size_for_{{ forloop.index }}{% endcapture %}
      {{ settings[size_for_key] }}
      {% else %}
    {{ value }}
     {% endif %}</span>
                      {% endfor %}
                   
                    </div>
                    </div>

                    <div id="{{ option.name | downcase | replace: ' ', '-' }}-options" class="info-field-container d-flex  flex-row  radio-selectors ">
                   
                  {% for value in option.values %}
                    <div class="radio-option d-flex">
                      
                    <input type="radio" id="{{ option.name | downcase | append: '-' | append: value }}" name="{{ option.name | downcase }}" value="{{ value }}"  {% if forloop.first %}checked{% endif %}>

