    function handleOptionChange(containerId, stepClass) {
      const container = document.getElementById(containerId);
      if (container) {
        container.addEventListener('change', function(event) {
          if (event.target.type === 'radio' && event.target.name === stepClass.toLowerCase()) {
            
          // Get all span elements in the specified .step class container
            const spans = document.querySelectorAll(`.step.step-${stepClass} span`);
            
            // Hide all spans first
            spans.forEach(span => {
              span.style.display = 'none';
            });
  
            // Construct a selector that matches the class attribute exactly
            const optionValue = event.target.value;
            const escapedOptionValue = optionValue.replace(/([\.\s])/g, "\\$1");
            const selector = `.step.step-${stepClass} span[class="${escapedOptionValue}"]`;
  
            // Find the span that matches the value of the selected radio button and show it
            const selectedSpan = document.querySelector(selector);
            if (selectedSpan) {
              selectedSpan.style.display = 'unset';  
            }
          }
        });
      } else {
        console.log(`Container #${containerId} not found.`);
      }
    }
  
    // Setup listeners for 'Size' and 'Filter'
    handleOptionChange('size-options', 'Size');
    handleOptionChange('filter-type-options', 'Filter');
  });


  /// Toggle Sub Plans

    document.addEventListener('DOMContentLoaded', function() {
      const selectElement = document.querySelector("#product-selectors");
      const subby = document.querySelector("#subby");
      const subscriptionGroups = document.querySelectorAll('.subscriptions__group');
      const oneTimeOption = document.querySelector('.one-time-option');
      const oneTimeRadio = oneTimeOption.querySelector('input[type="radio"]');

      const toggleDiscountPrice = document.querySelectorAll('[toggle-discount]');
      const togglePrice = document.querySelectorAll('[toggle-price]');


      

      function selectPlan() {
        const selectedOption = selectElement.options[selectElement.selectedIndex];
        const subPlanValue = selectedOption.getAttribute('data-sub-id').trim();
        subby.value = subPlanValue;

        
          let isSubPlanActive = false;
         
          subscriptionGroups.forEach(group => {
            const groupSubId = group.getAttribute('data-sub-id').trim();
            let radio = group.querySelector('input[type="radio"]');

            if(groupSubId === subPlanValue) {
              group.classList.add('active');
              group.classList.remove('sr-only');
              radio.checked = true;
              radio.dispatchEvent(new Event('change', { 'bubbles': true }));
              isSubPlanActive = true;  
              togglePrice.forEach(price => {
                price.classList.add('sr-only')
              });
              toggleDiscountPrice.forEach(price => {
                price.classList.remove('sr-only')
              });
            } else {
              group.classList.remove('active');
              group.classList.add('sr-only');
              radio.checked = false;
            }
          });

          // Manage the visibility and activity of the one-time option
          oneTimeOption.classList.remove('active');
          oneTimeRadio.checked = false;

          if (!isSubPlanActive) {
            oneTimeOption.classList.add('active');
            oneTimeRadio.checked = true;
          }
        
      }

      // Event listener for changes in the select element
      selectElement.addEventListener('change', selectPlan);

      // Click event for subscription group radios
      subscriptionGroups.forEach(group => {
        const radios = group.querySelectorAll('input[type="radio"]');
        radios.forEach(radio => {
          radio.addEventListener('click', function() {
            // Activate this group and deactivate others
            subscriptionGroups.forEach(innerGroup => {
              innerGroup.classList.remove('active');
              innerGroup.classList.add('sr-only');
              innerGroup.querySelector('input[type="radio"]').checked = false;
            });
            group.classList.add('active');
            group.classList.remove('sr-only');
            radio.checked = true;
            oneTimeOption.classList.remove('active');
            oneTimeRadio.checked = false;

            toggleDiscountPrice.forEach(price => {
                price.classList.remove('sr-only')
              });
              togglePrice.forEach(price => {
                price.classList.add('sr-only')
              });
          });
        });
      });

      // Click event for one-time option

      oneTimeRadio.addEventListener('click', function() {
              toggleDiscountPrice.forEach(price => {
                price.classList.add('sr-only')
              });
              togglePrice.forEach(price => {
                price.classList.remove('sr-only')
              });

        subscriptionGroups.forEach(group => {
          group.classList.remove('active');
          group.querySelector('input[type="radio"]').checked = false;
        });
        oneTimeOption.classList.add('active');
        oneTimeRadio.checked = true;
      });

      // Initialize on load
      selectPlan();  
      // Ensure the one-time option is always visible
      oneTimeOption.classList.remove('sr-only');
    });






  /// Display Subscription discount

  const priceElements = document.querySelectorAll("span[data-price]");

  // Create a MutationObserver instance to handle mutations
  const observer = new MutationObserver((mutations) => {
    mutations.forEach((mutation) => {
      // Handle the mutation appropriately if it involves text changes
      if (mutation.type === "characterData" || mutation.addedNodes.length > 0) {
        const targetElement =
          mutation.target.nodeType === Node.TEXT_NODE
            ? mutation.target.parentNode
            : mutation.target;
        updateDiscountedPrice(targetElement);
      }
    });
  });
  

  // Set up the observer for each price element

  priceElements.forEach((element) => {
    observer.observe(element, {
      characterData: true,
      childList: true,
      subtree: true,
    });
    // Trigger an initial update to set the discounted price
    updateDiscountedPrice(element);
  });

  // Function to update the discount based on the price in 'data-price'

  function updateDiscountedPrice(priceElement) {

  const fullPriceText = priceElement.textContent;
  const fullPrice = parseFloat(fullPriceText.replace(/[^0-9.]/g, ""));

  let planDiscount = priceElement
      .closest(".sub-price")
      .querySelector("#discount-amount");

      if (planDiscount) {
        const discountedPrice = fullPrice - planDiscount.value; // 

        const discountDisplay = priceElement
          .closest(".sub-price")
          .querySelector("[data-price-discount]");

          if (discountDisplay) {
            discountDisplay.textContent = formatCurrency(discountedPrice);
          }
      }
  }

  // Helper function to format the number as currency
  function formatCurrency(amount) {
    return new Intl.NumberFormat("en-US", {
      style: "currency",
      currency: "USD",
    }).format(amount);
  }


  /// Show Discount Price in Button & Sticky Buy Now

    document.addEventListener('DOMContentLoaded', function() {
    const subscriptionGroups = document.querySelectorAll('.subscriptions__group');
    let priceDiscountElements = document.querySelectorAll('[get-data-price-discount]');
    

    // Function to update price discounts on the page
    function updatePriceDiscounts(discountAmount) {
      priceDiscountElements.forEach(element => {
        element.textContent = discountAmount; 
      });
    }

    

    // MutationObserver callback to handle class changes
    const callback = function(mutationsList, observer) {
      for (const mutation of mutationsList) {
        if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
          let targetElement = mutation.target;
       
          const discountContainer = targetElement.querySelector('.sub-price [data-price-discount]');
          if (targetElement.classList.contains('active')) {
              discountContainer.classList.add('show');
            // When a group becomes active, find the discount amount and update
            const discountAmount = targetElement.querySelector('.sub-price [data-price-discount]').innerHTML;
            updatePriceDiscounts(discountAmount);
          }
          else {
              discountContainer.classList.remove('show');
          }
        }
      }
    };

    // Creating a MutationObserver instance to observe class changes
    const observer = new MutationObserver(callback);
    subscriptionGroups.forEach(group => {
      observer.observe(group, { attributes: true, attributeFilter: ['class'] });
    });

    // Optionally, initialize with the active group's discount if needed
    const activeGroup = document.querySelector('.subscriptions__group.active');
    if (activeGroup) {
      const initialDiscount = activeGroup.querySelector('.sub-price [data-price-discount]').innerHTML;
      updatePriceDiscounts(initialDiscount);
    }
  });


	</script>

