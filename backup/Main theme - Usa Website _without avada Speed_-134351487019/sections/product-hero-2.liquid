    <script>
  document.addEventListener("DOMContentLoaded", function () {
    const form = document.getElementById("add-to-cart");
    form.addEventListener("submit", function (e) {
      e.preventDefault();

      const fluoridId = "{{ fluorid_variant.id }}";
      const steelId = document.getElementById("steel_variant_id").value;
      const quantity = parseInt(document.querySelector('input[name="quantity"]').value, 10) || 1;

      const selectedPlan = document.querySelector('input[name="selling_plan"]:checked');
      const sellingPlanId = selectedPlan ? selectedPlan.value : null;

      const items = [
        {
          id: fluoridId,
          quantity: quantity,
          ...(sellingPlanId ? { selling_plan: sellingPlanId } : {})
        },
        {
          id: steelId,
          quantity: quantity
        }
      ];

      fetch("/cart/add.js", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ items })
      }).then(() => {
        window.location.href = "/cart";
      }).catch(err => {
        console.error('Cart Add Error:', err);
      });
    });
  });
</script>