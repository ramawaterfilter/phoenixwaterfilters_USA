{% assign current_variant = product.selected_or_first_available_variant %}
<div class="container">
  <div class="row justify-content-center lk">
    <div class="col-11 jkl col-lg-6 pe-5">
      <div class="position-relative {% if product.images.size <= 0 %}h-100{% endif %}">
        {% render 'product-badge', product: product %}

        {% if product.images.size > 1 %}
          <div class="swiper-container swiper product-swiper" data-slidestoshow="1" id="product-slider">
            <div class="swiper-wrapper">
              {% for media in product.media %}
                {% assign thisVariantID = "" %}
                {% for variant in product.variants %}
                  {% if variant.featured_image == media.src %}
                    {% assign thisVariantID = variant.id %}
                  {% endif %}
                {% endfor %}
                {% comment %} Add video check to conditional... maybe? {% endcomment %}
                {% if media.media_type == "external_video" %}
                  <div class="swiper-slide" data-variant-id="{{ thisVariantID }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | external_video_url: autoplay: 'true' }}" class="product-image product-image--video d-block">
                      {{ media.preview_image | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% elsif media.media_type == "image" %}
                  <div class="swiper-slide" data-variant-id="{{ thisVariantID }}" data-slide-index="{{ forloop.index }}">
                    <a data-fancybox="gallery" href="{{ media | image_url: width: 2560 }}" class="product-image d-block">
                      {{ media | image_url: width: 1200 | image_tag }}
                    </a>
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="swiper-container swiper control {% if product.media.size == 3 %} control-three {% endif %} {% if product.media.size == 5 %}control-five{% endif %}" id="product-slider-nav">
            <div class="swiper-wrapper {% if product.media.size == 3 or product.media.size == 5 %}wide{% endif %}">
              {% for media in product.media %}
                {% if media.media_type == "external_video" %}
                  <div class="swiper-slide">
                    {{ media.preview_image | image_url: width: 600 | image_tag }}
                  </div>
                {% elsif media.media_type == "image" %}
                  <div class="swiper-slide">
                    {{ media | image_url: width: 1200 | image_tag }}
                  </div>
                {% endif %}
              {% endfor %}
            </div>
          </div>
          <div class="swiper-nav">
            <div class="swiper-button-prev swiper-prev"></div>
            <div class="swiper-button-next swiper-next"></div>
          </div>
        {% elsif product.featured_image %}
          <a data-fancybox="gallery" href="{{ product.featured_image | image_url: width: 2560 }}" class="product-image d-block">
            {{ product.featured_image | image_url: width: 1200| image_tag }}
          </a>
        {% else %}
          <div class="placeholder">
            {{ 'image' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>
    </div>
    <div class="col-11 gg col-lg-6 mt-3 mt-lg-0">
      {% render 'product-hero-countdown', section: section %}
      <h1>{{ product.title }}</h1>
      <div class="product-rating">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when '@app' %}
              {% render block %}
          {% endcase %}
        {% endfor %}
      </div>
      {% render 'best-for-tag' %}
      {% if product.description != blank or product.metafields.custom.product_usps.value.size > 0 %}
        <div class="product-description">
          {{ product.description }}
          {% if product.metafields.custom.product_usps.value.size > 0 %}
            <ul class="product-description__usps">
              {% for usp in product.metafields.custom.product_usps.value %}
                <li>{{ usp }}</li>
              {% endfor %}
            </ul>
          {% endif %}
        </div>
      {% endif %}
      {% if settings.enable_minmax_buys %}
        {% assign min_buy = settings.min_buy_qty %}
        {% assign max_buy = settings.max_buy_qty %}
      {% endif %}
      
      {% assign fluorid_variant = null %}
{% assign steel_variant = null %}

{% for variant in product.variants %}
  {% assign v_title = variant.title | downcase %}
  {% if v_title contains "postreat fluorid refill media" %}
    {% assign fluorid_variant = variant %}
  {% endif %}
  {% if v_title contains "postreat steel" %}
    {% assign steel_variant = variant %}
  {% endif %}
{% endfor %}
<form method="post" action="/cart/add" id="add-to-cart">
  {%- comment -%}
  Main variant: FluoRid Refill Media (Appstle supported)
  {%- endcomment -%}
  <input type="hidden" name="id" value="{{ fluorid_variant.id }}">

  <div class="mb-3 p-3 border bg-light">
    ✅ <strong>{{ fluorid_variant.title }}</strong>
  </div>

  {% if fluorid_variant.selling_plan_allocations.size > 0 %}
    <div class="subscriptions__group mb-3" style="display:none">
      <p class="h5">Save & Subscribe:</p>
      {% for allocation in fluorid_variant.selling_plan_allocations %}
        <label>
          <input type="radio" name="selling_plan" value="{{ allocation.selling_plan.id }}"
          {% if forloop.first %}checked{% endif %}>
          {{ allocation.selling_plan.name }}
        </label><br/>
      {% endfor %}
    </div>
  {% endif %}

  {% if steel_variant %}
    <input type="hidden" name="steel_variant_id" id="steel_variant_id" value="{{ steel_variant.id }}">
    <div class="mb-3 p-3 border bg-light">
      ✅ <strong>{{ steel_variant.title }}</strong>
    </div>
  {% endif %}

  

  <button type="submit" class="btn btn-primary">Add to Cart</button>
</form>

    </div>
                

  </div>
</div>
                   


{% render 'sticky-add-to-cart' %}

{% unless product == empty %}
  {% comment %} Product Script {% endcomment %}
  <script>
    window.product = {{ product | json }} || {};
    {% if product.metafields.custom.product_badge_text.value != blank %}
      if(typeof product !== "undefined"){
        product['badge'] = "{{ product.metafields.custom.product_badge_text.value }}";
      }
    {% endif %}
    let metaInfo = product.handle + '?view=metafields';
    fetch(metaInfo)
      .then(response => response.json())
      .then(pageMeta => {
        window.product = Object.assign(product, pageMeta);
        
        if( document.readyState !== 'loading' ) {
          initProductScript(window.product, 'product-selectors', document);
        } else {
          document.addEventListener('DOMContentLoaded', function () {
            initProductScript(window.product, 'product-selectors', document);
          });
        }
      })
      .catch(error => {
        console.error('Error fetching page meta:', error);
      });
  </script>
{% endunless %}


