<script>
  window.variantComboImages = {{ product.metafields.custom.variant_combo_image | default: empty_object }};


document.addEventListener("DOMContentLoaded", function () {
  const variantSelect = document.getElementById("product-selectors");
  const priceEl = document.querySelector("[data-price]");
  const compareEl = document.querySelector("[data-compare]");
  const addToCartBtn = document.getElementById("product-add-to-cart");

  if (!variantSelect || !priceEl) return;

  function updatePrice() {
    const option = variantSelect.options[variantSelect.selectedIndex];

    const price = option.dataset.price;
    const compare = option.dataset.compare;
    const available = option.dataset.available === "true";

    // ✅ Update price
    priceEl.innerHTML = Shopify.formatMoney(price);

    // ✅ Compare at price
    if (compare && compare > price) {
      compareEl.innerHTML = `<s>${Shopify.formatMoney(compare)}</s>`;
    } else {
      compareEl.innerHTML = "";
    }

    // ✅ Handle stock state
    if (!available) {
      addToCartBtn.setAttribute("disabled", "disabled");
      addToCartBtn.innerText = "SOLD OUT";
    } else {
      addToCartBtn.removeAttribute("disabled");
      addToCartBtn.innerText = "Add to cart";
    }
  }

  variantSelect.addEventListener("change", updatePrice);
  updatePrice(); // run on load
});


</script>
