<script>
document.addEventListener("DOMContentLoaded", function () {

  // IMPORTANT: Use the actual option values (not label text)
  const DEFAULT_OPTIONS = [
    "2.25 Gallon",
    "2 Carbon Filter Elements",
    "No Stand"
  ];

  const variantSelect = document.querySelector('#product-selectors');
  const variants = window.productVariants || [];

  if (!variantSelect || !variants.length) return;

  setTimeout(() => {
    // Find matching variant
    const defaultVariant = variants.find(v =>
      v.options[0] === DEFAULT_OPTIONS[0] &&
      v.options[1] === DEFAULT_OPTIONS[1] &&
      v.options[2] === DEFAULT_OPTIONS[2]
    );

    if (!defaultVariant) {
      console.warn("Default variant not found:", DEFAULT_OPTIONS);
      return;
    }

    // Set select
    variantSelect.value = defaultVariant.id;
    variantSelect.dispatchEvent(new Event("change", { bubbles: true }));

    // Set radios
    document.querySelectorAll(".variant-radio").forEach(radio => {
      const index = Number(radio.dataset.optionIndex);
      if (DEFAULT_OPTIONS[index] === radio.value) {
        radio.checked = true;
      }
    });

    // Trigger your UI label script + price script
    variantSelect.dispatchEvent(new Event("change", { bubbles: true }));
  }, 300);
});
</script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  const variantSelect = document.getElementById("product-selectors");
  if (variantSelect) {
    variantSelect.dispatchEvent(new Event("change", { bubbles: true }));
  }
});
</script>
