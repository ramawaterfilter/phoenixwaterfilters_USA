<script>
  // Image lookup based on Filter Type + Stand
  window.variantComboImages = {
    {% for variant in product.variants %}
      "{{ variant.options[1] }}|{{ variant.options[2] }}": {{ variant.metafields.custom.variant_combo_image | json }}
      {% unless forloop.last %},{% endunless %}
    {% endfor %}
  };

  // Full variant list
  window.productVariants = [
    {% for variant in product.variants %}
      {
        id: {{ variant.id }},
        options: [{% for opt in variant.options %}"{{ opt }}"{% unless forloop.last %}, {% endunless %}{% endfor %}]
      }{% unless forloop.last %}, {% endunless %}
    {% endfor %}
  ];
</script>
<script>
 document.addEventListener("DOMContentLoaded", function () {
  const comboImages = window.variantComboImages || {};
  const variants = window.productVariants || [];

  const anchor = document.querySelector('.main-variant-image');
  const img = anchor?.querySelector('img') || anchor;
  const variantSelect = document.querySelector('form[action^="/cart/add"] select[name="id"]');

  if (!img || !anchor || !variantSelect) {
    console.warn("❌ Required DOM elements not found");
    return;
  }

function updateImageFromVariant() {
  const variantId = variantSelect.value;
  const variant = variants.find(v => v.id == variantId);
  if (!variant) return;

  const comboKey = `${variant.options[1]}|${variant.options[2]}`;
  const imageUrl = comboImages[comboKey];

  const anchor = document.querySelector('.main-variant-image');
  const img = anchor?.querySelector('img') || anchor;

  if (imageUrl && img) {
    if (anchor.tagName === 'A') {
      anchor.href = imageUrl;
    }

    // ✅ Set new image
    img.src = imageUrl;
    img.srcset = imageUrl;
    img.alt = comboKey;

    // ✅ Wait for image to load before resetting Swiper
    img.onload = () => {
      if (typeof mainSwiper !== 'undefined' && typeof mainSwiper.slideTo === 'function') {
        mainSwiper.slideTo(0); // Reset main Swiper
      }

      const navSwiper = document.querySelector('#product-slider-nav')?.swiper;
      if (navSwiper && typeof navSwiper.slideTo === 'function') {
        navSwiper.slideTo(0); // Reset thumbnail Swiper (if used)
      }
    };

    console.log("✅ Updated image to:", imageUrl);
  } else {
    console.warn("⚠️ No image found for combo:", comboKey);
  }
}
   // This code fr after swap the images the first image rturn after click the varient

  variantSelect.addEventListener("change", () => {
    updateImageFromVariant();
    if (typeof mainSwiper !== 'undefined') {
      mainSwiper.slideToLoop(0); 
    }
  });
  // Optional: run on page load
  updateImageFromVariant();
});

  variantSelect.addEventListener("change", () => {
  updateImageFromVariant();

  
  const allSwipers = document.querySelectorAll('.swiper');
  allSwipers.forEach(swiperEl => {
    if (swiperEl.swiper && typeof swiperEl.swiper.slideTo === 'function') {
      swiperEl.swiper.slideTo(0);
    }
  });
});
</script>


    
