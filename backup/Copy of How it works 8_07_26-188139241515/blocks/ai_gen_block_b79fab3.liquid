{% doc %}
  @prompt
    create the custom section directly paste the code in html css and js and liquid code if the space is empty not taken any space  i need eveything is editable like font size color  adn evething 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-section-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    padding-left: {{ block.settings.padding_left }}px;
    padding-right: {{ block.settings.padding_right }}px;
    margin-top: {{ block.settings.margin_top }}px;
    margin-bottom: {{ block.settings.margin_bottom }}px;
    border-radius: {{ block.settings.border_radius }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-custom-section-{{ ai_gen_id }}:empty {
    padding: 0;
    margin: 0;
    display: none;
  }

  .ai-custom-section__container-{{ ai_gen_id }} {
    max-width: {{ block.settings.content_max_width }}px;
    margin: 0 auto;
  }

  .ai-custom-section__container-{{ ai_gen_id }}:empty {
    display: none;
  }

  .ai-custom-section__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    color: {{ block.settings.heading_color }};
    font-weight: {{ block.settings.heading_font_weight }};
    line-height: {{ block.settings.heading_line_height }};
    margin-top: 0;
    margin-bottom: {{ block.settings.heading_margin_bottom }}px;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
  }

  .ai-custom-section__heading-{{ ai_gen_id }}:empty {
    display: none;
    margin: 0;
  }

  .ai-custom-section__subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    color: {{ block.settings.subheading_color }};
    font-weight: {{ block.settings.subheading_font_weight }};
    line-height: {{ block.settings.subheading_line_height }};
    margin-top: 0;
    margin-bottom: {{ block.settings.subheading_margin_bottom }}px;
    letter-spacing: {{ block.settings.subheading_letter_spacing }}px;
  }

  .ai-custom-section__subheading-{{ ai_gen_id }}:empty {
    display: none;
    margin: 0;
  }

  .ai-custom-section__content-{{ ai_gen_id }} {
    font-size: {{ block.settings.content_font_size }}px;
    color: {{ block.settings.content_color }};
    line-height: {{ block.settings.content_line_height }};
    margin-bottom: {{ block.settings.content_margin_bottom }}px;
  }

  .ai-custom-section__content-{{ ai_gen_id }}:empty {
    display: none;
    margin: 0;
  }

  .ai-custom-section__content-{{ ai_gen_id }} p {
    margin-top: 0;
    margin-bottom: {{ block.settings.paragraph_spacing }}px;
  }

  .ai-custom-section__content-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .ai-custom-section__button-wrapper-{{ ai_gen_id }} {
    margin-top: {{ block.settings.button_margin_top }}px;
  }

  .ai-custom-section__button-wrapper-{{ ai_gen_id }}:empty {
    display: none;
    margin: 0;
  }

  .ai-custom-section__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    background-color: {{ block.settings.button_background_color }};
    color: {{ block.settings.button_text_color }};
    font-size: {{ block.settings.button_font_size }}px;
    font-weight: {{ block.settings.button_font_weight }};
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_border_color }};
    transition: all 0.3s ease;
    cursor: pointer;
    letter-spacing: {{ block.settings.button_letter_spacing }}px;
  }

  .ai-custom-section__button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_background }};
    color: {{ block.settings.button_hover_text_color }};
    border-color: {{ block.settings.button_hover_border_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-custom-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.mobile_padding_top }}px;
      padding-bottom: {{ block.settings.mobile_padding_bottom }}px;
      padding-left: {{ block.settings.mobile_padding_left }}px;
      padding-right: {{ block.settings.mobile_padding_right }}px;
    }

    .ai-custom-section__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_font_size }}px;
    }

    .ai-custom-section__subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_subheading_font_size }}px;
    }

    .ai-custom-section__content-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_content_font_size }}px;
    }

    .ai-custom-section__button-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_button_font_size }}px;
    }
  }
{% endstyle %}

<div class="ai-custom-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-section__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-custom-section__heading-{{ ai_gen_id }}">
        {{ block.settings.heading }}
      </h2>
    {% endif %}

    {% if block.settings.subheading != blank %}
      <h3 class="ai-custom-section__subheading-{{ ai_gen_id }}">
        {{ block.settings.subheading }}
      </h3>
    {% endif %}

    {% if block.settings.content != blank %}
      <div class="ai-custom-section__content-{{ ai_gen_id }}">
        {{ block.settings.content }}
      </div>
    {% endif %}

    {% if block.settings.button_text != blank and block.settings.button_link != blank %}
      <div class="ai-custom-section__button-wrapper-{{ ai_gen_id }}">
        <a href="{{ block.settings.button_link }}" class="ai-custom-section__button-{{ ai_gen_id }}">
          {{ block.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</div>

