
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-custom-code-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
  }

  .ai-custom-code-wrapper-{{ ai_gen_id }} {
    width: 100%;
  }
{% endstyle %}

<div class="ai-custom-code-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-custom-code-wrapper-{{ ai_gen_id }}">
    {% if block.settings.custom_html != blank %}
      {{ block.settings.custom_html }}
    {% endif %}
  </div>
</div>

{% if block.settings.custom_css != blank %}
  <style>
    {{ block.settings.custom_css }}
  </style>
{% endif %}

{% if block.settings.custom_js != blank %}
  <script>
    (function() {
      {{ block.settings.custom_js }}
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Custom code",
  "settings": [
    {
      "type": "header",
      "content": "HTML"
    },
    {
      "type": "html",
      "id": "custom_html",
      "label": "HTML code"
    },
    {
      "type": "header",
      "content": "CSS"
    },
    {
      "type": "textarea",
      "id": "custom_css",
      "label": "CSS code"
    },
    {
      "type": "header",
      "content": "JavaScript"
    },
    {
      "type": "textarea",
      "id": "custom_js",
      "label": "JavaScript code"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Custom code"
    }
  ]
}
{% endschema %}