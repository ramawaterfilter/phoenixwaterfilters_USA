{% form 'customer'
  , class: 'kk-validation'
  , id: 'newsletter-footer' %}
  {% unless template.suffix == 'article' %}
    <p>
      <strong>
        {{ 'newsletter.title' | t }}
      </strong>
    </p>
  {% endunless %}

  {% if form.posted_successfully? %}
    <p>
      Thankyou, your subscription has been received.
    </p>
  {% else %}

    {{ form.errors | default_errors }}

    <div class="{% unless template.suffix == 'article' %}form-group {% else %} form-group article{% endunless %}">

      <input
        type="email"
        name="contact[email]"
        placeholder="{{ 'newsletter.label' | t }}"
        required />


      <button class="btn form-btn" aria-label="Submit">
        {% unless template.suffix == 'article' %}
          <svg
            class="form-arrow"
            width="18"
            height="12"
            viewBox="0 0 18 12"
            fill="none"
            xmlns="http://www.w3.org/2000/svg">
            <path
              d="M14.2111 7.54577L11.5123 10.273L14.2111 7.54577ZM14.2111 7.54577H14.7509V7.00031M14.2111 7.54577L14.7509 7.00031M14.7509 7.00031L14.3632 6.61664L13.9835 7.00031M14.7509 7.00031H13.9835M13.9835 7.00031H0.909979C0.432706 7.00031 0.0917969 6.6594 0.0917969 6.18213C0.0917969 5.73895 0.432706 5.36395 0.909979 5.36395H13.9795L14.3652 5.74964L14.7509 5.36395V4.81849H14.2054L11.5123 2.12531C11.1713 1.81849 11.1713 1.30713 11.5123 1.00031C11.8191 0.659402 12.3305 0.659402 12.6713 1.00031L17.3077 5.63667L13.9835 7.00031ZM11.9178 11.0332L11.8879 10.9999L11.853 10.972C11.8479 10.9679 11.8431 10.9634 11.8369 10.9478C11.8292 10.928 11.8191 10.8878 11.8191 10.8185C11.8191 10.7753 11.8264 10.7449 11.8339 10.7268C11.8403 10.711 11.8466 10.7041 11.853 10.699L11.8777 10.6792L11.9 10.6567L15.1386 7.38398L16.058 6.45486H14.7509H0.909979C0.733952 6.45486 0.637251 6.35816 0.637251 6.18213C0.637251 6.02518 0.748749 5.9094 0.909979 5.9094H14.7509H16.0677L15.1366 4.97826L11.898 1.73962L11.8878 1.72944L11.8771 1.71982C11.822 1.67024 11.802 1.61328 11.802 1.56281C11.802 1.51235 11.822 1.45538 11.8771 1.4058L11.8985 1.38656L11.9178 1.36516C11.9662 1.31135 12.0226 1.29008 12.079 1.29008C12.1372 1.29008 12.2131 1.31351 12.2855 1.38594L12.2856 1.38601L16.922 6.02237L16.922 6.0224C17.0158 6.1162 17.0158 6.28215 16.922 6.37595L16.922 6.37598L12.2856 11.0123L12.2855 11.0124C12.213 11.0849 12.1371 11.1083 12.079 11.1083C12.0227 11.1083 11.9663 11.0871 11.9178 11.0332Z"
              stroke="#344054"
              stroke-width="1.09091" />
          </svg>
        {% else %}
          {{ 'newsletter.button_label' | t }}
        {% endunless %}
      </button>
    </div>

  {% endif %}
{% endform %}