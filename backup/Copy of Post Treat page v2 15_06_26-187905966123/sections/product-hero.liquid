<script>
  document.addEventListener('DOMContentLoaded', function () {

    {% if product.handle == 'wooden-stand-for-gravity-water-filter-system' or product.handle == 'stainless-steel-stand' %}

    const boxes = document.querySelectorAll('.variant-img-box');
    const select = document.getElementById('product-selectors');
    const titleEl = document.getElementById('selected-variant-title');

    boxes.forEach(box => {
      box.addEventListener('click', function () {

        const variantId = this.dataset.id;

        // ✅ change variant
        select.value = variantId;
        select.dispatchEvent(new Event('change', { bubbles: true }));

        // ✅ update title
        if (titleEl) {
          titleEl.textContent = this.dataset.title;
        }

        // ✅ active state
        boxes.forEach(b => b.classList.remove('active'));
        this.classList.add('active');

        // ✅ 🔥 MOVE PRODUCT IMAGE (IMPORTANT FIX)
        changeProductImage(variantId);

      });
    });

    function changeProductImage(variantId) {

      // find matching slide
      const slides = document.querySelectorAll('#product-slider .swiper-slide');

      slides.forEach((slide, index) => {
        if (slide.getAttribute('data-variant-id') == variantId) {

          // swiper instance
          if (window.productSwiper) {
            window.productSwiper.slideTo(index);
          }

          // fallback (force click)
          slide.scrollIntoView({ behavior: "smooth", inline: "center" });
        }
      });
    }

    {% endif %}

  });
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const variantContainer = document.getElementById('product-variants');
  const select = document.getElementById('product-selectors');

    if (!variantContainer || !select) return;

  const boxes = variantContainer.querySelectorAll('.variant-img-box');
  const titleEl = document.getElementById('selected-variant-title');
  const productData = window.product || {{ product | json }};

  function formatVariantMoney(cents) {
    if (window.Shopify && typeof Shopify.formatMoney === 'function' && window.money_format) {
      return Shopify.formatMoney(cents, window.money_format);
    }

    return '$' + (cents / 100).toFixed(2);
  }

  function updatePriceLine(variant) {
    const priceEl = document.querySelector('.priceline [data-price]');
    const compareWrapper = document.querySelector('.priceline [data-compare]');
    const paypalMessage = document.querySelector('[data-pp-message]');
    let compareEl = compareWrapper && compareWrapper.querySelector('s');

    if (priceEl) {
      priceEl.innerHTML = formatVariantMoney(variant.price);
    }

    if (compareWrapper && !compareEl) {
      compareWrapper.innerHTML = '<s></s>';
      compareEl = compareWrapper.querySelector('s');
    }

    if (compareEl) {
      if (variant.compare_at_price && variant.compare_at_price > variant.price) {
        compareEl.innerHTML = formatVariantMoney(variant.compare_at_price);
        compareEl.style.display = 'inline';
      } else {
        compareEl.innerHTML = '';
        compareEl.style.display = 'none';
      }
    }

    if (paypalMessage) {
      paypalMessage.setAttribute('data-pp-amount', (variant.price / 100).toFixed(2));
    }
  }

  boxes.forEach(box => {
    box.addEventListener('click', function () {
      const variantId = this.dataset.id;
      const selectedVariant = productData.variants.find(variant => String(variant.id) === String(variantId));

      select.value = variantId;
      select.dispatchEvent(new Event('change', { bubbles: true }));

      if (selectedVariant) {
        updatePriceLine(selectedVariant);
      }

      if (titleEl) {
        titleEl.textContent = this.dataset.title;
      }

        boxes.forEach(item => {
          item.classList.remove('active');
          item.setAttribute('aria-pressed', 'false');
        });
        this.classList.add('active');
        this.setAttribute('aria-pressed', 'true');

        const slides = Array.from(document.querySelectorAll('#product-slider .swiper-slide'));
        const slideIndex = slides.findIndex(slide => slide.dataset.variantId === variantId);
        const productSlider = document.getElementById('product-slider');
        const swiper = productSlider && productSlider.swiper;

        if (swiper && slideIndex >= 0) {
          swiper.slideTo(slideIndex);
      }
    });
  });
});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const sliderEl = document.getElementById('product-slider');
  const navEl = document.getElementById('product-slider-nav');
  let attempts = 0;
  let eventsBound = false;

  if (!sliderEl || !navEl) return;

  function updateDesktopThumbs() {
    const mainSwiper = sliderEl.swiper;
    const navSlides = Array.from(navEl.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)'));

    if (!mainSwiper || !navSlides.length) {
      attempts += 1;
      if (attempts <= 30) {
        window.setTimeout(updateDesktopThumbs, 100);
      }
      return;
    }

    const activeIndex = typeof mainSwiper.realIndex === 'number' ? mainSwiper.realIndex : mainSwiper.activeIndex || 0;
    const visibleCount = Math.min(4, Math.max(navSlides.length - 1, 1));

    if (!eventsBound) {
      mainSwiper.on('slideChange', updateDesktopThumbs);
      mainSwiper.on('activeIndexChange', updateDesktopThumbs);
      eventsBound = true;
    }

    navSlides.forEach(slide => {
      slide.classList.remove('is-visible-product-thumb');
    });

    for (let offset = 1; offset <= visibleCount; offset += 1) {
      const index = (activeIndex + offset) % navSlides.length;
      navSlides[index].classList.add('is-visible-product-thumb');
    }
  }

  updateDesktopThumbs();
});
</script>

