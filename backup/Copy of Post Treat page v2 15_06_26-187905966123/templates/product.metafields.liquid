{%- layout none -%}

{ 
	{% if product.metafields.custom.min_buy_quantity.value and product.metafields.custom.max_buy_quantity.value %}
		"metafields": {
			"min_buy" : {{ product.metafields.custom.min_buy_quantity.value }},		
			"max_buy" : {{ product.metafields.custom.max_buy_quantity.value }}
		},

	{% elsif product.metafields.custom.min_buy_quantity.value %}
		"metafields": {
			"min_buy" : {{ product.metafields.custom.min_buy_quantity.value }},		
			"max_buy" : 999999
		},
	{% elsif product.metafields.custom.max_buy_quantity.value %}
		"metafields": {
			"min_buy" : 1,		
			"max_buy" : {{ product.metafields.custom.max_buy_quantity.value }}
		},
	{% else %}
		"metafields": false ,
	{% endif %}

	"variantStock": {
		{% for variant in product.variants %}
			"{{variant.id}}" : {
				"available": "{{variant.available}}",
				"inventory_management" : "{{ variant.inventory_management }}",
				"inventory_pollicy" : "{{ variant.inventory_policy }}",
				"inventory" : {{ variant.inventory_quantity }}
			}{% if forloop.index < product.variants.size %} , {% endif %}
		{% endfor %}
	}
}