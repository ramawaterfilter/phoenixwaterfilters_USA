{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-marquee-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    overflow: hidden;
    padding: {{ block.settings.padding_vertical }}px 0;
    position: relative;
  }

  .ai-marquee-track-{{ ai_gen_id }} {
    display: inline-block;
    white-space: nowrap;
    animation: ai-marquee-scroll-{{ ai_gen_id }} {{ block.settings.animation_duration }}s linear infinite;
    will-change: transform;
  }

  .ai-marquee-track-{{ ai_gen_id }} span {
    display: inline-block;
    padding-right: {{ block.settings.item_spacing }}px;
    font-size: {{ block.settings.font_size }}px;
  }

  @keyframes ai-marquee-scroll-{{ ai_gen_id }} {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-33.33%);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-marquee-track-{{ ai_gen_id }} span {
      font-size: {{ block.settings.font_size_mobile }}px;
    }
  }
{% endstyle %}

<div class="ai-announcement-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-marquee-track-{{ ai_gen_id }}">
    {% for i in (1..3) %}
      <span>{{ block.settings.message_1 }}</span>
      <span>{{ block.settings.message_2 }}</span>
      <span>{{ block.settings.message_3 }}</span>
      <span>{{ block.settings.message_4 }}</span>
      <span>{{ block.settings.message_5 }}</span>
      <span>{{ block.settings.message_6 }}</span>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Announcement marquee",
  "settings": [
    {
      "type": "header",
      "content": "Messages"
    },
    {
      "type": "text",
      "id": "message_1",
      "label": "Message 1",
      "default": "🚚 Free Shipping on Orders $99+"
    },
    {
      "type": "text",
      "id": "message_2",
      "label": "Message 2",
      "default": "✅ NSF Certified"
    },
    {
      "type": "text",
      "id": "message_3",
      "label": "Message 3",
      "default": "📞 Questions? Call Us at 1 (800) 917-0455"
    },
    {
      "type": "text",
      "id": "message_4",
      "label": "Message 4",
      "default": "✨ 60 Years of Pure Excellence"
    },
    {
      "type": "text",
      "id": "message_5",
      "label": "Message 5",
      "default": "🎁 Free Shipping in France Mainland"
    },
    {
      "type": "text",
      "id": "message_6",
      "label": "Message 6",
      "default": "🔥 PRE BLK FRI SALE 55% off"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#2B2B4E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 4,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Vertical padding",
      "default": 8
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "font_size_mobile",
      "min": 10,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Font size (mobile)",
      "default": 14
    },
    {
      "type": "range",
      "id": "item_spacing",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Spacing between items",
      "default": 60
    },
    {
      "type": "range",
      "id": "animation_duration",
      "min": 15,
      "max": 60,
      "step": 5,
      "unit": "s",
      "label": "Animation speed",
      "default": 35
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee"
    }
  ]
}
{% endschema %}
