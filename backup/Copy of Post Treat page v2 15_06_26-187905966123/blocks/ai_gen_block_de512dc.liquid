{% doc %}
  @prompt
    Create a custom Shopify section called “Feature Icons Section” with a clean, premium, modern design similar to a luxury ecommerce product benefits section. The section should have a full-width light beige background and display feature items in a responsive grid layout with 4 columns on desktop, 2 columns on tablet, and 1 column on mobile. Each feature item should be center aligned and include an icon image at the top, a bold heading below it, a small description text underneath, and a simple underlined “Learn More” button at the bottom. The overall styling should feel minimal, elegant, and spacious with soft typography, balanced spacing, muted description text, and subtle hover animations on each block.
    
    Build this as a dynamic Shopify section using schema blocks so I can easily add, edit, or remove feature items directly from the Shopify theme customizer. Each block should include settings for an icon image picker, heading text, description textarea, button text, and button link. The section itself should also include customizable settings for background color, heading color, text color, button color, top and bottom padding, and container width. The layout must automatically adjust when more blocks are added or removed. Use clean Liquid, CSS, and responsive styling only without any app dependency or hardcoded content. Add default demo content similar to “99.9% Fluoride Reduction,” “Up to 1,000 Gallons,” “Dual-Layer Filtration,” and “100% Aluminum-Free.”, i need to addd hte icon size also 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-icons-section-{{ ai_gen_id }} {
    display: block;
    background-color: {{ block.settings.background_color }};
    padding-top: {{ block.settings.padding_top }}px;
    padding-bottom: {{ block.settings.padding_bottom }}px;
    width: 100%;
  }

  .ai-feature-icons-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-feature-icons-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 40px;
    width: 100%;
  }

  .ai-feature-icons-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    transition: transform 0.3s ease;
  }

  .ai-feature-icons-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .ai-feature-icons-image-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icons-image-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-feature-icons-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icons-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-feature-icons-heading-{{ ai_gen_id }} {
    font-size: 18px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.3;
  }

  .ai-feature-icons-description-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.text_color }};
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }

  .ai-feature-icons-button-{{ ai_gen_id }} {
    font-size: 14px;
    color: {{ block.settings.button_color }};
    text-decoration: underline;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    margin-top: 8px;
    transition: opacity 0.3s ease;
  }

  .ai-feature-icons-button-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  @media screen and (max-width: 989px) {
    .ai-feature-icons-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-icons-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 40px;
    }

    .ai-feature-icons-section-{{ ai_gen_id }} {
      padding-top: {{ block.settings.padding_top | times: 0.7 }}px;
      padding-bottom: {{ block.settings.padding_bottom | times: 0.7 }}px;
    }
  }
{% endstyle %}

<feature-icons-section-{{ ai_gen_id }} class="ai-feature-icons-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-icons-container-{{ ai_gen_id }}">
