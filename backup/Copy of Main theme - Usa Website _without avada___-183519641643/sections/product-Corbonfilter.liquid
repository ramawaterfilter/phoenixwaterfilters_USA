<!-- Hidden Select (still needed for Shopify form functionality) -->
<select id="ProductSelect-{{ section.id }}" name="id" hidden>
  {% for variant in product.variants %}
    <option {% if variant == current_variant %} selected="selected" {% endif %}
      value="{{ variant.id }}">{{ variant.title }}</option>
  {% endfor %}
</select>
<script>
document.addEventListener("DOMContentLoaded", function() {
  const variantOptions = document.querySelectorAll('.variant-image-option');
  const variantSelect = document.querySelector('#ProductSelect-{{ section.id }}') || document.querySelector('select[name="id"]');
  const mainSwiperEl = document.querySelector('#product-slider');

  if (!variantSelect || !mainSwiperEl) return;

  // Get Swiper instance (wait a bit in case it's not ready yet)
  let mainSwiper;
  setTimeout(() => {
    mainSwiper = mainSwiperEl.swiper;
  }, 500);

  // Build a variant map
  const variantMap = {};
  if (window.product?.variants) {
    window.product.variants.forEach(v => variantMap[String(v.id)] = v);
  }

  // Helper: Go to matching Swiper slide
  function updateMainImage(variant) {
    if (!variant?.featured_image) return;
    const slide = document.querySelector(`.swiper-slide[data-variant-id="${variant.id}"]`);
    if (slide && mainSwiper) {
      const index = Array.from(slide.parentNode.children).indexOf(slide);
      mainSwiper.slideTo(index);
    }
  }

  // Helper: Update price
  function updatePrice(variant) {
    const priceEl = document.querySelector('[data-price].product-dyn-price') || document.querySelector('[data-price]');
    if (priceEl) priceEl.textContent = (variant.price / 100).toFixed(2);

    const compareEl = document.querySelector('[data-compare] s');
    if (compareEl) {
      compareEl.textContent = (variant.compare_at_price > variant.price)
        ? (variant.compare_at_price / 100).toFixed(2)
        : '';
    }
  }

  // On select change
  variantSelect.addEventListener('change', function() {
    const variantId = this.value;
    const variant = variantMap[variantId];
    if (!variant) return;

    updateMainImage(variant);
    updatePrice(variant);

    // Shopify theme triggers
    this.dispatchEvent(new Event('input', { bubbles: true }));
    this.dispatchEvent(new Event('change', { bubbles: true }));
    document.dispatchEvent(new CustomEvent('product:variant-change', { detail: { variant } }));
    if (typeof initProductScript === 'function') initProductScript(window.product, 'product-selectors', document);
  });

  // On image option click
  variantOptions.forEach(option => {
    option.addEventListener('click', () => {
      if (option.classList.contains('disabled')) return;

      variantOptions.forEach(o => o.classList.remove('active'));
      option.classList.add('active');

      const variantId = option.dataset.variantId;
      const variant = variantMap[variantId];
      if (!variant) return;

      variantSelect.value = variantId;
      variantSelect.dispatchEvent(new Event('change', { bubbles: true }));

      updateMainImage(variant);
      updatePrice(variant);
    });
  });

  // On page load → ensure correct image shown
  const defaultVariant = variantMap[variantSelect.value];
  if (defaultVariant) updateMainImage(defaultVariant);
});
</script>




