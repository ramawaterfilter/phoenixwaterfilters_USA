<div class="container">
	<div class="row justify-content-center text-center">
		<div class="col-12 col-lg-8 justify-content-between">
			<p>{{ 'customer.reset_password.subtext' | t }}.</p>

			{% form 'reset_customer_password' %}
				<div class="form-group">
					<label for="password" class="form-field">
						<input type="password" name="customer[password]" id="password"
							placeholder="{{ 'customer.reset_password.password' | t }}" required="">
					</label>
				</div>

				<div class="form-group">
					<label for="password_confirmation" class="form-field">
						<input type="password" name="customer[password_confirmation]" id="password_confirmation"
							placeholder="{{ 'customer.reset_password.password_confirm' | t }}" required="">
					</label>
				</div>

				<label for="submit" class="form-field">
					<button class="btn btn-primary" type="submit">
						 {{ 'customer.reset_password.submit' | t }}
					</button>
				</label>

				{{ form.errors | default_errors }}

			{% endform %}
		</div>
	</div>
</div>


{% schema %}
	{
	    "name": "Reset Password",
	    "tag": "section",
	    "class": "section-resetpassword",
	    "enabled_on": {
	        "templates": ["customers/reset_password"]
	    }
	}
{% endschema %}