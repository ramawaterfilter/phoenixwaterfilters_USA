{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-announcement-bar-{{ ai_gen_id }} {
    width: 100%;
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    position: relative;
    overflow: hidden;
    height: {{ block.settings.bar_height_desktop }}px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar-{{ ai_gen_id }} {
      height: {{ block.settings.bar_height_mobile }}px;
    }
  }

  .ai-announcement-bar__container-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 6px 0;
  }

  .ai-announcement-bar__slides-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    max-width: 1200px;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0 70px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__slides-{{ ai_gen_id }} {
      padding: 0 60px;
    }
  }

  .ai-announcement-bar__slide-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: calc(100% - 140px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__slide-{{ ai_gen_id }} {
      width: calc(100% - 120px);
    }
  }

  .ai-announcement-bar__slide-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.4;
    display: inline-block;
    width: 100%;
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__message-{{ ai_gen_id }} {
      font-size: {{ block.settings.font_size | times: 0.9 }}px;
    }
  }

  .ai-announcement-bar__message-{{ ai_gen_id }}:hover {
    opacity: 0.9;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} p {
    margin: 0;
    padding: 0;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} p a,
  .ai-announcement-bar__message-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
  }

  .ai-announcement-bar__message-{{ ai_gen_id }} p a:hover,
  .ai-announcement-bar__message-{{ ai_gen_id }} a:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .ai-announcement-bar__arrow-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: none;
    border: none;
    color: {{ block.settings.arrow_color }};
    cursor: pointer;
    padding: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.8;
    transition: opacity 0.3s ease;
    z-index: 10;
    width: 40px;
    height: 40px;
    margin: 0;
  }

  .ai-announcement-bar__arrow-{{ ai_gen_id }}:hover {
    opacity: 1;
  }

  .ai-announcement-bar__arrow--left-{{ ai_gen_id }} {
    left: 15px;
  }

  .ai-announcement-bar__arrow--right-{{ ai_gen_id }} {
    right: 15px;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__arrow-{{ ai_gen_id }} {
      padding: 8px;
      width: 36px;
      height: 36px;
    }

    .ai-announcement-bar__arrow--left-{{ ai_gen_id }} {
      left: 8px;
    }

    .ai-announcement-bar__arrow--right-{{ ai_gen_id }} {
      right: 8px;
    }
  }

  .ai-announcement-bar__arrow-{{ ai_gen_id }} svg {
    width: 20px;
    height: 20px;
    display: block;
  }

  @media screen and (max-width: 749px) {
    .ai-announcement-bar__arrow-{{ ai_gen_id }} svg {
      width: 18px;
      height: 18px;
    }
  }

  .ai-announcement-bar__empty-state-{{ ai_gen_id }} {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.7);
    font-style: italic;
    text-align: center;
  }

