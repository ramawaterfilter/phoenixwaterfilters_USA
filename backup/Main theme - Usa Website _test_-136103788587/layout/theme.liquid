        {% render 'entry-popup' %}
      {% endif %}
    {% else %}
      {% sections 'article-footer-group' %}
    {% endunless %}

    {% unless template.suffix == 'article' %}
      {% if settings.show_exit_popup %}
        {% render 'exit-popup' %}
      {% endif %}

      {% if settings.enable_slide_cart %}
        {% render 'cart-slideout' %}
      {% endif %}

      {% render 'toast' %}

      {% comment %} {% render 'quickview' %} {% endcomment %}
      {% render 'afterpay-script' %}
    {% endunless %}
    <form class="kk-global d-none"></form>

