    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1">
    <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no">

    {%- if request.path == '/collections/vendors' and collection.all_products_count == 0 -%}
      <meta name="robots" content="noindex">
    {%- endif -%}

    {% if page_description %}
      <meta name="description" content="{{ page_description | escape }}">
    {% endif %}

    {% if template != 'collection' %}
      <link rel="canonical" href="{{ canonical_url }}">
    {% else %}
      <link rel="canonical" href="{{ shop.url }}{{ collection.url }}">
    {% endif %}

    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="{{ settings.favicon_32 | image_url: width: 32 }}"
    >
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="{{ settings.favicon_16 | image_url: width: 16 }}"
    >

    {{ content_for_header }}

    {{ 'shopify_common.js' | shopify_asset_url | script_tag }}

    {% if template contains 'customers' and shop.customer_accounts_enabled %}
      {{ 'customer_area.js' | shopify_asset_url | script_tag }}
    {% endif %}

    {{ 'option_selection.js' | shopify_asset_url | script_tag }}

    {{ 'main.css' | asset_url | stylesheet_tag }}

    <script>
      <!-- Changes By K -->


      	window.enable_slide_cart = {{ settings.enable_slide_cart }};
      	window.enable_ajax_cart = {{ settings.enable_ajax_cart }};
      	window.show_exit_intent = {{ settings.show_exit_popup }};
      	window.show_entry_popup = {{ settings.show_entry_popup }};
      	window.enable_minmax_buys = {{ settings.enable_minmax_buys }};
         window.min_buy_qty = {{ settings.min_buy_qty }};
         window.max_buy_qty = {{ settings.max_buy_qty }}
      	// for quickview and product page variant selector
        		window.money_format = "{{ shop.money_format }}";
        		window.variant_colours = "{{ settings.variant_colours }}".split(',');
          window.inventory_text = {
          	add_to_cart : '{{ 'products.product.add_to_cart' | t }}',
          	sold_out : '{{ 'products.product.sold_out' | t }}',
          	pre_order: '{{ 'products.product.pre_order' | t }}',
          	in_stock_long: '{{ 'products.product.inventory_in_stock' | t }}',
          	low_stock_long: '{{ 'products.product.inventory_low_stock' | t }}',
          	sold_out_long: '{{ 'products.product.inventory_out_of_stock' | t }}'
          };
      	window.variantStock = [];
    </script>

    {% comment %} Remove Header And body padding on Article templates {% endcomment %}
    {% unless template.suffix == 'article' %}
      {% if settings.body_padding_desktop and settings.body_padding_mobile %}
        <style>
          body {
            padding-top: {{ settings.body_padding_mobile }}px;
          }

          @media screen and (min-width: 992px) {
            body {
              padding-top:110px;
            }
          }
        </style>
      {% endif %}
    {% else %}
      <style>
        body {
          padding-top: 0;
        }

        @media screen and (min-width: 992px) {
          body {
            padding-top: 0;
          }
        }
      </style>
    {% endunless %}

