    <title>
      {{ page_title }}
      {% if current_tags %}
        &ndash; tagged "{{ current_tags | join: ', ' | replace: 'cat-', '' }}"
      {%- endif %}
      {% if current_page != 1 %}
        &ndash; Page
        {{ current_page -}}
      {%- endif %}
      {% unless page_title contains shop.name %}
        &ndash; {{ shop.name -}}
      {%- endunless %}
    </title>

    {% comment %} Do not remove BH unless requested - or ask Chelsea :) {% endcomment %}
    <script
      type="text/javascript"
