            {
              "@type": "ListItem",
              "position": 1,
              "name": "Home",
              "item": "{{ shop.url }}"
            },
            {
              "@type": "ListItem",
              "position": 2,
              "name": "{{ product.title | escape }}",
              "item": "{{ shop.url }}{{ product.url }}"
            }
          ]
        }
      </script>
    {% endif %}
