{% assign stock = product.selected_or_first_available_variant.inventory_quantity %}
  <div class="stock-alert">
    🔥 Only {{ stock }} left — {{ settings.text1 }}
  </div> 


{% if product.handle == 'gravity-water-filter' and settings.enable_size_guide %}

<!-- SIZE GUIDE POPUP -->
<div id="sg-sizeGuideModal" class="sg-modal" onclick="sgOutsideClick(event)">
  <div class="sg-modal-content" onclick="event.stopPropagation()">

    <!-- Header -->
    <div class="sg-header">
      <h2>Find Your Perfect Size</h2>
      <button type="button" class="sg-close" onclick="sgClose()">×</button>
    </div>

    <p class="sg-subheading">Recommended by household size</p>

    <!-- Size Options -->
    <div class="sg-options">
      <div class="sg-card" data-size="1.5">
        <p>Family of 1–2</p>
        <h3>1.5 Gallon</h3>
        <span>2–3 top-ups per day</span>
      </div>

      <div class="sg-card active" data-size="2.25">
        <span class="sg-badge">MOST POPULAR</span>
        <p>Family of 3–4</p>
        <h3>2.25 Gallon</h3>
        <span>3–4 top-ups per day</span>
      </div>

      <div class="sg-card" data-size="3.25">
        <p>Family of 5+</p>
        <h3>3.25 Gallon</h3>
        <span>5+ top-ups per day</span>
      </div>
    </div>

    <!-- Calculator -->
    <div class="sg-calculator">
      <p class="sg-calc-title">Not sure? Quick calculator</p>

      <label>How many people drink from this filter daily?</label>

      <div class="sg-input-box">
        <input type="number" id="sg-peopleInput" value="4" min="1">
        <span>people</span>
      </div>

      <div class="sg-result-box">
        <p>Recommended size for your household</p>
        <h3 id="sg-resultText">2.25 Gallon ✅</h3>
        <span id="sg-resultSub">Perfect for 3–4 top-ups per day</span>
      </div>
    </div>

    {% comment %} <!-- Footer -->
    <div class="sg-footer">
      <span>Still unsure? <a href="#">Chat with us</a></span>
      <button type="button" onclick="sgClose()">Close</button>
    </div> {% endcomment %}

  </div>
</div>


{% if product.handle == 'gravity-water-filter' %}
<!-- Trigger -->
<button type="button" onclick="sgOpen()" class="sg-open-btn">
  Size Guide
</button>
      {% endif %}

      {% endif %}


<style>
  @media(max-width:768px){
  button.sg-close {
    position: absolute;
    top: 5%;
    transform: translate(-50%, -50%);
    left: 91%;
}
button.sg-open-btn {
    position: absolute;
    top: 48%;
    border: navajowhite;
    right: -5%;
    text-decoration: underline;
    text-underline-offset: 5px;
}
  }

    @media(min-width:768px){
  button.sg-open-btn {
    position: absolute;
    top: 50%;
    border: navajowhite;
    right: 8%;
    text-decoration: underline;
    text-underline-offset: 5px;
}
}


button.sg-close:hover {
    background: transparent;
    color: black;
}

button.sg-open-btn:hover {
    background: transparent;
    color: black;
    text-decoration: none;
}
p.sg-calc-title, form label {
    font-size: 16px;
    margin: 0px;
}
button.sg-close {
    margin: 0px;
    padding: 0px;
}
  .sg-card.active h3 {
    color: white;
    font-size: 24px;
}
.sg-card p, span {
    font-size: 14px;
    font-weight: bold;
}
.sg-card h3 {
    margin-top: 10px;
}
.sg-card p {
    margin-bottom: 5px;
    padding-top: 9px;
}
.sg-card h3 {
    font-size: 24px;
}
.sg-modal {
  display: none;
  position: fixed;
  z-index: 9999;
  inset: 0;
  background: rgba(0,0,0,0.6);
  padding: 20px;
}

.sg-modal-content {
  background: #fff;
  max-width: 700px;
  margin: auto;
  border-radius: 12px;
  padding: 20px;
}

.sg-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.sg-header h2 {
  font-size: 24px;
}

.sg-close {
  font-size: 22px;
  background: none;
  border: none;
  cursor: pointer;
}

.sg-subheading {
  margin: 15px 0;
  color: #555;
}

/* CARDS */
.sg-options {
  display: flex;
  gap: 15px;
  flex-wrap: wrap;
}

.sg-card {
  flex: 1;
  min-width: 150px;
  border: 1px solid #ccc;
  border-radius: 10px;
  padding: 15px;
  text-align: center;
  cursor: pointer;
  position: relative;
}

.sg-card.active {
  background: #1f3f5b;
  color: #fff;
}

.sg-badge {
    position: absolute;
    top: -5px;
    border: 1px solid white;
    left: 50%;
    background: #1f3f5b;
    color: #fff;
    font-size: 8px;
    padding: 3px 6px;
    border-radius: 5px;
    transform: translate(-50%, -50%);
}

/* CALCULATOR */
.sg-calculator {
  margin-top: 20px;
  background: #f5f5f5;
  padding: 15px;
  border-radius: 10px;
}

.sg-input-box {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 10px 0;
  width:50%;
}
input#sg-peopleInput {
    margin: 0px;
    border-radius: 7px;
    text-align:center;
}
.sg-result-box p {
    font-size: 16px;
}
.sg-input-box input {
  width: 60px;
  padding: 8px;
  font-size: 18px;
}

.sg-result-box {
  background: #fff;
  padding: 15px;
  border-radius: 10px;
  border: 1px solid #ccc;
  text-align: center;
}

.sg-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 15px;
}

.sg-open-btn {
  padding: 10px 15px;
  cursor: pointer;
}

/* MOBILE */
@media(max-width: 768px) {
  .sg-options {
    flex-direction: column;
  }

  .sg-modal-content {
    max-width: 100%;
    height: 90vh;
    overflow-y: auto;
  }
}
</style>

<script>
(function() {

  function sgOpen() {
    document.getElementById("sg-sizeGuideModal").style.display = "block";
    document.body.style.overflow = "hidden";
  }

  function sgClose() {
    document.getElementById("sg-sizeGuideModal").style.display = "none";
    document.body.style.overflow = "";
  }

  function sgOutsideClick(e) {
    if (e.target.id === "sg-sizeGuideModal") {
      sgClose();
    }
  }

  window.sgOpen = sgOpen;
  window.sgClose = sgClose;
  window.sgOutsideClick = sgOutsideClick;

  /* CARD CLICK */
  document.querySelectorAll(".sg-card").forEach(card => {
    card.addEventListener("click", function(e) {
      e.preventDefault();
      e.stopPropagation();

      document.querySelectorAll(".sg-card").forEach(c => c.classList.remove("active"));
      this.classList.add("active");
    });
  });

  const input = document.getElementById("sg-peopleInput");

  if (input) {

    input.addEventListener("keydown", function(e) {
      if (e.key === "Enter") {
        e.preventDefault();
      }
    });

    input.addEventListener("input", function(e) {
      e.preventDefault();
      e.stopPropagation();

      let val = parseInt(this.value) || 1;

      let result = document.getElementById("sg-resultText");
      let sub = document.getElementById("sg-resultSub");

      if (val <= 2) {
        result.innerHTML = "1.5 Gallon ✅";
        sub.innerHTML = "Perfect for 2–3 top-ups per day";
      } 
      else if (val <= 4) {
        result.innerHTML = "2.25 Gallon ✅";
        sub.innerHTML = "Perfect for 3–4 top-ups per day";
      } 
      else {
        result.innerHTML = "3.25 Gallon ✅";
        sub.innerHTML = "Perfect for 5+ top-ups per day";
      }
    });
  }

})();
</script>