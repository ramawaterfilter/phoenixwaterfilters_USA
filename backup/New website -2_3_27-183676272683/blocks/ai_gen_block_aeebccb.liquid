{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .filter-marquee-section-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    padding: 60px 20px;
    overflow: hidden;
  }

  .filter-marquee-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.section_width }}px;
    margin: 0 auto;
  }

  .filter-marquee-title-{{ ai_gen_id }} {
    text-align: center;
    font-size: 36px;
    font-weight: 700;
    color: {{ block.settings.title_color }};
    margin: 0 0 40px;
  }

  .filter-marquee-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .filter-marquee-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.item_gap }}px;
    animation: filter-marquee-scroll-{{ ai_gen_id }} {{ block.settings.scroll_speed }}s linear infinite;
    width: fit-content;
  }

  {% if block.settings.scroll_direction == 'left' %}
    @keyframes filter-marquee-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(0);
      }
      100% {
        transform: translateX(-50%);
      }
    }
  {% else %}
    @keyframes filter-marquee-scroll-{{ ai_gen_id }} {
      0% {
        transform: translateX(-50%);
      }
      100% {
        transform: translateX(0);
      }
    }
  {% endif %}

  .filter-marquee-item-{{ ai_gen_id }} {
    flex-shrink: 0;
    background: #ffffff;
    border-radius: 12px;
    padding: 30px 40px;
    text-align: center;
    min-width: 200px;
    transition: transform 0.3s ease;
  }

  .filter-marquee-item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
  }

  .filter-marquee-icon-{{ ai_gen_id }} {
    width: 80px;
    height: 80px;
    margin: 0 auto 20px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filter-marquee-icon-{{ ai_gen_id }} img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .filter-marquee-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .filter-marquee-icon-placeholder-{{ ai_gen_id }} svg {
    width: 50px;
    height: 50px;
    opacity: 0.3;
  }

  .filter-marquee-headline-{{ ai_gen_id }} {
    font-size: 20px;
    font-weight: 600;
    color: #1a1a1a;
    margin: 0 0 10px;
  }

  .filter-marquee-percentage-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 700;
    color: {{ block.settings.percentage_color }};
    margin: 0;
  }

  .filter-marquee-cta-{{ ai_gen_id }} {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .filter-marquee-cta-content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .filter-marquee-cta-text-{{ ai_gen_id }} {
    font-size: 16px;
    color: #4a4a4a;
    margin: 0;
    line-height: 1.6;
  }

  .filter-marquee-button-{{ ai_gen_id }} {
    display: inline-block;
    background-color: {{ block.settings.button_color | color_modify: 'alpha', 0.9 }};
    color: {{ block.settings.button_text_color }};
    padding: 14px 32px;
    border-radius: {{ block.settings.button_border_radius }}px;
    text-decoration: none;
    font-size: 16px;
    font-weight: 600;
    transition: all 0.3s ease;
    border: none;
    cursor: pointer;
    white-space: nowrap;
  }

  .filter-marquee-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_hover_color }};
    transform: translateY(-2px);
  }

  @media screen and (max-width: 768px) {
    .filter-marquee-section-{{ ai_gen_id }} {
      padding: 40px 15px;
    }

    .filter-marquee-title-{{ ai_gen_id }} {
      font-size: 28px;
      margin-bottom: 30px;
    }

    .filter-marquee-track-{{ ai_gen_id }} {
      gap: {{ block.settings.item_gap | times: 0.6 }}px;
    }

    .filter-marquee-item-{{ ai_gen_id }} {
      min-width: 160px;
      padding: 20px 25px;
    }

    .filter-marquee-icon-{{ ai_gen_id }} {
      width: 60px;
      height: 60px;
      margin-bottom: 15px;
    }

    .filter-marquee-headline-{{ ai_gen_id }} {
      font-size: 16px;
    }

    .filter-marquee-percentage-{{ ai_gen_id }} {
      font-size: 24px;
    }

    .filter-marquee-cta-content-{{ ai_gen_id }} {
      flex-direction: column;
      gap: 15px;
    }

    .filter-marquee-cta-text-{{ ai_gen_id }} {
      font-size: 14px;
    }

    .filter-marquee-button-{{ ai_gen_id }} {
      padding: 12px 24px;
      font-size: 14px;
    }
  }
{% endstyle %}

<div class="filter-marquee-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="filter-marquee-container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <h2 class="filter-marquee-title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
    {% endif %}

    <div class="filter-marquee-wrapper-{{ ai_gen_id }}">
      <div class="filter-marquee-track-{{ ai_gen_id }}">
        {% for i in (1..8) %}
          {% assign icon_key = 'item_' | append: i | append: '_icon' %}
          {% assign headline_key = 'item_' | append: i | append: '_headline' %}
          {% assign percentage_key = 'item_' | append: i | append: '_percentage' %}
          {% assign enabled_key = 'item_' | append: i | append: '_enabled' %}

          {% assign item_icon = block.settings[icon_key] %}
          {% assign item_headline = block.settings[headline_key] %}
          {% assign item_percentage = block.settings[percentage_key] %}
          {% assign item_enabled = block.settings[enabled_key] %}

          {% if item_enabled %}
            <div class="filter-marquee-item-{{ ai_gen_id }}">
              <div class="filter-marquee-icon-{{ ai_gen_id }}">
                {% if item_icon != blank %}
                  <img
                    src="{{ item_icon | image_url: width: 160 }}"
                    alt="{{ item_headline | escape }}"
                    loading="lazy"
                    width="80"
                    height="80"
                  >
                {% else %}
                  <div class="filter-marquee-icon-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if item_headline != blank %}
                <h3 class="filter-marquee-headline-{{ ai_gen_id }}">{{ item_headline }}</h3>
              {% endif %}
              {% if item_percentage != blank %}
                <p class="filter-marquee-percentage-{{ ai_gen_id }}">{{ item_percentage }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}

        {% for i in (1..8) %}
          {% assign icon_key = 'item_' | append: i | append: '_icon' %}
          {% assign headline_key = 'item_' | append: i | append: '_headline' %}
          {% assign percentage_key = 'item_' | append: i | append: '_percentage' %}
          {% assign enabled_key = 'item_' | append: i | append: '_enabled' %}

          {% assign item_icon = block.settings[icon_key] %}
          {% assign item_headline = block.settings[headline_key] %}
          {% assign item_percentage = block.settings[percentage_key] %}
          {% assign item_enabled = block.settings[enabled_key] %}

          {% if item_enabled %}
            <div class="filter-marquee-item-{{ ai_gen_id }}">
              <div class="filter-marquee-icon-{{ ai_gen_id }}">
                {% if item_icon != blank %}
                  <img
                    src="{{ item_icon | image_url: width: 160 }}"
                    alt="{{ item_headline | escape }}"
                    loading="lazy"
                    width="80"
                    height="80"
                  >
                {% else %}
                  <div class="filter-marquee-icon-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if item_headline != blank %}
                <h3 class="filter-marquee-headline-{{ ai_gen_id }}">{{ item_headline }}</h3>
              {% endif %}
              {% if item_percentage != blank %}
                <p class="filter-marquee-percentage-{{ ai_gen_id }}">{{ item_percentage }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="filter-marquee-cta-{{ ai_gen_id }}">
      <div class="filter-marquee-cta-content-{{ ai_gen_id }}">
        {% if block.settings.cta_text != blank %}
          <p class="filter-marquee-cta-text-{{ ai_gen_id }}">{{ block.settings.cta_text }}</p>
        {% endif %}
        {% if block.settings.pdf_file != blank and block.settings.button_text != blank %}
          <a
            href="{{ block.settings.pdf_file }}"
            class="filter-marquee-button-{{ ai_gen_id }}"
            download
            target="_blank"
            rel="noopener noreferrer"
          >
            {{ block.settings.button_text }}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

