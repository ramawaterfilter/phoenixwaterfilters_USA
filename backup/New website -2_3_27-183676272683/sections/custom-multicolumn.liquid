{% style %}
.image-card-row {
  background: {{ section.settings.bg_color }};
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
}

.image-card-row__wrapper {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns_desktop }}, 1fr);
  gap: 20px;
}

.image-card-row__card {
  text-align: center;
  display: block;
  text-decoration: none;
}

.image-card-row__image {
  width: 100%;
  overflow: hidden;
}

.image-card-row__image img {
  width: 100%;
  display: block;
}

.image-card-row__title {
  margin-top: 12px;
  color: {{ section.settings.heading_color }};
  font-size: {{ section.settings.heading_size }}px;
  font-weight: 600;
}

@media screen and (max-width: 767px) {
  .image-card-row__wrapper {
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, 1fr);
    gap: 15px;
  }
}
{% endstyle %}

<div class="image-card-row">
  <div class="page-width">
    <div class="image-card-row__wrapper">
      {% for block in section.blocks %}
        <a
          href="{{ block.settings.link }}"
          class="image-card-row__card"
          {{ block.shopify_attributes }}
        >
          <div class="image-card-row__image">
            {% if block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  widths: '300,400,600,800'
              }}
            {% endif %}
          </div>

          {% if block.settings.heading != blank %}
            <div class="image-card-row__title">
              {{ block.settings.heading }}
            </div>
          {% endif %}
        </a>
      {% endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Image Card Row",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading Size",
      "min": 12,
      "max": 40,
      "step": 1,
      "default": 18
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 0,
      "max": 150,
      "step": 5,
      "default": 50
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Desktop Columns",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_mobile",
      "label": "Mobile Columns",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Image Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Card Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Image Card Row",
      "blocks": [
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        },
        {
          "type": "card"
        }
      ]
    }
  ]
}
{% endschema %}