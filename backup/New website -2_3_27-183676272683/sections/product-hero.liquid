<script>
document.addEventListener('DOMContentLoaded', function () {

  {% if product.handle == 'wooden-stand-for-gravity-water-filter-system' %}

  const boxes = document.querySelectorAll('.variant-img-box');
  const select = document.getElementById('product-selectors');

  boxes.forEach(box => {
    box.addEventListener('click', function () {

      const variantId = this.getAttribute('data-id');

      // ✅ 1. CHANGE SELECT VALUE
      select.value = variantId;

      // ✅ 2. TRIGGER CHANGE EVENT (IMPORTANT)
      select.dispatchEvent(new Event('change', { bubbles: true }));

      // ✅ 3. FORCE SHOPIFY VARIANT UPDATE (CRITICAL FIX)
      const variant = window.product.variants.find(v => v.id == variantId);

      if (variant) {

        // 🔥 UPDATE PRICE
        const priceEl = document.querySelector('[data-price]');
        if (priceEl) {
          priceEl.innerHTML = (variant.price / 100).toFixed(2);
        }

        // 🔥 UPDATE COMPARE PRICE
        const compareEl = document.querySelector('[data-compare]');
        if (compareEl && variant.compare_at_price) {
          compareEl.innerHTML = (variant.compare_at_price / 100).toFixed(2);
        }

        // 🔥 CHANGE MAIN IMAGE
        if (variant.featured_image) {
          const mainImage = document.querySelector('.product-image img');
          if (mainImage) {
            mainImage.src = variant.featured_image.src;
          }
        }

      }

      // ✅ 4. ACTIVE CLASS
      boxes.forEach(b => b.classList.remove('active'));
      this.classList.add('active');

    });
  });

  {% endif %}

});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  {% if product.handle == 'wooden-stand-for-gravity-water-filter-system' %}

  const boxes = document.querySelectorAll('.variant-img-box');
  const select = document.getElementById('product-selectors');
  const titleEl = document.getElementById('selected-variant-title');

  boxes.forEach(box => {
    box.addEventListener('click', function () {

      const variantId = this.dataset.id;

      // ✅ change variant
      select.value = variantId;
      select.dispatchEvent(new Event('change', { bubbles: true }));

      // ✅ update heading
      titleEl.textContent = this.dataset.title;

      // ✅ active UI
      boxes.forEach(b => b.classList.remove('active'));
      this.classList.add('active');

    });
  });

  // ✅ sync when Shopify updates variant
  select.addEventListener('change', function () {
    const variant = window.product.variants.find(v => v.id == this.value);
    if (variant && titleEl) {
      titleEl.textContent = variant.title;
    }
  });

  {% endif %}

});
</script>

<script>
document.addEventListener('DOMContentLoaded', function () {

  {% if product.handle == 'wooden-stand-for-gravity-water-filter-system' %}

  const boxes = document.querySelectorAll('.variant-img-box');
  const select = document.getElementById('product-selectors');
  const titleEl = document.getElementById('selected-variant-title');

  boxes.forEach(box => {
    box.addEventListener('click', function () {

      const variantId = this.dataset.id;

      // ✅ change variant
      select.value = variantId;
      select.dispatchEvent(new Event('change', { bubbles: true }));

      // ✅ update title
      if (titleEl) {
        titleEl.textContent = this.dataset.title;
      }

      // ✅ active state
      boxes.forEach(b => b.classList.remove('active'));
      this.classList.add('active');

      // ✅ 🔥 MOVE PRODUCT IMAGE (IMPORTANT FIX)
      changeProductImage(variantId);

    });
  });

  function changeProductImage(variantId) {

    // find matching slide
    const slides = document.querySelectorAll('#product-slider .swiper-slide');

    slides.forEach((slide, index) => {
      if (slide.getAttribute('data-variant-id') == variantId) {

        // swiper instance
        if (window.productSwiper) {
          window.productSwiper.slideTo(index);
        }

        // fallback (force click)
        slide.scrollIntoView({ behavior: "smooth", inline: "center" });
      }
    });
  }

  {% endif %}

});
</script>