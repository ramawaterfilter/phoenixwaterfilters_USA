{% assign block_direction = 'grid' %}
{% assign step_width = '' %}
{% assign step_layout = 'flex-column' %}

{% if section.settings.block_direction == 'column' %}
  {% assign block_direction = 'flex-column justify-content-start' %}
  {% assign step_layout = 'flex-row col-12 col-md-10 mb-4' %}
{% endif %}

{% assign spacer = '' %}

{% if section.settings.video_id == blank and section.settings.banner_image == blank %}
  {% assign spacer = 'pb-5' %}
{% endif %}

<div class="background-image-container"></div>
<div class="{{ section.settings.custom_class }}" id="{{ section.settings.custom_id }} {{ spacer }}">
  <div class="container {{ spacer }}">
    <div class="row justify-content-center justify-content-md-start">
      <div class="col-11 col-md-8 col-lg-7 col-xl-10  mb-5">
        <h2>{{ section.settings.heading }}</h2>
        {{ section.settings.paragraph }}
      </div>
    </div>
    <div class="row mb-5 steps {{ block_direction }}">
      {% for block in section.blocks %}
        <div class="step-tile p-5 d-flex {{ step_layout }}">
          <div class="step-number {% if block.settings.icon == blank %}text-only{% endif %}">
            {% if block.settings.icon %}
              {{ block.settings.icon | image_url: width: 1920 | image_tag: class: 'view-animation img-fluid', loading: "lazy" }}
            {% else: %}
              {{ forloop.index }}
            {% endif; %}
          </div>
          <div class="step-content">
            <h3 class="step-heading h4 mb-2">{{ block.settings.heading }}</h3>
            {{ block.settings.copy }}
          </div>
        </div>

      {% endfor %}
    </div>

    {% if section.settings.buttonlink %}
      <div class="row justify-content-center text-center mb-5">
        <div class="col-12 col-md-10 col-lg-8 col-xl-6">
          {% render 'button'
            , class: 'mx-auto' %}
        </div>
      </div>
    {% endif %}
  </div>

  {% if section.settings.video_id != blank or section.settings.banner_image != blank %}
    <div class="container-fluid hero-image-video">
      <div class="row">
        {% if section.settings.video_id != blank %}
          <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ section.settings.video_id }}"></div>
        {% comment %} <div class="video-preview-container">
             
          <script src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}.jsonp" async></script></script><div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;"><div class="wistia_responsive_wrapper" style="height:100%;left:0;position:absolute;top:0;width:100%;"><div class="wistia_embed wistia_async_{{ section.settings.video_id }} seo=true videoFoam=true" style="height:100%;position:relative;width:100%"><div class="wistia_swatch" style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;"><img src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}/swatch" style="filter:blur(5px);height:100%;object-fit:contain;width:100%;" alt="" aria-hidden="true" onload="this.parentNode.style.opacity=1;"   loading="lazy"/></div></div></div></div>
                  </div> {% endcomment %}
        {% elsif section.settings.banner_image != blank and section.settings.video_id == blank %}
          {{ section.settings.banner_image | image_url: width: 1920 | image_tag }}
        {% else %}

        {% endif %}
      </div>
    </div>
  {% endif %}
</div>

{% schema %}
  {
    "name": "Steps Section",
    "tag": "section",
    "class": "section-steps pb-0 trigger-observer",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Headline"
      },
      {
        "type": "richtext",
        "id": "paragraph",
        "label": "Paragraph"
      },
      {
        "type": "text",
        "id": "video_id",
        "label": "Hero Video"
      }, {
        "type": "image_picker",
        "id": "banner_image",
        "label": "Hero Image"

      }, {
        "type": "radio",
        "id": "block_direction",
        "label": "Step Direction",
        "default": "row",
        "options": [
          {
            "value": "row",
            "label": "Row"
          }, {
            "value": "column",
            "label": "Column"
          }
        ]
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button text"
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Url"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button text"
      }, {
        "type": "header",
        "content": "Custom Code",
        "info": "Add classes or ID to the section"
      }, {
        "type": "text",
        "id": "custom_id",
        "label": "Custom ID"
      }, {
        "type": "text",
        "id": "custom_class",
        "label": "Custom Class"
      }
    ],
    "blocks": [
      {
        "type": "text",
        "name": "Steps",
        "settings": [
          {
            "type": "image_picker",
            "id": "icon",
            "label": "Step Number/Icon"
          }, {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          }, {
            "type": "richtext",
            "id": "copy",
            "label": "Copy"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Steps Section"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}