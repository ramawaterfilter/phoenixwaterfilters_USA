{% doc %}
  @prompt
    Create a Shopify section that displays a horizontally scrolling feature marquee like a premium ecommerce website.
    
    Design Requirements:
    
    - Add a centered heading at the top: "Our Filters Remove..."
    - Below the heading, create a horizontal scrolling row of feature items.
    
    Each feature item must include:
    - A circular icon container with a light background
    - An icon image centered inside the circle
    - A bold title (e.g., "Heavy Metals", "PFAs", "Microplastics")
    - A percentage text below (e.g., "99.99%")
    
    Layout:
    
    - All items must be aligned in a single horizontal row
    - Add a thin vertical divider line between each item
    - Each item should have equal spacing
    - The design should match a clean, modern ecommerce style
    
    Scrolling Behavior (VERY IMPORTANT):
    
    - The row must scroll continuously from right to left
    - The scrolling must be perfectly smooth with no stopping, no jumping, and no reset visible
    - It must behave like an infinite loop
    - Duplicate the content internally to ensure seamless looping
    - Use requestAnimationFrame OR a high-performance CSS transform (translate3d)
    - Do NOT use Swiper or slider libraries
    - Avoid any stuttering caused by image loading or layout shifts
    - Ensure constant linear speed
    
    Technical Requirements:
    
    - Use flexbox for layout
    - Prevent items from wrapping (white-space: nowrap or flex no-wrap)
    - Use transform: translate3d for GPU-accelerated smooth animation
    - Ensure the animation never pauses or resets visibly
    - Handle dynamic content width properly
    
    Shopify Customization:
    
    - Add section settings:
      - Heading text
      - Scroll speed control (range slider)
    - Add blocks:
      - Icon (image picker)
      - Title (text)
      - Percentage (text)
    
    Styling Details:
    
    - Circular icon background (light grey or subtle color)
    - Icon size consistent across items
    - Divider line between items (1px, light grey, full height of item)
    - Center all content vertically and horizontally
    - Use clean typography (bold for title, lighter for percentage)
    
    Responsive:
    
    - Must work smoothly on mobile and desktop
    - Reduce spacing and icon size on smaller screens
    - Keep smooth scrolling performance on mobile
    
    Optional Enhancements:
    
    - Pause scrolling on hover
    - Slight fade effect on left and right edges (gradient mask)
    
    Goal:
    
    The final result must look like a premium, smooth, continuously scrolling feature strip with icons and dividers, exactly like modern high-end Shopify stores., if the item is emty i dont need empty space or anything just remove that like that i need evething editable in mobile and desctop viweindiaully i edit the size space evething 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-marquee-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.padding_top_desktop }}px 0 {{ block.settings.padding_bottom_desktop }}px;
    background-color: {{ block.settings.background_color }};
    display: block;
  }

  .ai-feature-marquee__heading-{{ ai_gen_id }} {
    text-align: center;
    font-size: {{ block.settings.heading_size_desktop }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_margin_bottom_desktop }}px;
    padding: 0 20px;
  }

  .ai-feature-marquee__wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
  }

  .ai-feature-marquee__track-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    width: fit-content;
    will-change: transform;
  }

  .ai-feature-marquee__content-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .ai-feature-marquee__item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 0 {{ block.settings.item_spacing_desktop }}px;
    flex-shrink: 0;
    min-width: {{ block.settings.item_min_width_desktop }}px;
  }

  .ai-feature-marquee__icon-container-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size_desktop }}px;
    height: {{ block.settings.icon_size_desktop }}px;
    border-radius: 50%;
    background-color: {{ block.settings.icon_bg_color }};
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: {{ block.settings.icon_margin_bottom_desktop }}px;
    flex-shrink: 0;
  }

  .ai-feature-marquee__icon-container-{{ ai_gen_id }} img {
    width: calc({{ block.settings.icon_size_desktop }}px * 0.6);
    height: calc({{ block.settings.icon_size_desktop }}px * 0.6);
    object-fit: contain;
  }

  .ai-feature-marquee__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-marquee__icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-marquee__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size_desktop }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 {{ block.settings.title_margin_bottom_desktop }}px;
    text-align: center;
    white-space: nowrap;
  }

  .ai-feature-marquee__percentage-{{ ai_gen_id }} {
    font-size: {{ block.settings.percentage_size_desktop }}px;
    font-weight: 400;
    color: {{ block.settings.percentage_color }};
    margin: 0;
    text-align: center;
  }

  .ai-feature-marquee__divider-{{ ai_gen_id }} {
    width: 1px;
    height: {{ block.settings.divider_height_desktop }}px;
    background-color: {{ block.settings.divider_color }};
    flex-shrink: 0;
  }

  {% if block.settings.enable_fade_edges %}
    .ai-feature-marquee__wrapper-{{ ai_gen_id }}::before,
    .ai-feature-marquee__wrapper-{{ ai_gen_id }}::after {
      content: '';
      position: absolute;
      top: 0;
      bottom: 0;
      width: {{ block.settings.fade_width_desktop }}px;
      z-index: 2;
      pointer-events: none;
    }

    .ai-feature-marquee__wrapper-{{ ai_gen_id }}::before {
      left: 0;
      background: linear-gradient(to right, {{ block.settings.background_color }}, transparent);
    }

    .ai-feature-marquee__wrapper-{{ ai_gen_id }}::after {
      right: 0;
      background: linear-gradient(to left, {{ block.settings.background_color }}, transparent);
    }
  {% endif %}

  {% if block.settings.pause_on_hover %}
    .ai-feature-marquee__track-{{ ai_gen_id }}:hover {
      animation-play-state: paused !important;
    }
  {% endif %}

  @media screen and (max-width: 749px) {
    .ai-feature-marquee-{{ ai_gen_id }} {
      padding: {{ block.settings.padding_top_mobile }}px 0 {{ block.settings.padding_bottom_mobile }}px;
    }

    .ai-feature-marquee__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size_mobile }}px;
      margin-bottom: {{ block.settings.heading_margin_bottom_mobile }}px;
    }

    .ai-feature-marquee__item-{{ ai_gen_id }} {
      padding: 0 {{ block.settings.item_spacing_mobile }}px;
      min-width: {{ block.settings.item_min_width_mobile }}px;
    }

    .ai-feature-marquee__icon-container-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size_mobile }}px;
      height: {{ block.settings.icon_size_mobile }}px;
      margin-bottom: {{ block.settings.icon_margin_bottom_mobile }}px;
    }

    .ai-feature-marquee__icon-container-{{ ai_gen_id }} img {
      width: calc({{ block.settings.icon_size_mobile }}px * 0.6);
      height: calc({{ block.settings.icon_size_mobile }}px * 0.6);
    }

    .ai-feature-marquee__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size_mobile }}px;
      margin-bottom: {{ block.settings.title_margin_bottom_mobile }}px;
    }

    .ai-feature-marquee__percentage-{{ ai_gen_id }} {
      font-size: {{ block.settings.percentage_size_mobile }}px;
    }

    .ai-feature-marquee__divider-{{ ai_gen_id }} {
      height: {{ block.settings.divider_height_mobile }}px;
    }

    {% if block.settings.enable_fade_edges %}
      .ai-feature-marquee__wrapper-{{ ai_gen_id }}::before,
      .ai-feature-marquee__wrapper-{{ ai_gen_id }}::after {
        width: {{ block.settings.fade_width_mobile }}px;
      }
    {% endif %}
  }
{% endstyle %}

<feature-marquee-{{ ai_gen_id }} class="ai-feature-marquee-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-feature-marquee__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
  {% endif %}

  <div class="ai-feature-marquee__wrapper-{{ ai_gen_id }}">
    <div class="ai-feature-marquee__track-{{ ai_gen_id }}" data-speed="{{ block.settings.scroll_speed }}">
      <div class="ai-feature-marquee__content-{{ ai_gen_id }}">
        {% liquid
          assign items = ''
          if block.settings.item_1_title != blank
            assign items = items | append: '1,'
          endif
          if block.settings.item_2_title != blank
            assign items = items | append: '2,'
          endif
          if block.settings.item_3_title != blank
            assign items = items | append: '3,'
          endif
          if block.settings.item_4_title != blank
            assign items = items | append: '4,'
          endif
          if block.settings.item_5_title != blank
            assign items = items | append: '5,'
          endif
          if block.settings.item_6_title != blank
            assign items = items | append: '6,'
          endif
          if block.settings.item_7_title != blank
            assign items = items | append: '7,'
          endif
          if block.settings.item_8_title != blank
            assign items = items | append: '8,'
          endif
          assign item_array = items | split: ','
        %}

        {% for item_num in item_array %}
          {% if item_num != blank %}
            {% assign icon_key = 'item_' | append: item_num | append: '_icon' %}
            {% assign title_key = 'item_' | append: item_num | append: '_title' %}
            {% assign percentage_key = 'item_' | append: item_num | append: '_percentage' %}
            
            {% assign icon = block.settings[icon_key] %}
            {% assign title = block.settings[title_key] %}
            {% assign percentage = block.settings[percentage_key] %}

            {% if forloop.index > 1 %}
              <div class="ai-feature-marquee__divider-{{ ai_gen_id }}"></div>
            {% endif %}

            <div class="ai-feature-marquee__item-{{ ai_gen_id }}">
              <div class="ai-feature-marquee__icon-container-{{ ai_gen_id }}">
                {% if icon != blank %}
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-feature-marquee__icon-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if title != blank %}
                <h3 class="ai-feature-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if percentage != blank %}
                <p class="ai-feature-marquee__percentage-{{ ai_gen_id }}">{{ percentage }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <div class="ai-feature-marquee__content-{{ ai_gen_id }}" aria-hidden="true">
        {% for item_num in item_array %}
          {% if item_num != blank %}
            {% assign icon_key = 'item_' | append: item_num | append: '_icon' %}
            {% assign title_key = 'item_' | append: item_num | append: '_title' %}
            {% assign percentage_key = 'item_' | append: item_num | append: '_percentage' %}
            
            {% assign icon = block.settings[icon_key] %}
            {% assign title = block.settings[title_key] %}
            {% assign percentage = block.settings[percentage_key] %}

            {% if forloop.index > 1 %}
              <div class="ai-feature-marquee__divider-{{ ai_gen_id }}"></div>
            {% endif %}

            <div class="ai-feature-marquee__item-{{ ai_gen_id }}">
              <div class="ai-feature-marquee__icon-container-{{ ai_gen_id }}">
                {% if icon != blank %}
                  <img
                    src="{{ icon | image_url: width: 200 }}"
                    alt="{{ title | escape }}"
                    loading="lazy"
                    width="200"
                    height="200"
                  >
                {% else %}
                  <div class="ai-feature-marquee__icon-placeholder-{{ ai_gen_id }}">
                    {{ 'image' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
              {% if title != blank %}
                <h3 class="ai-feature-marquee__title-{{ ai_gen_id }}">{{ title }}</h3>
              {% endif %}
              {% if percentage != blank %}
                <p class="ai-feature-marquee__percentage-{{ ai_gen_id }}">{{ percentage }}</p>
              {% endif %}
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</feature-marquee-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureMarquee{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.track = this.querySelector('.ai-feature-marquee__track-{{ ai_gen_id }}');
        this.content = this.querySelector('.ai-feature-marquee__content-{{ ai_gen_id }}');
        this.speed = parseFloat(this.track.dataset.speed) || 1;
        this.position = 0;
        this.contentWidth = 0;
        this.animationId = null;
      }

      connectedCallback() {
        this.init();
        window.addEventListener('resize', this.handleResize.bind(this));
      }

      disconnectedCallback() {
        if (this.animationId) {
          cancelAnimationFrame(this.animationId);
        }
        window.removeEventListener('resize', this.handleResize.bind(this));
      }

      init() {
        this.contentWidth = this.content.offsetWidth;
        this.animate();
      }

      handleResize() {
        this.contentWidth = this.content.offsetWidth;
      }

      animate() {
        this.position -= this.speed;

        if (Math.abs(this.position) >= this.contentWidth) {
          this.position = 0;
        }

        this.track.style.transform = `translate3d(${this.position}px, 0, 0)`;

        this.animationId = requestAnimationFrame(this.animate.bind(this));
      }
    }

    customElements.define('feature-marquee-{{ ai_gen_id }}', FeatureMarquee{{ ai_gen_id }});
  })();
</script>

