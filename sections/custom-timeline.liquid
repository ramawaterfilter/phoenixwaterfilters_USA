<section
  class="custom-timeline"
  style="
    --timeline-background: {{ section.settings.background_color }};
    --timeline-text: {{ section.settings.text_color }};
    --timeline-muted: {{ section.settings.muted_text_color }};
    --timeline-accent: {{ section.settings.accent_color }};
    --timeline-line: {{ section.settings.line_color }};
    --timeline-card-background: {{ section.settings.card_background_color }};
    --timeline-card-text: {{ section.settings.card_text_color }};
    --timeline-card-heading: {{ section.settings.card_heading_color }};
    --timeline-card-border: {{ section.settings.card_border_color }};
    --timeline-step-count: {{ section.blocks.size | at_least: 1 }};
  "
>
  <div class="custom-timeline__container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.introduction != blank %}
      <div class="custom-timeline__header">
        {% if section.settings.eyebrow != blank %}
          <p class="custom-timeline__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="custom-timeline__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.introduction != blank %}
          <div class="custom-timeline__introduction rte">
            {{ section.settings.introduction }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      <ol class="custom-timeline__steps" role="list">
        {% for block in section.blocks %}
          <li class="custom-timeline__step" {{ block.shopify_attributes }}>
            <span class="custom-timeline__marker" aria-hidden="true"></span>
            <div class="custom-timeline__step-content">
              {% if block.settings.label != blank %}
                <p class="custom-timeline__step-label">{{ block.settings.label | escape }}</p>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="custom-timeline__step-description rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}
            </div>
          </li>
        {% endfor %}
      </ol>
    {% endif %}

    {% if section.settings.card_heading != blank or section.settings.card_description != blank or section.settings.card_image != blank %}
      <div class="custom-timeline__card">
        {% if section.settings.card_image != blank %}
          <div class="custom-timeline__card-media">
            {{
              section.settings.card_image
              | image_url: width: 300
              | image_tag:
                class: 'custom-timeline__card-image',
                loading: 'lazy',
                widths: '100, 150, 200, 300',
                sizes: '(max-width: 749px) 66px, 52px',
                alt: section.settings.card_image_alt
            }}
          </div>
        {% endif %}

        <div class="custom-timeline__card-content">
          {% if section.settings.card_heading != blank %}
            <h3 class="custom-timeline__card-heading">{{ section.settings.card_heading }}</h3>
          {% endif %}

          {% if section.settings.card_description != blank %}
            <div class="custom-timeline__card-description rte">
              {{ section.settings.card_description }}
            </div>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-timeline {
    background: var(--timeline-background);
    color: var(--timeline-text);
    padding: 5rem 0;
  }

  .custom-timeline__container {
    width: min(100% - 3.2rem, 1440px);
    margin: 0 auto;
  }

  .custom-timeline__header {
    max-width: 84rem;
    margin-bottom: 4.4rem;
  }

  .custom-timeline__eyebrow {
    margin: 0 0 1.6rem;
    color: var(--timeline-accent);
    font-family: Value Sans Bold, sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .28rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .custom-timeline__heading {
    margin: 0;
    color: var(--timeline-text);
    font-size: clamp(2.8rem, 3vw, 4.2rem);
    line-height: 1.15;
  }

  .custom-timeline__introduction {
    margin-top: 1.8rem;
    color: var(--timeline-muted);
    font-family: Value Sans, sans-serif;
    font-size: 1.7rem;
    line-height: 1.6;
  }

  .custom-timeline__introduction > :last-child,
  .custom-timeline__step-description > :last-child,
  .custom-timeline__card-description > :last-child {
    margin-bottom: 0;
  }

  .custom-timeline__steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--timeline-step-count, 1), minmax(0, 1fr));
    gap: 2.4rem;
    padding: 0;
    margin: 0 0 3.6rem;
    list-style: none;
  }

  .custom-timeline__steps::before {
    content: "";
    position: absolute;
    top: 1.4rem;
    right: 0;
    left: 0;
    height: .4rem;
    border-radius: 99rem;
    background: var(--timeline-line);
  }

  .custom-timeline__step {
    position: relative;
    min-width: 0;
  }

  .custom-timeline__marker {
    position: relative;
    z-index: 1;
    display: block;
    width: 2.8rem;
    height: 2.8rem;
    margin-bottom: 2.2rem;
    border: .2rem solid var(--timeline-accent);
    border-radius: 50%;
    background: var(--timeline-accent);
    box-shadow: 0 0 0 .3rem var(--timeline-background);
  }

  .custom-timeline__step-label {
    margin: 0;
    color: var(--timeline-text);
    font-family: Georgia Pro Bold, serif;
    font-size: 2rem;
    line-height: 1.25;
  }

  .custom-timeline__step-description {
    margin-top: 1rem;
    max-width: 26rem;
    color: var(--timeline-muted);
    font-family: Value Sans, sans-serif;
    font-size: 1.6rem;
    line-height: 1.5;
  }

  .custom-timeline__card {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 11rem;
    padding: 2rem 2.8rem;
    border: 1px solid var(--timeline-card-border);
    border-left: .4rem solid var(--timeline-accent);
    border-radius: 1.8rem;
    background: var(--timeline-card-background);
    color: var(--timeline-card-text);
  }

  .custom-timeline__card-media {
    flex: 0 0 5.2rem;
    width: 5.2rem;
    height: 5.2rem;
    overflow: hidden;
    border-radius: 50%;
    background: #fff;
  }

  .custom-timeline__card-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .custom-timeline__card-content {
    min-width: 0;
  }

  .custom-timeline__card-heading {
    margin: 0;
    color: var(--timeline-card-heading);
    font-family: Georgia Pro Bold, serif;
    font-size: 2.2rem;
    line-height: 1.25;
  }

  .custom-timeline__card-description {
    margin-top: .8rem;
    color: var(--timeline-card-text);
    font-family: Value Sans, sans-serif;
    font-size: 1.6rem;
    line-height: 1.5;
  }

  @media (max-width: 749px) {
    .custom-timeline {
      padding: 3.2rem 0;
    }

    .custom-timeline__container {
      width: min(100% - 1.8rem, 54rem);
    }

    .custom-timeline__header {
      margin-bottom: 2.2rem;
    }

    .custom-timeline__eyebrow {
      margin-bottom: .8rem;
      font-size: 1.1rem;
      letter-spacing: .22rem;
    }

    .custom-timeline__heading {
      font-size: 2.6rem;
      line-height: 1.2;
    }

    .custom-timeline__introduction {
      margin-top: 1.2rem;
      font-size: 1.5rem;
    }

    .custom-timeline__steps {
      display: flex;
      flex-direction: column;
      gap: 0;
      margin-bottom: 2.2rem;
    }

    .custom-timeline__steps::before {
      top: .8rem;
      bottom: .8rem;
      left: .8rem;
      width: .2rem;
      height: auto;
    }

    .custom-timeline__step {
      display: grid;
      grid-template-columns: 1.8rem minmax(0, 1fr);
      gap: .8rem;
      padding-bottom: 1.8rem;
    }

    .custom-timeline__step:last-child {
      padding-bottom: 0;
    }

    .custom-timeline__marker {
      width: 1.8rem;
      height: 1.8rem;
      margin: 0;
      border-width: .2rem;
      background: var(--timeline-accent);
      box-shadow: inset 0 0 0 .3rem var(--timeline-background);
    }

    .custom-timeline__step-label {
      color: var(--timeline-accent);
      font-family: Value Sans Bold, sans-serif;
      font-size: 1.1rem;
      letter-spacing: .1rem;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .custom-timeline__step-description {
      margin-top: .3rem;
      max-width: none;
      color: var(--timeline-text);
      font-size: 1.4rem;
      line-height: 1.4;
    }

    .custom-timeline__card {
      align-items: flex-start;
      gap: 1.4rem;
      min-height: 0;
      padding: 2.2rem 1.8rem;
      border: 0;
      border-radius: 1.8rem;
    }

    .custom-timeline__card-media {
      flex-basis: 6.6rem;
      width: 6.6rem;
      height: 6.6rem;
      border-radius: 1rem;
    }

    .custom-timeline__card-heading {
      font-size: 1.6rem;
    }

    .custom-timeline__card-description {
      margin-top: .5rem;
      font-size: 1.3rem;
      line-height: 1.45;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom timeline",
  "tag": "section",
  "class": "section-custom-timeline",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
