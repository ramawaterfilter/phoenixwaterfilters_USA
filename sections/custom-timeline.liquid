          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Month 0"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Install & start filtering</p>"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Custom timeline",
      "blocks": [
        {
          "type": "timeline_step",
          "settings": {
            "label": "Month 0",
            "description": "<p>Install & start filtering</p>"
