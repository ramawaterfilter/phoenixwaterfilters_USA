      "id": "card_background_color",
      "label": "Background color",
      "default": "#f8f9fd"
    },
    {
      "type": "color",
      "id": "card_text_color",
      "label": "Text color",
      "default": "#677892"
    },
    {
      "type": "color",
      "id": "card_heading_color",
