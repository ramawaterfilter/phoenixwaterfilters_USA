<div class="wrapper
  {% if section.settings.section_randoimg != blank %}
  extra-image-space
  {% endif %}">

  {% assign columns = 'col-12 col-xl-10 pe-5 pb-5' %}
  {% assign img_classes = 'pb-5' %}

  {% if section.settings.section_randoimg != blank %}
    {% assign columns = 'col-12 col-md-5 pe-3' %}
  {% endif %}

  <div class="container">
    {% if section.settings.top_image %}
      <div class="row justify-content-start">
        <div class="col-12 col-xl-10 pe-5 pb-5">
          <img
            src="{{ section.settings.top_image | img_url: '1920x' }}"
            class="{{ img_classes }}"
            loading="lazy" />
        </div>
      </div>
    {% endif %}

    {% if section.settings.heading != blank or section.settings.content != blank or section.settings.section_randoimg != blank %}
      <div class="row justify-content-start">
        <div class="{{ columns }}">
          {% if section.settings.heading != blank %}
            <h2 class="article-heading{% if section.settings.section_randoimg != blank %} list-heading{%endif%}">{{ section.settings.heading }}</h2>
          {% endif %}

          {% if section.settings.content != blank %}
            {{ section.settings.content | replace: '[month]', '<span class="dyn-month"></span>' }}
          {% endif %}
        </div>

        {% if section.settings.section_randoimg != blank %}
          <div class="col-12 col-md-4 small-image-column offset-md-1">
            <img
              src="{{ section.settings.section_randoimg | img_url: '600x' }}"
              loading="lazy"
              class="float-right-small" />
          </div>
        {% endif %}
      </div>
    {% endif %}


    {% if section.blocks != blank %}
      <div class="row">
        <div class="col-12 col-xl-10 pe-5 pb-5">
          {% if section.settings.features_heading != blank %}
            <p>
              <strong>{{ section.settings.features_heading }}</strong>
            </p>
          {% endif %}

          <ul class="features features-{{ section.settings.feature_cols }} d-flex flex-wrap pb-5">

            {% assign total_blocks = section.blocks.size %}
            {% assign is_odd = total_blocks | modulo: 2 %}

            {% for block in section.blocks %}
              {% assign is_last_item = forloop.last %}
              {% assign li_classes = 'd-flex align-items-start py-2 me-3' %}

              {% if section.settings.feature_cols == 'two-cols' and is_odd and is_last_item %}
                {% assign li_classes = li_classes | append: ' li-last' %}
              {% endif %}

              <li class="{{ li_classes }}">
                {% if block.settings.feature_icon %}
                  {{ block.settings.feature_icon | img_url: '200x' | image_tag: class: "img-fluid feature-icon view-animation me-3", loading: "lazy" }}
                {% else %}
                  {% if section.settings.layout != 'copy' %}
                    <img src="{{ 'icon-features-tick-alt.svg' | asset_url }}" loading="lazy" />
                  {% endif %}
                {% endif %}
                <p>{{ block.settings.feature_text }}</p>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}

    {% if section.settings.buttonlink != blank %}
      <div class="row">
        <div class="col-12 col-xl-10 pb-5 mt-2 mb-5">
          {% render 'button' %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.bottom_image %}
      <div class="row justify-content-start">
        <div class="col-12 col-xl-10 pe-5 pb-5">
          <img
            src="{{ section.settings.bottom_image | img_url: '1920x' }}"
            class="{{ img_classes }}"
            loading="lazy" />
        </div>
      </div>
    {% endif %}

    {% if section.settings.video_id != blank %}
      <div class="row justify-content-start">
        <div class="col-12 col-xl-10 pe-5 pb-5">

          <div class="video-preview-container view-animation fade-up" data-wistia-vid-id="{{ section.settings.video_id }}"></div>
        {% comment %} 
                    <div class="video-preview-container card__video">              
          <script src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}.jsonp" async></script></script><div class="wistia_responsive_padding" style="padding:56.25% 0 0 0;position:relative;"><div class="wistia_responsive_wrapper" style="height:100%;left:0;position:absolute;top:0;width:100%;"><div class="wistia_embed wistia_async_{{ section.settings.video_id }} seo=true videoFoam=true" style="height:100%;position:relative;width:100%"><div class="wistia_swatch" style="height:100%;left:0;opacity:0;overflow:hidden;position:absolute;top:0;transition:opacity 200ms;width:100%;"><img src="https://fast.wistia.com/embed/medias/{{ section.settings.video_id }}/swatch" style="filter:blur(5px);height:100%;object-fit:contain;width:100%;" alt="" aria-hidden="true" onload="this.parentNode.style.opacity=1;"   loading="lazy" /></div></div></div>
          </div></div> 
        {% endcomment %}
        </div>
      </div>
    {% endif %}

    {% if section.settings.show_divider == 'show' %}
      <div class="row p-0 ">
        <div class="col-12 col-xl-10 me-5 divider"></div>
      </div>
    {% endif %}

  </div>
</div>

{% schema %}
  {
    "name": "Article Copy",
    "tag": "section",
    "class": "section-copy-image section-article-copy trigger-observer",
    "settings": [
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "image_picker",
        "id": "top_image",
        "label": "Top Image"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading"
      },
      {
        "type": "richtext",
        "id": "content",
        "label": "Content"
      }, {
        "type": "image_picker",
        "id": "bottom_image",
        "label": "Bottom Image"
      }, {
        "type": "text",
        "id": "video_id",
        "label": "Wistia Video ID"
      }, {
        "type": "text",
        "id": "features_heading",
        "label": "Features Title"
      }, {
        "type": "select",
        "id": "feature_cols",
        "label": "Features Width",
        "default": "fill",
        "options": [
          {
            "value": "fill",
            "label": "Fill"
          }, {
            "value": "two-cols",
            "label": "Half"
          }, {
            "value": "max-content",
            "label": "Hug"
          }
        ]
      }, {
        "type": "url",
        "id": "buttonlink",
        "label": "Button Link"
      }, {
        "type": "text",
        "id": "buttontext",
        "label": "Button Text"
      }, {
        "type": "text",
        "id": "afterbutton",
        "label": "After Button Text"
      }, {
        "type": "select",
        "id": "show_divider",
        "label": "Divider",
        "default": "hide",
        "options": [
          {
            "value": "show",
            "label": "Show"
          }, {
            "value": "hide",
            "label": "Hide"
          }
        ]
      }, {
        "type": "image_picker",
        "id": "section_randoimg",
        "label": "Floating Image"
      }

    ],
    "blocks": [
      {
        "type": "text",
        "name": "Features",
        "settings": [
          {
            "type": "image_picker",
            "id": "feature_icon",
            "label": "Custom Icon"
          }, {
            "type": "text",
            "id": "feature_text",
            "label": "Text"
          }
        ]
      }
    ],
    "presets": [
      {
        "name": "Article Copy"
      }
    ],
    "disabled_on": {
      "groups": ["header"]
    }
  }
{% endschema %}