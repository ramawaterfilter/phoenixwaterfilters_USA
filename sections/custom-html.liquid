{% schema %}
{
  "name": "Custom Embed Video",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "embed_code",
      "label": "Embed Code",
      "info": "Paste your full Wistia/YouTube/Vimeo embed code here"
    }
  ],
  "presets": [
    {
      "name": "Custom Embed Video"
    }
  ]
}
{% endschema %}

<div class="custom-embed-video-container">
  <div class="responsive-embed-wrapper">
    {{ section.settings.embed_code }}
  </div>
</div>

<style>
.custom-embed-video-container {
  max-width: 100%;
  margin: 0 auto;
  padding:0px;
}
.responsive-embed-wrapper {
  position: relative;
  padding-bottom: 56.25%; /* 16:9 aspect ratio */
  height: 0;
  overflow: hidden;
}
.responsive-embed-wrapper iframe,
.responsive-embed-wrapper .wistia_responsive_wrapper {
  position: absolute !important;
  top: 0;
  left: 0;
  width: 100% !important;
  height: 100% !important;
}
</style>
