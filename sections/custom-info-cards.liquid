<section
  class="custom-info-cards"
  style="
    --info-cards-background: {{ section.settings.background_color }};
    --info-cards-text: {{ section.settings.text_color }};
    --info-cards-accent: {{ section.settings.accent_color }};
    --info-cards-columns: {{ section.settings.columns_desktop }};
  "
>
  <div class="custom-info-cards__container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.introduction != blank %}
      <div class="custom-info-cards__header">
        {% if section.settings.eyebrow != blank %}
          <p class="custom-info-cards__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="custom-info-cards__heading">{{ section.settings.heading }}</h2>
        {% endif %}

        {% if section.settings.introduction != blank %}
          <div class="custom-info-cards__introduction rte">
            {{ section.settings.introduction }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    {% if section.blocks.size > 0 %}
      {% liquid
        assign cards_limit = section.blocks.size
        if section.settings.cards_to_show == 'one'
          assign cards_limit = 1
        endif
      %}

      <div class="custom-info-cards__grid">
        {% for block in section.blocks limit: cards_limit %}
          <article class="custom-info-card" {{ block.shopify_attributes }}>
            {% if block.settings.desktop_image != blank or block.settings.mobile_image != blank %}
              {% assign desktop_image = block.settings.desktop_image | default: block.settings.mobile_image %}
              {% assign mobile_image = block.settings.mobile_image | default: desktop_image %}

              <div class="custom-info-card__media">
                <picture>
                  <source
                    media="(max-width: 749px)"
                    srcset="
                      {{ mobile_image | image_url: width: 480 }} 480w,
                      {{ mobile_image | image_url: width: 720 }} 720w,
                      {{ mobile_image | image_url: width: 960 }} 960w
                    "
                    sizes="calc(100vw - 3.2rem)"
                  >
                  {{
                    desktop_image
                    | image_url: width: 900
                    | image_tag:
                      class: 'custom-info-card__image',
                      loading: 'lazy',
                      widths: '300, 450, 600, 750, 900',
                      sizes: '(min-width: 1200px) 280px, (min-width: 750px) 25vw, calc(100vw - 3.2rem)',
                      alt: block.settings.image_alt
                  }}
                </picture>
              </div>
            {% endif %}

            <div class="custom-info-card__content">
              {% if block.settings.heading != blank %}
                <h3 class="custom-info-card__heading">{{ block.settings.heading }}</h3>
              {% endif %}

              {% if block.settings.description != blank %}
                <div class="custom-info-card__description rte">
                  {{ block.settings.description }}
                </div>
              {% endif %}

              {% if block.settings.tag != blank %}
                <span class="custom-info-card__tag">{{ block.settings.tag | escape }}</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .custom-info-cards {
    background: var(--info-cards-background);
    color: var(--info-cards-text);
    padding: 5rem 0;
  }

  .custom-info-cards__container {
    width: min(100% - 3.2rem, 1440px);
    margin: 0 auto;
  }

  .custom-info-cards__header {
    max-width: 84rem;
    margin-bottom: 3rem;
  }

  .custom-info-cards__eyebrow {
    margin: 0 0 1rem;
    color: var(--info-cards-accent);
    font-family: Value Sans Bold, sans-serif;
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: .24rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .custom-info-cards__heading {
    margin: 0;
    color: var(--info-cards-text);
    font-size: clamp(2.8rem, 3.2vw, 4.6rem);
    line-height: 1.15;
  }

  .custom-info-cards__introduction {
    max-width: 76rem;
    margin-top: 1.4rem;
    color: var(--info-cards-text);
    font-family: Value Sans, sans-serif;
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .custom-info-cards__introduction > :last-child,
  .custom-info-card__description > :last-child {
    margin-bottom: 0;
  }

  .custom-info-cards__grid {
    display: grid;
    grid-template-columns: repeat(var(--info-cards-columns), minmax(0, 1fr));
    gap: 2.8rem;
  }

  .custom-info-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid #e5e8eb;
    border-radius: 1.6rem;
    background: #fff;
    box-shadow: 0 .4rem 1.6rem rgba(21, 58, 91, .06);
  }

  .custom-info-card__media {
    aspect-ratio: 1.35 / 1;
    overflow: hidden;
    background: #f3f3f3;
  }

  .custom-info-card__media picture,
  .custom-info-card__image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .custom-info-card__image {
    object-fit: cover;
  }

  .custom-info-card__content {
    padding: 2.4rem;
  }

  .custom-info-card__heading {
    margin: 0;
    color: var(--info-cards-text);
    font-family: Georgia Pro Bold, serif;
    font-size: 2rem;
    line-height: 1.25;
  }

  .custom-info-card__description {
    margin-top: 1.2rem;
    color: var(--info-cards-text);
    font-family: Value Sans, sans-serif;
    font-size: 1.5rem;
    line-height: 1.6;
  }

  .custom-info-card__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.4rem;
    margin-top: 1.8rem;
    padding: .7rem 1.6rem;
    border-radius: 999px;
    background: #55b6e7;
    color: #fff;
    font-family: Value Sans Bold, sans-serif;
    font-size: 1.35rem;
    font-weight: 700;
    line-height: 1.2;
  }

  @media (max-width: 989px) and (min-width: 750px) {
    .custom-info-cards__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) {
    .custom-info-cards {
      padding: 3.2rem 0;
    }

    .custom-info-cards__container {
      width: min(100% - 2.6rem, 54rem);
    }

    .custom-info-cards__header {
      margin-bottom: 2.4rem;
    }

    .custom-info-cards__eyebrow {
      margin-bottom: .8rem;
      font-size: 1.1rem;
    }

    .custom-info-cards__heading {
      font-size: 2.6rem;
      line-height: 1.2;
    }

    .custom-info-cards__introduction {
      margin-top: 1.6rem;
      font-size: 1.5rem;
      line-height: 1.65;
    }

    .custom-info-cards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.6rem;
    }

    .custom-info-card {
      border: 0;
      border-radius: 1.2rem;
      box-shadow: 0 .6rem 2rem rgba(21, 58, 91, .08);
    }

    .custom-info-card__media {
      aspect-ratio: 2.45 / 1;
    }

    .custom-info-card__content {
      padding: 2rem 1.5rem 2.2rem;
    }

    .custom-info-card__heading {
      font-size: 1.8rem;
    }

    .custom-info-card__description {
      margin-top: .8rem;
      font-size: 1.4rem;
      line-height: 1.55;
    }

    .custom-info-card__tag {
      min-height: 3.2rem;
      margin-top: 1.6rem;
      padding: .7rem 1.5rem;
      font-size: 1.25rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Custom info cards",
  "tag": "section",
  "class": "section-custom-info-cards",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Why it matters"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Removes >95% of Fluoride"
    },
    {
      "type": "richtext",
      "id": "introduction",
      "label": "Introduction",
      "default": "<p>Fluoride is added to public drinking water for approximately three out of four Americans. Growing scientific research has raised concerns about excessive fluoride exposure and its potential impacts on health.</p>"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Cards per row on desktop",
      "default": "4",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "select",
      "id": "cards_to_show",
      "label": "Cards to show",
      "default": "all",
      "options": [
        {
          "value": "all",
          "label": "All cards"
        },
        {
          "value": "one",
          "label": "One card"
        }
      ]
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#0d2948"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Eyebrow color",
      "default": "#0b6b73"
    }
  ],
  "blocks": [
    {
      "type": "info_card",
      "name": "Info card",
      "settings": [
        {
          "type": "image_picker",
          "id": "desktop_image",
          "label": "Desktop image"
        },
        {
          "type": "image_picker",
          "id": "mobile_image",
          "label": "Mobile image",
          "info": "Uses the desktop image when left blank."
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Neurological Health"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description",
          "default": "<p>Emerging research has raised concerns about excessive fluoride exposure and potential health effects.</p>"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Subscribe & Save 5%"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Custom info cards",
      "blocks": [
        {
          "type": "info_card"
        },
        {
          "type": "info_card"
        },
        {
          "type": "info_card"
        },
        {
          "type": "info_card"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  }
}
{% endschema %}
